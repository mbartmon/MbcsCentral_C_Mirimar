<Window x:Class="MbcsCentral.MigrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="350" Width="525"
        Name="formMigrationWindow"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Button Name="cmdSelectAll" Content="Select All" VerticalAlignment="Center" Margin="20,0,0,0" Click="cmdSelectAll_Click"/>
            <Button Name="cmdSelectNone" Content="Select None" VerticalAlignment="Center" Margin="20,0,0,0" Click="cmdSelectNone_Click"/>
        </StackPanel>
        <ListView Grid.Row="1" Name="lstTables">
            <ListView.View>
                <GridView>
                    <GridViewColumn>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding DisplayValue}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <Button Name="cmdProcess" Content="PROCESS" Click="cmdProcess_Click"/>
            <Button Name="cmdCancel" Content="CANCEL" Margin="20,0,0,0" Click="cmdCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
