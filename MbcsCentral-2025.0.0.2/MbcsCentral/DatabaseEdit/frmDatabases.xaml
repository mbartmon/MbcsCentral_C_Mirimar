<Window x:Class="MbcsCentral.frmDatabases"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Database Utilities"
        Width="1070"
        MinWidth="860"
        MinHeight="440"
        Background="AliceBlue"
        Closing="Window_Closing"
        Loaded="Window_Loaded"
        SizeToContent="Width"
        TextBlock.FontSize="14"
        TextBlock.FontWeight="Bold"
        TextBlock.TextAlignment="Center">
    <TabControl>
        <TabControl.Resources>
            <Style TargetType="TabItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border Name="Border"
                                    Margin="2,0"
                                    BorderBrush="Gainsboro"
                                    BorderThickness="1,1,1,0"
                                    CornerRadius="4,4,0,0">
                                <ContentPresenter x:Name="ContentSite"
                                                  Margin="10,2"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  ContentSource="Header" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="LightSkyBlue" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="False">
                                    <Setter TargetName="Border" Property="Background" Value="Bisque" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </TabControl.Resources>
        <TabItem Name="tabEdit"
                 Background="Bisque"
                 FontSize="14"
                 Header="Choose/Create Database Copies">
            <Grid HorizontalAlignment="Stretch"
                  TextBlock.FontSize="12"
                  TextBlock.TextAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="69*" MinWidth="250" />
                    <ColumnDefinition Width="181*" />
                    <ColumnDefinition Width="0*" />
                    <ColumnDefinition Width="170*" />
                    <ColumnDefinition Width="154*" />
                    <ColumnDefinition Width="231*" />
                    <ColumnDefinition Width="0*" />
                    <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="90" />
                    <RowDefinition />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="35" />
                </Grid.RowDefinitions>
                <Grid Name="InputBox"
                      Grid.Row="1"
                      Grid.Column="0"
                      Grid.ColumnSpan="6"
                      Margin="0,0,0.231,0"
                      Visibility="Collapsed">
                    <Grid Background="Black" Opacity="0.5" />
                    <Border MinWidth="300"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Orange"
                            BorderBrush="Black"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel>
                            <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                <TextBlock Name="InputTextLabel"
                                           Margin="2,0,0,0"
                                           FontWeight="Bold"
                                           Text="Enter up to 8 character tag." />
                                <TextBox Name="InputTextBox"
                                         Width="50"
                                         Margin="5,0,3,0"
                                         VerticalAlignment="Center"
                                         MaxLength="8"
                                         PreviewKeyDown="InputTextBox_PreviewKeyDown" />
                            </StackPanel>
                            <TextBlock Margin="0,-3,3,0"
                                       HorizontalAlignment="Right"
                                       Text="Only Letters and Numbers" />
                            <TextBlock VerticalAlignment="Center" Text="New Database Name:" />
                            <TextBlock Name="txtNewDatabaseName"
                                       VerticalAlignment="Center"
                                       Background="Bisque">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}_{1}_{2}">
                                        <Binding Path="InitialCatalog" />
                                        <Binding ElementName="InputTextBox" Path="Text" />
                                        <Binding Path="CreateDate" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <Button x:Name="YesButton"
                                        Margin="5"
                                        Background="{x:Null}"
                                        Click="YesButton_Click"
                                        Content="Create"
                                        IsDefault="True" />
                                <Button x:Name="NoButton"
                                        Margin="5"
                                        Background="{x:Null}"
                                        Click="NoButton_Click"
                                        Content="Cancel" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                <StackPanel Grid.Row="0"
                            Grid.ColumnSpan="6"
                            Margin="0,0,5.231,0"
                            TextBlock.FontSize="12">
                    <Border Height="Auto"
                            Background="LightGray"
                            BorderBrush="Green"
                            BorderThickness="2,2,2,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Width="125"
                                           VerticalAlignment="Center"
                                           Text="Production Server:" />
                                <TextBlock Name="txtProductionServer"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           Foreground="DarkRed"
                                           Text="{Binding productionServer, Mode=TwoWay}"
                                           TextAlignment="Left" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Width="125"
                                           VerticalAlignment="Center"
                                           Text="Production Database:" />
                                <TextBlock Name="txtProductionDatabase"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           Foreground="DarkRed"
                                           Text="{Binding productionDatabase, Mode=TwoWay}"
                                           TextAlignment="Left" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Height="Auto"
                            BorderBrush="Green"
                            BorderThickness="2">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Width="125"
                                           VerticalAlignment="Center"
                                           Text="Current Server:" />
                                <TextBlock Name="txtCurrentServer"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="DarkBlue"
                                           Text="{Binding currentServer, Mode=TwoWay}"
                                           TextAlignment="Left" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Width="125"
                                           VerticalAlignment="Center"
                                           Text="Current Database:" />
                                <TextBlock Name="txtCurrentDatabase"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="DarkBlue"
                                           Text="{Binding currentDatabase, Mode=TwoWay}"
                                           TextAlignment="Left" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Border Name="bdrDatabases"
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="6"
                        Margin="10,10,10.231,10"
                        BorderBrush="Blue"
                        BorderThickness="2"
                        CornerRadius="5">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="DATABASE NAMES"
                                   TextAlignment="Center" />
                        <TreeView Name="lstDatabases"
                                  Background="White"
                                  DisplayMemberPath="DisplayName"
                                  ItemsSource="{Binding}">

                            <TreeView.ItemContainerStyle>
                                <Style TargetType="{x:Type TreeViewItem}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=Current}" Value="True">
                                            <Setter Property="TreeViewItem.Foreground" Value="Red" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Path=Current}" Value="False">
                                            <Setter Property="TreeViewItem.Foreground" Value="Black" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TreeView.ItemContainerStyle>

                        </TreeView>
                    </DockPanel>
                </Border>
                <StackPanel Grid.RowSpan="4"
                            Grid.Column="5"
                            Grid.ColumnSpan="3"
                            Width="Auto"
                            Margin="230.598,5,0.231,0">
                    <Border BorderBrush="Black"
                            BorderThickness="2"
                            CornerRadius="3">
                        <CheckBox Name="chkPermanent"
                                  Width="220"
                                  Margin="0,2,0,2">
                            <CheckBox.Content>
                                <TextBlock Margin="0,0,5,0"
                                           FontStyle="Italic"
                                           Foreground="DarkBlue"
                                           TextWrapping="Wrap">
                                    Checking this box will cause any changes made here to be applied to all users. Those changes will persist after you exit the program.<LineBreak />
                                    <LineBreak />
                                    To use the changes for only yourself during the current session, leave the box un-checked.</TextBlock>
                            </CheckBox.Content>
                        </CheckBox>
                    </Border>
                    <StackPanel Margin="0,5,0,0"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                        <Button Name="cmdSave"
                                Margin="5"
                                Click="cmdSave_Click"
                                Content="Save then Exit" />
                        <Button Name="cmdExit"
                                Margin="5"
                                Click="cmdExit_Click"
                                Content="Exit Only" />
                    </StackPanel>
                    <Button Name="cmdCreate"
                            Margin="5"
                            Background="BurlyWood"
                            Click="cmdCreate_Click">
                        <Button.Content>
                            <TextBlock>
                                Create NEW Database<LineBreak />
                                from current Database.</TextBlock>
                        </Button.Content>
                    </Button>
                    <Button Name="cmdEdit"
                            Margin="20,0,20,0"
                            Background="BurlyWood"
                            Click="cmdEdit_Click"
                            Content="Edit Databases" />
                    <Button Name="cmdBackup"
                            Margin="20,5,20,0"
                            Background="BurlyWood"
                            Click="cmdBackup_Click"
                            Content="Backups" />
                    <Button x:Name="cmdRepair"
                            Margin="20,5,20,0"
                            Background="BurlyWood"
                            Click="cmdRepair_Click"
                            Content="Repair Database" />
                </StackPanel>
                <TextBlock Grid.Row="2"
                           Grid.Column="2"
                           Grid.ColumnSpan="4"
                           Margin="114,0,212.231,0"
                           HorizontalAlignment="Center">
                    <Span Foreground="Red">RED</Span>
                    highlight indicates current selection</TextBlock>
                <Button Name="cmdChangeDatabase"
                        Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="6"
                        Margin="5,5,5.231,5"
                        Click="cmdChangeDatabase_Click"
                        Content="Change Database" />
            </Grid>
        </TabItem>
        <TabItem Name="tabServers"
                 Background="LightCoral"
                 FontSize="14"
                 Header="Select Servers">
            <Grid HorizontalAlignment="Stretch"
                  TextBlock.FontSize="12"
                  TextBlock.TextAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232.313" />
                    <ColumnDefinition Width="23.687" />
                    <ColumnDefinition Width="41.5" />
                    <ColumnDefinition Width="43" />
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="45" />
                    <ColumnDefinition Width="119" />
                    <ColumnDefinition Width="525" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="35" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>
                <Grid Name="InputBoxServers"
                      Grid.Column="0"
                      Grid.ColumnSpan="7"
                      Visibility="Collapsed">
                    <Grid Background="Black" Opacity="0.5" />
                    <Border MinWidth="300"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Orange"
                            BorderBrush="Black"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel>
                            <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                <TextBlock Name="InputTextLabelServers"
                                           Margin="2,0,0,0"
                                           FontWeight="Bold"
                                           Text="Enter up to 8 character tag." />
                                <TextBox Name="InputTextBoxServers"
                                         Width="50"
                                         Margin="5,0,3,0"
                                         VerticalAlignment="Center"
                                         MaxLength="8"
                                         PreviewKeyDown="InputTextBox_PreviewKeyDown" />
                            </StackPanel>
                            <TextBlock Margin="0,-3,3,0"
                                       HorizontalAlignment="Right"
                                       Text="Only Letters and Numbers" />
                            <TextBlock VerticalAlignment="Center" Text="New Database Name:" />
                            <TextBlock Name="txtNewDatabaseNameServers"
                                       VerticalAlignment="Center"
                                       Background="Bisque">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}_{1}_{2}">
                                        <Binding Path="InitialCatalog" />
                                        <Binding ElementName="InputTextBox" Path="Text" />
                                        <Binding Path="CreateDate" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <Button x:Name="YesButtonServers"
                                        Margin="5"
                                        Background="{x:Null}"
                                        Click="YesButton_ClickServers"
                                        Content="Create"
                                        IsDefault="True" />
                                <Button x:Name="NoButtonServers"
                                        Margin="5"
                                        Background="{x:Null}"
                                        Click="NoButton_ClickServers"
                                        Content="Cancel" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Name="bdrDatabasesServers"
                        Grid.Column="0"
                        Grid.ColumnSpan="7"
                        Margin="10"
                        BorderBrush="Blue"
                        BorderThickness="2"
                        CornerRadius="5">
                    <DockPanel LastChildFill="True">
                        <Border BorderBrush="Blue" BorderThickness="2">
                            <StackPanel Width="250">
                                <TextBlock Text="DATABASE MACHINE NAMES" TextAlignment="Center" />
                                <TreeView Name="lstDatabaseMachines"
                                          Background="White"
                                          DisplayMemberPath="DisplayName"
                                          ItemsSource="{Binding}">
                                    <TreeView.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />
                                    </TreeView.Resources>
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="{x:Type TreeViewItem}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=Current}" Value="True">
                                                    <Setter Property="TreeViewItem.Foreground" Value="Red" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Path=Current}" Value="False">
                                                    <Setter Property="TreeViewItem.Foreground" Value="Black" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TreeView.ItemContainerStyle>

                                </TreeView>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="Blue" BorderThickness="2">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="DATABASE SERVER NAMES" TextAlignment="Center" />
                                <TreeView Name="lstDatabaseServers"
                                          Background="White"
                                          DisplayMemberPath="DisplayName"
                                          ItemsSource="{Binding}">
                                    <TreeView.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />
                                    </TreeView.Resources>

                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="{x:Type TreeViewItem}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=Current}" Value="True">
                                                    <Setter Property="TreeViewItem.Foreground" Value="Red" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Path=Current}" Value="False">
                                                    <Setter Property="TreeViewItem.Foreground" Value="Black" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TreeView.ItemContainerStyle>

                                </TreeView>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </Border>

                <Border Grid.Row="3"
                        Grid.ColumnSpan="7"
                        Margin="10"
                        BorderBrush="Blue"
                        BorderThickness="3"
                        CornerRadius="3">
                    <StackPanel>
                        <TextBlock VerticalAlignment="Center"
                                   Text="Available Servers"
                                   TextAlignment="Center" />
                        <Border Height="3"
                                BorderBrush="Black"
                                BorderThickness="1" />
                        <TreeView Name="lstServersDatabases"
                                  DisplayMemberPath="DisplayName"
                                  ItemsSource="{Binding}"
                                  SelectedItemChanged="LstServersDatabases_SelectedItemChanged">
                            <TreeView.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />
                            </TreeView.Resources>

                            <TreeView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Name="ctxPeekDatabases" Click="CtxPeekDatabases_Click" />
                                    <MenuItem Name="ctxMakeCurrent" Click="CtxMakeCurrent_Click" />
                                    <MenuItem Name="ctxDeleteServerDB" Click="CtxDeleteServerDB_Click" />
                                </ContextMenu>
                            </TreeView.ContextMenu>
                        </TreeView>
                    </StackPanel>
                </Border>
                <Border Grid.Row="3"
                        Grid.Column="7"
                        Width="Auto"
                        Margin="10"
                        BorderBrush="Blue"
                        BorderThickness="3"
                        CornerRadius="3">

                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center" Text="Databases" />
                        <Border Width="Auto"
                                Height="3"
                                BorderBrush="Black"
                                BorderThickness="1" />
                        <TreeView Name="lstSelectedDatabases"
                                  DisplayMemberPath="DisplayName"
                                  ItemsSource="{Binding}">
                            <TreeView.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />
                            </TreeView.Resources>

                        </TreeView>
                    </StackPanel>
                </Border>
                <StackPanel Grid.RowSpan="3"
                            Grid.Column="7"
                            Width="Auto"
                            Margin="0,5,0,0">
                    <Border Width="250"
                            BorderBrush="Black"
                            BorderThickness="2"
                            CornerRadius="3">
                        <CheckBox Name="chkPermanentServers"
                                  Width="220"
                                  Margin="0,2,0,2">
                            <CheckBox.Content>
                                <TextBlock Margin="0,0,5,0"
                                           FontStyle="Italic"
                                           Foreground="DarkBlue"
                                           TextWrapping="Wrap">
                                    Checking this box will cause any changes made here to be applied to all users. Those changes will persist after you exit the program.<LineBreak />
                                    <LineBreak />
                                    To use the changes for only yourself during the current session, leave the box un-checked.<LineBreak /><LineBreak />
                                    In either case, to save the changes: Click 'Save Then Exit'</TextBlock>
                            </CheckBox.Content>
                        </CheckBox>
                    </Border>
                    <StackPanel Margin="0,5,0,0"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                        <Button Name="cmdSaveServers"
                                Margin="5"
                                Click="cmdSave_ClickServers"
                                Content="Save then Exit" />
                        <Button Name="cmdExitServers"
                                Margin="5"
                                Click="cmdExit_Click"
                                Content="Exit Only" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Row="1"
                           Grid.ColumnSpan="6"
                           Margin="152,0,31,0"
                           HorizontalAlignment="Center">
                    <Span FontWeight="Bold" Foreground="Red">RED</Span>
                    highlight indicates current selection</TextBlock>
                <StackPanel Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="8"
                            Orientation="Horizontal">
                    <!--
                    <Button
                        Name="cmdChangeDatabaseMachine"
                        Width="250"
                        Margin="10,6,5,4"
                        Click="CmdChangeDatabaseMachine_Click">
                        <TextBlock>
                            <Run Text="Change Database " />
                            <Span
                                FontSize="14"
                                FontStyle="Italic"
                                Foreground="DarkRed">
                                MACHINE
                            </Span>
                        </TextBlock>
                    </Button>
                    <Button
                        Name="cmdChangeDatabaseServer"
                        Width="220"
                        Margin="5,5,5,5"
                        HorizontalAlignment="Left"
                        Click="CmdChangeDatabaseServer_Click">
                        <TextBlock>
                            <Run Text="Change Database " />
                            <Span
                                FontSize="14"
                                FontStyle="Italic"
                                Foreground="DarkRed">
                                SERVER
                            </Span>
                        </TextBlock>
                    </Button>
                    -->
                    <Button Name="cmdAddToAvailable"
                            Width="190"
                            Margin="10,5,5,5"
                            Click="CmdAddToAvailable_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center">Add to Available Servers</TextBlock>
                            <Image Margin="5,0,0,0" Source="pack://application:,,,/Resources/ARW03DN.png" />
                        </StackPanel>
                    </Button>
                    <Button Name="cmdRemoveFromAvailable"
                            Width="225"
                            Height="25"
                            Margin="5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Click="CmdRemoveFromAvailable_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center">Remove from Available Servers</TextBlock>
                            <Image Margin="5,0,0,0" Source="pack://application,,,/Resources/ARW03UP.png" />
                        </StackPanel>
                    </Button>
                    <!--
                    <Button
                        Name="cmdPeekDatabases"
                        Width="160"
                        Height="25"
                        Margin="5"
                        HorizontalAlignment="Left"
                        Click="CmdPeekDatabases_Click"
                        Content="Peek at Selected Databases" />
                    -->
                    <Button Name="cmdMakeAvailableCurrent"
                            Width="225"
                            Height="25"
                            Margin="5"
                            HorizontalAlignment="Left"
                            Click="CmdMakeAvailableCurrent_Click"
                            Content="Make Selected Server Currrent Server" />

                    <Button Name="cmdTest"
                            Margin="10,5,5,5"
                            HorizontalAlignment="Left"
                            Click="CmdTest_Click"
                            Content="TEST CONNECTION" />
                    <Button Name="cmdRepairDB"
                            Margin="10,5,5,5"
                            Content="REPAIR DATABASE"
                            Click="cmdRepairDB_Click"/>

                </StackPanel>

            </Grid>

        </TabItem>
        <TabItem Name="tabCopyServers"
                 Background="LightCoral"
                 FontSize="14"
                 Header="Edit/Copy Databases">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="225" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Popup Name="CopyProgress"
                       Placement="Center"
                       Visibility="Visible">
                    <Border MinWidth="600"
                            Padding="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Orange"
                            BorderBrush="Black"
                            BorderThickness="3"
                            CornerRadius="10">
                        <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="COPYING DATABASE: " />
                                <TextBlock Name="txtDatabase" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="2,0,0,0" Text="to DATABASE:" />
                                <TextBlock Name="txtToDB" Margin="10,0,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                                <TextBlock Text="From Server: " />
                                <TextBlock Name="txtFrom" Margin="10,0,0,0" />
                                <TextBlock Margin="10,0,0,0" Text="To: " />
                                <TextBlock Name="txtTo" Margin="10,0,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,20,0,0"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                <TextBlock Name="txtProgress"
                                           FontSize="18"
                                           Text="WORKING">
                                    <TextBlock.Triggers>
                                        <EventTrigger RoutedEvent="TextBlock.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation AutoReverse="True"
                                                                     RepeatBehavior="Forever"
                                                                     Storyboard.TargetName="txtProgress"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     From="1.0"
                                                                     To="0.0"
                                                                     Duration="0:0:5" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </TextBlock.Triggers>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel>
                                <Button Name="cmdClosePopup"
                                        Margin="0,10,0,0"
                                        Content="CLOSE"
                                        Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>
                <Border Grid.Row="0"
                        Grid.Column="0"
                        BorderBrush="Blue"
                        BorderThickness="3"
                        CornerRadius="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25" />
                            <RowDefinition Height="3" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Text="Source Servers" />
                        <Border Grid.Row="1"
                                BorderBrush="Black"
                                BorderThickness="1" />
                        <TreeView Name="lstSourceServers"
                                  Grid.Row="2"
                                  DisplayMemberPath="DisplayName"
                                  ItemsSource="{Binding}"
                                  ScrollViewer.CanContentScroll="True"
                                  SelectedItemChanged="LstServersDatabases_SelectedItemChanged">
                            <TreeView.Resources>
