<Window x:Class="MbcsCentral.Email.frmSmtpDelivery"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:my="clr-namespace:MbcsCentral.Email"
        Name="formSmtpDelivery"
        Title="Email Accounts Configuration"
        Width="988"
        Height="519"
        Background="{StaticResource {x:Static SystemColors.InactiveBorderBrushKey}}"
        mc:Ignorable="d"
        Loaded="formSmtpDelivery_Loaded">
    <Window.Resources>
        <DataTemplate x:Key="SmtpAccountDataTemplate">
            <Grid>
                <StackPanel HorizontalAlignment="Stretch" Orientation="Horizontal">
                    <TextBox Width="300"
                             Margin="10,0,0,0"
                             HorizontalAlignment="Stretch"
                             BorderThickness="0"
                             IsReadOnly="True"
                             Text="{Binding Path=description,
                                            FallbackValue=description}"
                             TextWrapping="Wrap" />
                    <CheckBox Name="chkDefault"
                              Margin="10,0,0,0"
                              Content="Default?"
                              IsChecked="{Binding Path=defaultAccount,
                                                  FallbackValue=defaultAccount}"
                              IsEnabled="False"
                              IsTabStop="False" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid Name="gridMain"
          Height="auto"
          DataContext="{Binding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="39" />
            <RowDefinition Height="*" />
            <RowDefinition Height="35" />
            <RowDefinition Height="125" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Border Name="Border1"
                Width="248"
                Height="33"
                HorizontalAlignment="center"
                VerticalAlignment="Center"
                Background="{StaticResource {x:Static SystemColors.GradientActiveCaptionBrushKey}}"
                BorderBrush="{StaticResource {x:Static SystemColors.ControlTextBrushKey}}"
                BorderThickness="2"
                CornerRadius="20">
            <TextBlock Name="TextBlock1"
                       Width="Auto"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="16"
                       FontWeight="Bold"
                       Text="Email Account Configurations" />
        </Border>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Label Content="Email Accounts" FontWeight="Bold" />
            <ListBox Name="lstSmtpAccts"
                     Width="400"
                     HorizontalAlignment="Stretch"
                     ItemTemplate="{DynamicResource SmtpAccountDataTemplate}"
                     ItemsSource="{Binding}"
                     SelectedValuePath="ID" />
        </StackPanel>
        <StackPanel Name="StackAddSmtp"
                    Grid.Row="2"
                    Height="25"
                    Orientation="Horizontal"
                    Visibility="Collapsed">
            <Label Width="Auto"
                   Content="New Email Account Description"
                   FontWeight="Bold" />
            <TextBox Name="NewSmtpAccount" Width="120" />
            <Button Name="cmdSaveNewSmtp" Content="SAVE" />
            <Button Name="cmdCancelNewSmtp" Content="CANCEL" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Grid Name="Grid1"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox Name="DescriptionTextBox"
                         Grid.Column="1"
                         Width="300"
                         Height="23"
                         Margin="3,3,0,3"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Text="{Binding Path=description,
                                        Mode=TwoWay,
                                        ValidatesOnExceptions=true,
                                        NotifyOnValidationError=true}" />
                <Label Grid.Row="0"
                       Grid.Column="0"
                       Margin="3"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Content="Description:"
                       FontWeight="Bold" />
            </Grid>
            <Grid Name="Grid2"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox Name="EmailAddressTextBox"
                         Grid.Column="1"
                         Width="300"
                         Height="23"
                         Margin="3,3,0,3"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Text="{Binding Path=emailAddress,
                                        Mode=TwoWay,
                                        ValidatesOnExceptions=true,
                                        NotifyOnValidationError=true}" />
                <Label Grid.Row="0"
                       Grid.Column="0"
                       Margin="3"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Content="Email Address:"
                       FontWeight="Bold" />
            </Grid>
            <Grid Name="Grid10"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Grid.Row="0"
                       Grid.Column="0"
                       Margin="3"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Content="Default Account:" />
                <CheckBox Name="chkDefault"
                          Grid.Row="0"
                          Grid.Column="1"
                          Height="16"
                          Margin="3"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Content=""
                          IsChecked="{Binding Path=defaultAccount,
                                              Mode=TwoWay,
                                              ValidatesOnExceptions=true,
                                              NotifyOnValidationError=true}" />
            </Grid>
        </StackPanel>
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="20" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="81"
                    HorizontalAlignment="Center"
                    BorderBrush="Black"
                    BorderThickness="1"
                    CornerRadius="10">
                <TextBlock HorizontalAlignment="Center" Text="OUT-GOING" />
            </Border>
            <Border Grid.Column="1"
                    Width="80"
                    HorizontalAlignment="Center"
                    BorderBrush="Black"
                    BorderThickness="1"
                    CornerRadius="10">
                <TextBlock HorizontalAlignment="Center" Text="IN-COMING" />
            </Border>
            <StackPanel Name="StackFields"
                        Grid.Row="1"
                        Grid.Column="0">
                <StackPanel Width="Auto" Orientation="Horizontal">
                    <Grid Name="Grid3"
                          Width="279"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Name="UserNameTextBox"
                                 Grid.Column="1"
                                 Width="190"
                                 Height="23"
                                 Margin="3,3,0,3"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Text="{Binding Path=userName,
                                                Mode=TwoWay,
                                                ValidatesOnExceptions=true,
                                                NotifyOnValidationError=true}" />
                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Margin="3"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Content="User Name:"
                               FontWeight="Bold" />
                    </Grid>
                    <Grid Name="Grid4"
                          Width="200"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Name="PasswordTextBox"
                                 Grid.Column="1"
                                 Width="120"
                                 Height="23"
                                 Margin="3,3,0,3"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Text="{Binding Path=password,
                                                Mode=TwoWay,
                                                ValidatesOnExceptions=true,
                                                NotifyOnValidationError=true}" />
                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Margin="3"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Content="Password:"
                               FontWeight="Bold" />
                    </Grid>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Grid Name="Grid5"
                          Width="348"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Name="ServerTextBox"
                                 Grid.Column="1"
                                 Width="289"
                                 Height="23"
                                 Margin="3,3,0,3"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Text="{Binding Path=server,
                                                Mode=TwoWay,
                                                ValidatesOnExceptions=true,
                                                NotifyOnValidationError=true}" />
                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Margin="3"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Content="Server URL:"
                               FontWeight="Bold" />
                    </Grid>
                    <Grid Name="Grid6"
                          Width="100"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Name="PortTextBox"
                                 Grid.Column="1"
                                 Width="48"
                                 Height="23"
                                 Margin="3,3,0,3"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Text="{Binding Path=port,
                                                Mode=TwoWay,
                                                ValidatesOnExceptions=true,
                                                NotifyOnValidationError=true}" />
                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Margin="3"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Content="Port:"
                               FontWeight="Bold" />
                    </Grid>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Grid Name="Grid9"
                          Width="300"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ComboBox Name="lstAuthentication"
                                  Grid.Column="1"
                                  Width="140"
                                  Height="23"
                                  Margin="3,3,0,3"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  DisplayMemberPath="DisplayItem" />
                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Margin="3"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Content="Authentication Method:"
                               FontWeight="Bold" />
                    </Grid>
                    <Grid Name="Grid7"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Margin="3"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Content="Use SSL:"
                               FontWeight="Bold" />
                        <CheckBox Name="SSLCheckBox"
                                  Grid.Row="0"
                                  Grid.Column="1"
                                  Height="16"
                                  Margin="3"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Content=""
                                  IsChecked="{Binding Path=SSL,
                                                      Mode=TwoWay,
                                                      ValidatesOnExceptions=true,
                                                      NotifyOnValidationError=true}" />
                    </Grid>
                    <Grid Name="Grid8"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Margin="3"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Content="Use TSL:"
                               FontWeight="Bold" />
                        <CheckBox Name="TSLCheckBox"
                                  Grid.Row="0"
                                  Grid.Column="1"
                                  Height="16"
                                  Margin="3"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Content=""
                                  IsChecked="{Binding Path=TSL,
                                                      Mode=TwoWay,
                                                      ValidatesOnExceptions=true,
                                                      NotifyOnValidationError=true}" />
                    </Grid>
                </StackPanel>
            </StackPanel>
            <StackPanel Name="StackFields_in"
                        Grid.Row="1"
                        Grid.Column="1">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="279"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Name="UserNameInTextBox"
                                 Grid.Column="1"
                                 Width="190"
                                 Height="23"
                                 Margin="3,3,0,3"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Text="{Binding Path=in_userName,
                                                Mode=TwoWay,
                                                ValidatesOnExceptions=true,
                                                NotifyOnValidationError=true}" />
                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Margin="3"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Content="User Name:"
                               FontWeight="Bold" />
                    </Grid>
                    <Grid Width="200"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Name="PasswordInTextBox"
                                 Grid.Column="1"
                                 Width="120"
                                 Height="23"
                                 Margin="3,3,0,3"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Text="{Binding Path=in_password,
                                                Mode=TwoWay,
                                                ValidatesOnExceptions=true,
                                                NotifyOnValidationError=true}" />
                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Margin="3"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Content="Password:"
                               FontWeight="Bold" />
                    </Grid>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Grid Width="348"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Name="ServerInTextBox"
                                 Grid.Column="1"
                                 Width="289"
                                 Height="23"
                                 Margin="3,3,0,3"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Text="{Binding Path=in_server,
                                                Mode=TwoWay,
                                                ValidatesOnExceptions=true,
                                                NotifyOnValidationError=true}" />
                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Margin="3"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Content="Server URL:"
                               FontWeight="Bold" />
                    </Grid>
                    <Grid Width="100"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Name="PortInTextBox"
                                 Grid.Column="1"
                                 Width="48"
                                 Height="23"
                                 Margin="3,3,0,3"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Text="{Binding Path=in_port,
                                                Mode=TwoWay,
                                                ValidatesOnExceptions=true,
                                                NotifyOnValidationError=true}" />
                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Margin="3"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Content="Port:"
                               FontWeight="Bold" />
                    </Grid>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Grid Width="300"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="256" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ComboBox Name="lstAuthenticationIn"
                                  Grid.Column="1"
                                  Width="140"
                                  Height="23"
                                  Margin="3,3,0,3"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  DisplayMemberPath="DisplayItem" />
                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Margin="3"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Content="Authentication Method:"
                               FontWeight="Bold" />
                    </Grid>
                    <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Margin="3"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Content="Use SSL:"
                               FontWeight="Bold" />
                        <CheckBox Name="SSLInCheckBox"
                                  Grid.Row="0"
                                  Grid.Column="1"
                                  Height="16"
                                  Margin="3"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Content=""
                                  IsChecked="{Binding Path=in_SSL,
                                                      Mode=TwoWay,
                                                      ValidatesOnExceptions=true,
                                                      NotifyOnValidationError=true}" />
                    </Grid>
                    <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Margin="3"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Content="Use TSL:"
                               FontWeight="Bold" />
                        <CheckBox Name="TSLInCheckBox"
                                  Grid.Row="0"
                                  Grid.Column="1"
                                  Height="16"
                                  Margin="3"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Content=""
                                  IsChecked="{Binding Path=in_TSL,
                                                      Mode=TwoWay,
                                                      ValidatesOnExceptions=true,
                                                      NotifyOnValidationError=true}" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Grid>
        <StackPanel Name="StackPanel1"
                    Grid.Row="4"
                    Width="Auto"
                    Height="34"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
            <Button Name="cmdSave"
                    Margin="10,0,0,0"
                    Content="SAVE"
                    FontWeight="Bold" />
            <Button Name="cmdDelete"
                    Margin="10,0,0,0"
                    Content="DELETE"
                    FontWeight="Bold" />
            <Button Name="cmdTest"
                    Margin="10,0,0,0"
                    Content="TEST"
                    FontWeight="Bold" />
            <Button Name="cmdAdd"
                    Margin="10,0,0,0"
                    Content="ADD New EMAIL Account"
                    FontWeight="Bold" />
            <Button Name="cmdExit"
                    Margin="10,0,0,0"
                    Content="EXIT"
                    FontWeight="Bold" />
        </StackPanel>
    </Grid>
</Window>
