<Window
    x:Class="MbcsCentral.frmProcedures"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Name="FormProcedures"
    Title="Database Queries"
    Width="1053"
    Height="364.678"
    Closed="FormProcedures_Closed"
    Loaded="FormProcedures_Loaded"
    TextBlock.FontSize="14"
    TextBlock.FontWeight="Bold"
    TextBlock.TextAlignment="Center">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border
                Grid.Row="0"
                Background="AliceBlue"
                BorderBrush="Blue"
                BorderThickness="2"
                CornerRadius="5">
                <StackPanel>
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Text="Stored Queries"
                        TextAlignment="Center" />
                    <ComboBox
                        Name="lstProcedure"
                        Margin="5,0,5,0"
                        VerticalAlignment="Center"
                        Background="White"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding}"
                        SelectionChanged="lstProcedure_SelectionChanged" />
                </StackPanel>
            </Border>


            <Border
                Grid.Row="1"
                Background="AliceBlue"
                BorderBrush="Blue"
                BorderThickness="2"
                CornerRadius="5">
                <StackPanel>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        FontSize="14"
                        FontWeight="Bold"
                        Text="Parameters"
                        TextAlignment="Center" />
                    <Grid Name="grdParms" 
                          Margin="10" 
                          TextBlock.TextAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25" />
                            <RowDefinition Height="25" />
                            <RowDefinition Height="25" />
                            <RowDefinition Height="25" />
                            <RowDefinition Height="25" />
                        </Grid.RowDefinitions>

                        <TextBlock Name="txtParm1" VerticalAlignment="Center" />
                        <TextBox
                            Name="Parm1"
                            Grid.Column="1"
                            Width="Auto"
                            VerticalAlignment="Center" />


                        <TextBlock
                            Name="txtParm2"
                            Grid.Row="1"
                            VerticalAlignment="Center" />
                        <TextBox
                            Name="Parm2"
                            Grid.Row="1"
                            Grid.Column="1"
                            Width="Auto"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Name="txtParm3"
                            Grid.Row="2"
                            VerticalAlignment="Center" />
                        <TextBox
                            Name="Parm3"
                            Grid.Row="2"
                            Grid.Column="1"
                            Width="Auto"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Name="txtParm4"
                            Grid.Row="3"
                            VerticalAlignment="Center" />
                        <TextBox
                            Name="Parm4"
                            Grid.Row="3"
                            Grid.Column="1"
                            Width="Auto"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Name="txtParm5"
                            Grid.Row="4"
                            VerticalAlignment="Center" />

                        <TextBox
                            Name="Parm5"
                            Grid.Row="4"
                            Grid.Column="1"
                            Width="Auto"
                            VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Margin="5,10,10,10" Orientation="Horizontal">
                        <Button
                            Name="cmdRun"
                            Click="cmdRun_Click"
                            Content="RUN" />
                        <Button
                            Name="cmdPrint"
                            Margin="10,0,0,0"
                            Click="cmdPrint_Click"
                            Content="PRINT"
                            IsEnabled="False" />
                        <Button
                            Name="cmdExport"
                            Margin="10,0,0,0"
                            Click="cmdExport_Click"
                            Content="EXPORT"
                            IsEnabled="False" />
                        <Button
                            Name="cmdExit"
                            Margin="10,0,0,0"
                            Click="cmdExit_Click"
                            Content="EXIT" />
                        <Button Name="cmdRefresh" Margin="10,0,0,0" Content="REFRESH" Click="cmdRefresh_Click"/>
                    </StackPanel>
                    <Button Name="cmdBuilder"
                            Click="cmdBuilder_Click"
                            Content="QUERY BUILDER" />
                    <Button
                            Name="cmdEdit"
                            Click="cmdEdit_Click"
                            Content="EDIT QUERIES"
                            Margin="0,10,0,0"/>
   </StackPanel>
            </Border>
        </Grid>
        <Border
            Grid.Column="1"
            BorderBrush="Blue"
            BorderThickness="2"
            CornerRadius="5">
            <DataGrid
                Name="grdResults"
                Width="Auto"
                Height="Auto"
                AutoGenerateColumns="True"
                ItemsSource="{Binding}"
                TextBlock.FontSize="11"
                TextBlock.FontWeight="Normal"
                TextBlock.TextAlignment="Left" />
        </Border>


    </Grid>
</Window>
