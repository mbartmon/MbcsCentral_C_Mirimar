<Window Name="formMbcsCentralService"
    x:Class="MbcsCentral.frmMbcsCentralService"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MbcsCentral Service"
    Width="568"
    Height="501"
    Background="{StaticResource {x:Static SystemColors.GradientInactiveCaptionBrushKey}}"
    Closing="frmListener_Closing"
    Loaded="frmListener_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35" />
            <RowDefinition Height="40" />
            <RowDefinition Height="0" />
            <RowDefinition Height="0" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Name="Border1"
            Width="200"
            Height="31"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="{StaticResource {x:Static SystemColors.GradientActiveCaptionBrushKey}}"
            BorderBrush="Black"
            BorderThickness="2"
            CornerRadius="25">
            <TextBlock Name="TextBlock1" Text="MbcsCentral Service"
                HorizontalAlignment="Center"
                FontSize="16"
                FontWeight="Bold" />
        </Border>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Label
                VerticalAlignment="Bottom"
                Content="STATUS: "
                FontWeight="Bold" />
            <TextBlock Name="ServiceStatus"
                Width="150"
                Margin="0,5"
                VerticalAlignment="Bottom"
                FontSize="14"
                FontWeight="ExtraBold"
                Foreground="Red" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Name="cmdStart"
                    Grid.Column="0"
                    Margin="10,10,0,0"
                    Click="cmdStart_Click"
                    Content="START" />
                <Button Name="cmdStop"
                    Grid.Column="1"
                    Margin="10,10,0,0"
                    Click="cmdStop_Click"
                    Content="STOP" />
                <Button Name="cmdRESTART"
                    Grid.Column="2"
                    Margin="10,10,0,0"
                    Click="cmdRESTART_Click"
                    Content="RESTART" />
                <Button Name="cmdInstall"
                    Grid.Column="3"
                    Margin="10,10,0,0"
                    Click="cmdInstall_Click"
                    Content="INSTALL" />
                <Button Name="cmdUnInstall"
                    Grid.Column="4"
                    Margin="10,10,0,0"
                    Click="cmdUnInstall_Click"
                    Content="UNINSTALL" />
            </Grid>
        </StackPanel>
        <!--
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Label
                VerticalAlignment="Bottom"
                Content="Mail Retrieval Interval in minutes: "
                FontWeight="Bold" />
            <TextBox Name="MailRetrieval"
                Width="50"
                Margin="0,3"
                VerticalAlignment="Bottom"
                MaxLength="3" />
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <Label
                VerticalAlignment="Bottom"
                Content="Use SMTP Config to retrieve messages? "
                FontWeight="Bold" />
            <CheckBox Name="chkSMTP"
                Margin="0,5"
                VerticalAlignment="Bottom" />
            <Label
                Margin="10,0,0,0"
                VerticalAlignment="Bottom"
                Content="Read Outlook Inbox? "
                FontWeight="Bold" />
            <CheckBox Name="chkOutlook"
                Margin="0,5"
                VerticalAlignment="Bottom" />
        </StackPanel>
        -->
        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Button Name="cmdSave"
                Margin="10,0,0,0"
                VerticalAlignment="Bottom"
                Content="SAVE" />
            <Button Name="cmdCancel"
                Margin="10,0,0,0"
                VerticalAlignment="Bottom"
                Content="CANCEL" />
            <Button Name="cmdViewLog"
                Margin="10,0,0,0"
                VerticalAlignment="Bottom"
                Click="cmdViewLog_Click"
                Content="VIEW LOG" />
            <Button Name="cmdRefreshLog"
                Margin="10,0,0,0"
                VerticalAlignment="Bottom"
                Click="cmdRefreshLog_Click"
                Content="REFRESH LOG" />
            <Button Name="cmdClearLog"
                Margin="10,0,0,0"
                VerticalAlignment="Bottom"
                Click="cmdClearLog_Click"
                Content="CLEAR LOG" />
            <CheckBox Name="chkTail"
                Margin="10,0,0,0"
                VerticalAlignment="Bottom"
                Checked="chkTail_Checked"
                Content="Tail?" />
            <TextBlock Text="Log Date:"
                Margin="20,0,0,5"
                VerticalAlignment="Bottom"
                FontWeight="Bold" />
            <ComboBox Name="lstDates"
                Width="100"
                Margin="5,0,0,3"
                VerticalAlignment="Bottom"
                DisplayMemberPath="DisplayItem"
                ItemsSource="{Binding}"
                SelectionChanged="lstDates_SelectionChanged" />
        </StackPanel>
        <!--
        <DocumentViewer
            Name="LogViewer"
            Grid.Row="5"
            Margin="0,5"
            IsTabStop="False"

            ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        -->
        <ListBox Name="LogViewer"
            Grid.Row="5"
            Margin="0,5" />

    </Grid>
</Window>
