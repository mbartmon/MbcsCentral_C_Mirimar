
<Window
    x:Class="MbcsCentral.WinGL.frmInvoiceNumber"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:my="clr-namespace:MbcsCentral"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Name="FormfrmInvoiceNumber"
    Title="Batch Invoice Data Entry"
    Width="399.564"
    Height="349.582"
    Background="AliceBlue"
    Closed="frmInvoiceNumber_Closed"
    FontSize="14"
    FontWeight="Bold"
    Loaded="frmInvoiceNumber_Loaded"
    TextBlock.TextAlignment="Center">
    <Border
        BorderBrush="Blue"
        BorderThickness="3"
        CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <TextBox
                Name="txtTitle"
                Background="LightSteelBlue"
                BorderBrush="Blue"
                BorderThickness="2"
                FontSize="14"
                FontWeight="Bold"
                Text="Batch Invoice Data Entry"
                TextAlignment="Center" />
            <Grid Grid.Row="1" TextBlock.FontSize="12">
                <!--  Place your content here  -->
                <Grid Name="grdMain">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="7*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="3*" />
                    </Grid.RowDefinitions>
                    <Border
                        Padding="3"
                        BorderBrush="Black"
                        BorderThickness="2"
                        CornerRadius="3">
                        <DockPanel>
                            <TextBlock
                                Name="lblInvoice"
                                Width="Auto"
                                Height="Auto"
                                DockPanel.Dock="Top"
                                FontSize="14"
                                Text="Invoice"
                                TextAlignment="Left"
                                TextWrapping="Wrap" />
                            <DockPanel
                                Height="35"
                                VerticalAlignment="Bottom"
                                LastChildFill="True"
                                Visibility="Collapsed">
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Text="Memo" />
                                <TextBox
                                    Name="txtMemo"
                                    Width="Auto"
                                    Height="35"
                                    Margin="5,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    TextWrapping="Wrap" />
                            </DockPanel>
                        </DockPanel>
                    </Border>
                    <StackPanel
                        Name="pnlManual"
                        Grid.Row="1"
                        Orientation="Horizontal">
                        <TextBlock
                            Name="lblManual"
                            Width="100"
                            VerticalAlignment="Center"
                            FontSize="14" />
                        <TextBox
                            Name="txtManual"
                            Width="200"
                            Height="25"
                            Margin="10,0,0,0"
                            FontSize="12"
                            TextAlignment="Left" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Name="Label1"
                                Width="80"
                                Margin="10,0,0,0"
                                HorizontalAlignment="Left" />
                            <TextBlock
                                Name="Label2"
                                Width="80"
                                Margin="35,0,0,0" />
                        </StackPanel>
                        <StackPanel Name="pnlInvoice" Orientation="Horizontal">
                            <TextBox
                                Name="lblDepartment"
                                Width="119"
                                Background="White"
                                TextAlignment="Left" />
                            <DatePicker
                                Name="dtInvoice"
                                Width="110"
                                Margin="20,0,0,0"
                                VerticalAlignment="Center"
                                SelectedDate="{x:Static sys:DateTime.Now}" />
                            <CheckBox
                                Name="chkDate"
                                VerticalAlignment="Center"
                                Content="Use entries for all invoices"
                                FontSize="9" Width="140" />
                        </StackPanel>
                        <StackPanel
                            Name="pnlCheck"
                            Margin="0,3,0,0"
                            Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="Check#/Date" />
                            <my:NumberEntry
                                x:Name="txtCheck"
                                Width="50"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Decimals="0"
                                MaxLength="6" />
                            <DatePicker
                                Name="dtCheck"
                                Width="106"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                SelectedDate="{x:Static sys:DateTime.Now}" />
                            <CheckBox Name="chkCheck" FontSize="9">
                                <TextBlock TextAlignment="Left">
                                    Keep DATE &amp; Increment
                                    <LineBreak />
                                    Check Number
                                </TextBlock>
                            </CheckBox>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
            <StackPanel
                Grid.Row="2"
                Margin="0,5,0,5"
                Background="AliceBlue"
                Orientation="Horizontal"
                TextBlock.FontSize="12">
                <Button
                    Name="cmdEdit"
                    Height="25"
                    Margin="10,0,0,0"
                    Click="cmdEdit_Click"
                    Content="Edit Invoice" />
                <Button
                    Name="cmdAccept"
                    Margin="20,0,0,0"
                    Click="cmdAccept_Click"
                    Content="ACCEPT" />
                <Button
                    Name="cmdSkip"
                    Margin="10,0,0,0"
                    Click="cmdSkip_Click"
                    Content=" SKIP INVOICE" />
                <Button
                    Name="cmdCancel"
                    Margin="10,0,0,0"
                    Click="cmdCancel_Click"
                    Content="CANCEL RUN" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
