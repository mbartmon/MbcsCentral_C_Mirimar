
<Window Name="FormfrmDisbursementReport"
    x:Class="MbcsCentral.WinGL.frmDisbursementReport"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Disbursement Report"
    Width="592.153"
    Height="300"
    Background="AliceBlue"
    Closed="frmDisbursementReport_Closed"
    FontSize="14"
    FontWeight="Bold"
    Loaded="frmDisbursementReport_Loaded"
    TextBlock.TextAlignment="Center">
    <Border
        BorderBrush="Blue"
        BorderThickness="3"
        CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <TextBox Text="Disbursement Report"
                Background="LightSteelBlue"
                BorderBrush="Blue"
                BorderThickness="2"
                FontSize="14"
                FontWeight="Bold"
                TextAlignment="Center" />
            <Grid Grid.Row="1">
                <!--  Place your content here  -->
                <Grid TextBlock.FontSize="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25" />
                        <RowDefinition Height="25" />
                        <RowDefinition Height="25" />
                        <RowDefinition Height="25" />
                        <RowDefinition Height="25" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <StackPanel
                        Grid.Row="0"
                        Margin="3"
                        Orientation="Horizontal">
                        <TextBlock Text="Company"
                            Width="115"
                            VerticalAlignment="Center"
                            TextAlignment="Left" />
                        <ComboBox Name="lstCompanies"
                            Width="200"
                            VerticalAlignment="Center"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding}" 
                                  SelectedValue="{Binding Company}"
                                  SelectedValuePath="CompanyNumber"
                            SelectionChanged="lstCompanies_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel
                        Grid.Row="1"
                        Margin="3"
                        Orientation="Horizontal">
                        <TextBlock Text="Department"
                            Width="115"
                            VerticalAlignment="Center"
                            TextAlignment="Left" />
                        <ComboBox Name="lstDepartments"
                            Width="200"
                            DisplayMemberPath="Name"
                                  SelectedValue="{Binding Department}"
                                  SelectedValuePath="DepartmentNumber"
                            ItemsSource="{Binding}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Row="2"
                        Margin="3"
                        Orientation="Horizontal">
                        <TextBlock Text="Month"
                            Width="115"
                            VerticalAlignment="Center"
                            TextAlignment="Left" />
                        <ComboBox Name="lstMonths"
                            Width="100"
                            VerticalAlignment="Center">
                            <ComboBoxItem>January</ComboBoxItem>
                            <ComboBoxItem>February</ComboBoxItem>
                            <ComboBoxItem>March</ComboBoxItem>
                            <ComboBoxItem>April</ComboBoxItem>
                            <ComboBoxItem>May</ComboBoxItem>
                            <ComboBoxItem>June</ComboBoxItem>
                            <ComboBoxItem>July</ComboBoxItem>
                            <ComboBoxItem>August</ComboBoxItem>
                            <ComboBoxItem>September</ComboBoxItem>
                            <ComboBoxItem>October</ComboBoxItem>
                            <ComboBoxItem>November</ComboBoxItem>
                            <ComboBoxItem>December</ComboBoxItem>
                        </ComboBox>
                        <CheckBox Name="chkPriorYear"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Content="Check for prior year" />
                    </StackPanel>
                    <StackPanel
                        Grid.Row="3"
                        Margin="3"
                        Orientation="Horizontal">
                        <TextBlock Text="Balance Account"
                            Width="115"
                            VerticalAlignment="Center"
                            TextAlignment="Left" />
                        <ComboBox Name="lstBalanceAccount"
                            Width="200"
                            VerticalAlignment="Center"
                            DisplayMemberPath="Description"
                            ItemsSource="{Binding}"
                            SelectedValue="{Binding BalanceAccount}"
                            SelectedValuePath="Key" />
                    </StackPanel>
                    <StackPanel
                        Grid.Row="4"
                        Margin="3"
                        Orientation="Horizontal">
                        <TextBlock Text="Collection Accounts"
                            Width="115"
                            VerticalAlignment="Center"
                            TextAlignment="Left" />
                        <ComboBox Name="lstCollectionsOne"
                            Width="200"
                            DisplayMemberPath="Description"
                            ItemsSource="{Binding}"
                            SelectedValue="{Binding CollectionAccountOne}"
                            SelectedValuePath="Key" />
                        <ComboBox Name="lstCollectionsTwo"
                            Width="200"
                            Margin="5,0,0,0"
                            DisplayMemberPath="Description"
                            ItemsSource="{Binding}"
                            SelectedValue="{Binding CollectionAccountTwo}"
                            SelectedValuePath="Key" />
                    </StackPanel>
                    <StackPanel Grid.Row="5">
                        <TextBlock Background="LightBlue" Text="Journals" />

                        <Grid Grid.Row="5" Margin="3">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <ComboBox Name="lstJournal0"
                                Grid.Row="0"
                                Grid.Column="0"
                                DisplayMemberPath="JournalName"
                                ItemsSource="{Binding}"
                                SelectedValue="{Binding Journals[0]}"
                                SelectedValuePath="JournalName" />
                            <ComboBox Name="lstJournal1"
                                Grid.Row="0"
                                Grid.Column="1"
                                DisplayMemberPath="JournalName"
                                ItemsSource="{Binding}"
                                SelectedValue="{Binding Journals[1]}"
                                SelectedValuePath="JournalName" />
                            <ComboBox Name="lstJournal2"
                                Grid.Row="0"
                                Grid.Column="2"
                                DisplayMemberPath="JournalName"
                                ItemsSource="{Binding}"
                                SelectedValue="{Binding Journals[2]}"
                                SelectedValuePath="JournalName" />
                            <ComboBox Name="lstJournal3"
                                Grid.Row="0"
                                Grid.Column="3"
                                DisplayMemberPath="JournalName"
                                ItemsSource="{Binding}"
                                SelectedValue="{Binding Journals[3]}"
                                SelectedValuePath="JournalName" />
                            <ComboBox Name="lstJournal4"
                                Grid.Row="0"
                                Grid.Column="4"
                                DisplayMemberPath="JournalName"
                                ItemsSource="{Binding}"
                                SelectedValue="{Binding Journals[4]}"
                                SelectedValuePath="JournalName" />
                            <ComboBox Name="lstJournal5"
                                Grid.Row="1"
                                Grid.Column="0"
                                DisplayMemberPath="JournalName"
                                ItemsSource="{Binding}"
                                SelectedValue="{Binding Journals[5]}"
                                SelectedValuePath="JournalName" />
                            <ComboBox Name="lstJournal6"
                                Grid.Row="1"
                                Grid.Column="1"
                                DisplayMemberPath="JournalName"
                                ItemsSource="{Binding}"
                                SelectedValue="{Binding Journals[6]}"
                                SelectedValuePath="JournalName" />
                            <ComboBox Name="lstJournal7"
                                Grid.Row="1"
                                Grid.Column="2"
                                DisplayMemberPath="JournalName"
                                ItemsSource="{Binding}"
                                SelectedValue="{Binding Journals[7]}"
                                SelectedValuePath="JournalName" />
                            <ComboBox Name="lstJournal8"
                                Grid.Row="1"
                                Grid.Column="3"
                                DisplayMemberPath="JournalName"
                                ItemsSource="{Binding}"
                                SelectedValue="{Binding Journals[8]}"
                                SelectedValuePath="JournalName" />
                            <ComboBox Name="lstJournal9"
                                Grid.Row="1"
                                Grid.Column="4"
                                DisplayMemberPath="JournalName"
                                ItemsSource="{Binding}"
                                SelectedValue="{Binding Journals[9]}"
                                SelectedValuePath="JournalName" />
                        </Grid>
                    </StackPanel>
                </Grid>

            </Grid>
            <StackPanel
                Grid.Row="2"
                Margin="0,5,0,5"
                Background="AliceBlue"
                Orientation="Horizontal">
                <Button Name="cmdSave"
                    Margin="10,0,0,0"
                    Click="cmdSave_Click"
                    Content="DISPLAY" />
                <Button Name="cmdClose"
                    Margin="10,0,0,0"
                    Click="cmdClose_Click"
                    Content="CLOSE" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
