
<Window x:Class="MbcsCentral.WinGL.frmOperatingStatement"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Name="FormfrmOperatingStatement"
        Title="Operating Statement"
        Width="434.854"
        Height="360"
        Background="AliceBlue"
        Closed="frmOperatingStatement_Closed"
        FontSize="14"
        FontWeight="Bold"
        Loaded="frmOperatingStatement_Loaded"
        TextBlock.TextAlignment="Center">
    <Border BorderBrush="Blue"
            BorderThickness="3"
            CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <TextBox Background="LightSteelBlue"
                     BorderBrush="Blue"
                     BorderThickness="2"
                     FontSize="14"
                     FontWeight="Bold"
                     Text="Operating Statement"
                     TextAlignment="Center" />
            <Grid Grid.Row="1">
                <!--  Place your content here  -->
                <StackPanel Margin="10" TextBlock.FontSize="11">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Statement Name" VerticalAlignment="Center"/>
                        <ComboBox Name="lstStatements" 
                                  ItemsSource="{Binding}" 
                                  DisplayMemberPath="ReportName"
                                  SelectedValuePath="ReportName"
                                  SelectedValue="{Binding Path=StatementName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectionChanged="lstStatements_SelectionChanged"
                                  Margin="5,0,0,0" 
                                  Width="200" 
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Company" VerticalAlignment="Center" Width="92" TextAlignment="Left"/>
                        <ComboBox Name="lstCompanies"
                                  ItemsSource="{Binding}"
                                  DisplayMemberPath="Name"
                                  SelectedValue="{Binding CompanyNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="CompanyNumber"
                                  Width="220"
                                  VerticalAlignment="Center"
                                  SelectionChanged="lstCompanies_SelectionChanged"/>
                        <CheckBox Name="chkConsolidated"
                                  Content="Consolidated"
                                  TextBlock.FontSize="9"
                                  Margin="5,0,0,0"
                                  IsChecked="{Binding Path=Consolidated, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="Department" VerticalAlignment="Center" TextAlignment="Left" Width="92"/>
                        <ComboBox Name="lstDepartments"
                                  ItemsSource="{Binding}"
                                  DisplayMemberPath="Name"
                                  SelectedValue="{Binding DepartmentNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="DepartmentNumber"
                                  SelectionChanged="lstDepartments_SelectionChanged"
                                  Width="220"
                                  VerticalAlignment="Center">
                            <ComboBox.Style >
                                <Style TargetType="ComboBox" >
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=chkConsolidated}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=chkConsolidated}" Value="False">
                                            <Setter Property="IsEnabled" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>

                            </ComboBox.Style>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Month/Year" VerticalAlignment="Center" Width="92" TextAlignment="Left"/>
                        <ComboBox Name="lstMonths" 
                                  VerticalAlignment="Center" Width="80" Background="White">
                            <ComboBoxItem>January</ComboBoxItem>
                            <ComboBoxItem>February</ComboBoxItem>
                            <ComboBoxItem>March</ComboBoxItem>
                            <ComboBoxItem>April</ComboBoxItem>
                            <ComboBoxItem>May</ComboBoxItem>
                            <ComboBoxItem>June</ComboBoxItem>
                            <ComboBoxItem>July</ComboBoxItem>
                            <ComboBoxItem>August</ComboBoxItem>
                            <ComboBoxItem>September</ComboBoxItem>
                            <ComboBoxItem>October</ComboBoxItem>
                            <ComboBoxItem>November</ComboBoxItem>
                            <ComboBoxItem>December</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Text="/" VerticalAlignment="Center"/>
                        <ComboBox Name="lstYears"
                                  VerticalAlignment="Center" 
                                  Width="60"/>

                    </StackPanel>
                    <Button Name="cmdIncome"
                            Content="INCOME ACCOUNTS"
                            Width="200"
                            HorizontalAlignment="Left"
                            Margin="92,10,0,0"
                            Click="cmdIncome_Click"/>
                    <Button Name="cmdExpense"
                            Content="EXPENSE ACCOUNTS"
                            Width="200"
                            HorizontalAlignment="Left"
                            Margin="92,5,0,0"
                            Click="cmdExpense_Click"/>
                    <StackPanel Orientation="Horizontal">
                        <Border BorderBrush="Black" BorderThickness="1" CornerRadius="3"   Margin="0,10,0,0">
                            <GroupBox >
                                <StackPanel Margin="3">
                                    <RadioButton Name="optDetail" GroupName="grpDetail" Content="Detail" Margin="0,3,0,0"/>
                                    <RadioButton Name="optSummary" GroupName="grpDetail" Content="Summary" Margin="0,3,0,0"/>
                                    <RadioButton Name="optTotals" GroupName="grpDetail" Content="Totals" Margin="0,3,0,0"/>
                                </StackPanel>
                            </GroupBox>
                        </Border>
                        <Border BorderBrush="Black" BorderThickness="1" CornerRadius="3" Margin="20,10,0,0">
                            <GroupBox>
                                <StackPanel Margin="3">
                                    <RadioButton Name="optCurrent" GroupName="grpCurrent" Content="Current" Margin="0,3,0,0"/>
                                    <RadioButton Name="optQTD" GroupName="grpCurrent" Content="QTD" Margin="0,3,0,0"/>
                                    <RadioButton Name="optYTD" GroupName="grpCurrent" Content="YTD" Margin="0,3,0,0"/>
                                </StackPanel>
                            </GroupBox>
                        </Border>
                        <StackPanel Margin="20,10,0,0">
                            <CheckBox Name="chkPrior" Content="Show Prior Year" IsChecked="{Binding Path=PriorYear}"/>
                            <CheckBox Name="chkPercentage" Content="Show Percentage" IsChecked="{Binding Path=Percentage}" Margin="0,1,0,0"/>
                            <CheckBox Name="chkYtd" Content="Print YTD" IsChecked="{Binding Path=PrintYtd}" Margin="0,1,0,0"/>
                            <CheckBox Name="chkZero" Content="Print Zero Balances" IsChecked="{Binding Path=PrintZero}" Margin="0,1,0,0"/>
                            <CheckBox Name="chkCondensed" Content="Condensed Print" IsChecked="{Binding Path=CondensePrint}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="2"
                        Margin="0,5,0,5"
                        Background="AliceBlue"
                        Orientation="Horizontal"
                        TextBlock.FontSize="12">
                <Button Name="cmdDisplay"
                        Margin="10,0,0,0"
                        Click="cmdDisplay_Click"
                        Content="DISPLAY"/>
                <Button Name="cmdClose"
                        Margin="10,0,0,0"
                        Click="cmdClose_Click"
                        Content="CLOSE" />
                <Button Name="cmdClear"
                        Margin="10,0,0,0"
                        Click="cmdClear_Click"
                        Content="CLEAR"/>
                <Button Name="cmdNew"
                        Margin="10,0,0,0"
                        Click="cmdNew_Click"
                        Content="NEW"/>
                <Button Name="cmdDelete"
                        Margin="10,0,0,0"
                        Click="cmdDelete_Click"
                        Content="DELETE"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
