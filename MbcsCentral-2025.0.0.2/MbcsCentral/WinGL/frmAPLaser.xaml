<Window x:Class="MbcsCentral.WinGL.frmAPLaser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:MbcsCentral.WinGL"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Name="formAPLaser"
        Title="frmAPLaser"
        Width="309"
        Height="176"
        Background="AliceBlue"
        WindowStyle="None"
        Loaded="formAPLaser_Loaded"
        Closed="formAPLaser_Closed"
        mc:Ignorable="d">
    <Border BorderBrush="Blue"
            BorderThickness="5"
            CornerRadius="5">
        <Grid>
            <StackPanel>
                <Border Background="LightSteelBlue"
                        BorderBrush="Blue"
                        BorderThickness="0,0,0,5">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="Bold"
                               Text=" Printing A/P Checks" />
                </Border>
                <StackPanel Margin="5" Orientation="Horizontal">
                    <TextBlock Width="70"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Text="Company" />
                    <TextBox Name="txtCompany"
                             Width="200"
                             IsReadOnly="True" />
                </StackPanel>
                <StackPanel Margin="5" Orientation="Horizontal">
                    <TextBlock Width="70"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Text="Department" />
                    <TextBox Name="txtDepartment"
                             Width="200"
                             IsReadOnly="True" />
                </StackPanel>
                <StackPanel Margin="5,20,5,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Width="100"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Text="Check Number" />
                        <TextBox Name="txtCheckNumber"
                                 Width="100"
                                 IsReadOnly="True" />
                    </StackPanel>
                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                        <TextBlock Width="100"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Text="Check Date" />
                        <TextBox Name="txtCheckDate"
                                 Width="100"
                                 IsReadOnly="True" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
