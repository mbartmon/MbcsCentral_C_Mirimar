<Window
    x:Class="MbcsCentral.WinGL.frmAccountBalances"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:my="clr-namespace:MbcsCentral"
    Name="FormfrmAccountBalances"
    Title="Account Balances"
    Width="652.406"
    Height="298"
    Background="AliceBlue"
    Closed="frmAccountBalances_Closed"
    FontSize="14"
    FontWeight="Bold"
    Loaded="frmAccountBalances_Loaded"
    TextBlock.TextAlignment="Center">
    <Window.Resources>
        <my:CurrencyPaddingConverter x:Key="CurrencyPadder" />
    </Window.Resources>
    <Border
        BorderBrush="Blue"
        BorderThickness="3"
        CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
            </Grid.RowDefinitions>
            <TextBox
                Background="LightSteelBlue"
                BorderBrush="Blue"
                BorderThickness="2"
                FontSize="14"
                FontWeight="Bold"
                Text="Account Balances"
                TextAlignment="Center" />
            <Grid Grid.Row="1">
                <TabControl Name="tabBalances" TextBlock.FontSize="13">

                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border Name="Border" BorderThickness="1,1,1,0" BorderBrush="Gainsboro" CornerRadius="4,4,0,0" Margin="2,0">
                                            <ContentPresenter x:Name="ContentSite"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        ContentSource="Header"
                                        Margin="10,2"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="LightSkyBlue" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="False">
                                                <Setter TargetName="Border" Property="Background" Value="Bisque" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <!--  By Company  -->
                    <TabItem Name="tabCompany">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="By Company" />
                                <CheckBox
                                    Name="chkByCompany"
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Center"
                                    Click="chkTab_Click" />
                            </StackPanel>
                        </TabItem.Header>
                        <Grid TextBlock.FontSize="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="295*"/>
                                <ColumnDefinition Width="13*"/>
                                <ColumnDefinition Width="332*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel
                                Grid.Row="0"
                                Margin="2,2,2,2"
                                Orientation="Horizontal" Grid.ColumnSpan="3">
                                <TextBlock
                                    Width="55"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Text="Company"
                                    TextAlignment="Left" />
                                <ComboBox
                                    Name="lstCompanies_Company"
                                    Width="200"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{Binding}"
                                    SelectionChanged="lstCompanies_Company_SelectionChanged" />

                                <ComboBox
                                    Name="lstMonths_Company"
                                    Width="80"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    SelectionChanged="lstMonths_Company_SelectionChanged">
                                    <ComboBoxItem>January</ComboBoxItem>
                                    <ComboBoxItem>February</ComboBoxItem>
                                    <ComboBoxItem>March</ComboBoxItem>
                                    <ComboBoxItem>April</ComboBoxItem>
                                    <ComboBoxItem>May</ComboBoxItem>
                                    <ComboBoxItem>June</ComboBoxItem>
                                    <ComboBoxItem>July</ComboBoxItem>
                                    <ComboBoxItem>August</ComboBoxItem>
                                    <ComboBoxItem>September</ComboBoxItem>
                                    <ComboBoxItem>October</ComboBoxItem>
                                    <ComboBoxItem>November</ComboBoxItem>
                                    <ComboBoxItem>December</ComboBoxItem>
                                </ComboBox>
                                <TextBlock VerticalAlignment="Center" Text="/" />
                                <ComboBox
                                    Name="lstYears_Company"
                                    Width="55"
                                    Margin="1"
                                    ItemsSource="{Binding}"
                                    SelectionChanged="lstMonths_Company_SelectionChanged" />
                            </StackPanel>
                            <StackPanel
                                Grid.Row="1"
                                Margin="2,2,2,2"
                                Orientation="Horizontal" Grid.ColumnSpan="3">
                                <TextBlock
                                    Width="55"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Text="Account"
                                    TextAlignment="Left" />
                                <ComboBox
                                    Name="lstAccounts_Company"
                                    Width="350"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    DisplayMemberPath="Description"
                                    ItemsSource="{Binding}"
                                    SelectionChanged="lstAccounts_Company_SelectionChanged" />
                            </StackPanel>

                            <DataGrid
                                Name="grdAccount"
                                Grid.Row="2"
                                AutoGenerateColumns="False"
                                ItemsSource="{Binding}" Grid.ColumnSpan="3">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Binding="{Binding Department}"
                                        Header="Dpt"
                                        TextBlock.TextAlignment="Right">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                <Setter Property="Margin" Value="2,0,0,0" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn
                                        Width="200"
                                        Binding="{Binding Name}"
                                        Header="Name"
                                        TextBlock.TextAlignment="Left">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                <Setter Property="Margin" Value="2,0,0,0" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn
                                        Width="100"
                                        Binding="{Binding Path=Current, Converter={StaticResource CurrencyPadder}, ConverterParameter=14c}"
                                        Header="Current"
                                        TextBlock.TextAlignment="Right">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                <Setter Property="Margin" Value="0,0,4,0" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn
                                        Width="100"
                                        Binding="{Binding Prior, Converter={StaticResource CurrencyPadder}, ConverterParameter=14c}"
                                        Header="Prior"
                                        TextBlock.TextAlignment="Right">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                <Setter Property="Margin" Value="0,0,4,0" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!--  By Company / Department  -->
                    <TabItem Name="tabCompanyDepartment">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="By Comp/Dept" />
                                <CheckBox
                                    Name="chkByCmpDept"
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Center"
                                    Click="chkTab_Click" />
                            </StackPanel>
                        </TabItem.Header>
                        <Grid TextBlock.FontSize="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="15" />
                                <RowDefinition Height="25" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="265*" />
                                <ColumnDefinition Width="39*" />
                                <ColumnDefinition Width="226*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Margin="5,0,0,24"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="Company"
                                TextAlignment="Left" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                Margin="5,0,0,24"
                                VerticalAlignment="Center"
                                Text="Department"
                                TextAlignment="Left" />
                            <ComboBox
                                Name="lstCompanies_CompanyDepartment"
                                Grid.Row="1"
                                Grid.Column="0"
                                Width="250"
                                Margin="5,1,0,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding}"
                                SelectionChanged="lstCompanies_CompanyDepartment_SelectionChanged" />
                            <ComboBox
                                Name="lstDepartments_CompanyDepartment"
                                Grid.Row="1"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                Width="250"
                                Margin="5,1,0,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding}"
                                SelectionChanged="lstDepartments_CompanyDepartment_SelectionChanged" />

                            <StackPanel
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Margin="5,2,2,2"
                                Orientation="Horizontal">
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Text="Account"
                                    TextAlignment="Left" />
                                <ComboBox
                                    Name="lstAccounts_CompanyDepartment"
                                    Width="466"
                                    Margin="5,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    DisplayMemberPath="Description"
                                    ItemsSource="{Binding}"
                                    SelectionChanged="lstAccounts_CompanyDepartment_SelectionChanged" />
                            </StackPanel>
                            <DataGrid
                                Name="grdCompanyDepartment"
                                Grid.Row="3"
                                Grid.ColumnSpan="3"
                                AutoGenerateColumns="False"
                                ItemsSource="{Binding}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="100"
                                        Binding="{Binding Month}"
                                        TextBlock.TextAlignment="Left">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                <Setter Property="Margin" Value="2,0,0,0" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn
                                        Width="100"
                                        Binding="{Binding Path=Current, Converter={StaticResource CurrencyPadder}, ConverterParameter=14c}"
                                        Header="Current Year"
                                        TextBlock.TextAlignment="Right">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                <Setter Property="Margin" Value="0,0,4,0" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn
                                        Width="100"
                                        Binding="{Binding Path=CurrentYtd, Converter={StaticResource CurrencyPadder}, ConverterParameter=14c}"
                                        Header="YTD"
                                        TextBlock.TextAlignment="Right">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                <Setter Property="Margin" Value="0,0,4,0" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn
                                        Width="100"
                                        Binding="{Binding Path=Prior, Converter={StaticResource CurrencyPadder}, ConverterParameter=14c}"
                                        Header="Prior Year"
                                        TextBlock.TextAlignment="Right">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                <Setter Property="Margin" Value="0,0,4,0" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn
                                        Width="100"
                                        Binding="{Binding Path=PriorYtd, Converter={StaticResource CurrencyPadder}, ConverterParameter=14c}"
                                        Header="YTD"
                                        TextBlock.TextAlignment="Right">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                <Setter Property="Margin" Value="0,0,4,0" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!--  BY ACCOUNT  -->
                    <TabItem Name="tabAccount">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="By Account" />
                                <CheckBox
                                    Name="chkByAccount"
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Center"
                                    Click="chkTab_Click" />
                            </StackPanel>
                        </TabItem.Header>
                        <Grid TextBlock.FontSize="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel
                                Grid.Row="0"
                                Margin="2"
                                Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="Account"
                                    TextAlignment="Left" />
                                <ComboBox
                                    Name="lstAccounts_Account"
                                    Width="300"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    DisplayMemberPath="Description"
                                    ItemsSource="{Binding}"
                                    SelectionChanged="lstAccounts_Account_SelectionChanged" />
                                <TextBlock
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="Month"
                                    TextAlignment="Left" />
                                <ComboBox
                                    Name="lstMonths_Account"
                                    Width="85"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    SelectionChanged="lstMonths_Account_SelectionChanged">
                                    <ComboBoxItem>January</ComboBoxItem>
                                    <ComboBoxItem>February</ComboBoxItem>
                                    <ComboBoxItem>March</ComboBoxItem>
                                    <ComboBoxItem>April</ComboBoxItem>
                                    <ComboBoxItem>May</ComboBoxItem>
                                    <ComboBoxItem>June</ComboBoxItem>
                                    <ComboBoxItem>July</ComboBoxItem>
                                    <ComboBoxItem>August</ComboBoxItem>
                                    <ComboBoxItem>September</ComboBoxItem>
                                    <ComboBoxItem>October</ComboBoxItem>
                                    <ComboBoxItem>November</ComboBoxItem>
                                    <ComboBoxItem>December</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <DataGrid
                                Name="grdAccount_Long"
                                Grid.Row="1"
                                AutoGenerateColumns="False"
                                ItemsSource="{Binding}"
                                FrozenColumnCount="3">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Name="ctxExcludeLong" Header="Exclude Company" Click="ctxExcludeLong_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="200"
                                        Binding="{Binding Path=CompanyName}"
                                        Header="Company">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                <Setter Property="Margin" Value="2,0,0,0" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn
                                        Width="35"
                                        Binding="{Binding Department}"
                                        Header="Dpt">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                <Setter Property="Margin" Value="0,0,2,0" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn
                                        Width="200"
                                        Binding="{Binding Path=Name}"
                                        Header="Name">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                <Setter Property="Margin" Value="2,0,0,0" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!--  By Account - 2 Years  -->
                    <TabItem Name="tabAccount2Years">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="By Account 2 yrs" />
                                <CheckBox
                                    Name="chkByAcct2"
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Center"
                                    Click="chkTab_Click" />
                            </StackPanel>
                        </TabItem.Header>
                        <Grid TextBlock.FontSize="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="294*"/>
                                <ColumnDefinition Width="127*"/>
                                <ColumnDefinition Width="219*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel
                                Grid.Row="0"
                                Margin="2,2,2,2"
                                Orientation="Horizontal" Grid.ColumnSpan="3">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="Account"
                                    TextAlignment="Left" />
                                <ComboBox
                                    Name="lstAccounts_Account2"
                                    Width="300"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    DisplayMemberPath="Description"
                                    ItemsSource="{Binding}"
                                    SelectionChanged="lstAccounts_Account2_SelectionChanged" />
                                <TextBlock
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="Month"
                                    TextAlignment="Left" />
                                <ComboBox
                                    Name="lstMonths_Account2"
                                    Width="85"
                                    Margin="3,0,0,0"
                                    VerticalAlignment="Center"
                                    SelectionChanged="lstMonths_Account2_SelectionChanged">
                                    <ComboBoxItem>January</ComboBoxItem>
                                    <ComboBoxItem>February</ComboBoxItem>
                                    <ComboBoxItem>March</ComboBoxItem>
                                    <ComboBoxItem>April</ComboBoxItem>
                                    <ComboBoxItem>May</ComboBoxItem>
                                    <ComboBoxItem>June</ComboBoxItem>
                                    <ComboBoxItem>July</ComboBoxItem>
                                    <ComboBoxItem>August</ComboBoxItem>
                                    <ComboBoxItem>September</ComboBoxItem>
                                    <ComboBoxItem>October</ComboBoxItem>
                                    <ComboBoxItem>November</ComboBoxItem>
                                    <ComboBoxItem>December</ComboBoxItem>
                                </ComboBox>
                                <TextBlock
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="Base Year" />
                                <ComboBox
                                    Name="lstBaseYears"
                                    Width="60"
                                    Margin="3,0,0,0"
                                    SelectionChanged="lstYears_SelectionChanged" />
                            </StackPanel>
                            <DataGrid
                                Name="grdAccount_Long2"
                                Grid.Row="1"
                                AutoGenerateColumns="False"
                                ItemsSource="{Binding}" Grid.ColumnSpan="3">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Name="ctxExcludeLong2" Header="Exclude Company" Click="ctxExcludeLong2_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="200"
                                        Binding="{Binding Path=CompanyName}"
                                        Header="Company">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                <Setter Property="Margin" Value="2,0,0,0" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn
                                        Width="80"
                                        Binding="{Binding Department, StringFormat={}{0:###}}"
                                        Header="Dpt">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                <Setter Property="Margin" Value="0,0,2,0" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn
                                        Width="200"
                                        Binding="{Binding Path=Name}"
                                        Header="Name">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                <Setter Property="Margin" Value="2,0,0,0" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                    </TabItem>

                </TabControl>
            </Grid>
            <StackPanel
                Grid.Row="2"
                Margin="0,5,0,5"
                Background="AliceBlue"
                Orientation="Horizontal">
                <Button
                    Name="cmdClose"
                    Margin="10,0,0,0"
                    Click="cmdClose_Click"
                    Content="CLOSE" />
                <Button
                    Name="cmdPrint"
                    Margin="10,0,0,0"
                    Click="cmdPrint_Click"
                    Content="PRINT" />
                <StackPanel Margin="20,0,0,0" TextBlock.FontSize="11">
                    <CheckBox
                        Name="chkActive"
                        VerticalAlignment="Center"
                        Checked="chkActive_Checked"
                        Content="Include InActive Companies?"
                        Unchecked="chkActive_Unchecked" />
                    <CheckBox
                        Name="chkActiveAccounts"
                        Checked="chkActiveAccounts_Checked"
                        Content="Include InActive Accounts?"
                        Unchecked="chkActiveAccounts_Unchecked" />

                </StackPanel>
                <TextBox
                    Margin="10,0,0,0"
                    Background="AliceBlue"
                    FontSize="12"
                    IsReadOnly="True"
                    Text="Check box on tab to make it the default." />
            </StackPanel>
            <Border Grid.Row="3" BorderBrush="Blue" BorderThickness="1">
                <DockPanel Grid.Row="3">
                    <StackPanel  DockPanel.Dock="Left">
                        <TextBlock Text="Companies excluded from 'By Account' results:"/>
                        <Button Content="Click for HELP" FontSize="10" Click="Button_Click"/>
                    </StackPanel>
                    <TextBlock Name="txtNumExcluded" Foreground="Red" Margin="5,0,0,0"  DockPanel.Dock="Left" />
                    <TextBlock Name="txtExclusions" Margin="1,0,0,0" Width="Auto" DockPanel.Dock="Left">
                        <TextBlock.Style >
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=InUse, UpdateSourceTrigger=PropertyChanged}" Value="True">
                                        <Setter Property="Text" Value="EXCLUSIONS PRESENT"/>
                                        <Setter Property="TextBlock.Foreground" Value="Red"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Path=InUse, UpdateSourceTrigger=PropertyChanged}" Value="False">
                                        <Setter Property="Text" Value="No Exclusions"/>
                                        <Setter Property="TextBlock.Foreground" Value="Blue"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ListBox Name="lstCompanyExclusions" 
                            DisplayMemberPath="CompanyName" 
                            Width="300" 
                            FontSize="10"
                            Foreground="Red"
                             Margin="5,0,0,0"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Left"
                            Height="40"
                            DockPanel.Dock="Left">
                        <ListBox.ContextMenu>
                            <ContextMenu >
                                <MenuItem Name="ctxUnExclude" Header="Remove from Excluded List" Click="ctxUnExclude_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
