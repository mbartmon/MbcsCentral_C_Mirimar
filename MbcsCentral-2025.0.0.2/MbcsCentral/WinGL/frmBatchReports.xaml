<Window
    x:Class="MbcsCentral.WinGL.frmBatchReports"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Name="FormfrmBatchReports"
    Title="Batch Reporting"
    Width="593.024"
    Height="370.808"
    Background="AliceBlue"
    Closed="frmBatchReports_Closed"
    FontSize="14"
    FontWeight="Bold"
    Loaded="frmBatchReports_Loaded"
    TextBlock.TextAlignment="Center">
    <Border
        BorderBrush="Blue"
        BorderThickness="3"
        CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <TextBox
                Name="txtTitle"
                Background="LightSteelBlue"
                BorderBrush="Blue"
                BorderThickness="2"
                FontSize="14"
                FontWeight="Bold"
                Text="Batch Reporting"
                TextAlignment="Center" />
            <Grid Grid.Row="1">
                <TabControl Background="AliceBlue" SelectionChanged="TabControl_SelectionChanged">
                    
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="Border" BorderThickness="1,1,1,0" BorderBrush="Gainsboro" CornerRadius="4,4,0,0" Margin="2,0">
                                        <ContentPresenter x:Name="ContentSite"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        ContentSource="Header"
                                        Margin="10,2"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="LightSkyBlue" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="False">
                                            <Setter TargetName="Border" Property="Background" Value="Bisque" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>
  
                    <TabItem
                        Name="tabReports"
                        FontSize="14"
                        Header="Reports">
                        <Grid
                            Background="AliceBlue"
                            TextBlock.FontSize="12"
                            TextBlock.FontWeight="Normal">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="118.666" />
                                <ColumnDefinition Width="31.334" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="25" />
                                <RowDefinition Height="25" />
                            </Grid.RowDefinitions>
                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="5"
                                Orientation="Vertical"
                                TextBlock.FontSize="12"
                                TextBlock.FontWeight="Bold">
                                <TextBox
                                    Margin="0,0,0,5"
                                    HorizontalAlignment="Left"
                                    Background="Yellow"
                                    IsReadOnly="True"
                                    Text="ADD A REPORT" />
                                <Button
                                    Name="cmdCheckRegister"
                                    Width="130"
                                    Margin="0,0,0,3"
                                    HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Left"
                                    Click="cmdCheckRegister_Click"
                                    Content="Check Register (CR)" />
                                <Button
                                    Name="cmdGeneralLedger"
                                    Width="130"
                                    Margin="0,0,0,3"
                                    HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Left"
                                    Click="cmdGeneralLedger_Click"
                                    Content="General Ledger (GL)" />
                                <Button
                                    Name="cmdOperatingStatement"
                                    Width="130"
                                    Margin="0,0,0,3"
                                    HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Left"
                                    Click="cmdOperatingStatement_Click"
                                    Content="Operating Stmnt (OS)" />
                                <Button
                                    Name="cmdBalanceSheet"
                                    Width="130"
                                    Margin="0,0,0,3"
                                    HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Left"
                                    Click="cmdBalanceSheet_Click"
                                    Content="Balance Sheet (BS)" />
                                <Button
                                    Name="cmdJournalReport"
                                    Width="130"
                                    Margin="0,0,0,3"
                                    HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Left"
                                    Click="cmdJournalReport_Click"
                                    Content="Journal Report (JR)" />
                                <Button
                                    Name="cmdTrialBalance"
                                    Width="130"
                                    Margin="0,0,0,3"
                                    HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Left"
                                    Click="cmdTrialBalance_Click"
                                    Content="Trial Balance (TB)" />
                                <Button
                                    Name="cmdDisbursements"
                                    Width="130"
                                    HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Left"
                                    Click="cmdDisbursements_Click"
                                    Content="Disbursement (DR)" />
                            </StackPanel>
                            <ListView
                                Name="lstReports"
                                Grid.Row="0"
                                Grid.Column="2"
                                Height="Auto"
                                VerticalAlignment="Stretch"
                                DisplayMemberPath="DisplayItem"
                                FontWeight="Bold"
                                ItemsSource="{Binding}">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListViewItem}">
                                        <EventSetter Event="MouseDoubleClick" Handler="lstReports_MouseDoubleClick" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem
                                            Name="ctxEdit"
                                            Click="ctxEdit_Click"
                                            Header="Edit" />
                                        <MenuItem
                                            Name="ctxDelete"
                                            Click="ctxDelete_Click"
                                            Header="Delete" />
                                    </ContextMenu>
                                </ListView.ContextMenu>
                            </ListView>
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="2"
                                Margin="0,2,0,1"
                                Padding="2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="Yellow"
                                FontSize="12"
                                IsReadOnly="True"
                                Text="Select a line above to Edit or Delete by right clicking it or DoubleClick to Edit" />
                            <Grid
                                Name="InputBox"
                                Grid.Row="0"
                                Grid.Column="2"
                                Grid.ColumnSpan="1"
                                Visibility="Collapsed">
                                <Grid Background="Black" Opacity="0.5" />
                                <Border
                                    MinWidth="500"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="Orange"
                                    BorderBrush="Black"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <StackPanel>
                                        <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                            <TextBlock
                                                Name="InputTextLabel"
                                                Margin="2,0,0,0"
                                                FontWeight="Bold"
                                                Text="Name for new batch:" />
                                            <TextBox
                                                Name="InputTextBox"
                                                Width="350"
                                                Margin="5,0,3,0"
                                                VerticalAlignment="Center"
                                                MaxLength="64"
                                                TextAlignment="Left" />
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <Button
                                                x:Name="YesButton"
                                                Margin="5"
                                                Background="{x:Null}"
                                                Click="YesButton_Click"
                                                Content="Create"
                                                IsDefault="True" />
                                            <Button
                                                x:Name="NoButton"
                                                Margin="5"
                                                Background="{x:Null}"
                                                Click="NoButton_Click"
                                                Content="Cancel" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel
                                Grid.Row="2"
                                Grid.ColumnSpan="3"
                                Orientation="Horizontal"
                                TextBlock.FontSize="12">
                                <CheckBox
                                    Name="chkUsePrinter"
                                    Grid.ColumnSpan="2"
                                    Margin="3,4,0,0"
                                    VerticalAlignment="Center"
                                    Content="Use default printer settings" />
                                <TextBlock
                                    Margin="10,2,0,0"
                                    VerticalAlignment="Center"
                                    Text="Printer" />
                                <ComboBox
                                    Name="lstPrinter"
                                    Width="150"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    ItemsSource="{Binding}" />
                                <CheckBox Name="chkDuplex"
                                          Margin="5,0,0,0"
                                          VerticalAlignment="Center"
                                          Content="Duplex"
                                          IsChecked="{Binding Path=Duplex, Mode=TwoWay}"/>
                                <CheckBox
                                    Name="chkCondensePrint"
                                    Margin="5,0,0,0"
                                    FontSize="11"
                                    VerticalAlignment="Center"
                                    Content="Condense Print"
                                    IsChecked="{Binding Path=CondensePrint, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                    </TabItem>
                    <TabItem
                        Name="tabReportsList"
                        Background="AliceBlue"
                        FontSize="14"
                        Header="Reports List">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                                <ListBox
                                    Name="lstReportList"
                                    Width="250"
                                    MinHeight="150"
                                    DisplayMemberPath="ListName"
                                    FontSize="12"
                                    ItemsSource="{Binding}"
                                    SelectionChanged="lstReportList_SelectionChanged">
                                    <ListBox.Resources>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border
                                                            Name="Border"
                                                            Padding="2"
                                                            SnapsToDevicePixels="true">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="true">
                                                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.Resources>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="{x:Type ListBoxItem}">
                                            <EventSetter Event="MouseDoubleClick" Handler="ListViewItem_MouseDoubleClick" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                                <Border
                                    Padding="3"
                                    HorizontalAlignment="Center"
                                    BorderBrush="Blue"
                                    BorderThickness="2"
                                    CornerRadius="3">
                                    <StackPanel
                                        Height="20"
                                        Orientation="Horizontal"
                                        TextBlock.FontSize="11">
                                        <Button
                                            Name="cmdSelect"
                                            Click="cmdSelect_Click"
                                            Content="SELECT" />
                                        <Button Name="cmdCancel" Content="CANCEL" Click="cmdCancel_Click"/>
                                        <Button Name="cmdDelete" Content="DELETE" Click="cmdDelete_Click" />
                                        <CheckBox
                                            Name="chkAdjustDates"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Content="Adjust Dates" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <Border
                                Name="bdrDates"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Background="AliceBlue"
                                BorderBrush="Blue"
                                BorderThickness="2"
                                CornerRadius="3"
                                Visibility="Collapsed">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="35" />
                                        <RowDefinition Height="35" />
                                        <RowDefinition Height="35" />
                                        <RowDefinition Height="50" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Width="125"
                                        VerticalAlignment="Center"
                                        Text="Starting Date"
                                        TextAlignment="Left" />
                                    <DatePicker
                                        Name="dtStartDate"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Width="125"
                                        Margin="10,0,0,0"
                                        SelectedDateFormat="Short" 
                                        SelectedDate="{Binding Path=FromDate}"/>
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="Ending Date"
                                        TextAlignment="Left" />
                                    <DatePicker
                                        Name="dtEndDate"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Width="125"
                                        Margin="10,0,0,0"
                                        SelectedDateFormat="Short" 
                                        SelectedDate="{Binding Path=ToDate}"/>
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="Month/Year"
                                        TextAlignment="Left" />
                                    <ComboBox
                                        Name="lstMonths"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Width="125"
                                        VerticalAlignment="Center"
                                        SelectedIndex="{Binding ReportMonth}">
                                        <ComboBox.Resources>
                                            <!--  Selected color when the ComboBox is focused  -->
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Yellow" />
                                            <!--  Selected color when the ComboBox is not focused  -->
                                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Yellow" />

                                            <!--  selected text  -->
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black" />
                                        </ComboBox.Resources>
                                        <ComboBoxItem>January</ComboBoxItem>
                                        <ComboBoxItem>February</ComboBoxItem>
                                        <ComboBoxItem>March</ComboBoxItem>
                                        <ComboBoxItem>April</ComboBoxItem>
                                        <ComboBoxItem>May</ComboBoxItem>
                                        <ComboBoxItem>June</ComboBoxItem>
                                        <ComboBoxItem>July</ComboBoxItem>
                                        <ComboBoxItem>August</ComboBoxItem>
                                        <ComboBoxItem>September</ComboBoxItem>
                                        <ComboBoxItem>October</ComboBoxItem>
                                        <ComboBoxItem>November</ComboBoxItem>
                                        <ComboBoxItem>December</ComboBoxItem>
                                    </ComboBox>
                                    <ComboBox
                                        Name="lstYears"
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        Width="125"
                                        VerticalAlignment="Center">
                                        <ComboBox.Resources>
                                            <!--  Selected color when the ComboBox is focused  -->
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Yellow" />
                                            <!--  Selected color when the ComboBox is not focused  -->
                                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Yellow" />

                                            <!--  selected text  -->
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black" />
                                        </ComboBox.Resources>
                                    </ComboBox>
                                    <Button
                                        Name="cmdAdjSave"
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Width="50"
                                        VerticalAlignment="Center"
                                        Click="cmdAdjSave_Click"
                                        Content="SAVE" />
                                    <Button
                                        Name="cmdAdjCancel"
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Width="60"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Click="cmdAdjCancel_Click"
                                        Content="CANCEL" />
                                </Grid>
                            </Border>


                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
            <StackPanel
                Grid.Row="2"
                Margin="0,5,0,5"
                Background="AliceBlue"
                Orientation="Horizontal">
                <Button
                    Name="cmdPrint"
                    Margin="10,0,0,0"
                    Click="cmdPrint_Click"
                    Content="PRINT" />
                <Button
                    Name="cmdEmail"
                    Margin="10,0,0,0"
                    Click="cmdEmail_Click"
                    Content="EMAIL" />
                <Button
                    Name="cmdClose"
                    Margin="10,0,0,0"
                    Click="cmdClose_Click"
                    Content="CLOSE" />
                <Button
                    Name="cmdRecall"
                    Margin="10,0,0,0"
                    Click="cmdRecall_Click"
                    Content="LOAD A BATCH" />
                <Button
                    Name="cmdClear"
                    Margin="10,0,0,0"
                    Click="cmdClear_Click"
                    Content="CLEAR" />
                <Button
                    Name="cmdSave"
                    Margin="10,0,0,0"
                    Click="cmdSave_Click"
                    Content="SAVE" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
