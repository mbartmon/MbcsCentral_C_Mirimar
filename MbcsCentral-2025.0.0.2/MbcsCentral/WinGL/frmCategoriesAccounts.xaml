<Window
    x:Class="MbcsCentral.WinGL.frmCategoriesAccounts"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MbcsCentral.WinGL"
    Name="formCategorieAccounts"
    Title="Categories and Accounts"
    Width="611"
    Height="496.05"
    Closing="formCategorieAccounts_Closing"
    FontWeight="Bold"
    Loaded="formCategorieAccounts_Loaded">

    <Window.Resources>
        <Style x:Key="Color" TargetType="{x:Type ListBox}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=active}" Value="True">
                    <Setter Property="Foreground" Value="Red" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=active}" Value="False">
                    <Setter Property="Foreground" Value="Gray" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25" />
            <RowDefinition />
            <RowDefinition Height="60" />
            <RowDefinition Height="25" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="15" />
        </Grid.ColumnDefinitions>
        <StackPanel Background="AliceBlue">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                FontSize="16"
                Text="Categories" />
        </StackPanel>

        <StackPanel Grid.Column="2" Background="AliceBlue">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                FontSize="16"
                Text="Accounts" />
        </StackPanel>

        <TreeView
            Name="lstCategories"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            AllowDrop="True"
            Background="BlanchedAlmond"
            Drop="lstCategories_Drop"
            PreviewMouseDown="lstCategories_PreviewMouseDown"
            PreviewMouseMove="lstCategories_PreviewMouseMove">
            <TreeView.ContextMenu>
                <ContextMenu>
                    <MenuItem
                        Name="AddRootCategory"
                        Click="CategoriesAddRoot_Click"
                        Header="Add Root Category" />
                    <MenuItem
                        Name="AddSubCategory"
                        Click="CategoriesAddSub_Click"
                        Header="Add Sub Category" />
                    <MenuItem
                        Name="RenameCatgory"
                        Click="RenameCatgory_Click"
                        Header="Edit Name" />
                    <MenuItem
                        Name="DeleteCategory"
                        Click="cmdDelete_Click"
                        Header="Delete" />
                </ContextMenu>
            </TreeView.ContextMenu>
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="TreeViewItem.IsExpanded" Value="True" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type local:MajorCategories}" ItemsSource="{Binding SubCats}">
                    <TextBlock Text="{Binding CategoryDescription}" />
                </HierarchicalDataTemplate>
                <HierarchicalDataTemplate DataType="{x:Type local:SubCat}" ItemsSource="{Binding SubSubCats}">
                    <TextBlock Text="{Binding CategoryDescription}" />
                </HierarchicalDataTemplate>
                <DataTemplate DataType="{x:Type local:SubSubCat}">
                    <TextBlock Text="{Binding CategoryDescription}" />
                </DataTemplate>
            </TreeView.Resources>
        </TreeView>
        <GridSplitter
            Grid.Row="1"
            Grid.Column="1"
            Width="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            Background="Black"
            ShowsPreview="True" />
        <ListBox
            Name="lstAccounts"
            Grid.Row="1"
            Grid.RowSpan="2"
            Grid.Column="2"
            Margin="0,7,0,53"
            Padding="5,0,0,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="LightSteelBlue"
            DisplayMemberPath="Description"
            ItemsSource="{Binding}"
            PreviewMouseDown="lstAccounts_PreviewMouseDown"
            PreviewMouseMove="lstCategories_PreviewMouseMove"
            ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem
                        Name="AccountsEdit"
                        Click="cmdEditAccount_Click"
                        Header="Change Account Name" />
                    <MenuItem
                        Name="AccountsStatus"
                        Click="AccountsStatus_Click"
                        Header="Toggle Account Status" />
                    <MenuItem
                        Name="AccountsAddItem"
                        Click="cmdAddAccount_Click"
                        Header="Add Account" />
                    <MenuItem
                        Name="AccountsDelete"
                        Click="cmdDeleteAccount_Click"
                        Header="Delete Account" />
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=active}" Value="True">
                            <Setter Property="ListBoxItem.Foreground" Value="Black" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=active}" Value="False">
                            <Setter Property="ListBoxItem.Foreground" Value="Gray" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
        <Grid
            Grid.Row="1"
            Grid.Column="3"
            Background="LightGray">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Button
                Name="cmdUp"
                Height="Auto"
                VerticalAlignment="Stretch"
                Click="cmdUp_Click">
                <Button.Background>
                    <ImageBrush ImageSource="/MbcsCentral;component/Resources/ARW03UP.png" Stretch="Uniform" />
                </Button.Background>
            </Button>

            <Button
                Name="cmdDown"
                Grid.Row="1"
                Height="Auto"
                VerticalAlignment="Stretch"
                Click="cmdDown_Click">
                <Button.Background>
                    <ImageBrush ImageSource="/MbcsCentral;component/Resources/ARW03DN.png" Stretch="Uniform" />
                </Button.Background>
            </Button>
        </Grid>
        <Border
            Grid.Row="2"
            Grid.Column="0"
            BorderBrush="Black"
            BorderThickness="2">
            <StackPanel Margin="10,0,0,3">
                <TextBlock Text="Drag and Drop Categories to other Categories." />
                <TextBlock Text="Drag and Drop Accounts to other Categories." />
                <TextBlock Foreground="Blue" Text="Right click a Category to perform actions." />
            </StackPanel>
        </Border>
        <Border
            Grid.Row="2"
            Grid.Column="2"
            BorderBrush="Black"
            BorderThickness="2">
            <StackPanel Margin="10,0,0,3">
                <TextBlock Text="ACTIVE ACCOUNT" />
                <TextBlock Foreground="Gray" Text="INACTIVE ACCOUNT" />
                <TextBlock Foreground="Blue" Text="Right click an Account to perform actions." />
            </StackPanel>
        </Border>
        <Grid
            Grid.Row="3"
            Grid.ColumnSpan="4"
            Background="DarkTurquoise">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="110" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
            </Grid.RowDefinitions>
            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                <!--
                    <Button Name="cmdEditCategory" Content="EDIT" Margin="3" Width="62" Click="cmdEditCategory_Click"/>
                    <Button Name="cmdAddCategory" Content="ADD" Margin="-3,3,0,3" Width="62" Click="cmdAddCategory_Click"/>
                    <Button Name="cmdDelete" Content="DELETE" Margin="0,3,0,3" Width="62" Click="cmdDelete_Click"/>
                -->
                <Button
                    Name="cmdSave"
                    Margin="25,3,0,3"
                    Click="cmdSave_Click"
                    Content="SAVE Category changes." />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Name="cmdExit"
                    Width="65"
                    Click="cmdExit_Click"
                    Content="EXIT" />
                <Button
                    Name="cmdPrint"
                    Margin="5,0,0,0"
                    Click="CmdPrint_OnClick"
                    Content="PRINT" />
            </StackPanel>
            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <!--
                    <Button Name="cmdEditAccount" Content="EDIT" Margin="3" Width="62" Click="cmdEditAccount_Click"/>
                    <Button Name="cmdAddAccount" Content="ADD" Margin="-3,3,0,3" Width="62" Click="cmdAddAccount_Click"/>
                    <Button Name="cmdDeleteAccount" Content="DELETE" Margin="0,3,0,3" Width="62" Click="cmdDeleteAccount_Click"/>
                -->
                <Button
                    Name="cmdSaveAccount"
                    Margin="0,3,25,3"
                    Click="cmdSaveAccount_Click"
                    Content="SAVE Account changes." />
            </StackPanel>

        </Grid>
         <Grid 
             Name="InputBox" 
             Grid.Row="1"
             Grid.Column="1"
             Grid.ColumnSpan="1"
             Visibility="Collapsed">
            <Grid Background="Black" Opacity="0.5" />
            <Border
                MinWidth="250"
                MinHeight="50"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Orange"
                BorderBrush="Black"
                BorderThickness="1"
                CornerRadius="0,55,0,55" RenderTransformOrigin="0.512,3.44">
                <StackPanel>
                    <TextBlock
                        Name="InputTextLabel"
                        Margin="5"
                        FontWeight="Bold"
                        Text="Input Box:" />
                    <TextBox
                        Name="InputTextBox"
                        Width="150"
                        Margin="5,0,0,0" />
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Button
                            x:Name="YesButton"
                            Margin="5"
                            Background="{x:Null}"
                            Click="YesButton_Click"
                            Content="Yes"
                            IsDefault="True" />
                        <Button
                            x:Name="NoButton"
                            Margin="5"
                            Background="{x:Null}"
                            Click="NoButton_Click"
                            Content="No" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
