
<Window
    x:Class="MbcsCentral.WinGL.frmCheckRegisterEdit"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:my="clr-namespace:MbcsCentral"
    Name="FormfrmCheckRegisterEdit"
    Title="Check Edit"
    Width="841.145"
    Height="300"
    Background="AliceBlue"
    Closed="frmCheckRegisterEdit_Closed"
    FontSize="14"
    FontWeight="Bold"
    Loaded="frmCheckRegisterEdit_Loaded">
    <Window.Resources>
        <!--  SINGLE CLICK EDITING  -->
        <Style TargetType="{x:Type DataGridCell}">
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DataGridCell_PreviewMouseLeftButtonDown" />
        </Style>
        <CollectionViewSource x:Key="companies" />
        <CollectionViewSource x:Key="departments" />
        <CollectionViewSource x:Key="accounts" />
    </Window.Resources>
    <Border
        BorderBrush="Blue"
        BorderThickness="3"
        CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <TextBox
                Background="LightSteelBlue"
                BorderBrush="Blue"
                BorderThickness="2"
                FontSize="14"
                FontWeight="Bold"
                Text="Check Edit"
                TextAlignment="Center" />
            <Grid Grid.Row="1">
                <Grid TextBlock.FontSize="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <StackPanel
                        Grid.Row="0"
                        Margin="5"
                        Orientation="Horizontal">
                        <TextBlock
                            Width="60"
                            VerticalAlignment="Center"
                            Text="Company" />
                        <ComboBox
                            Name="lstCheckCompany"
                            Width="200"
                            DisplayMemberPath="Name"
                            IsEnabled="False"
                            ItemsSource="{Binding}"
                            SelectedValue="{Binding Path=Company, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedValuePath="CompanyNumber" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Text="Department" />
                        <ComboBox
                            Name="lstCheckDepartment"
                            Width="200"
                            Margin="5,0,0,0"
                            DisplayMemberPath="Name"
                            IsEnabled="False"
                            ItemsSource="{Binding}"
                            SelectedValue="{Binding Path=Department, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedValuePath="DepartmentNumber" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Text="Check #" />
                        <my:NumberEntry
                            x:Name="txtCheckNumber"
                            Width="80"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            Decimals="0"
                            MaxLength="6"
                            Text="{Binding Path=CheckNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Name="cmdScan"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Click="cmdScan_Click"
                            Content="SCAN Invoice" />
                    </StackPanel>
                    <StackPanel
                        Grid.Row="1"
                        Margin="5"
                        Orientation="Horizontal">
                        <TextBlock
                            Width="60"
                            VerticalAlignment="Center"
                            Text="Vendor" />
                        <ComboBox
                            Name="lstVendor"
                            Width="200"
                            VerticalAlignment="Center"
                            DisplayMemberPath="VendorName"
                            ItemsSource="{Binding}"
                            SelectedValue="{Binding Path=VendorAccount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedValuePath="VendorNumber" />
                        <TextBlock
                            Margin="10"
                            VerticalAlignment="Center"
                            Text="Check Date" />
                        <DatePicker
                            Name="dtCheck"
                            Margin="1,0,0,0"
                            VerticalAlignment="Center"
                            SelectedDate="{Binding Path=Date}" />
                        <CheckBox
                            Name="chkRecon"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Content="Reconciled"
                            FlowDirection="RightToLeft"
                            IsChecked="{Binding Path=ReconFlag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Margin="13,0,0,0"
                            VerticalAlignment="Center"
                            Text="Net" />
                        <my:NumberEntry
                            x:Name="txtNet"
                            Width="80"
                            Margin="28,0,0,0"
                            VerticalAlignment="Center"
                            Decimals="2"
                            MaxLength="11"
                            Text="{Binding Path=Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:C}}" />
                        <Button
                            Name="cmdDisplay"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Click="cmdDisplay_Click"
                            Content="Display Invoice" />
                    </StackPanel>
                    <DataGrid
                        Name="lstAllocations"
                        CanUserAddRows="False"
                        Grid.Row="2"
                        AutoGenerateColumns="False"
                        ItemsSource="{Binding}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Delete}" Value="True">
                                        <Setter Property="Foreground" Value="Red" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Delete}" Value="False">
                                        <Setter Property="Foreground" Value="Black" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding Path=Delete, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Delete">
                                <DataGridCheckBoxColumn.CellStyle>
                                    <Style>
                                        <EventSetter Event="CheckBox.Checked" Handler="ctxDelete_Click" />
                                        <EventSetter Event="CheckBox.Unchecked" Handler="ctxDelete_Click" />
                                    </Style>
                                </DataGridCheckBoxColumn.CellStyle>
                            </DataGridCheckBoxColumn>
                            <DataGridComboBoxColumn
                                Width="220"
                                DisplayMemberPath="Name"
                                Header="Company"
                                SelectedValueBinding="{Binding DistCompany, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                SelectedValuePath="CompanyNumber">
                                <DataGridComboBoxColumn.ElementStyle>
                                        <Style TargetType="{x:Type ComboBox}">
                                            <Setter Property="ItemsSource" Value="{Binding CompanyList}" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextBlock.TextAlignment" Value="Left" />
                                            <Setter Property="Selector.IsSynchronizedWithCurrentItem" Value="False" />
                                        </Style>
                                </DataGridComboBoxColumn.ElementStyle>
                                <DataGridComboBoxColumn.EditingElementStyle>
                                        <Style TargetType="{x:Type ComboBox}">
                                            <Setter Property="Tag" Value="ListCompanyDist" />
                                            <Setter Property="ItemsSource" Value="{Binding CompanyList}" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="IsTextSearchEnabled" Value="True" />
                                            <Setter Property="IsEditable" Value="True" />
                                            <Setter Property="Selector.IsSynchronizedWithCurrentItem" Value="False" />
                                            <EventSetter Event="SelectionChanged" Handler="CompanySelection_Changed" />
                                        </Style>
                                </DataGridComboBoxColumn.EditingElementStyle>
                            </DataGridComboBoxColumn>
                            <DataGridComboBoxColumn
                                Width="220"
                                DisplayMemberPath="Name"
                                Header="Department"
                                SelectedItemBinding="{Binding SelectedDepartment}"
                                SelectedValueBinding="{Binding DepartmentName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                SelectedValuePath="Name">
                                <DataGridComboBoxColumn.ElementStyle>
                                    <Style TargetType="{x:Type ComboBox}">
                                        <Setter Property="ItemsSource" Value="{Binding DepartmentList}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="TextBlock.TextAlignment" Value="Left" />
                                        <Setter Property="SelectedIndex" Value="0" />
                                        <Setter Property="Selector.IsSynchronizedWithCurrentItem" Value="False" />
                                    </Style>
                                </DataGridComboBoxColumn.ElementStyle>
                                <DataGridComboBoxColumn.EditingElementStyle>
                                    <Style TargetType="{x:Type ComboBox}">
                                        <Setter Property="Tag" Value="ListDepartmentsDist" />
                                        <Setter Property="ItemsSource" Value="{Binding DepartmentList}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="IsTextSearchEnabled" Value="True" />
                                        <Setter Property="IsEditable" Value="True" />
                                        <Setter Property="SelectedIndex" Value="0" />
                                        <Setter Property="Selector.IsSynchronizedWithCurrentItem" Value="False" />
                                        <EventSetter Event="SelectionChanged" Handler="CompanySelection_Changed" />
                                  </Style>
                                </DataGridComboBoxColumn.EditingElementStyle>
                            </DataGridComboBoxColumn>
                            <DataGridComboBoxColumn
                                Width="220"
                                DisplayMemberPath="Description"
                                Header="Account"
                                ItemsSource="{Binding Source={StaticResource accounts}}"
                                SelectedValueBinding="{Binding VendorAccount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                SelectedValuePath="Key" />
                            <DataGridTemplateColumn Width="105" Header="Amount">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Width="100"
                                            Text="{Binding Path=Amount, StringFormat={}{0:#######0.00}}"
                                            TextAlignment="Right" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <my:NumberEntry
                                            MaxLength="10"
                                            Text="{Binding Path=Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextChanged="NumberEntry_TextChanged" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
            <Grid
                Grid.Row="2"
                Margin="0,5,0,5"
                Background="AliceBlue">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="415" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Orientation="Horizontal">
                    <Button
                        Name="cmdSave"
                        Margin="5,0,0,0"
                        Click="cmdSave_Click"
                        Content="SAVE" />
                    <Button
                        Name="cmdDelete"
                        Margin="5,0,0,0"
                        Click="cmdDelete_Click"
                        Content="DELETE" />
                    <Button
                        Name="cmdClose"
                        Margin="5,0,0,0"
                        Click="cmdClose_Click"
                        Content="CLOSE" />
                    <Button
                        Name="cmdAddLine"
                        Margin="20,0,0,0"
                        Click="cmdAddLine_Click"
                        Content="Add an allocation"
                        Visibility="Visible" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <TextBlock
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Text="CHECK TOTAL" />
                    <TextBox
                        Name="txtTotal"
                        Width="100"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="12"
                        IsReadOnly="True"
                        TextAlignment="Right" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
