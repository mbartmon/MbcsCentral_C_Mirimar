<Window
    x:Class="MbcsCentral.WinGL.frmInvoiceSelections"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MbcsCentral.WinGL"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Name="formInvoiceSelections"
    Title="Select Invoices for Payment"
    Width="479.364"
    Height="300"
    Background="Lightgreen"
    Closed="formInvoiceSelections_Closed"
    FontSize="14"
    FontWeight="Bold"
    Loaded="formInvoiceSelections_Loaded"
    TextBlock.TextAlignment="Center"
    mc:Ignorable="d">
    <Border
        BorderBrush="Blue"
        BorderThickness="3"
        CornerRadius="5">
        <Grid
            TextBlock.FontSize="12"
            TextBlock.FontWeight="Normal"
            TextBlock.TextAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="35" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="35" />
            </Grid.RowDefinitions>
            <StackPanel
                Grid.Row="0"
                Margin="5"
                Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="Pay all invoices with a payment due date that is on or before: " />
                <DatePicker
                    Name="dtDueDate"
                    Height="30"
                    VerticalAlignment="Center"
                    SelectedDateFormat="Short" />
            </StackPanel>
            <GroupBox
                Grid.Row="1"
                Margin="5"
                BorderBrush="Black"
                Header="Force Discount">
                <StackPanel>
                    <TextBlock Margin="5">
                        You can decide if you want to take available discounts even if the payment due<LineBreak />
                        date on the invoice has passed.</TextBlock>
                    <StackPanel Margin="5,5,0,0" Orientation="Horizontal">
                        <TextBlock>
                            Normally, if the payment due date has passed, the discount is not taken.<LineBreak />
                            However, you may choose to take the discount anyway by checking this box.</TextBlock>
                        <CheckBox
                            Name="chkTakeDiscount"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>
            <GroupBox
                Grid.Row="2"
                Margin="5"
                BorderBrush="Black"
                Header="Selection Options"
                Visibility="Collapsed">
                <StackPanel Margin="5">
                    <RadioButton
                        Name="optAdd"
                        Content="Select and add invoices to payment list"
                        GroupName="SelectionOptions"
                        IsChecked="True" />
                    <RadioButton
                        Name="optClear"
                        Margin="0,10,0,0"
                        Content="Clear list then select invoices"
                        GroupName="SelectionOptions" />
                </StackPanel>
            </GroupBox>
            <StackPanel
                Grid.Row="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                TextBlock.FontWeight="BOLD">
                <Button
                    Name="cmdProcess"
                    Click="cmdProcess_Click"
                    Content="PROCESS" />
                <Button
                    Name="cmdCancel"
                    Margin="20,0,0,0"
                    Click="cmdCancel_Click"
                    Content="EXIT" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
