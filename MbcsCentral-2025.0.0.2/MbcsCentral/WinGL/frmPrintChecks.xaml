<Window
    x:Class="MbcsCentral.WinGL.frmPrintChecks"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MbcsCentral.WinGL"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Name="formPrintChecks"
    Width="404.427"
    Height="300"
    Background="LightSteelBlue"
    Closed="formPrintChecks_Closed"
    FontSize="14"
    FontWeight="Bold"
    Loaded="formPrintChecks_Loaded"
    TextBlock.TextAlignment="Center"
    mc:Ignorable="d">
    <Border
        BorderBrush="Blue"
        BorderThickness="3"
        CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <TextBox
                Background="AliceBlue"
                BorderBrush="Blue"
                BorderThickness="2"
                FontSize="14"
                FontWeight="Bold"
                Text="Print A/P Checks"
                TextAlignment="Center" />
            <Grid
                Grid.Row="1"
                TextBlock.FontSize="12"
                TextBlock.FontWeight="Normal">
                <StackPanel Margin="5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="Check Date " />
                        <DatePicker
                            Name="dtCheckDate"
                            Height="25"
                            SelectedDateFormat="Short" />
                        <GroupBox
                            Margin="20,0,0,0"
                            BorderBrush="Black"
                            BorderThickness="1"
                            Header="Voucher Description Options">
                            <StackPanel Margin="5,10,5,5">
                                <RadioButton
                                    Name="optBuildingAddress"
                                    Content="Building Address"
                                    GroupName="VoucherOptions" />
                                <RadioButton
                                    Name="optFirstLine"
                                    Content="First Line of Allocations"
                                    GroupName="VoucherOptions"
                                    IsChecked="True" />
                                <RadioButton
                                    Name="optPayroll"
                                    Content="Payroll Format"
                                    GroupName="VoucherOptions" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                    <StackPanel x:Name="pnlNonACH">
                        <CheckBox
                            Name="chkChangeCheckNumber"
                            Margin="0,10,0,0"
                            Content="Change Check # or Date for each Account" />
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="Check Format" />
                            <ComboBox
                                Name="lstCheckFormat"
                                Width="150"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Background="White"
                                SelectedIndex="0">
                                <ComboBox.Items>
                                    <ComboBoxItem>Continuous/PrintBoss</ComboBoxItem>
                                    <ComboBoxItem>BlankCheck V1</ComboBoxItem>
                                    <ComboBoxItem>BlankCheck V2</ComboBoxItem>
                                </ComboBox.Items>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="Printer for Continuous" />
                            <ComboBox
                                Name="lstPrinters"
                                Width="150"
                                Margin="5,0,0,0"
                                Background="White"
                                DisplayMemberPath="FullName"
                                ItemsSource="{Binding}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <StackPanel
                Grid.Row="2"
                Margin="0,5,0,5"
                Background="AliceBlue"
                Orientation="Horizontal">
                <Button
                    Name="cmdSave"
                    Margin="10,0,0,0"
                    Click="cmdSave_Click"
                    Content="PRINT" />
                <Button
                    Name="cmdClose"
                    Margin="10,0,0,0"
                    Click="cmdClose_Click"
                    Content="CLOSE" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
