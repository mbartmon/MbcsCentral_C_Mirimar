<Window x:Class="MbcsCentral.WinPM.frmChargeCodes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:my="clr-namespace:MbcsCentral"
        xmlns:viblend="clr-namespace:VIBlend.WPF.Controls;assembly=VIBlend.WPF.Editors"
        Name="formChargeCodes"
        Title="Charge Codes"
        Width="704"
        Height="300"
        Loaded="formChargeCodes_Loaded_1">
    <Window.Resources>
        <my:BooleanYesNoConverter x:Key="BoolYesNo" />
        <Style x:Key="BorderItem" TargetType="ListViewItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border BorderBrush="Gray" BorderThickness="2">
                            <GridViewRowPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="100" />
            <RowDefinition Height="35" />
        </Grid.RowDefinitions>

        <ListView Name="lstCharges"
                  Grid.Row="0"
                  Background="Bisque"
                  BorderBrush="Black"
                  BorderThickness="2"
                  ItemContainerStyle="{StaticResource BorderItem}"
                  ItemsSource="{Binding}"
                  PreviewMouseDown="lstCharges_PreviewMouseDown_1"
                  SelectionChanged="lstCharges_SelectionChanged_1">
            <ListView.View>
                <GridView>
                    <GridViewColumn DisplayMemberBinding="{Binding ChargeCode}" Header="Code" />
                    <GridViewColumn DisplayMemberBinding="{Binding ChargeDescription}" Header="Description" />
                    <GridViewColumn DisplayMemberBinding="{Binding rentFlag, Converter={StaticResource BoolYesNo}}" Header="Rent" />
                    <!-- <GridViewColumn DisplayMemberBinding="{Binding securityFlag, Converter={StaticResource BoolYesNo}}" Header="Security" /> -->
                    <!-- <GridViewColumn DisplayMemberBinding="{Binding LegalCode, Converter={StaticResource BoolYesNo}}" Header="Legal" /> -->
                    <GridViewColumn DisplayMemberBinding="{Binding GLCreditName}" Header="GL Credit Acct" />
                    <GridViewColumn DisplayMemberBinding="{Binding GLDebitName}" Header="GL Debit Acct" />
                </GridView>
            </ListView.View>
        </ListView>



        <StackPanel Name="pnlDetails"
                    Grid.Row="1"
                    VerticalAlignment="Stretch"
                    Background="LightBlue">
            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                <TextBlock Margin="5,0,0,0"
                           VerticalAlignment="Center"
                           Text="ID:" />
                <TextBlock Width="50"
                           Margin="5,0,0,0"
                           Background="AliceBlue"
                           Text="{Binding ID}" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Text="Code:" />
                <TextBox Name="txtChargeCode"
                         Width="25"
                         Margin="5,0,0,0"
                         Background="AliceBlue"
                         CharacterCasing="Upper"
                         MaxLength="2"
                         Text="{Binding ChargeCode,
                                        Mode=TwoWay}" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Text="Description:" />
                <TextBox Name="txtChargeDescription"
                         Width="250"
                         Margin="5,0,0,0"
                         MaxLength="32"
                         Text="{Binding ChargeDescription,
                                        Mode=TwoWay}" />
            </StackPanel>
            <Border Margin="0,5,0,0"
                    BorderBrush="Black"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <CheckBox Margin="10,0,0,0"
                              VerticalAlignment="Center"
                              Content="Default Rent Charge"
                              IsChecked="{Binding rentFlag,
                                                  UpdateSourceTrigger=PropertyChanged}" />
                   <!-- <CheckBox Margin="10,0,0,0"
                              VerticalAlignment="Center"
                              Content="Default Security Charge"
                              IsChecked="{Binding securityFlag,
                                                  UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Margin="10,0,0,0"
                              VerticalAlignment="Center"
                              Content="Is a LEGAL charge"
                              IsChecked="{Binding LegalCode,
                                                  UpdateSourceTrigger=PropertyChanged}" />
                    -->
                </StackPanel>
            </Border>
            <Border Margin="0,5,0,0"
                    BorderBrush="Black"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Text="GL Credit Account:" />
                    <ComboBox Name="lstCreditAccount"
                              DisplayMemberPath="Description"
                              Width="175"
                              Margin="10,0,0,0"
                              Background="White"
                              ItemsSource="{Binding}"
                              SelectionChanged="lstCreditAccount_SelectionChanged" 
                              Visibility="Collapsed"/>
                    <my:NumberEntry Width="50"
                                    Decimals="0"
                                    MaxLength="4"
                                    Text="{Binding Path=GLCreditAccount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:#0000}}"
                                    />
                    <!--  <viblend:NumberEditor MaxLength="4" DecimalPlaces="0" Width="40" Value="{Binding GLCreditAccount, Mode=TwoWay}" Margin="5,0,0,0"/>  -->
                    <TextBlock Margin="20,0,0,0"
                               VerticalAlignment="Center"
                               Text="GL Debit Account:" />
                    <ComboBox Name="lstDebitAccount"
                              DisplayMemberPath="Description"
                              Width="175"
                              Margin="10,0,0,0"
                              Background="White"
                              ItemsSource="{Binding}"
                              SelectionChanged="lstDebitAccount_SelectionChanged" 
                              Visibility="Collapsed"/>
                    <my:NumberEntry Width="50"
                                    Decimals="0"
                                    MaxLength="4"
                                    Text="{Binding Path=GLDebitAccount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:#0000}}"
                                    />
                    <!--  <viblend:NumberEditor MaxLength="4" DecimalPlaces="0" Width="40" Value="{Binding GLDebitAccount, Mode=TwoWay}" Margin="5,0,0,0"/>  -->
                </StackPanel>
            </Border>
        </StackPanel>
        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Stretch"
                    Background="AliceBlue"
                    Orientation="Horizontal">
            <Button Name="cmdSave"
                    Margin="0,0,0,0"
                    Click="cmdSave_Click_1"
                    Content="SAVE"
                    Visibility="Hidden" />
            <Button Name="cmdDelete"
                    Margin="20,0,0,0"
                    Click="cmdDelete_Click_1"
                    Content="DELETE"
                    Visibility="Hidden" />
            <Button Name="cmdAdd"
                    Margin="20,0,0,0"
                    Click="cmdAdd_Click_1"
                    Content="ADD a New Charge" />
            <Button Name="cmdCancel"
                    Margin="20,0,0,0"
                    Click="cmdCancel_Click_1"
                    Content="CANCEL ADD"
                    Visibility="Hidden" />
            <Button Name="cmdExit"
                    Margin="20,0,20,0"
                    Click="cmdExit_Click_1"
                    Content="EXIT" />
        </StackPanel>
    </Grid>
</Window>
