<Window x:Class="MbcsCentral.WinPM.frmPaymentRegister"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Name="formPaymentRegister"
        Background="Aquamarine"
        Title="Payment Register"
        Width="300" FontFamily="Rockwell Extra Bold" FontSize="16" WindowStyle="None" Height="146" WindowStartupLocation="CenterOwner"
        Closed="formPaymentRegister_Closed">
    <Grid>
        <StackPanel>
            <TextBlock Text="Payment Register" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="Blue"/>
            <Button Content="Display" Margin="5,10,5,0" Click="Display_Click"/>
            <Button Content="Print" Margin="5,10,5,0" Click="Print_Click"/>
            <Button Content="Exit" Margin="5,10,5,0" Click="Exit_Click"/>
        </StackPanel>
    </Grid>
</Window>
