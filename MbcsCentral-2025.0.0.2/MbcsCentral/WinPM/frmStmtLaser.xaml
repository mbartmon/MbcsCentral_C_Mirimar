<Window x:Class="MbcsCentral.WinPM.frmStmtLaser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wait="clr-namespace:MbcsWpfControls;assembly=MbcsWpfControls"
        Name="formStmtLaser"
        Title="Print Rent Statements"
        Width="639.832"
        Height="303.779"
        Background="ForestGreen"
        Closed="formStmtLaser_Closed"
        Loaded="formStmtLaser_Loaded">
    <Window.Resources>
        <Style x:Key="{x:Type ListViewItem}" TargetType="{x:Type ListViewItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="true">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!--
    -->
    <Grid Name="mainGrid" DataContext="{Binding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="53" />
            <RowDefinition Height="32" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="colMain" Width="186" />
            <ColumnDefinition x:Name="colMiddle" Width="186" />
            <ColumnDefinition x:Name="colTenant" Width="250" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0"
                    Grid.Column="0"
                    Orientation="Horizontal">
            <TextBlock Width="90"
                       Margin="15,0,0,0"
                       VerticalAlignment="Center"
                       Text="Starting Tenant" />
            <TextBox Name="txtStartBuilding"
                     Width="30"
                     Margin="5,0,0,0"
                     VerticalAlignment="Center"
                     GotFocus="txtTenantSelect_GotFocus"
                     MaxLength="3"
                     Text="000"
                     TextChanged="txtStartBuilding_TextChanged" />
            <TextBox Name="txtStartTenant"
                     Width="35"
                     VerticalAlignment="Center"
                     GotFocus="txtTenantSelect_GotFocus"
                     LostFocus="txtTenantSelect_LostFocus"
                     MaxLength="4"
                     Text="0000" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <TextBlock Width="90"
                       Margin="15,0,0,0"
                       VerticalAlignment="Center"
                       Text="Ending Tenant" />
            <TextBox Name="txtEndBuilding"
                     Width="30"
                     Margin="5,0,0,0"
                     VerticalAlignment="Center"
                     GotFocus="txtTenantSelect_GotFocus"
                     MaxLength="3"
                     Text="ZZZ"
                     TextChanged="txtEndBuilding_TextChanged" />
            <TextBox Name="txtEndTenant"
                     Width="35"
                     VerticalAlignment="Center"
                     GotFocus="txtTenantSelect_GotFocus"
                     LostFocus="txtTenantSelect_LostFocus"
                     MaxLength="4"
                     Text="ZZZZ" />
        </StackPanel>
        <StackPanel Grid.Row="0"
                    Grid.Column="1"
                    Margin="5,5,0,0">
            <CheckBox Name="chkLockBox"
                      Content="Use Lock Box Scan Line"
                      IsChecked="False"
                      IsTabStop="False" />
            <CheckBox Name="chkAddressLine"
                      Content="Use Above Perf Address Lines"
                      IsChecked="False"
                      IsTabStop="False" />
            <CheckBox Name="chkACH"
                      Content="Print ACH Only"
                      IsChecked="False"
                      IsTabStop="True"/>
        </StackPanel>
        <Button x:Name="cmdTenants"
                Grid.Row="1"
                Grid.Column="1"
                Margin="52,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Click="cmdTenants_Click"
                Content="INDIVIDUAL TENANTS &gt;" Width="134" Height="20" />

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock Width="70"
                       Margin="15,0,0,0"
                       VerticalAlignment="Center"
                       Text="Closing Date" />
            <DatePicker Name="dtClosingDate"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Text="{Binding ClosingDate, Mode=TwoWay}" />
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <TextBlock Width="70"
                       Margin="15,0,0,0"
                       VerticalAlignment="Center"
                       Text="Billing Date" />
            <DatePicker Name="dtBillingDate"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Text="{Binding BillingDate, Mode=TwoWay}" />
        </StackPanel>
        <Border x:Name="bdrBill1"
                Grid.Row="2"
                Grid.Column="1"
                BorderBrush="Blue"
                BorderThickness="2,2,2,0">
            <!--
            <CheckBox Name="chkBillPay"
                      VerticalAlignment="Center"
                      Content="Generate Billing File?" />
            -->
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Text="ONE PAY FILE GENERATION" />
        </Border>
        <Border Name="bdrBill2"
                Grid.Row="3"
                Grid.RowSpan="4"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                BorderBrush="Blue"
                BorderThickness="2,0,2,2">
            <StackPanel Margin="2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Width="95"
                               VerticalAlignment="Center"
                               Text="Filename prefix" />
                    <TextBox Name="txtBillFilePrefix"
                             Width="200"
                             MaxLength="32" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Width="95"
                               VerticalAlignment="Center"
                               Text="Optional File Tag" />
                    <TextBox Name="txtBillingFileTag"
                             Width="100"
                             VerticalAlignment="Center"
                             MaxLength="16" />
                </StackPanel>
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="File Location" />
                    <TextBox Name="txtBillingingFileLocation"
                             Width="300"
                             Margin="5,0,0,0"
                             VerticalAlignment="Center"
                             IsReadOnly="True" />
                    <Button Name="cmdBillingBrowse"
                            Margin="5,0,0,0"
                            Click="cmdBillingBrowse_Click"
                            Content="BROWSE" />
                </StackPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="14"
                               FontWeight="Bold"
                               Text="Include in Bill Descriptions" />
                    <DataGrid Name="grdDescription"
                              Grid.Row="1"
                              ItemsSource="{Binding}" />
                </Grid>
                <Button x:Name="cmdBillingFile"
                        Margin="5,5,0,0"
                        HorizontalAlignment="Left"
                        Click="cmdPrint_Click"
                        Content="GENERATE BILLING FILE" />
            </StackPanel>
        </Border>
        <Border x:Name="bdrBill3"
                Grid.Row="2"
                Grid.Column="1"
                BorderBrush="Blue"
                BorderThickness="2,2,2,0">

            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Text="ACH FILE GENERATION" />
        </Border>
        <Border Name="bdrBill4"
                Grid.Row="3"
                Grid.RowSpan="4"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                BorderBrush="Blue"
                BorderThickness="2,0,2,2">
            <StackPanel Margin="2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Width="95"
                               VerticalAlignment="Center"
                               Text="Filename prefix" />
                    <TextBox Name="txtNachaFilePrefix"
                             Width="200"
                             MaxLength="32" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Width="95"
                               VerticalAlignment="Center"
                               Text="Optional File Tag" />
                    <TextBox Name="txtNachaFileTag"
                             Width="100"
                             VerticalAlignment="Center"
                             MaxLength="16" />
                </StackPanel>
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="File Location" />
                    <TextBox Name="txtNachaFileLocation"
                             Width="300"
                             Margin="5,0,0,0"
                             VerticalAlignment="Center"
                             IsReadOnly="True" />
                    <Button Name="cmdNachaBrowse"
                            Margin="5,0,0,0"
                            Click="cmdBillingBrowse_Click"
                            Content="BROWSE" />
                </StackPanel>
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <StackPanel>
                        <TextBlock Text="Statement Msg:" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="Area:" />
                            <TreeView Name="lstMsgArea" Width="40" Margin="3,0,0,0">
                                <TreeView.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />
                                </TreeView.Resources>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="{x:Type TreeViewItem}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Path=Current}" Value="True">
                                                <Setter Property="TreeViewItem.Foreground" Value="Red" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Path=Current}" Value="False">
                                                <Setter Property="TreeViewItem.Foreground" Value="Black" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                            </TreeView>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="txtStatementMessage"
                             Width="255"
                             Height="60"
                             Margin="5,0,0,0"
                             MaxLength="128"
                             TextWrapping="Wrap" />
                            <GroupBox Margin="5,0,0,0"
                              Content="[PayDate]"
                              Header="Insert" />
                        </StackPanel>
                        <Border BorderBrush="Black" BorderThickness="2" CornerRadius="3">
                            <TextBlock>
                                0 = No message
                                <LineBreak/>
                                1 = Top of message box
                                <LineBreak/>
                                2, 3 = Middle of message box
                                <LineBreak/>
                                4 = Bottom of message box
                                <LineBreak/>
                                5 = Instead of 'Make Payment to'
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="cmdNachaFile"
                        Margin="5,5,0,0"
                        HorizontalAlignment="Left"
                        Click="cmdPrint_Click"
                        Content="GENERATE NACHA FILE" />
                    <Button x:Name="cmdNachaManageFiles"
                            Margin="10,5,0,0"
                            HorizontalContentAlignment="Left"
                            Click="cmdNachaManageFiles_Click"
                            Content="Manage ACH Files"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="4"
                    Grid.RowSpan="3"
                    HorizontalAlignment="Center"
                    Orientation="Vertical" Width="186" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button Name="cmdEmail"
             Width="180"
             VerticalAlignment="Center"
             Click="cmdEmail_Click"
             Content="Email Non-ACH tenants Rent bills"
             IsDefault="True" 
             Visibility="Hidden"/>

            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Name="cmdPrint"
                        Width="50"
                        VerticalAlignment="Center"
                        Click="cmdPrint_Click"
                        Content="PRINT"
                        IsDefault="True" />
                <Button Name="cmdCancel"
                        Width="50"
                        Margin="80,0,0,0"
                        VerticalAlignment="Center"
                        Click="cmdCancel_Click"
                        Content="CLOSE"
                        IsCancel="True" />

            </StackPanel>
           
            <TextBlock Name="Status"
                       VerticalAlignment="Center"
                       TextAlignment="Center" />
        </StackPanel>
        <Grid x:Name="Expander"
              Grid.RowSpan="3"
              Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="20" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    BorderBrush="Black"
                    BorderThickness="2,0,3,0" />
            <TextBlock Margin="5,0,5,0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Text="INDIVIDUAL TENANTS" />
            <Border x:Name="bdrTenants"
                    Grid.Row="1"
                    BorderBrush="Black"
                    BorderThickness="2,3,3,3">
                <ListView Name="lstTenants"
                          DisplayMemberPath="NumberName"
                          IsEnabled="False"
                          SelectionMode="Extended"
                          Visibility="Hidden" />
            </Border>
        </Grid>
    </Grid>
</Window>
