<Window x:Class="frmOptions"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Options" Height="293" Width="436" FontWeight="SemiBold" Background="AliceBlue" BorderThickness="2" BorderBrush="Black">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" LastChildFill="True">
                <Label Content="Company Name" Width="100"/>
                <TextBox Name="txtCompanyName" Margin="0,5,0,5" />
            </DockPanel>
            <DockPanel Grid.Row="1" LastChildFill="True" >
                <Label Content="Email Signature" VerticalAlignment="top" Width="100"/>
                <TextBox Name="txtSignature" HorizontalAlignment="Stretch" Width="auto" TextWrapping="Wrap" IsManipulationEnabled="True" MaxLines="5" />
            </DockPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Label Content="WinTRM DB Location" Width="130"/>
            <TextBox Name="txtTrmDB" Margin="5,5,0,5" Width="Auto" HorizontalAlignment="Stretch"/>
            <Button Name="cmdTrmDB" Content="Change" Margin="5,5,0,5" FontWeight="Bold"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <Label Content="WinPM DB Location" Width="130"/>
            <TextBox Name="txtPmDB" Margin="5,5,0,5" Width="Auto" HorizontalAlignment="Stretch"/>
            <Button Name="cmdPmDB" Content="Change" Margin="5,5,0,5" FontWeight="Bold"/>
        </StackPanel>
        <CheckBox Grid.Row="4" Name="chkAutoEmail" Content="Auto Issue Emails?" Margin="10"  />
        <StackPanel Grid.Row="5" Orientation="Horizontal">
                <Button Name="cmdSave" Content="SAVE" Margin="10" HorizontalAlignment="Left"/>
                <Button Name="cmdCancel" Content="CANCEL" Margin="10" HorizontalAlignment="Left"/>
            </StackPanel>
    </Grid>
</Window>
