<Window x:Class="frmSchedules"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:WinTRM"
    Title="frmSchedules" Height="300" Width="663">
    <Grid>
        <DataGrid AutoGenerateColumns="False" HorizontalAlignment="Stretch" Margin="2,1,0,38" Name="grdSchedules" VerticalAlignment="Stretch" Width="639" DataContext="{Binding}" ItemsSource="{Binding}" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}"/>
                <DataGridTextColumn Header="Account" Binding="{Binding Account}"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="HowOften" Binding="{Binding HowOften}"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button Content="ADD" Height="27" Margin="104,0,0,5" Name="cmdAdd" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="94" />
        <Button Content="DELETE" Height="27" HorizontalAlignment="Left" Margin="196,0,0,5" Name="cmdDelete" VerticalAlignment="Bottom" Width="94" />
        <Button Content="EDIT" Height="27" HorizontalAlignment="Left" Margin="12,0,0,5" Name="cmdEdit" VerticalAlignment="Bottom" Width="94" />
        <Button Content="CANCEL" Height="27" HorizontalAlignment="Left" Margin="288,0,0,5" Name="cmdCancel" VerticalAlignment="Bottom" Width="94" />
    </Grid>
</Window>
