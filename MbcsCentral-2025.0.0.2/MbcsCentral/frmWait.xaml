
<Window Name="FormfrmWait"
    x:Class="MbcsCentral.frmWait"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    WindowStyle="None"
    Height="40"
    Width="220"
    Background="Transparent"
    Closed="frmWait_Closed"
    FontSize="32"
    FontWeight="Bold"
    Loaded="frmWait_Loaded"
    TextBlock.TextAlignment="Center">
    <Border
        Height="35"
        Width="200"
        Background="AliceBlue"
        BorderBrush="Blue"
        BorderThickness="3"
        CornerRadius="5">
        <TextBox Name="txtWait" Text="Please wait..."  VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </Border>
</Window>
