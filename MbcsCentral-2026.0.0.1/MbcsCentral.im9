	actions {
		sub _EntryHandler: Comment="Handles installer startup and selection of session type" {
			gosub DoInits: Flags=0x0, Platforms=0x73FFFFC0, Target=_InitSession, JumpType=0;
			action CheckAccessRights: Flags=0x0, Platforms=0x73FFFFC0;
			action RedirectFolders: Flags=0x0, Platforms=0x73FFFFC0;
			gosub GotoFirstInstall: Flags=0x0, Platforms=0x73FFFFC0, Condition="NOT Installed", Target=DoFirstInstall, JumpType=1;
			rundlg SelectRunMode: Flags=0x1000, Platforms=0x73FFFFC0, Condition="TsuRunMode = 0", TargetPath="\\RunModeDlg";
			gosub GotoChangeInstall: Flags=0x0, Platforms=0x73FFFFC0, Condition="TsuRunMode = 1", Target=DoChangeInstall, JumpType=1;
			gosub GotoUninstall: Flags=0x0, Platforms=0x73FFFFC0, Condition="TsuRunMode = 2", Target=DoUninstall, JumpType=1;
			gosub GotoPostBootRegister: Flags=0x0, Platforms=0x73FFFFC0, Condition="TsuRunMode = 3", Target=DoPostBootRegister, JumpType=1;
			gosub GotoRepair: Flags=0x0, Platforms=0x73FFFFC0, Condition="TsuRunMode = 4", Target=DoRepair, JumpType=1;
			gosub GotoResume: Flags=0x0, Platforms=0x73FFFFC0, Condition="TsuRunMode = 5", Target=DoResume, JumpType=1;
			msgbox RunModeError: Flags=0x0, Platforms=0x73FFFFC0, Buttons=0, Icon=4, DefButton=0, Default=0, FailMode=0, TimeOut=300 {
				str Text: Flags=0x10000, PhraseID=Error.UnknownRunMode, Default="Unknown run mode - Installation cancelled" {
					xlat ID=1033 {"Unknown run mode - Installation cancelled"}
				}
			}
		}
		sub _ExitHandler: Comment="Performs final cleanup above and beyond normal session termination" {
			rundlg RunFailed: Flags=0x1000, Platforms=0x73FFFFC0, Condition="(TsuStatus < 2) AND (NOT TsuQuiet) AND (TsuRunMode <> 2)", TargetPath="\\FailedDlg";
		}
		sub _InitSession: Comment="Initializes session variables" {
			set Init1: Flags=0x0, Platforms=0x73FFFFC0, SymbolName=InstallDate {
				str Value: Default="<$sysval(26,0)>";
			}
			set Init2: Flags=0x0, Platforms=0x73FFFFC0, SymbolName=InstallTime {
				str Value: Default="<$sysval(26,4)>";
			}
			set Init3: Flags=0x0, Platforms=0x73FFFFC0, SymbolName=Date {
				str Value: Default="<$sysval(26,2)>";
			}
			set Init4: Flags=0x0, Platforms=0x73FFFFC0, SymbolName=Time {
				str Value: Default="<$sysval(26,6)>";
			}
			set SetVariable1: Flags=0x0, Platforms=0x7FFFFFFF, SymbolName=InstallSQLInstance {
				str Value: Default=0;
			}
		}
		sub DoChangeInstall: Comment="Top-level control of a Modify session" {
			action UpdateComponents: Flags=0x0, Platforms=0x73FFFFC0;
			gosub ChangeInstallUI: Flags=0x0, Platforms=0x73FFFFC0, Condition="NOT TsuQuiet", Target=UIChangeInstall, JumpType=1;
			rundlg ProgressPage: Flags=0x0, Platforms=0x73FFFFC0, Condition="TsuQuiet < 2", TargetPath="\\ProgressQuietDlg";
			gosub RunMainInstall: Flags=0x0, Platforms=0x73FFFFC0, Target=MainInstall, JumpType=0;
			enddlg CloseProgressPage: Flags=0x0, Platforms=0x73FFFFC0, Condition="TsuQuiet < 2", TargetPath="\\ProgressQuietDlg", Result=6;
		}
		sub DoFirstInstall: Comment="Top-level control of the initial installation session" {
			action InitComponents: Flags=0x0, Platforms=0x73FFFFC0;
			action UpdateComponents: Flags=0x0, Platforms=0x73FFFFC0;
			set SetMainInstallDir: Flags=0x80, Platforms=0x73FFFFC0, Condition="TsuAddOn AND MainInstallLocation", SymbolName=PRIMARYFOLDER {
				str Value: Default="<MainInstallLocation>";
			}
			set SetInstallDir: Flags=0x80, Platforms=0x73FFFFC0, Condition=InstallLocation, SymbolName=PRIMARYFOLDER {
				str Value: Default="<InstallLocation>";
			}
			gosub FirstInstallUI: Flags=0x0, Platforms=0x73FFFFC0, Condition="NOT TsuQuiet", Target=UIFirstInstall, JumpType=1;
			rundlg ProgressPage: Flags=0x0, Platforms=0x73FFFFC0, Condition="TsuQuiet < 2", TargetPath="\\ProgressQuietDlg";
			gosub RunMainInstall: Flags=0x0, Platforms=0x73FFFFC0, Target=MainInstall, JumpType=0;
			enddlg CloseProgressPage: Flags=0x0, Platforms=0x73FFFFC0, Condition="TsuQuiet < 2", TargetPath="\\ProgressQuietDlg", Result=6;
		}
		sub DoPostBootRegister: Comment="Top-level control of an automatic post-boot registration session" {
			action UpdateComponents: Flags=0x0, Platforms=0x73FFFFC0;
			rundlg ProgressPage: Flags=0x0, Platforms=0x73FFFFC0, Condition="TsuQuiet < 2", TargetPath="\\ProgressQuietDlg";
			gosub RunMainRegister: Flags=0x0, Platforms=0x73FFFFC0, Target=MainRegister, JumpType=0;
			enddlg CloseProgressPage: Flags=0x0, Platforms=0x73FFFFC0, Condition="TsuQuiet < 2", TargetPath="\\ProgressQuietDlg", Result=6;
		}
		sub DoRepair: Comment="Top-level control of a Repair session" {
			action UpdateComponents: Flags=0x0, Platforms=0x73FFFFC0;
			gosub RepairUI: Flags=0x0, Platforms=0x73FFFFC0, Condition="NOT TsuQuiet", Target=UIRepair, JumpType=1;
			rundlg ProgressPage: Flags=0x0, Platforms=0x73FFFFC0, Condition="TsuQuiet < 2", TargetPath="\\ProgressQuietDlg";
			gosub RunRepair: Flags=0x0, Platforms=0x73FFFFC0, Target=MainRepair, JumpType=0;
			enddlg CloseProgressPage: Flags=0x0, Platforms=0x73FFFFC0, Condition="TsuQuiet < 2", TargetPath="\\ProgressQuietDlg", Result=6;
		}
		sub DoResume: Comment="Top-level control of a session that was interrupted due to a system reboot" {
			action UpdateComponents: Flags=0x0, Platforms=0x73FFFFC0;
			gosub ResumeUI: Flags=0x0, Platforms=0x73FFFFC0, Condition="NOT TsuQuiet", Target=UIResume, JumpType=1;
			rundlg ProgressPage: Flags=0x0, Platforms=0x73FFFFC0, Condition="TsuQuiet < 2", TargetPath="\\ProgressQuietDlg";
			gosub RunMainInstall: Flags=0x0, Platforms=0x73FFFFC0, Target=MainInstall, JumpType=0;
			enddlg CloseProgressPage: Flags=0x0, Platforms=0x73FFFFC0, Condition="TsuQuiet < 2", TargetPath="\\ProgressQuietDlg", Result=6;
		}
		sub DoUninstall: Comment="Top-level control of an Uninstall session" {
			action UpdateComponents: Flags=0x0, Platforms=0x73FFFFC0;
			msgbox QueryUninstall: Flags=0x0, Platforms=0x73FFFFC0, Buttons=2, Icon=2, DefButton=1, Default=2, FailMode=0, TimeOut=300 {
