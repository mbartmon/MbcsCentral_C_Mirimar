<Window x:Class="MbcsCentral.ControlPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MBCS Central Control Panel" 
    Name="formControlPanel"
    Height="300" Width="640">
    
    <Grid>
        <TabControl Name="tabMain">
            <TabItem Name="tabGeneral" Header="General">
                
            </TabItem>
            <TabItem Name="tabApplications" Header="Applications">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="WinTRM DB Connection "  VerticalAlignment="Center" Margin="5,0,0,0"/>
                    <TextBox Grid.Row="0" Grid.Column="1" IsReadOnly="True" />
                    <Button Grid.Row="0" Grid.Column="2" Content="Change" />
                    
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="WinDoc DB Connection " VerticalAlignment="Center" Margin="5,0,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" IsReadOnly="True" />
                    <Button Grid.Row="1" Grid.Column="2" Content="Change" />
                
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="LeaseMaker DB Connection " VerticalAlignment="Center" Margin="5,0,0,0"/>
                    <TextBox Grid.Row="2" Grid.Column="1" IsReadOnly="True"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="Change"/>
                </Grid>
            </TabItem>
        </TabControl>    
    </Grid>
</Window>
