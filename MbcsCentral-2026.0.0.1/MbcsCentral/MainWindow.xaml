<Window x:Class="MbcsCentral.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xtc="http://schemas.xceed.com/wpf/xaml/toolkit"
        Name="formMainWindow"
        Title="MBCS Property Management Central"
        Width="300"
        Height="78"
        Background="AliceBlue"
        BorderBrush="Blue"
        BorderThickness="2"
        mc:Ignorable="d">

    <!--  Background="#FF00CEFF"  -->
    <Grid Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Border BorderBrush="Blue" BorderThickness="2">
            <TextBlock Name="TextTitle"
                       Grid.Row="0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Text="MBCSCENTRAL" />
        </Border>
        <ToolBar Name="ToolBar1"
                 Width="Auto"
                 Height="26"
                 Margin="0,20,0,0"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Top"
                 Visibility="Collapsed" />
        <DockPanel x:Name="mainDock"
                   Margin="5,0,0,0"
                   LastChildFill="False" />
        <xtc:BusyIndicator x:Name="_busy"
                           BusyContent="Please wait while we set-up your environment..."
                           IsBusy="False" />
        <Grid Name="subGrid" Grid.Row="1" />
    </Grid>

</Window>
