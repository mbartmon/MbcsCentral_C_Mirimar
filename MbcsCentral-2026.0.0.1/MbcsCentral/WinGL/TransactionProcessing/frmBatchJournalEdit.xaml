
<Window
    x:Class="MbcsCentral.WinGL.frmBatchJournalEdit"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Name="FormfrmBatchJournalEdit"
    Title="Batch Journal Entry Maintenance"
    Width="703.661"
    Height="300"
    Background="AliceBlue"
    Closed="frmBatchJournalEdit_Closed"
    FontSize="14"
    FontWeight="Bold"
    Loaded="frmBatchJournalEdit_Loaded"
    TextBlock.TextAlignment="Center">
    <Border
        BorderBrush="Blue"
        BorderThickness="3"
        CornerRadius="5">
        <Grid Name="MainGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <TextBox
                Background="LightSteelBlue"
                BorderBrush="Blue"
                BorderThickness="2"
                FontSize="14"
                FontWeight="Bold"
                Text="Batch Journal Entry Maintenance"
                TextAlignment="Center" />
            <Grid Grid.Row="1" TextBlock.FontSize="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="95" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>


                <StackPanel>
                    <StackPanel Margin="5" Orientation="Horizontal">
                        <TextBlock
                            Width="55"
                            VerticalAlignment="Center"
                            Text="Batch"
                            TextAlignment="Left" />
                        <ComboBox
                            Name="lstBatches"
                            Width="350"
                            Margin="5,0,0,0"
                            HorizontalContentAlignment="Left"
                            Background="White"
                            DisplayMemberPath="BatchName"
                            IsEditable="True"
                            ItemsSource="{Binding}"
                            SelectedValue="{Binding BatchName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedValuePath="BatchName"
                            SelectionChanged="lstBatches_SelectionChanged"
                            TextBlock.TextAlignment="Left"
                            TextBoxBase.TextChanged="lstBatches_TextChanged" />
                        <Button
                            Name="cmdDeleteBatch"
                            Margin="10,0,0,0"
                            Background="Coral"
                            Click="cmdDeleteBatch_Click"
                            Content="DELETE BATCH">
                            <Button.Style>
                                <Style>
                                    <Setter Property="Button.Effect">
                                        <Setter.Value>
                                            <DropShadowEffect
                                                Direction="320"
                                                Opacity="0.5"
                                                ShadowDepth="5"
                                                Color="Black" />
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button
                            Name="cmdAdd"
                            Margin="5,0,0,0"
                            Background="Coral"
                            Click="cmdAdd_Click"
                            Content="NEW BATCH">
                            <Button.Style>
                                <Style>
                                    <Setter Property="Button.Effect">
                                        <Setter.Value>
                                            <DropShadowEffect
                                                Direction="320"
                                                Opacity="0.5"
                                                ShadowDepth="5"
                                                Color="Black" />
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>

                        </Button>
                        <Button
                            Name="cmdClear"
                            Margin="5,0,0,0"
                            Background="Coral"
                            Click="cmdClear_Click"
                            Content="CLEAR FORM">
                            <Button.Style>
                                <Style>
                                    <Setter Property="Button.Effect">
                                        <Setter.Value>
                                            <DropShadowEffect
                                                Direction="320"
                                                Opacity="0.5"
                                                ShadowDepth="5"
                                                Color="Black" />
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>

                        </Button>
                    </StackPanel>
                    <StackPanel Name="pnlHeader" DataContext="{Binding}">
                        <StackPanel Margin="5,0,0,0" Orientation="Horizontal">
                            <TextBlock
                                Width="55"
                                VerticalAlignment="Center"
                                Text="Company"
                                TextAlignment="Left" />
                            <ComboBox
                                Name="lstCompanies"
                                Width="250"
                                Margin="5,0,0,0"
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding}"
                                SelectedValue="{Binding Company}"
                                SelectedValuePath="CompanyNumber"
                                SelectionChanged="lstCompanies_SelectionChanged" />
                        </StackPanel>
                        <StackPanel Margin="5" Orientation="Horizontal">
                            <TextBlock
                                Width="55"
                                VerticalAlignment="Center"
                                Text="Journal"
                                TextAlignment="Left" />
                            <ComboBox
                                Name="lstJournals"
                                Width="200"
                                Margin="5,0,0,0"
                                DisplayMemberPath="JournalName"
                                ItemsSource="{Binding}"
                                SelectedValue="{Binding Journal}"
                                SelectedValuePath="JournalName" />
                            <TextBlock
                                Margin="50,0,0,0"
                                VerticalAlignment="Center"
                                Text="Source" />
                            <TextBox
                                Name="txtSource"
                                Width="200"
                                Margin="5,0,0,0"
                                MaxLength="32"
                                Text="{Binding Source, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <Grid
                    Name="InputBox"
                    Grid.Column="0"
                    Grid.ColumnSpan="1"
                    Visibility="Collapsed">
                    <Grid Background="Black" Opacity="0.5" />
                    <Border
                        MinWidth="500"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="Orange"
                        BorderBrush="Black"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel>
                            <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                <TextBlock
                                    Name="InputTextLabel"
                                    Margin="2,0,0,0"
                                    FontWeight="Bold"
                                    Text="Name for new batch:" />
                                <TextBox
                                    Name="InputTextBox"
                                    Width="350"
                                    Margin="5,0,3,0"
                                    VerticalAlignment="Center"
                                    MaxLength="64"
                                    TextAlignment="Left" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <Button
                                    x:Name="YesButton"
                                    Margin="5"
                                    Background="{x:Null}"
                                    Click="YesButton_Click"
                                    Content="Create"
                                    IsDefault="True" />
                                <Button
                                    x:Name="NoButton"
                                    Margin="5"
                                    Background="{x:Null}"
                                    Click="NoButton_Click"
                                    Content="Cancel" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                <ScrollViewer Grid.Row="1">
                    <Grid
                        Name="grdTransactions"
                        Height="Auto"
                        DataContext="{Binding}"
                        ScrollViewer.CanContentScroll="True" />
                </ScrollViewer>
            </Grid>
            <StackPanel
                Grid.Row="2"
                Margin="0,5,0,5"
                Background="AliceBlue"
                Orientation="Horizontal">
                <Button
                    Name="cmdSave"
                    Margin="10,0,0,0"
                    Click="cmdSave_Click"
                    Content="SAVE" />
                <Button
                    Name="cmdClose"
                    Margin="10,0,0,0"
                    Click="cmdClose_Click"
                    Content="CLOSE" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
