<Window
    x:Class="MbcsCentral.WinGL.frmInvoice"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ex="clr-namespace:MbcsWpfControls;assembly=MbcsWpfControls"
    xmlns:my="clr-namespace:MbcsCentral"
    xmlns:my2="clr-namespace:VirtualKeyboard"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:tips="clr-namespace:Tips"
    xmlns:viblendEditors="clr-namespace:VIBlend.WPF.Controls;assembly=VIBlend.WPF.Editors"
    Name="FormInvoice"
    Title="Invoice Edit"
    Width="1053"
    Height="794.245"
    Closing="FrmInvoice_OnClosing"
    FontSize="12"
    Loaded="FrmInvoice_OnLoaded"
    TextBlock.TextAlignment="Center">
    <Window.Resources>
        <!--  SINGLE CLICK EDITING  -->
        <Style TargetType="{x:Type DataGridCell}">
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DataGridCell_PreviewMouseLeftButtonDown" />
        </Style>
        <CollectionViewSource x:Key="Vendors" />
        <CollectionViewSource x:Key="Companies" />
        <CollectionViewSource x:Key="Departments" />
        <CollectionViewSource x:Key="Accounts" />
        <CollectionViewSource x:Key="Journals" />
        <my:SetColor x:Key="SetColor" />
        <my:StringTruncate x:Key="Truncate" />
        <my:StringTrim x:Key="Trim"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
            <TabControl MinWidth="1055" >

                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="Border" BorderThickness="1,1,1,0" BorderBrush="Gainsboro" CornerRadius="4,4,0,0" Margin="2,0">
                                        <ContentPresenter x:Name="ContentSite"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        ContentSource="Header"
                                        Margin="10,2"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="LightSkyBlue" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="False">
                                            <Setter TargetName="Border" Property="Background" Value="Bisque" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <TabItem
                Name="TabInvoice"
                FontSize="16"
                FontWeight="Bold"
                GotFocus="TabInvoice_GotFocus"
                Header="Invoice">
                    <Border
                    Width="835"
                    Padding="2"
                    HorizontalAlignment="Center"
                    BorderBrush="Blue"
                    BorderThickness="3"
                    CornerRadius="5">
                        <Grid
                        Name="GridMain"
                        Background="Aqua"
                        DataContext="{Binding}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="375" />
                                <RowDefinition Height="135" />
                                <RowDefinition Height="95" />
                                <RowDefinition Height="92" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="525" />
                                    <ColumnDefinition Width="280" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Grid.ColumnSpan="2">
                                    <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                        <TextBlock
                                        Width="125"
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="Vendor"
                                        TextAlignment="Left" />
                                        <ComboBox
                                        Name="ListVendors"
                                        Width="367"
                                        Background="White"
                                        DisplayMemberPath="FullName"
                                        FontSize="15"
                                        IsEditable="True"
                                        IsTextSearchEnabled="True"
                                        ItemsSource="{Binding}"
                                        SelectedItem="{Binding Vendor, Mode=OneWay}"
                                        SelectedValue="{Binding Path=VendorNumber}"
                                        SelectedValuePath="VendorNumber"
                                        SelectionChanged="ListVendors_SelectionChanged"
                                        TextBlock.TextAlignment="Left" />
                                    </StackPanel>
                                    <StackPanel Margin="10,3,0,0" Orientation="Horizontal">
                                        <TextBlock
                                        Width="125"
                                        VerticalAlignment="Center"
                                        Text="Department"
                                        TextAlignment="Left" />
                                        <TextBox
                                        Name="txtDepartmentNumber"
                                        Width="50"
                                        IsEnabled="{Binding ElementName=chkUseDepartmentNumber, Path=IsChecked}"
                                        IsReadOnly="True"
                                        Text="{Binding ElementName=ListDepartments, Path=SelectedItem.DepartmentNumber, StringFormat={}{0:000}}" />
                                        <CheckBox
                                        Name="chkUseDepartmentNumber"
                                        VerticalAlignment="Center"
                                        Content="Use? From Dept Dropdown" />
                                        <CheckBox
                                        Name="chkHoldDepartment"
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        Content="Hold" />
                                    </StackPanel>
                                    <StackPanel Margin="10,1,0,0" Orientation="Horizontal">
                                        <TextBlock
                                        Width="125"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="Invoice Number"
                                        TextAlignment="Left" />
                                        <ComboBox
                                        Name="ListInvoiceNumbers"
                                        Width="345"
                                        Background="White"
                                        DisplayMemberPath="InvoiceNumber"
                                        IsEditable="True"
                                        ItemsSource="{Binding}"
                                        SelectedValue="{Binding Path=InvoiceNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="InvoiceNumber"
                                        Text="{Binding InvoiceNumber}"
                                        TextBlock.TextAlignment="Left" />
                                        <CheckBox
                                        Name="chkSaveInvoiceNumber"
                                        VerticalAlignment="Center"
                                        Content="Hold"
                                        ToolTip="{x:Static tips:StaticConstants.HoldTip}" />
                                    </StackPanel>
                                    <StackPanel Margin="10,0,0,0" Orientation="Horizontal">
                                        <TextBlock
                                        Width="125"
                                        VerticalAlignment="Center"
                                        Text="Suffix"
                                        TextAlignment="Left" />
                                        <TextBox
                                        Name="txtSuffix"
                                        Width="150"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding ElementName=chkUseSuffix, Path=IsChecked}"
                                        MaxLength="12"
                                        Text="{Binding Path=Suffix, Converter={StaticResource Trim}}"
                                        TextAlignment="Left" 
                                            my2:PopupKeyboard.Placement="Bottom"
                                                    my2:PopupKeyboard.PlacementTarget="{Binding ElementName=txtAmount}"
                                                    my2:PopupKeyboard.HorizontalOffset="20"
                                                    my2:PopupKeyboard.Height="220"
                                                    my2:PopupKeyboard.Width="200"
                                                    my2:PopupKeyboard.IsEnabled="False"/>
                                        <!--
                                    <ComboBox
                                    Name="lstTenants"
                                    Width="300"
                                    DisplayMemberPath="NumberName"
                                    IsEnabled="{Binding ElementName=chkUseTenant, Path=IsChecked}"
                                    ItemsSource="{Binding}"
                                        IsEditable="True"/>
                                    -->

                                        <CheckBox
                                        Name="chkUseSuffix"
                                        VerticalAlignment="Center"
                                        Content="Use?" />
                                        <CheckBox
                                        Name="chkSaveSuffix"
                                        Margin="3,0,0,0"
                                        VerticalAlignment="Center"
                                        Content="Hold"
                                        ToolTip="{x:Static tips:StaticConstants.HoldTip}" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                        Width="125"
                                        Margin="9,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="Final Invoice #"
                                        TextAlignment="Left" />
                                        <Border
                                        Width="400"
                                        Height="30"
                                        HorizontalAlignment="Left"
                                        BorderBrush="Black"
                                        BorderThickness="2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox
                                                Name="txtInvoicePrefix"
                                                VerticalAlignment="Center"
                                                Background="Aqua"
                                                BorderThickness="0,0,0,0"
                                                IsReadOnly="True"
                                                Text="{Binding ElementName=ListDepartments, Path=SelectedItem.DepartmentNumber, StringFormat='{}{0:000} '}">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ElementName=chkUseDepartmentNumber, Path=IsChecked}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                                <TextBox
                                                Name="txtInvoiceProper"
                                                VerticalAlignment="Center"
                                                Background="Aqua"
                                                BorderThickness="0,0,0,0"
                                                IsReadOnly="True"
                                                Text="{Binding ElementName=ListInvoiceNumbers, Path=Text}" />
                                                <TextBox
                                                Name="txtInvoiceSuffix"
                                                VerticalAlignment="Center"
                                                Background="Aqua"
                                                BorderThickness="0,0,0,0"
                                                IsReadOnly="True"
                                                Text="{Binding ElementName=txtSuffix, Path=Text}">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ElementName=chkUseSuffix, Path=IsChecked}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Margin="10,3,0,0" Orientation="Horizontal">
                                        <TextBlock
                                        Name="txtInvoiceDate"
                                        Width="125"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="Invoice Date"
                                        TextAlignment="Left" />
                                        <DatePicker
                                        Name="DateInvoice"
                                        SelectedDate="{Binding Date}"
                                        SelectedDateFormat="Short" />
                                        <StackPanel
                                        Name="pnlFrequency"
                                        Margin="10,0,0,0"
                                        Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center" Text="Frequency" />
                                            <ComboBox
                                            Name="ListFrequency"
                                            Width="118"
                                            Margin="10,0,0,0"
                                            Background="White"
                                            SelectedIndex="0">
                                                <ComboBoxItem>On-Demand</ComboBoxItem>
                                                <ComboBoxItem>Weekly</ComboBoxItem>
                                                <ComboBoxItem>Semi Monthly</ComboBoxItem>
                                                <ComboBoxItem>Monthly</ComboBoxItem>
                                                <ComboBoxItem>Bi-Monthly</ComboBoxItem>
                                                <ComboBoxItem>Quarterly</ComboBoxItem>
                                                <ComboBoxItem>Yearly</ComboBoxItem>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Margin="10,1,0,0" Orientation="Horizontal">
                                        <TextBlock
                                        Name="TextDue"
                                        Width="125"
                                        VerticalAlignment="Center"
                                        Text="Due Date"
                                        TextAlignment="Left" />
                                        <DatePicker
                                        Name="DateDue"
                                        IsEnabled="{Binding ElementName=CheckUseDue, Path=IsChecked}"
                                        SelectedDate="{Binding PayDueDate}"
                                        SelectedDateChanged="DateDue_SelectedDateChanged"
                                        SelectedDateFormat="Short" />
                                        <CheckBox
                                        Name="CheckUseDue"
                                        VerticalAlignment="Center"
                                        Checked="CheckUseDue_Checked"
                                        Content="Use"
                                        IsChecked="True" />
                                    </StackPanel>
                                    <StackPanel Margin="10,3,0,0" Orientation="Horizontal">
                                        <TextBlock
                                        Width="125"
                                        VerticalAlignment="Center"
                                        Text="Invoice Amount"
                                        TextAlignment="Left" />
                                        <my:NumberEntry
                                        x:Name="txtAmount"
                                        Width="100"
                                        Decimals="2"
                                        MaxLength="10"
                                        Text="{Binding Amount, StringFormat={}{0:#######.00}}"
                                        TextChanged="NumberEntry_TextChanged"
                                                    my2:PopupKeyboard.Placement="Bottom"
                                                    my2:PopupKeyboard.PlacementTarget="{Binding ElementName=txtAmount}"
                                                    my2:PopupKeyboard.HorizontalOffset="20"
                                                    my2:PopupKeyboard.Height="220"
                                                    my2:PopupKeyboard.Width="200"
                                            my2:PopupKeyboard.IsEnabled="False"/>

                                        <!--
                                        Name="txtAmount"
                                        Width="100"
                                        DecimalPlaces="2"
                                        MaxLength="10"
                                        Text="{Binding Amount, StringFormat={}{0:C}}" />
                                    -->
                                        <TextBlock
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="(FULL Amount due)" />
                                    </StackPanel>
                                    <StackPanel Margin="10,1,0,0" Orientation="Horizontal">
                                        <TextBlock
                                        Width="125"
                                        VerticalAlignment="Center"
                                        Text="Allowance"
                                        TextAlignment="Left" />
                                        <my:NumberEntry
                                        Width="100"
                                        Decimals="2"
                                        MaxLength="10"
                                        Text="{Binding Allowance, StringFormat={}{0:######0.00}}" />
                                        <!--
                                    <viblendEditors:NumberEditor
                                        Width="100"
                                        DecimalPlaces="2"
                                        MaxLength="10"
                                        Text="{Binding Allowance, StringFormat={}{0:C}}" />
                                    -->
                                        <TextBlock
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="(Amount NOT Subject to Discount)" />
                                    </StackPanel>
                                    <StackPanel Margin="10,1,0,0" Orientation="Horizontal">
                                        <TextBlock
                                        Width="125"
                                        VerticalAlignment="Center"
                                        Text="Discount"
                                        TextAlignment="Left" />
                                        <my:NumberEntry
                                        x:Name="txtDiscount"
                                        Width="100"
                                        Decimals="2"
                                        MaxLength="10"
                                        Text="{Binding Path=Discount, StringFormat={}{0:####0.00}}" />
                                        <!--
                                                                    <my:NumberEntry.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=PrePaid}" Value="True">
                                                    <Setter Property="Text" Value="{Binding Discount, StringFormat={}{0:F2}}"/>
                                                    <Setter Property="Foreground" Value="Red"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Path=PrePaid}" Value="False">
                                                    <Setter Property="Text"  Value="{Binding Discount, StringFormat={}{0:C}}"/>
                                                    <Setter Property="Foreground" Value="Blue" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </my:NumberEntry.Style>
                                    -->
                                        <!-- <TextBlock Text="(amount if pre-paid, % if not pre-paid)" VerticalAlignment="Center" Margin="5,0,0,0"/> -->
                                        <CheckBox
                                        Name="chkDiscAmount"
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        Content="Make a DOLLAR amount"
                                        IsChecked="{Binding Path=DiscountDollar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <CheckBox Name="chkDiscHold" VerticalAlignment="Center" Content="Hold" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Margin="10,1,0,0" Orientation="Horizontal">
                                        <TextBlock
                                        Width="125"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="Company"
                                        TextAlignment="Left" />
                                        <ComboBox
                                        Name="ListCompanies"
                                        Width="400"
                                        VerticalAlignment="Center"
                                        Background="White"
                                        DisplayMemberPath="Name"
                                        IsEditable="True"
                                        IsTextSearchEnabled="True"
                                        ItemsSource="{Binding}"
                                        SelectionChanged="ListCompanies_OnSelectionChanged"
                                        TextBlock.TextAlignment="Left" />
                                    </StackPanel>
                                    <StackPanel Margin="10,1,0,0" Orientation="Horizontal">
                                        <TextBlock
                                        Width="125"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="Department"
                                        TextAlignment="Left" />
                                        <ComboBox
                                        Name="ListDepartments"
                                        Width="400"
                                        VerticalAlignment="Center"
                                        Background="White"
                                        DisplayMemberPath="Name"
                                        ItemsSource="{Binding}"
                                        SelectionChanged="ListDepartments_SelectionChanged" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                        Width="125"
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="Check Group"
                                        TextAlignment="Left" />
                                        <ComboBox
                                        Name="ListCheckGroup"
                                        Width="40"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="White"
                                        Text="{Binding CheckGroup}" />
                                        <Button
                                        Name="cmdScanDoc"
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Center"
                                        Background="Beige"
                                        BorderThickness="3"
                                        Click="cmdScanDoc_Click"
                                        Content="Scan Invoice" />
                                        <Button
                                        Name="cmdDisplayDoc"
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Center"
                                        Background="Beige"
                                        BorderThickness="3"
                                        Click="cmdDisplayDoc_Click"
                                        Content="Display Invoice" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <StackPanel
                                    Name="PnlPay"
                                    Height="150"
                                    Margin="23,0,10,0"
                                    VerticalAlignment="Top"
                                    Background="ForestGreen">
                                        <GroupBox
                                        Width="200"
                                        Margin="2"
                                        BorderBrush="Black"
                                        BorderThickness="2"
                                        Header="Pay Flag">
                                            <ComboBox
                                            Name="ListPayFlag"
                                            Background="White"
                                            SelectedIndex="0">
                                                <ComboBoxItem>0 - Do Not Pay</ComboBoxItem>
                                                <ComboBoxItem>1 - Pay</ComboBoxItem>
                                                <ComboBoxItem>2 - Pay, Force Disc</ComboBoxItem>
                                                <ComboBoxItem>3 - {Not Selected}</ComboBoxItem>
                                                <ComboBoxItem>4 - Pay</ComboBoxItem>
                                            </ComboBox>
                                        </GroupBox>
                                        <StackPanel>
                                            <StackPanel Margin="10,10,0,0" Orientation="Horizontal">
                                                <TextBlock
                                                Width="120"
                                                VerticalAlignment="Center"
                                                Text="Amount to Pay"
                                                TextAlignment="Left" />
                                                <viblendEditors:NumberEditor
                                                Width="100"
                                                Margin="10,0,0,0"
                                                BorderBrush="Black"
                                                BorderThickness="2"
                                                MaxLength="10"
                                                Text="{Binding AmountToPay, StringFormat={}{0:C}}" />
                                            </StackPanel>
                                            <StackPanel Margin="10,10,0,0" Orientation="Horizontal">
                                                <TextBlock
                                                Width="120"
                                                VerticalAlignment="Center"
                                                Text="Amount Paid"
                                                TextAlignment="Left" />
                                                <viblendEditors:NumberEditor
                                                Width="100"
                                                Margin="10,0,0,0"
                                                MaxLength="10"
                                                Text="{Binding AmountPaid, StringFormat={}{0:C}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBox
                                    Name="txtComment"
                                    Grid.Column="1"
                                    Height="130"
                                    Margin="35,10,10,0"
                                    Padding="2"
                                    Background="LightYellow"
                                    IsReadOnly="True"
                                    Text=""
                                    TextAlignment="Left"
                                    TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <GroupBox
                            Grid.Row="1"
                            Grid.Column="0"
                            Height="130"
                            Margin="2"
                            VerticalAlignment="Top"
                            BorderBrush="Gray"
                            BorderThickness="2"
                            Header="Memo Line">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox
                                        Name="CheckMemo"
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        Content="Use Memo"
                                        IsChecked="True"
                                        TextBlock.TextAlignment="Center" />
                                        <TextBox
                                        x:Name="TxtMemo"
                                        Width="560"
                                        Height="60"
                                        Margin="10,1,0,7"
                                        VerticalAlignment="Center"
                                        AcceptsReturn="True"
                                        IsEnabled="{Binding ElementName=CheckMemo, Path=IsChecked}"
                                        MaxLength="120"
                                        TextAlignment="Left"
                                        TextChanged="TxtMemo_TextChanged"
                                        TextWrapping="Wrap" 
                                        ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox
                                                Name="chkHoldMemo"
                                                Margin="5,0,0,0"
                                                Content="Hold"
                                                IsEnabled="{Binding ElementName=CheckMemo, Path=IsChecked}"
                                                ToolTip="{x:Static tips:StaticConstants.HoldTip}" />
                                                <CheckBox
                                                Name="chkKeepMemo"
                                                Margin="5,0,0,0"
                                                Content="Save"
                                                IsEnabled="{Binding ElementName=CheckMemo, Path=IsChecked}"
                                                ToolTip="{x:Static tips:StaticConstants.SaveTip}" />
                                            </StackPanel>
                                            <Button
                                            Name="cmdClearMemo"
                                            Width="65"
                                            Height="23"
                                            Margin="10,0,0,0"
                                            Click="cmdClearMemo_Click"
                                            Content="Clear" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="Memo List" />
                                        <ComboBox
                                        Name="lstMemos"
                                        Width="555"
                                        Margin="10,0,0,0"
                                        DisplayMemberPath="   Memo"
                                        IsEnabled="{Binding IsChecked, ElementName=CheckMemo}"
                                        ItemsSource="{Binding}"
                                        SelectionChanged="lstMemos_SelectionChanged" />
                                        <Button
                                        Name="cmdGoToMemos"
                                        Margin="5,0,0,0"
                                        Click="cmdGoToMemos_Click"
                                        Content="Edit Memos" />
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                            <StackPanel
                            Grid.Row="2"
                            Grid.Column="0"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                                <GroupBox
                                Margin="2"
                                BorderBrush="Gray"
                                BorderThickness="2"
                                Header="Distributions">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                            Width="65"
                                            VerticalAlignment="Center"
                                            Text="Account" />
                                            <ComboBox
                                            Name="ListAccounts"
                                            Width="350"
                                            Margin="5,0,0,0"
                                            Background="White"
                                            DisplayMemberPath="Description"
                                            IsEditable="True"
                                            IsTextSearchEnabled="True"
                                            ItemsSource="{Binding}"
                                            SelectionChanged="ListAccounts_SelectionChanged"
                                            TextBlock.TextAlignment="Left" />
                                            <CheckBox
                                            Name="CheckSplit"
                                            Margin="5,0,3,0"
                                            VerticalAlignment="Center"
                                            Content="Split"
                                            IsEnabled="False" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                            Width="65"
                                            VerticalAlignment="Center"
                                            Text="Journal" />
                                            <ComboBox
                                            Name="ListJournals"
                                            Width="350"
                                            Margin="5,0,0,0"
                                            Background="White"
                                            DisplayMemberPath="JournalName"
                                            ItemsSource="{Binding}"
                                            TextBlock.TextAlignment="Left" />
                                            <Button
                                            Name="CmdShowSplits"
                                            Margin="5,0,5,0"
                                            Click="CmdShowSplits_OnClick"
                                            Content="Show Splits" />
                                        </StackPanel>
                                    </StackPanel>

                                </GroupBox>
                            </StackPanel>
                            <StackPanel
                            Grid.Row="3"
                            Grid.Column="0"
                            Orientation="Horizontal">
                                <GroupBox
                                Width="444"
                                Height="85"
                                Margin="2,2,2,0"
                                VerticalAlignment="Top"
                                BorderBrush="Gray"
                                BorderThickness="2"
                                Header="Pre-Paid Check Data">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel
                                            Grid.Column="0"
                                            Margin="10,10,0,0"
                                            Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" Text="Number:" />
                                                <my:NumberEntry
                                                Width="90"
                                                Height="29"
                                                Margin="5,0,0,0"
                                                VerticalAlignment="Bottom"
                                                Decimals="0"
                                                MaxLength="6"
                                                Text="{Binding CheckNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:#####0}}"
                                                TextChanged="NumberEntry_TextChanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="1">
                                                <CheckBox
                                                Name="chkEFT"
                                                Margin="55,0,5,0"
                                                Content="EFT"
                                                IsChecked="{Binding EFT, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Margin="10,5,0,0" Text="Date:" />
                                                    <ex:DatePickerEx
                                                    Margin="3,0,0,0"
                                                    SelectedDate="{Binding CheckDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    SelectedDateChanged="DatePickerEx_SelectedDateChanged" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>
                                <StackPanel Margin="155,0,0,0" VerticalAlignment="Top">
                                    <CheckBox
                                    Name="CheckScan"
                                    Margin="10,12,0,0"
                                    VerticalAlignment="Top"
                                    Content="Scan Invoice"
                                    IsChecked="True" />
                                    <StackPanel Margin="10,10,0,0" Orientation="Horizontal">
                                        <Button
                                        Name="cmdNew"
                                        Width="50"
                                        Click="cmdNew_Click"
                                        Content="NEW" />
                                        <Button
                                        Name="cmdSave"
                                        Width="50"
                                        Margin="2,0,0,0"
                                        Click="cmdSave_Click"
                                        Content="SAVE" />
                                        <Button
                                        Name="cmdExit"
                                        Width="50"
                                        Margin="2,0,0,0"
                                        Click="cmdExit_Click"
                                        Content="EXIT" />
                                    </StackPanel>
                                    <TextBlock IsEnabled="False" Background="Aqua" Name="txtDistTable" Margin="0,5,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </TabItem>
                <TabItem
                Name="TabDistributions"
                FontSize="16"
                FontWeight="Bold"
                GotFocus="TabDistributions_GotFocus"
                Header="Distributions"
                LostFocus="TabDistributions_LostFocus">

                    <Border
                    Padding="5"
                    BorderBrush="Blue"
                    BorderThickness="2"
                    CornerRadius="5">
                        <Grid
                        Name="GridDistribution"
                        Background="LightCyan"
                        DataContext="{Binding}"
                        ShowGridLines="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                                <RowDefinition />
                                <RowDefinition Height="25" />
                                <RowDefinition Height="35" />
                            </Grid.RowDefinitions>
                            <StackPanel
                            Grid.Row="0"
                            Margin="20,0,0,0"
                            Orientation="Horizontal">
                                <TextBlock
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Text="Vendor" />
                                <Border
                                Margin="3"
                                VerticalAlignment="Center"
                                BorderBrush="Blue"
                                BorderThickness="1"
                                CornerRadius="3">
                                    <TextBlock
                                    Name="TextVendorName"
                                    Width="250"
                                    Margin="1"
                                    VerticalAlignment="Center"
                                    Background="White"
                                    Text="{Binding ElementName=ListVendors, Path=Text}"
                                    TextAlignment="Left" />
                                </Border>
                                <TextBlock
                                Width="120"
                                Margin="50,0,0,0"
                                VerticalAlignment="Center"
                                Text="Invoice Number" />
                                <Border
                                Margin="3"
                                VerticalAlignment="Center"
                                BorderBrush="Blue"
                                BorderThickness="1"
                                CornerRadius="3">
                                    <TextBlock
                                    Name="TextInvoiceNumber"
                                    Width="200"
                                    Margin="1"
                                    VerticalAlignment="Center"
                                    Background="White"
                                    Text="{Binding ElementName=ListInvoiceNumbers, Path=Text}"
                                    TextAlignment="Left" />
                                </Border>
                            </StackPanel>
                            <StackPanel
                            Grid.Row="1"
                            Margin="20,0,0,0"
                            Orientation="Horizontal">
                                <TextBlock
                                Width="50"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="Date"
                                TextAlignment="Left" />
                                <DatePicker
                                Name="DateInvoiceDate"
                                VerticalAlignment="Center"
                                IsEnabled="False"
                                SelectedDate="{Binding ElementName=DateInvoice, Path=SelectedDate}"
                                SelectedDateFormat="Short" />
                                <TextBlock
                                Width="110"
                                Margin="200,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="Amount"
                                TextAlignment="Left" />
                                <Border
                                Margin="3"
                                VerticalAlignment="Center"
                                BorderBrush="Blue"
                                BorderThickness="1"
                                CornerRadius="3">
                                    <TextBlock
                                    Name="AmountInvoice"
                                    Width="120"
                                    Margin="1"
                                    VerticalAlignment="Center"
                                    Background="White"
                                    Text="{Binding ElementName=txtAmount, Path=Text}"
                                    TextAlignment="Right" />
                                </Border>
                            </StackPanel>

                            <DataGrid
                            Name="GridDistributions"
                            Grid.Row="2"
                            AutoGenerateColumns="False"
                            CanUserAddRows="True"
                            CanUserDeleteRows="True"
                            GridLinesVisibility="All"
                            ItemsSource="{Binding}"
                            SelectionUnit="Cell"
                            PreparingCellForEdit="GridDistributions_PreparingCellForEdit"
                            RowEditEnding="GridDistributions_OnRowEditEnding">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem
                                        Name="CtxDelete"
                                        Click="CtxDelete_Click"
                                        Header="Delete/Un-Delete" />
                                        <MenuItem
                                        Name="CtxAdd"
                                        Click="CtxAdd_Click"
                                        Header="Add" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>

                                <DataGrid.Columns>
                                    <DataGridComboBoxColumn
                                    Width="250"
                                    DisplayMemberPath="Name"
                                    Header="Department"
                                    SelectedItemBinding="{Binding SelectedDepartment}"
                                    SelectedValueBinding="{Binding DepartmentName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    SelectedValuePath="Name">
                                        <DataGridComboBoxColumn.ElementStyle>
                                            <Style TargetType="{x:Type ComboBox}">
                                                <Setter Property="ItemsSource" Value="{Binding DepartmentList}" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="SelectedIndex" Value="0" />
                                                <Setter Property="Selector.IsSynchronizedWithCurrentItem" Value="False" />
                                            </Style>
                                        </DataGridComboBoxColumn.ElementStyle>
                                        <DataGridComboBoxColumn.EditingElementStyle>
                                            <Style TargetType="{x:Type ComboBox}">
                                                <Setter Property="Tag" Value="ListDepartmentsDist" />
                                                <Setter Property="ItemsSource" Value="{Binding DepartmentList}" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="SelectedIndex" Value="0" />
                                                <Setter Property="Selector.IsSynchronizedWithCurrentItem" Value="False" />
                                                <EventSetter Event="SelectionChanged" Handler="Selector_OnSelectionChanged" />
                                            </Style>
                                        </DataGridComboBoxColumn.EditingElementStyle>
                                    </DataGridComboBoxColumn>
                                    <DataGridComboBoxColumn
                                    Width="250"
                                    DisplayMemberPath="Description"
                                    Header="Account"
                                    SelectedValueBinding="{Binding Account, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedValuePath="Key">
                                        <DataGridComboBoxColumn.ElementStyle>
                                            <Style TargetType="{x:Type ComboBox}">
                                                <Setter Property="ItemsSource" Value="{Binding AccountList}" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="TextBlock.TextAlignment" Value="Left" />
                                                <Setter Property="Selector.IsSynchronizedWithCurrentItem" Value="False" />
                                            </Style>
                                        </DataGridComboBoxColumn.ElementStyle>
                                        <DataGridComboBoxColumn.EditingElementStyle>
                                            <Style TargetType="{x:Type ComboBox}">
                                                <Setter Property="Tag" Value="ListAccountsDist" />
                                                <Setter Property="ItemsSource" Value="{Binding AccountList}" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="TextBlock.TextAlignment" Value="Left" />
                                                <Setter Property="IsTextSearchEnabled" Value="True" />
                                                <Setter Property="IsEditable" Value="True" />
                                                <Setter Property="Selector.IsSynchronizedWithCurrentItem" Value="False" />
                                                <EventSetter Event="SelectionChanged" Handler="Selector_OnSelectionChanged" />
                                            </Style>
                                        </DataGridComboBoxColumn.EditingElementStyle>
                                    </DataGridComboBoxColumn>


                                    <DataGridTemplateColumn Width="100" Header="Amount">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <my:NumberEntry
                                                    x:Name="txtDistAmount"
                                                    Foreground="{Binding Path=Deleted, Converter={StaticResource SetColor}}"
                                                    Text="{Binding Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    TextAlignment="Right" 
                                                    Decimals="2"
                                                    MaxLength="10"
                                                    TextChanged="TextBoxBase_OnTextChanged"
                                                    my2:PopupKeyboard.Placement="Bottom"
                                                    my2:PopupKeyboard.PlacementTarget="{Binding ElementName=txtDistAmount}"
                                                    my2:PopupKeyboard.HorizontalOffset="20"
                                                    my2:PopupKeyboard.Height="220"
                                                    my2:PopupKeyboard.Width="200"
                                                    my2:PopupKeyboard.IsEnabled="False"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="200" Header="Journal">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                Foreground="{Binding Path=Deleted, Converter={StaticResource SetColor}}"
                                                Text="{Binding Journal}"
                                                TextAlignment="Left" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox
                                                Name="ListJournalsDist"
                                                DisplayMemberPath="JournalName"
                                                ItemsSource="{Binding JournalList}"
                                                SelectedValue="{Binding Journal}"
                                                SelectedValuePath="JournalName"
                                                SelectionChanged="Selector_OnSelectionChanged" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel
                            Grid.Row="3"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="LightSeaGreen"
                            Orientation="Horizontal">
                                <Border
                                Margin="0,0,0,0"
                                HorizontalAlignment="Center"
                                Background="White"
                                BorderBrush="Gray"
                                BorderThickness="1">
                                    <TextBlock Foreground="Red" Text="Rows in red have been deleted (and are not included in total) but can be undeleted prior to save." />
                                </Border>
                                <TextBlock
                                VerticalAlignment="Center"
                                FontSize="14"
                                Text="Total Distribution Amount" />
                                <Border
                                Margin="5,0,5,0"
                                Padding="1"
                                BorderBrush="Blue"
                                BorderThickness="1"
                                CornerRadius="3">
                                    <TextBlock
                                    Name="TextTotal"
                                    Width="110"
                                    Background="White"
                                    FontWeight="ExtraBold"
                                    TextAlignment="Right" />
                                </Border>
                            </StackPanel>
                            <Border
                            Grid.Row="4"
                            BorderBrush="Blue"
                            BorderThickness="2">
                                <StackPanel
                                HorizontalAlignment="Center"
                                Background="LightCyan"
                                Orientation="Horizontal">
                                    <Button
                                    Name="CmdDelete"
                                    Margin="10,5,5,5"
                                    Click="CmdDelete_Click"
                                    Content="DELETE" />
                                    <Button
                                    Name="CmdAdd"
                                    Margin="5"
                                    Click="CmdAdd_Click"
                                    Content="ADD" />
                                    <Button
                                    Name="CmdSave"
                                    Margin="5"
                                    Click="CmdSaveDist_Click"
                                    Content="SAVE" />
                                    <Button
                                    Name="CmdExit"
                                    Margin="5"
                                    Click="CmdExit_Click"
                                    Content="EXIT" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                </TabItem>
            </TabControl>
    </Grid>
</Window>
