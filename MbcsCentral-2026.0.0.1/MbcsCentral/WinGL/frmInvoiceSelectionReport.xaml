<Window x:Class="MbcsCentral.WinGL.frmInvoiceSelectionReport"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:MbcsCentral.WinGL"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:util="clr-namespace:CSharp;assembly=CSharp"
        Title="Invoice Payment Selection Report"
        Width="300"
        Height="152.113"
        Background="AliceBlue"
        TextBlock.FontSize="14"
        TextBlock.FontWeight="Bold"
        TextBlock.TextAlignment="Center"
        mc:Ignorable="d">
    <Border BorderBrush="Blue"
            BorderThickness="3"
            CornerRadius="5">
        <Grid>
            <StackPanel>
                <util:PrinterSelection Height="50" />
                <StackPanel Margin="20"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                    <Button Name="cmdDisplay"
                            VerticalAlignment="Center"
                            Click="cmdDisplay_Click"
                            Content="Display" />
                    <Button Name="cmdPrint"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"
                            Click="cmdPrint_Click"
                            Content="Print" />
                    <Button Name="cmdExit"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"
                            Click="cmdExit_Click"
                            Content="Exit" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
