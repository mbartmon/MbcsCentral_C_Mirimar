<Window x:Class="MbcsCentral.WinGL.frmMemos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xceed="clr-namespace:Xceed.Wpf.Toolkit;assembly=Xceed.Wpf.Toolkit"
        x:Name="formMemos"
        Title="Invoice Memos"
        Width="780"
        Height="356"
        Closed="formMemos_Closed"
        FontSize="14"
        FontWeight="Bold"
        Loaded="formMemos_Loaded"
        TextBlock.TextAlignment="Center">
    <Window.Resources>
        <!--  SINGLE CLICK EDITING  -->
        <Style TargetType="{x:Type DataGridCell}">
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DataGridCell_PreviewMouseLeftButtonDown" />
        </Style>

        <CollectionViewSource x:Key="departments" />
        <CollectionViewSource x:Key="companies" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition />
            <RowDefinition Height="35" />
        </Grid.RowDefinitions>
        <Border Height="35"
                Margin="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Linen"
                BorderBrush="Blue"
                BorderThickness="3"
                CornerRadius="5"
                Padding="4">
            <TextBlock Name="txtVendorName"
                       Width="Auto"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Background="Linen"
                       FontSize="20" />
        </Border>
        <Border Grid.Row="1"
                Margin="1"
                BorderBrush="Blue"
                BorderThickness="3"
                CornerRadius="5"
                Padding="2">
            <DataGrid x:Name="grdMemos"
                      AutoGenerateColumns="False"
                      Background="Linen"
                      FontSize="12"
                      ItemsSource="{Binding}"
                      TextBlock.TextAlignment="Left">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Name="ctxDelete"
                                  Click="ctxDelete_Click"
                                  Header="Toggle Delete" />
                        <MenuItem Name="ctxAdd"
                                  Click="ctxAdd_Click"
                                  Header="Add Memo" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="25" Header="X">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="Red"
                                           TextAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Delete, UpdateSourceTrigger=PropertyChanged}" Value="True">
                                                    <Setter Property="Text" Value="*" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Delete, UpdateSourceTrigger=PropertyChanged}" Value="False">
                                                    <Setter Property="Text" Value=" " />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="190" Header="Company">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center" Text="{Binding CompanyName}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox x:Name="lstCompanies"
                                          Background="White"
                                          DisplayMemberPath="Name"
                                          IsSynchronizedWithCurrentItem="False"
                                          IsTextSearchEnabled="True"
                                          ItemsSource="{Binding Source={StaticResource companies}}"
                                          SelectedValue="{Binding Path=CompanyName}"
                                          SelectedValuePath="Name"
                                          SelectionChanged="List_SelectionChanged" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="190" Header="Department">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center" Text="{Binding DepartmentName}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox x:Name="lstDepartments"
                                          Background="White"
                                          DisplayMemberPath="Name"
                                          DropDownOpened="lstDepartments_DropDownOpened"
                                          IsSynchronizedWithCurrentItem="False"
                                          IsTextSearchEnabled="True"
                                          ItemsSource="{Binding Source={StaticResource departments}}"
                                          Loaded="lstDepartments_Loaded"
                                          SelectedValue="{Binding Path=DepartmentName}"
                                          SelectedValuePath="Name"
                                          SelectionChanged="List_SelectionChanged" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="55" Header="ChkGrp">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center" Text="{Binding CheckGroup}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <xceed:ShortUpDown Maximum="9"
                                                   Minimum="0"
                                                   Value="{Binding Path=CheckGroup,
                                                                   Mode=TwoWay,
                                                                   UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Batch"
                                        Binding="{Binding BatchNumber}"
                                        IsReadOnly="True"/>
                    <DataGridCheckBoxColumn Header="Keep" Binding="{Binding Keep}"/>
                    <DataGridTextColumn Width="Auto"
                                        Binding="{Binding Memo,
                                                          Mode=TwoWay,
                                                          UpdateSourceTrigger=PropertyChanged}"
                                        Header="Memo Line">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="AcceptsReturn" Value="True"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <StackPanel Grid.Row="2"
                    Margin="5,0,0,0"
                    Orientation="Horizontal">
            <TextBlock Margin="10"
                       VerticalAlignment="Center"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="Red"
                       Text="*" />
            <TextBlock Margin="-5,0,0,0"
                       VerticalAlignment="Center"
                       Text="=Delete Memo Line" />
            <Button Name="cmdSave"
                    Margin="20,0,0,0"
                    Click="cmdSave_Click"
                    Content="SAVE" />
            <Button Name="cmdExit"
                    Margin="10,0,0,0"
                    Click="cmdExit_Click"
                    Content="EXIT" />
            <TextBlock Margin="20,0,0,0"
                       VerticalAlignment="Center"
                       Text="Use Context Menu to DELETE or ADD a Memo Line" />
        </StackPanel>
    </Grid>
</Window>
