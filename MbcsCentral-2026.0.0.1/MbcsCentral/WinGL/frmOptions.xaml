
<Window x:Class="MbcsCentral.WinGL.frmOptions"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Name="FormfrmOptions"
        Title="G/L-A/P Options"
        Width="440.273"
        Height="309.054"
        Background="AliceBlue"
        Closed="frmOptions_Closed"
        FontSize="14"
        FontWeight="Bold"
        Loaded="frmOptions_Loaded"
        TextBlock.TextAlignment="Center">
    <Border BorderBrush="Blue"
            BorderThickness="3"
            CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <TextBox Background="LightSteelBlue"
                     BorderBrush="Blue"
                     BorderThickness="2"
                     FontSize="14"
                     FontWeight="Bold"
                     Text="G/L-A/P Options"
                     TextAlignment="Center" />
            <Grid Name="grdOptions"
                  Grid.Row="1"
                  DataContext="{Binding}">
                <TabControl Width="Auto"
                            Height="Auto"
                            FontSize="12"
                            Background="AliceBlue">
                    
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="Border" BorderThickness="1,1,1,0" BorderBrush="Gainsboro" CornerRadius="4,4,0,0" Margin="2,0">
                                        <ContentPresenter x:Name="ContentSite"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        ContentSource="Header"
                                        Margin="10,2"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="LightSkyBlue" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="False">
                                            <Setter TargetName="Border" Property="Background" Value="Bisque" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>
  
                    <TabItem Header="Posting">
                        <StackPanel Margin="5">
                            <GroupBox FontSize="11" Header="G/L Cash Account Posting Method" BorderThickness="2">
                                <StackPanel>
                                    <RadioButton Name="optInvoice"
                                                 Margin="0,1,0,0"
                                                 Checked="optInvoice_Checked"
                                                 Content="By Invoice"
                                                 GroupName="PostingOption" />
                                    <RadioButton Name="optBatch"
                                                 Margin="0,1,0,0"
                                                 Checked="optBatch_Checked"
                                                 Content="By Batch (One entry per Company/Department)"
                                                 GroupName="PostingOption" />
                                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                        <TextBlock HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   Text="Batch Description" />
                                        <TextBox Width="200"
                                                 Margin="5,0,0,0"
                                                 IsEnabled="{Binding ElementName=optBatch,
                                                                     Path=IsChecked}"
                                                 MaxLength="60"
                                                 Text="{Binding GLBatchDesc,
                                                                Mode=TwoWay,
                                                                UpdateSourceTrigger=PropertyChanged}"
                                                 TextAlignment="Left" />
                                </StackPanel>
                              </StackPanel>
                            </GroupBox>
                            <CheckBox Name="chkCompliance" 
                                      Content="Use Strict Accounting Compliance" 
                                      IsChecked="{Binding Path=Strict, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      FlowDirection="RightToLeft" 
                                      HorizontalAlignment="Left" 
                                      Margin="0,5,0,0"/>
                            <CheckBox Name="chkEftPost"
                                      Content="Post EFTs Immediately"
                                      IsChecked="{Binding Path=ImmediateEftPost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      FlowDirection="RightToLeft"
                                      HorizontalAlignment="Left"
                                      Margin="0,5,0,0"/>
                            <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="Cash Account" />
                                <ComboBox Name="lstAccounts"
                                          Width="200"
                                          Margin="5,5,0,0"
                                          VerticalAlignment="Center"
                                          DisplayMemberPath="Description"
                                          ItemsSource="{Binding}"
                                          SelectedValue="{Binding Path=GLCashAccount}"
                                          SelectedValuePath="Key" />
                            </StackPanel>
                            <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Bottom" Text="Receivables Journal" />
                                <ComboBox Name="lstJournals"
                                          Width="175"
                                          Margin="5,0,0,0"
                                          DisplayMemberPath="JournalName"
                                          ItemsSource="{Binding}"
                                          SelectedValue="{Binding Path=GLARJournal}"
                                          SelectedValuePath="JournalName" />
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Trans Edit List">
                        <StackPanel Margin="5">
                            <TextBlock HorizontalAlignment="Left" Text="Sort Report by the following" />
                            <Grid Margin="5" TextBlock.FontWeight="Normal">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           HorizontalAlignment="Left"
                                           Text="First by" />
                                <ComboBox Name="lstSorts1"
                                          Grid.Row="0"
                                          Grid.Column="1"
                                          Width="100"
                                          DisplayMemberPath="Name"
                                          ItemsSource="{Binding}"
                                          SelectedValue="{Binding Path=EdListSort1_fld}"
                                          SelectedValuePath="Name" />
                                <GroupBox Grid.Row="0"
                                          Grid.Column="2"
                                          VerticalAlignment="Bottom">
                                    <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal">
                                        <RadioButton Name="optAsc1"
                                                     Content="Asc"
                                                     GroupName="sort1"
                                                     IsChecked="True" />
                                        <RadioButton Name="optDes1"
                                                     Content="Des"
                                                     GroupName="sort1" />
                                    </StackPanel>
                                </GroupBox>
                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           HorizontalAlignment="Left"
                                           Text="Then by" />
                                <ComboBox Name="lstSorts2"
                                          Grid.Row="1"
                                          Grid.Column="1"
                                          Width="100"
                                          DisplayMemberPath="Name"
                                          ItemsSource="{Binding}"
                                          SelectedValue="{Binding Path=EdListSort2_fld}"
                                          SelectedValuePath="Name" />
                                <GroupBox Grid.Row="1"
                                          Grid.Column="2"
                                          VerticalAlignment="Bottom">
                                    <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal">
                                        <RadioButton Name="optAsc2"
                                                     Content="Asc"
                                                     GroupName="sort2"
                                                     IsChecked="True" />
                                        <RadioButton Name="optDes2"
                                                     Content="Des"
                                                     GroupName="sort2" />
                                    </StackPanel>
                                </GroupBox>
                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           HorizontalAlignment="Left"
                                           Text="Then by" />
                                <ComboBox Name="lstSorts3"
                                          Grid.Row="2"
                                          Grid.Column="1"
                                          Width="100"
                                          DisplayMemberPath="Name"
                                          ItemsSource="{Binding}"
                                          SelectedValue="{Binding Path=EdListSort3_fld}"
                                          SelectedValuePath="Name" />
                                <GroupBox Grid.Row="2"
                                          Grid.Column="2"
                                          VerticalAlignment="Bottom">
                                    <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal">
                                        <RadioButton Name="optAsc3"
                                                     Content="Asc"
                                                     GroupName="sort3"
                                                     IsChecked="True" />
                                        <RadioButton Name="optDes3"
                                                     Content="Des"
                                                     GroupName="sort3" />
                                    </StackPanel>
                                </GroupBox>
                                <TextBlock Grid.Row="3"
                                           Grid.Column="0"
                                           HorizontalAlignment="Left"
                                           Text="Then by" />
                                <ComboBox Name="lstSorts4"
                                          Grid.Row="3"
                                          Grid.Column="1"
                                          Width="100"
                                          DisplayMemberPath="Name"
                                          ItemsSource="{Binding}"
                                          SelectedValue="{Binding Path=EdListSort4_fld}"
                                          SelectedValuePath="Name" />
                                <GroupBox Grid.Row="3"
                                          Grid.Column="2"
                                          VerticalAlignment="Bottom">
                                    <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal">
                                        <RadioButton Name="optAsc4"
                                                     Content="Asc"
                                                     GroupName="sort4"
                                                     IsChecked="True" />
                                        <RadioButton Name="optDes4"
                                                     Content="Des"
                                                     GroupName="sort4" />
                                    </StackPanel>
                                </GroupBox>
                                <TextBlock Grid.Row="4"
                                           Grid.Column="0"
                                           HorizontalAlignment="Left"
                                           Text="Then by" />
                                <ComboBox Name="lstSorts5"
                                          Grid.Row="4"
                                          Grid.Column="1"
                                          Width="100"
                                          DisplayMemberPath="Name"
                                          ItemsSource="{Binding}"
                                          SelectedValue="{Binding Path=EdListSort5_fld}"
                                          SelectedValuePath="Name" />
                                <GroupBox Grid.Row="4"
                                          Grid.Column="2"
                                          VerticalAlignment="Bottom">
                                    <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal">
                                        <RadioButton Name="optAsc5"
                                                     Content="Asc"
                                                     GroupName="sort5"
                                                     IsChecked="True" />
                                        <RadioButton Name="optDes5"
                                                     Content="Des"
                                                     GroupName="sort5" />
                                    </StackPanel>
                                </GroupBox>
                                <TextBlock Grid.Row="5"
                                           Grid.Column="0"
                                           HorizontalAlignment="Left"
                                           Text="Then by" />
                                <ComboBox Name="lstSorts6"
                                          Grid.Row="5"
                                          Grid.Column="1"
                                          Width="100"
                                          DisplayMemberPath="Name"
                                          ItemsSource="{Binding}"
                                          SelectedValue="{Binding Path=EdListSort6_fld}"
                                          SelectedValuePath="Name" />
                                <GroupBox Grid.Row="5"
                                          Grid.Column="2"
                                          VerticalAlignment="Bottom">
                                    <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal">
                                        <RadioButton Name="optAsc6"
                                                     Content="Asc"
                                                     GroupName="sort6"
                                                     IsChecked="True" />
                                        <RadioButton Name="optDes6"
                                                     Content="Des"
                                                     GroupName="sort6" />
                                    </StackPanel>
                                </GroupBox>
                            </Grid>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Batch Invoices">
                        <CheckBox Margin="10"
                                  Content="Use Batch Invoicing"
                                  IsChecked="{Binding Path=BatchOn}" />
                    </TabItem>
                    <TabItem Header="Scanning">
                        <StackPanel Margin="5">
                            <CheckBox Name="CheckDocs"
                                      Margin="0,10,0,0"
                                      VerticalAlignment="Center"
                                      Content="Document Scanning Enabled"
                                      IsChecked="{Binding Scan,
                                                          Mode=TwoWay,
                                                          UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,20,0,0"
                                       HorizontalAlignment="Left"
                                       Text="Document Database Location:" />
                            <TextBlock Width="500"
                                       Margin="5,5,0,0"
                                       Background="White"
                                       Text="{Binding Path=WindocLocation,
                                                      Mode=TwoWay,
                                                      UpdateSourceTrigger=PropertyChanged}"
                                       TextAlignment="Left" />
                            <Button Name="CmdWindoc"
                                    Margin="5,5,0,0"
                                    Click="CmdWindoc_Click"
                                    Content="BROWSE" />
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Grid>
            <StackPanel Grid.Row="2"
                        Margin="0,5,0,5"
                        Background="AliceBlue"
                        Orientation="Horizontal">
                <Button Name="cmdSave"
                        Margin="10,0,0,0"
                        Click="cmdSave_Click"
                        Content="SAVE" />
                <Button Name="cmdClose"
                        Margin="10,0,0,0"
                        Click="cmdClose_Click"
                        Content="CLOSE" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
