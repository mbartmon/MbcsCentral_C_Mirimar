<Window x:Class="MbcsCentral.WinPM.frmMoveBuilding"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Move Building to Another Owner" Height="300" Width="471" Background="#FF00C0C0"
    Name="formMoveBuilding" FontWeight="Bold"
    Loaded="frmMoveBuilding_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="35"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Name="txtBuilding" Text="{Binding Address1, Mode=OneTime}" Background="LightGray" Margin="5" />
        <ListView Name="lstOwners" Grid.Column="1" Grid.Row="0" Grid.RowSpan="3" Margin="0,5,5,5" MouseDoubleClick="lstOwners_MouseDoubleClick"/>
        <TextBlock Text="Select new Owner for this Building >>>>" Grid.Column="0" Grid.Row="1" Margin="5,0,0,0"/>
        <StackPanel Grid.Column="0" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Button Name="cmdSave" Content="SAVE" Margin="0,20,0,0" Click="cmdSave_Click"/>
            <Button Name="cmdCancel" Content="CANCEL" Margin="0,20,0,0" Click="cmdCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
