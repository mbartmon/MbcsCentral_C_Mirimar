<Window x:Class="MbcsCentral.WinPM.frmPaymentDetails"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:local="clr-namespace:MbcsCentral.WinPM" 
        xmlns:my="clr-namespace:MbcsCentral"
        mc:Ignorable="d" Height="236" Width="240"
        x:Name="formPaymentDetails"
        Title="Payment Details for: "
        Loaded="formPaymentDetails_Loaded_1">
    <Window.Resources>
        <CollectionViewSource x:Key="paymentsViewSource" d:DesignSource="{d:DesignInstance {x:Type local:Payments}, CreateList=True}"/>
        <my:CurrencyPaddingConverter x:Key="CurrencyPadder"/>
    </Window.Resources>
    <Grid DataContext="{StaticResource paymentsViewSource}">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <DataGrid Grid.Row="0" x:Name="paymentsDataGrid" AutoGenerateColumns="False" EnableRowVirtualization="True" 
                  ItemsSource="{Binding}" RowDetailsVisibilityMode="VisibleWhenSelected" 
                  FontFamily="Courier New"
                  AlternatingRowBackground="LightGreen">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="amountColumn" Binding="{Binding Amount,
                                                                   Converter={StaticResource CurrencyPadder},
                                                                   ConverterParameter=10}" 
                                    Header="Amount" Width="80"/>
                <DataGridTextColumn Binding="{Binding DateofEntry, StringFormat={}{0:MM/dd/yyyy}}" Width="80" Header="Date"/>
<!--
                    <DataGridTemplateColumn x:Name="dateofEntryColumn" Header="Dateof Entry" Width="SizeToHeader">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DatePicker SelectedDate="{Binding DateofEntry, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
-->
                <DataGridTextColumn x:Name="securityCodeColumn" Binding="{Binding SecurityCode}" Header="Code" Width="80"/>
                <DataGridTextColumn x:Name="notesColumn" Binding="{Binding Notes}" Header="Notes" Width="400"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="1" Background="AliceBlue">
            <Button Name="cmdClose" Content="CLOSE" Margin="20,4,20,0" Click="cmdClose_Click_1"/>
        </StackPanel>
    </Grid>
</Window>
