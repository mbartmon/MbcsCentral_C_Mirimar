<Window x:Class="frmEndOn"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="End Schedule" Height="174" Width="300" xmlns:extToolkit="http://schemas.xceed.com/wpf/xaml/toolkit"  ResizeMode="NoResize">
    <Grid Margin="0" Height="137">
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="Black" Offset="0" />
                <GradientStop Color="#FFEAE3E3" Offset="1" />
                <GradientStop Color="#FF020202" Offset="0" />
                <GradientStop Color="#FFB2A8A8" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition Height="1.5*" />
        </Grid.RowDefinitions>
        <RadioButton Content="No end date" Height="16" HorizontalAlignment="Left" Margin="5" Name="optNoEndDate" VerticalAlignment="Center" IsChecked="True" FontWeight="Bold" />
        <RadioButton Content="End on" Height="16" HorizontalAlignment="Left" Margin="5" Name="optEndOn" VerticalAlignment="Center" Grid.Row="1" FontWeight="Bold" />
        <RadioButton Content="End after" Height="16" HorizontalAlignment="Left" Margin="5" Name="optEndAfter" VerticalAlignment="Center" Grid.Row="2" FontWeight="Bold" />
        <DatePicker Grid.Column="1" Grid.Row="1" Height="21" HorizontalAlignment="Left" Name="dtEndOn" VerticalAlignment="Center" Width="122" Margin="5" />
        <extToolkit:IntegerUpDown Grid.Column="1" Grid.Row="2" Height="25" HorizontalAlignment="Left" Margin="5" Name="lstEndAfter" VerticalAlignment="Center" Width="48" Minimum="1" Maximum="999" />
        <Label Content="times" Grid.Column="1" Grid.Row="2" Height="27" Margin="59,0,0,0" Name="Label1" VerticalAlignment="Center" />
        <Button Content="SAVE" Grid.Column="1" Grid.Row="3" Height="24" HorizontalAlignment="Left" Margin="4,11,0,0" Name="cmdSave" VerticalAlignment="Top" Width="49" />
        <Button Content="CANCEL" Height="24" HorizontalAlignment="Left" Margin="59,11,0,0" Name="cmdCancel" VerticalAlignment="Top" Width="49" Grid.Column="1" Grid.Row="3" />
    </Grid>
</Window>
