<Window x:Class="frmSchedule"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:extToolkit="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    xmlns:swf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
    Title="Add/Edit A Schedule" Height="332" Width="559" Name="frmSchedule" Background="White" xmlns:my="clr-namespace:WinTRM" ResizeMode="NoResize">
    <Grid Width="541" Background="#FFC6C6C6" Name="grid" Height="378">
        <Grid.RowDefinitions>
            <RowDefinition Height="36*" />
            <RowDefinition Height="59*" />
            <RowDefinition Height="28*" />
            <RowDefinition Height="103*" />
            <RowDefinition Height="29*" />
            <RowDefinition Height="123*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="151*" />
            <ColumnDefinition Width="292*" />
            <ColumnDefinition Width="24*" />
            <ColumnDefinition Width="74" />
        </Grid.ColumnDefinitions>
        <Label Content="Next Due Date" Height="30" HorizontalAlignment="Right" Margin="0,5,10,0" Name="Label1" VerticalAlignment="Center" Width="105" FontSize="14" FontStretch="Expanded" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Grid.Row="1" />
       <!-- <DatePicker Height="38" HorizontalAlignment="Left" Name="dtNextDue" VerticalAlignment="Center" Width="151" Margin="0,5,0,0" Grid.Row="1" Grid.Column="1" VerticalContentAlignment="Stretch" /> -->
        <xctk:DateTimePicker Height="38" FontSize="12" FontWeight="Bold" HorizontalAlignment="Stretch" Name="dtNextDue" VerticalAlignment="Center" Margin="0,5,0,0" Grid.Row="1" Grid.Column="1" VerticalContentAlignment="Stretch" />
        <Label Content="How Often" Grid.Row="2" Height="28" HorizontalAlignment="Right" Margin="0,5,10,0" Name="Label2" VerticalAlignment="Top" FontSize="14" HorizontalContentAlignment="Right" />
        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3">
            <ComboBox Height="23" HorizontalAlignment="Left" Margin="0,5,0,0" Name="lstHowOften" VerticalAlignment="Top" Width="151" Grid.Row="2" Grid.Column="1" />
            <CheckBox Name="chkWeekends" Content="Include Weekends" IsChecked="{Binding IncludeWeekends, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="5,0,0,0"/>
            <CheckBox Name="chkHoliday" Content="Include Holidays" IsChecked="{Binding IncludeHolidays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="5,0,0,0"/>
        </StackPanel>
        <Label Content="End On" Grid.Row="4" Height="26" HorizontalAlignment="Right" Margin="0,0,10,0" Name="Label3" VerticalAlignment="Top" Width="55" FontSize="14" HorizontalContentAlignment="Right" />
        <Label Content="Schedule Name" Height="28" HorizontalAlignment="Right" Margin="0,5,10,0" Name="Label4" VerticalAlignment="Top" HorizontalContentAlignment="Right" FontSize="14" />
        <TextBox Height="37" HorizontalAlignment="Stretch" Margin="0,1,0,0" Name="txtName" VerticalAlignment="Top" MinLines="2" TextWrapping="Wrap" BorderThickness="3" VerticalContentAlignment="Center" Grid.ColumnSpan="2" Grid.Column="1" />
        <Label Grid.Row="4" Height="30" HorizontalAlignment="Left" Name="lblEndOn" VerticalAlignment="Top" Width="151" Grid.Column="1" VerticalContentAlignment="Center" />
        <Button Content="Change" Height="23" HorizontalAlignment="Left" Margin="157,2,0,0" Name="cmdChange" VerticalAlignment="Top" Width="75" Grid.Column="1" Grid.Row="4" />
        <Button Content="SAVE" Height="23" HorizontalAlignment="Left" Name="cmdSave" VerticalAlignment="Top" Width="75" Grid.Row="5" Grid.Column="1" />
        <Button Content="CANCEL" Height="23" HorizontalAlignment="Left" Margin="76,0,0,0" Name="cmdCancel" VerticalAlignment="Top" Width="75" Grid.Column="1" Grid.Row="5" />
        <CheckBox Content="Active" Height="16" HorizontalAlignment="Left" Margin="5" Name="chkActive" VerticalAlignment="Center" Grid.Column="3" IsChecked="True" Padding="0" />
        <!-- <local:TimeSpinner Grid.Column="1" Grid.Row="1" Height="55" HorizontalAlignment="Left" Margin="159,4,0,0" x:Name="dtTime" VerticalAlignment="Top" Width="133" /> -->
    </Grid>
</Window>
