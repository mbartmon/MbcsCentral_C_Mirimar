<Window x:Class="frmSmtpDelivery"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Email Accounts Configuration" Height="519" Width="988" mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:my="clr-namespace:WinTRM" Background="{StaticResource {x:Static SystemColors.InactiveBorderBrushKey}}">
    <Window.Resources>
        <CollectionViewSource x:Key="SmtpConfigViewSource" d:DesignSource="{d:DesignInstance my:SmtpConfig, CreateList=True}" />
        <DataTemplate x:Key="SmtpAccountDataTemplate">
        	<Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
        		    <TextBox IsReadOnly="True" HorizontalAlignment="Stretch" Margin="10,0,0,0" Width="300" TextWrapping="Wrap" Text="{Binding Path=description, FallbackValue=description}" BorderThickness="0" />
				    <CheckBox IsEnabled="False" Name="chkDefault" Content="Default?" Margin="10,0,0,0" IsChecked="{Binding Path=defaultAccount, FallbackValue=defaultAccount}"  IsTabStop="False" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid Name="gridMain" DataContext="{StaticResource SmtpConfigViewSource}" Height="auto">
        <Grid.RowDefinitions>
            <RowDefinition Height="39" />
            <RowDefinition Height="*" />
            <RowDefinition Height="35"/>
            <RowDefinition Height="125"/>
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Border BorderBrush="{StaticResource {x:Static SystemColors.ControlTextBrushKey}}" BorderThickness="2"  Height="33" HorizontalAlignment="center"  Name="Border1" VerticalAlignment="Center" Width="248" CornerRadius="20" Background="{StaticResource {x:Static SystemColors.GradientActiveCaptionBrushKey}}">
            <TextBlock Name="TextBlock1" Text="Email Account Configurations"  FontSize="16" FontWeight="Bold" Width="Auto" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Label Content="Email Accounts" FontWeight="Bold"/>
            <ListBox Name="lstSmtpAccts" Width="400" HorizontalAlignment="Stretch" ItemsSource="{Binding}" SelectedValuePath="ID" ItemTemplate="{DynamicResource SmtpAccountDataTemplate}" /> 
        </StackPanel>
        <StackPanel Name="StackAddSmtp" Grid.Row="2" Orientation="Horizontal" Height="25" Visibility="Collapsed"  >
            <Label Content="New Email Account Description" FontWeight="Bold" Width="Auto" />
            <TextBox Name="NewSmtpAccount" Width="120" />
            <Button Name="cmdSaveNewSmtp" Content="SAVE" />
            <Button Name="cmdCancelNewSmtp" Content="CANCEL" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" >
            <Grid HorizontalAlignment="Left"  Name="Grid1" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Content="Description:" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Margin="3" VerticalAlignment="Center" FontWeight="Bold" />
                <TextBox Grid.Column="1" Height="23" HorizontalAlignment="Left" Margin="3,3,0,3" Name="DescriptionTextBox" Text="{Binding Path=description, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" VerticalAlignment="Center" Width="300" />
            </Grid>
            <Grid  HorizontalAlignment="Left" Name="Grid2" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label FontWeight="Bold" Content="Email Address:" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Margin="3" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Height="23" HorizontalAlignment="Left" Margin="3,3,0,3" Name="EmailAddressTextBox" Text="{Binding Path=emailAddress, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" VerticalAlignment="Center" Width="300" />
            </Grid>
            <Grid HorizontalAlignment="Left" Name="Grid10" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Content="Default Account:" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Margin="3" VerticalAlignment="Center" />
                <CheckBox Content="" Grid.Column="1" Grid.Row="0" Height="16" HorizontalAlignment="Left" IsChecked="{Binding Path=defaultAccount, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" Margin="3" Name="chkDefault" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border HorizontalAlignment="Center"  BorderBrush="Black" BorderThickness="1" CornerRadius="10" Width="81">
                <TextBlock Text="OUT-GOING" HorizontalAlignment="Center"/>
            </Border>
            <Border Grid.Column="1" HorizontalAlignment="Center"  BorderBrush="Black" BorderThickness="1" CornerRadius="10" Width="80">
                <TextBlock Text="IN-COMING" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Name="StackFields" Grid.Column="0" Grid.Row="1">
                <StackPanel Orientation="Horizontal" Width="Auto">
                    <Grid HorizontalAlignment="Left"  Name="Grid3" VerticalAlignment="Top" Width="279">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label FontWeight="Bold" Content="User Name:" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Margin="3" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Height="23" HorizontalAlignment="Left" Margin="3,3,0,3" Name="UserNameTextBox" Text="{Binding Path=userName, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" VerticalAlignment="Center" Width="190" />
                    </Grid>
                    <Grid HorizontalAlignment="Left"  Name="Grid4" VerticalAlignment="Top" Width="200">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label FontWeight="Bold" Content="Password:" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Margin="3" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Height="23" HorizontalAlignment="Left" Margin="3,3,0,3" Name="PasswordTextBox" Text="{Binding Path=password, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" VerticalAlignment="Center" Width="120" />
                    </Grid>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Grid  HorizontalAlignment="Left"  Name="Grid5" VerticalAlignment="Top" Width="348">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label FontWeight="Bold" Content="Server URL:" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Margin="3" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Height="23" HorizontalAlignment="Left" Margin="3,3,0,3" Name="ServerTextBox" Text="{Binding Path=server, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" VerticalAlignment="Center" Width="289" />
                    </Grid>
                    <Grid  HorizontalAlignment="Left"  Name="Grid6" VerticalAlignment="Top" Width="100">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label FontWeight="Bold" Content="Port:" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Margin="3" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Height="23" HorizontalAlignment="Left" Margin="3,3,0,3" Name="PortTextBox" Text="{Binding Path=port, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" VerticalAlignment="Center" Width="48" />
                    </Grid>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Grid HorizontalAlignment="Left" Name="Grid9" VerticalAlignment="Top" Width="300">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label Content="Authentication Method:" FontWeight="Bold" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Margin="3" VerticalAlignment="Center" />
                        <ComboBox DisplayMemberPath="DisplayItem" Grid.Column="1" Height="23" HorizontalAlignment="Left" Margin="3,3,0,3" Name="lstAuthentication" VerticalAlignment="Center" Width="140">
                        </ComboBox>
                    </Grid>
                    <Grid HorizontalAlignment="Left" Name="Grid7" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label FontWeight="Bold" Content="Use SSL:" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Margin="3" VerticalAlignment="Center" />
                        <CheckBox Content="" Grid.Column="1" Grid.Row="0" Height="16" HorizontalAlignment="Left" IsChecked="{Binding Path=SSL, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" Margin="3" Name="SSLCheckBox" VerticalAlignment="Center" />
                    </Grid>
                    <Grid HorizontalAlignment="Left"  Name="Grid8" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label FontWeight="Bold" Content="Use TSL:" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Margin="3" VerticalAlignment="Center" />
                        <CheckBox Content="" Grid.Column="1" Grid.Row="0" Height="16" HorizontalAlignment="Left" IsChecked="{Binding Path=TSL, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" Margin="3" Name="TSLCheckBox" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </StackPanel>
            <StackPanel Name="StackFields_in"  Grid.Column="1" Grid.Row="1">
                    <StackPanel Orientation="Horizontal">
                    <Grid HorizontalAlignment="Left"   VerticalAlignment="Top" Width="279">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label FontWeight="Bold" Content="User Name:" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Margin="3" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Height="23" HorizontalAlignment="Left" Margin="3,3,0,3" Name="UserNameInTextBox" Text="{Binding Path=in_userName, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" VerticalAlignment="Center" Width="190" />
                        </Grid>
                    <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Width="200">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label FontWeight="Bold" Content="Password:" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Margin="3" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Height="23" HorizontalAlignment="Left" Margin="3,3,0,3" Name="PasswordInTextBox" Text="{Binding Path=in_password, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" VerticalAlignment="Center" Width="120" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Grid  HorizontalAlignment="Left" VerticalAlignment="Top" Width="348">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label FontWeight="Bold" Content="Server URL:" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Margin="3" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Height="23" HorizontalAlignment="Left" Margin="3,3,0,3" Name="ServerInTextBox" Text="{Binding Path=in_server, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" VerticalAlignment="Center" Width="289" />
                        </Grid>
                        <Grid  HorizontalAlignment="Left" VerticalAlignment="Top" Width="100">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label FontWeight="Bold" Content="Port:" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Margin="3" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Height="23" HorizontalAlignment="Left" Margin="3,3,0,3" Name="PortInTextBox" Text="{Binding Path=in_port, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" VerticalAlignment="Center" Width="48" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                    <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Width="300">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="256" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Content="Authentication Method:" FontWeight="Bold" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Margin="3" VerticalAlignment="Center" />
                            <ComboBox DisplayMemberPath="DisplayItem" Grid.Column="1" Height="23" HorizontalAlignment="Left" Margin="3,3,0,3" Name="lstAuthenticationIn" VerticalAlignment="Center" Width="140">
                            </ComboBox>
                        </Grid>
                    <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label FontWeight="Bold" Content="Use SSL:" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Margin="3" VerticalAlignment="Center" />
                        <CheckBox Content="" Grid.Column="1" Grid.Row="0" Height="16" HorizontalAlignment="Left" IsChecked="{Binding Path=in_SSL, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" Margin="3" Name="SSLInCheckBox" VerticalAlignment="Center" />
                    </Grid>
                    <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label FontWeight="Bold" Content="Use TSL:" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Margin="3" VerticalAlignment="Center" />
                        <CheckBox Content="" Grid.Column="1" Grid.Row="0" Height="16" HorizontalAlignment="Left" IsChecked="{Binding Path=in_TSL, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" Margin="3" Name="TSLInCheckBox" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
                </StackPanel>
        </Grid>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Height="34" Name="StackPanel1" Width="Auto" HorizontalAlignment="Center">
            <Button Name="cmdSave" Content="SAVE" FontWeight="Bold" Margin="10,0,0,0" />
            <Button Name="cmdDelete" Content="DELETE" FontWeight="Bold" Margin="10,0,0,0"/>
            <Button Name="cmdTest" Content="TEST" FontWeight="Bold" Margin="10,0,0,0"/>
            <Button Name="cmdAdd" Content="ADD New EMAIL Account" FontWeight="Bold" Margin="10,0,0,0" />
            <Button Name="cmdExit" Content="EXIT" FontWeight="Bold" Margin="10,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
