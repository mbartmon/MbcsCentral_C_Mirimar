<Window x:Class="MbcsCentral.frmConfiguration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Loaded="Window_Loaded"
        Title="Configuration Parameters" Height="300" Width="731">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <DataGrid Name="grdParms" ItemsSource="{Binding}" AlternatingRowBackground="AliceBlue"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Button Name="cmdAdd" Content="ADD" Click="cmdAdd_Click" Margin="10,0,0,0"/>
            <Button Name="cmdSave" Content="SAVE" Click="cmdSave_Click" Margin="10,0,0,0"/>
            <Button Name="cmdExit" Content="EXIT" Click="cmdExit_Click" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
