<Window x:Class="MbcsCentral.frmDatabases"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Database Utilities"
        Width="633.271"
        Height="300"
        Background="AliceBlue"
        Closing="Window_Closing"
        Loaded="Window_Loaded"
        SizeToContent="Width"
        TextBlock.FontSize="14"
        TextBlock.FontWeight="Bold"
        TextBlock.TextAlignment="Center">
    <Grid Width="Auto"
          HorizontalAlignment="Left"
          TextBlock.FontSize="12"
          TextBlock.TextAlignment="Left">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="20" />
            <RowDefinition Height="35" />
        </Grid.RowDefinitions>
        <Border Grid.Column="0"
                Margin="10"
                BorderBrush="Blue"
                BorderThickness="2"
                CornerRadius="5">
            <StackPanel>
                <TextBlock Text="MACHINE NAMES" TextAlignment="Center" />
                <ListBox Name="lstMachines"
                         Background="White"
                         DisplayMemberPath="DisplayName"
                         ItemsSource="{Binding}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=Current}" Value="True">
                                    <Setter Property="ListBoxItem.Foreground" Value="Red" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Current}" Value="False">
                                    <Setter Property="ListBoxItem.Foreground" Value="Black" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </StackPanel>
        </Border>
        <Grid Name="InputBox"
              Grid.Column="0"
              Grid.ColumnSpan="3"
              Visibility="Collapsed">
            <Grid Background="Black" Opacity="0.5" />
            <Border MinWidth="250"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Orange"
                    BorderBrush="Black"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                        <TextBlock Name="InputTextLabel"
                                   Margin="2,0,0,0"
                                   FontWeight="Bold"
                                   Text="Enter an up to 8 character identifying tag." />
                        <TextBox Name="InputTextBox"
                                 Width="35"
                                 Margin="5,0,3,0"
                                 VerticalAlignment="Center"
                                 MaxLength="8"
                                 PreviewKeyDown="InputTextBox_PreviewKeyDown" />
                    </StackPanel>
                    <TextBlock Margin="0,-3,3,0"
                               HorizontalAlignment="Right"
                               Text="Only Letters and Numbers" />
                    <TextBlock VerticalAlignment="Center" Text="New Database Name:" />
                    <TextBlock Name="txtNewDatabaseName"
                               VerticalAlignment="Center"
                               Background="Bisque">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}_{1}_{2}">
                                <Binding Path="InitialCatalog" />
                                <Binding ElementName="InputTextBox" Path="Text" />
                                <Binding Path="CreateDate" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Button x:Name="YesButton"
                                Margin="5"
                                Background="{x:Null}"
                                Click="YesButton_Click"
                                Content="Create"
                                IsDefault="True" />
                        <Button x:Name="NoButton"
                                Margin="5"
                                Background="{x:Null}"
                                Click="NoButton_Click"
                                Content="Cancel" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Column="1"
                Margin="10"
                BorderBrush="Blue"
                BorderThickness="2"
                CornerRadius="5">
            <StackPanel>
                <TextBlock Text="SERVER NAMES" TextAlignment="Center" />
                <ListBox Name="lstServers"
                         Background="White"
                         DisplayMemberPath="DisplayName"
                         ItemsSource="{Binding}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=Current}" Value="True">
                                    <Setter Property="ListBoxItem.Foreground" Value="Red" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Current}" Value="False">
                                    <Setter Property="ListBoxItem.Foreground" Value="Black" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </StackPanel>
        </Border>
        <Border Grid.Column="2"
                Margin="10"
                BorderBrush="Blue"
                BorderThickness="2"
                CornerRadius="5">
            <StackPanel>
                <TextBlock Text="DATABASE NAMES" TextAlignment="Center" />
                <ListBox Name="lstDatabases"
                         Background="White"
                         DisplayMemberPath="DisplayName"
                         ItemsSource="{Binding}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=Current}" Value="True">
                                    <Setter Property="ListBoxItem.Foreground" Value="Red" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Current}" Value="False">
                                    <Setter Property="ListBoxItem.Foreground" Value="Black" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>

                </ListBox>
            </StackPanel>
        </Border>
        <StackPanel Grid.RowSpan="3"
                    Grid.Column="3"
                    Width="Auto"
                    Margin="0,5,0,0">
            <Border BorderBrush="Black"
                    BorderThickness="2"
                    CornerRadius="3">
                <CheckBox Name="chkPermanent" Width="220">
                    <CheckBox.Content>
                        <TextBlock Margin="0,0,5,0"
                                   FontStyle="Italic"
                                   Foreground="DarkBlue"
                                   TextWrapping="Wrap">
                            Checking this box will cause any changes made here to be applied to all users. Those changes will persist after you exit the program.
                            <LineBreak />
                            <LineBreak />
                            To use the changes for only yourself during the current session, leave the box un-checked.
                        </TextBlock>
                    </CheckBox.Content>
                </CheckBox>
            </Border>
            <StackPanel Margin="0,5,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                <Button Name="cmdSave"
                        Margin="5"
                        Click="cmdSave_Click"
                        Content="Save then Exit" />
                <Button Name="cmdExit"
                        Margin="5"
                        Click="cmdExit_Click"
                        Content="Exit Only" />
            </StackPanel>
            <Button Name="cmdCreate"
                    Margin="5"
                    Background="BurlyWood"
                    Click="cmdCreate_Click">
                <Button.Content>
                    <TextBlock>
                        Create NEW Database
                        <LineBreak />
                        from current Database.
                    </TextBlock>
                </Button.Content>
            </Button>
            <Button Name="cmdEdit"
                    Margin="20,0,20,0"
                    Background="BurlyWood"
                    Click="cmdEdit_Click"
                    Content="Edit Databases" />
        </StackPanel>
        <TextBlock Grid.Row="1"
                   Grid.ColumnSpan="3"
                   HorizontalAlignment="Center">
            <Span Foreground="Red">RED</Span>
            highlight indicates current selection
        </TextBlock>
        <Button Name="cmdChangeMachine"
                Grid.Row="2"
                Grid.Column="0"
                Margin="5"
                Click="cmdChangeMachine_Click"
                Content="Change Machine" />
        <Button Name="cmdChange"
                Grid.Row="2"
                Grid.Column="1"
                Margin="5"
                Click="cmdChange_Click"
                Content="Change Server" />
        <Button Name="cmdChangeDatabase"
                Grid.Row="2"
                Grid.Column="2"
                Margin="5"
                Click="cmdChangeDatabase_Click"
                Content="Change Database" />
    </Grid>
</Window>
