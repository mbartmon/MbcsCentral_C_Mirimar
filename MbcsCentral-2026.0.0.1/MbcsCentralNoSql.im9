	richtexts {
		rtf License1: {"{\\rtf1\\ansi\\ansicpg1252\\deff0\\nouicompat{\\fonttbl{\\f0\\fnil\\fcharset0 MS Shell Dlg;}}\r\n{\\*\\generator Riched20 6.3.9600}\\viewkind4\\uc1 \r\n\\pard\\f0\\fs17\\lang1033 LICENSE AGREEMENT\\par\r\n\\par\r\nTODO - Replace this text with your own license agreement to which the customer should agree prior to installation of your product.\\par\r\n\\par\r\nInstallMate will display this text prior to the installation process proper, and will cancel the process if the customer does not agree to its terms.\\par\r\n}\r\n"}
		rtf Readme1: {"{\\rtf1\\ansi\\ansicpg1252\\deff0\\nouicompat{\\fonttbl{\\f0\\fnil\\fcharset0 MS Shell Dlg;}}\r\n{\\*\\generator Riched20 6.3.9600}\\viewkind4\\uc1 \r\n\\pard\\f0\\fs17\\lang1033 README INFORMATION\\par\r\n\\par\r\nTODO - Replace this text with your own pre-installation information.\\par\r\n\\par\r\nInstallMate will display this text at the start of the installation process.\\par\r\n}\r\n"}
		rtf RichText1: {"{\\rtf1\\ansi\\ansicpg1252\\deff0\\nouicompat{\\fonttbl{\\f0\\fnil\\fcharset0 MS Shell Dlg;}}\r\n{\\colortbl ;\\red255\\green0\\blue0;\\red0\\green0\\blue0;}\r\n{\\*\\generator Riched20 6.3.9600}\\viewkind4\\uc1 \r\n\\pard\\qc\\cf1\\b\\f0\\fs28\\lang1033 SQL SERVER 2012 Installation\\fs24\\line\\cf0\\b0\\par\r\n\r\n\\pard\\cf2 A new instance of SQL Server 2012 named MBCSCENTRALSQL will now be created.  If SQL Server 2012 is not already on your system, it will be installed.\\cf0\\par\r\n}\r\n"}
		rtf SQLText2: {"{\\rtf1\\ansi\\deff0\\nouicompat{\\fonttbl{\\f0\\fnil\\fcharset0 MS Shell Dlg;}}\r\n{\\colortbl ;\\red255\\green0\\blue0;\\red0\\green0\\blue0;}\r\n{\\*\\generator Riched20 6.3.9600}\\viewkind4\\uc1 \r\n\\pard\\qc\\cf1\\b\\f0\\fs28\\lang1033 SQL SERVER 2012 Instance Installation\\line\\cf0\\b0\\fs24\\par\r\n\r\n\\pard\\cf2 An instance of SQL Server 2012 named MBCSCENTRALSQL was found.  Do you need to install the MbcsCentral Database?\\cf0\\par\r\n\r\n\\pard\\qc\\fs17\\par\r\n}\r\n"}
	}
