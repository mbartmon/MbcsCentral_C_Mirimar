<Window
    x:Class="MbcsCentral.frmDatabaseServers"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MbcsCentral"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Database Servers"
    Width="1030.07"
    Height="450"
    Background="AliceBlue"
    Closing="Window_Closing"
    Loaded="Window_Loaded"
    SizeToContent="Width"
    TextBlock.FontSize="14"
    TextBlock.FontWeight="Bold"
    TextBlock.TextAlignment="Center"
    mc:Ignorable="d">
    <Grid
        HorizontalAlignment="Stretch"
        TextBlock.FontSize="12"
        TextBlock.TextAlignment="Left">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="250" />
            <ColumnDefinition Width="250" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="20" />
            <RowDefinition Height="35" />
        </Grid.RowDefinitions>
        <Grid
            Name="InputBox"
            Grid.Column="0"
            Grid.ColumnSpan="1"
            Visibility="Collapsed">
            <Grid Background="Black" Opacity="0.5" />
            <Border
                MinWidth="300"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Orange"
                BorderBrush="Black"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                        <TextBlock
                            Name="InputTextLabel"
                            Margin="2,0,0,0"
                            FontWeight="Bold"
                            Text="Enter up to 8 character tag." />
                        <TextBox
                            Name="InputTextBox"
                            Width="50"
                            Margin="5,0,3,0"
                            VerticalAlignment="Center"
                            MaxLength="8"
                            PreviewKeyDown="InputTextBox_PreviewKeyDown" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,-3,3,0"
                        HorizontalAlignment="Right"
                        Text="Only Letters and Numbers" />
                    <TextBlock VerticalAlignment="Center" Text="New Database Name:" />
                    <TextBlock
                        Name="txtNewDatabaseName"
                        VerticalAlignment="Center"
                        Background="Bisque">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}_{1}_{2}">
                                <Binding Path="InitialCatalog" />
                                <Binding ElementName="InputTextBox" Path="Text" />
                                <Binding Path="CreateDate" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Button
                            x:Name="YesButton"
                            Margin="5"
                            Background="{x:Null}"
                            Click="YesButton_Click"
                            Content="Create"
                            IsDefault="True" />
                        <Button
                            x:Name="NoButton"
                            Margin="5"
                            Background="{x:Null}"
                            Click="NoButton_Click"
                            Content="Cancel" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <Border
            Name="bdrDatabases"
            Grid.Column="0"
            Grid.ColumnSpan="1"
            Margin="10"
            BorderBrush="Blue"
            BorderThickness="2"
            CornerRadius="5">
            <DockPanel LastChildFill="True">
                <Border BorderBrush="Blue" BorderThickness="2">
                    <StackPanel Width="300">
                        <TextBlock Text="DATABASE MACHINE NAMES" TextAlignment="Center" />
                        <TreeView
                            Name="lstDatabaseMachines"
                            Background="White"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding}">
                            <TreeView.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />
                            </TreeView.Resources>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="{x:Type TreeViewItem}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=Current}" Value="True">
                                            <Setter Property="TreeViewItem.Foreground" Value="Red" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Path=Current}" Value="False">
                                            <Setter Property="TreeViewItem.Foreground" Value="Black" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TreeView.ItemContainerStyle>

                        </TreeView>
                    </StackPanel>
                </Border>
                <Border BorderBrush="Blue" BorderThickness="2">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="DATABASE SERVER NAMES" TextAlignment="Center" />
                        <TreeView
                            Name="lstDatabaseServers"
                            Background="White"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding}">
                            <TreeView.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />
                            </TreeView.Resources>

                            <TreeView.ItemContainerStyle>
                                <Style TargetType="{x:Type TreeViewItem}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=Current}" Value="True">
                                            <Setter Property="TreeViewItem.Foreground" Value="Red" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Path=Current}" Value="False">
                                            <Setter Property="TreeViewItem.Foreground" Value="Black" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TreeView.ItemContainerStyle>

                        </TreeView>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>
        <StackPanel
            Grid.RowSpan="3"
            Grid.Column="1"
            Width="Auto"
            Margin="0,5,0,0">
            <Border
                BorderBrush="Black"
                BorderThickness="2"
                CornerRadius="3">
                <CheckBox
                    Name="chkPermanent"
                    Width="220"
                    Margin="0,2,0,2">
                    <CheckBox.Content>
                        <TextBlock
                            Margin="0,0,5,0"
                            FontStyle="Italic"
                            Foreground="DarkBlue"
                            TextWrapping="Wrap">
                            Checking this box will cause any changes made here to be applied to all users. Those changes will persist after you exit the program.<LineBreak />
                            <LineBreak />
                            To use the changes for only yourself during the current session, leave the box un-checked.</TextBlock>
                    </CheckBox.Content>
                </CheckBox>
            </Border>
            <StackPanel
                Margin="0,5,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Name="cmdSave"
                    Margin="5"
                    Click="cmdSave_Click"
                    Content="Save then Exit" />
                <Button
                    Name="cmdExit"
                    Margin="5"
                    Click="cmdExit_Click"
                    Content="Exit Only" />
            </StackPanel>
        </StackPanel>
        <TextBlock Grid.Row="1" HorizontalAlignment="Center">
            <Span Foreground="Red">RED</Span>
            highlight indicates current selection</TextBlock>
        <StackPanel
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Orientation="Horizontal">
            <Button
                Name="cmdChangeDatabaseMachine"
                Width="300"
                Margin="10,5,5,5"
                Click="CmdChangeDatabaseMachine_Click">
                <TextBlock>
                    Change Database<Span FontSize="14" FontStyle="Italic">MACHINE</Span>
                </TextBlock>
            </Button>
            <Button
                Name="cmdChangeDatabaseServer"
                Width="300"
                Margin="25,5,5,5"
                HorizontalAlignment="Left"
                Click="CmdChangeDatabaseServer_Click">
                <TextBlock>
                    Change Database<Span FontSize="14" FontStyle="Italic">SERVER</Span>
                </TextBlock>
            </Button>
            <Button
                Name="cmdTest"
                Margin="25,5,5,5"
                HorizontalAlignment="Left"
                Click="CmdTest_Click"
                Content="TEST CONNECTION" />

        </StackPanel>

    </Grid>
</Window>
