                                            <Setter Property="TextAlignment" Value="Left" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="200"
                                                    Binding="{Binding Path=Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Header="Name">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Left" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <!-- <DataGridTextColumn Binding="{Binding Path=Requirement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Requirement" /> -->
                                <DataGridComboBoxColumn Header="Requirement"
                                                        ItemsSource="{Binding Source={StaticResource NachaRequirements}}"
                                                        SelectedItemBinding="{Binding Requirement}" />
                                <DataGridComboBoxColumn Header="DataType"
                                                        ItemsSource="{Binding Source={my:EnumBindingSource {x:Type l:DataTypes}}}"
                                                        SelectedItemBinding="{Binding DataType}" />
                                <DataGridCheckBoxColumn Binding="{Binding Path=Delete, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="DELETE" />
                            </DataGrid.Columns>
                        </DataGrid>

                    </TabItem>
                    <TabItem Name="tabFileControl" Header="File Control">
                        <DataGrid Name="grdFileControl"
                                  AutoGenerateColumns="False"
                                  ItemsSource="{Binding}">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Delete}" Value="True">
                                            <Setter Property="Background" Value="Red" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Delete}" Value="False">
                                            <Setter Property="Background" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Name="ctxAddFileControl"
                                              Click="ctxAdd_Click"
                                              Header="ADD" />
                                    <MenuItem Name="ctxDeleteFileControl"
                                              Click="ctxDelete_Click"
                                              Header="DELETE" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Path=Field}"
                                                    Header="Field"
                                                    IsReadOnly="True" />
                                <DataGridTemplateColumn Header="Position">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Path=Position, StringFormat={}{0:##0}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <my:NumberEntry Decimals="0"
                                                            MaxLength="3"
                                                            Text="{Binding Path=Position, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Length">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Path=Length, StringFormat={}{0:##0}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <my:NumberEntry Decimals="0"
                                                            MaxLength="3"
                                                            Text="{Binding Path=Length, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="200"
                                                    Binding="{Binding Path=Contents, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Header="Contents">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Left" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="200"
                                                    Binding="{Binding Path=Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Header="Name">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Left" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <!-- <DataGridTextColumn Binding="{Binding Path=Requirement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Requirement" /> -->
                                <DataGridComboBoxColumn Header="Requirement"
                                                        ItemsSource="{Binding Source={StaticResource NachaRequirements}}"
                                                        SelectedItemBinding="{Binding Requirement}" />
                                <DataGridComboBoxColumn Header="DataType"
                                                        ItemsSource="{Binding Source={my:EnumBindingSource {x:Type l:DataTypes}}}"
                                                        SelectedItemBinding="{Binding DataType}" />
                                <DataGridCheckBoxColumn Binding="{Binding Path=Delete, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="DELETE" />
                            </DataGrid.Columns>
                        </DataGrid>

                    </TabItem>
                </TabControl>
            </Grid>
            <StackPanel Grid.Row="2"
                        Margin="0,5,0,5"
                        Background="AliceBlue"
                        Orientation="Horizontal">
                <Button Name="cmdSave"
                        Margin="10,0,0,0"
                        Click="cmdSave_Click"
                        Content="SAVE" />
                <Button Name="cmdClose"
                        Margin="10,0,0,0"
                        Click="cmdClose_Click"
                        Content="CLOSE" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
