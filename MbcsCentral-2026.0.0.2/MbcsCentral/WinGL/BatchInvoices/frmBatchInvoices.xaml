<Window
    x:Class="MbcsCentral.WinGL.frmBatchInvoices"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:my="clr-namespace:MbcsCentral"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Name="FormfrmBatchInvoices"
    Title="Batch Invoice List"
    Width="815.024"
    Height="299.33"
    Background="AliceBlue"
    Closed="frmBatchInvoices_Closed"
    FontSize="14"
    FontWeight="Bold"
    Foreground="White"
    Loaded="frmBatchInvoices_Loaded"
    TextBlock.TextAlignment="Center">
    <Window.Resources>
        <!--  SINGLE CLICK EDITING  -->
        <Style TargetType="{x:Type DataGridCell}">
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DataGridCell_PreviewMouseLeftButtonDown" />
        </Style>
        <CollectionViewSource x:Key="batchOptions" Source="{Binding}" />
        <my:StringTrim x:Key="StringTrim" />
    </Window.Resources>
    <Border
        BorderBrush="Blue"
        BorderThickness="3"
        CornerRadius="5">
        <Grid TextBlock.Foreground="Black">
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
                <RowDefinition Height="100" />
            </Grid.RowDefinitions>
            <Grid
                Name="InputBox"
                Grid.Row="1"
                Background="Black"
                Opacity="0.5"
                Visibility="Collapsed">
                <Border
                    MinWidth="500"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Orange"
                    BorderBrush="Black"
                    BorderThickness="1"
                    CornerRadius="10">
                    <StackPanel>
                        <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                            <TextBlock
                                Name="InputTextLabel"
                                Margin="2,0,0,0"
                                FontWeight="Bold"
                                Text="Name for new batch:" />
                            <TextBox
                                Name="InputTextBox"
                                Width="350"
                                Margin="5,0,3,0"
                                VerticalAlignment="Center"
                                MaxLength="64"
                                TextAlignment="Left" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <Button
                                x:Name="YesButton"
                                Margin="5"
                                Background="{x:Null}"
                                Click="YesButton_Click"
                                Content="Create"
                                IsDefault="True" />
                            <Button
                                x:Name="NoButton"
                                Margin="5"
                                Background="{x:Null}"
                                Click="NoButton_Click"
                                Content="Cancel" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <TextBox
                Background="LightSteelBlue"
                BorderBrush="Blue"
                BorderThickness="2"
                FontSize="14"
                FontWeight="Bold"
                Text="Batch Invoice List"
                TextAlignment="Center" />
            <!--  Place your content here  -->
            <FrameworkElement x:Name="Proxy" Visibility="Collapsed"/>
            <DataGrid
                Name="lstBatches"
                Grid.Row="1"
                AutoGenerateColumns="False"
                ItemsSource="{Binding}"
                TextBlock.TextAlignment="Left">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Key, Mode=OneWay, StringFormat={}{0:##0}}" Header="Batch" IsReadOnly="True"/>
                    <DataGridTextColumn
                        Width="300"
                        Binding="{Binding BatchName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Header="Batch Name"
                        TextBlock.TextAlignment="Left" />
                    <DataGridTextColumn
                        Binding="{Binding LastDate, StringFormat={}{0:MM/dd/yyyy}}"
                        Header="Last Processed"
                        IsReadOnly="True" />
                    <DataGridTemplateColumn Header="Invoice Option">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Background="#00FFFFFF" Text="{Binding Path=OptionName, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox
                                    Background="#00FFFFFF"
                                    DisplayMemberPath="OptionName"
                                    ItemsSource="{Binding Source={StaticResource batchOptions}}"
                                    SelectedValue="{Binding InvoiceOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedValuePath="Index"
                                    SelectionChanged="ComboBox_SelectionChanged"
                                    Text="{Binding OptionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridCheckBoxColumn Binding="{Binding Selected, Mode=TwoWay}" Header="Select" />
                    <DataGridCheckBoxColumn Binding="{Binding Private, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Private" Visibility ="Collapsed"/>
                    <DataGridTextColumn
                        Width="200"
                        Binding="{Binding Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource StringTrim}}"
                        Header="Comment">
                        <DataGridTextColumn.CellStyle>
                            <Style>
                                <Setter Property="TextBlock.TextAlignment" Value="Left" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding NumberOfInvoices, Mode=OneWay}" Header="#" />
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel
                Grid.Row="2"
                Margin="0,5,0,5"
                Background="AliceBlue"
                Orientation="Horizontal"
                TextBlock.FontSize="12">
                <Button
                    Name="cmdEdit"
                    Margin="10,0,0,0"
                    Click="cmdEdit_Click"
                    Content="EDIT BATCH" />
                <Button
                    Name="cmdAdd"
                    Margin="10,0,0,0"
                    Click="cmdAdd_Click"
                    Content="ADD A BATCH" />
                <Button
                    Name="cmdRemove"
                    Margin="10,0,0,0"
                    Click="cmdRemove_Click"
                    Content="REMOVE BATCH" />
                <Button
                    Name="cmdProcess"
                    Margin="10,0,0,0"
                    Click="cmdProcess_Click_1"
                    Content="PROCESS BATCHES" />
                <Button
                    Name="cmdPrint"
                    Margin="10,0,0,0"
                    Click="cmdPrint_Click"
                    Content="BATCH REPORT" />
                <Button
                    Name="cmdClose"
                    Margin="10,0,0,0"
                    Click="cmdClose_Click"
                    Content="CLOSE" />
            </StackPanel>
            <GroupBox
                Grid.Row="3"
                Padding="5,0,0,0"
                BorderBrush="Black"
                Header="Processing Options">
                <StackPanel>
                    <StackPanel Height="25" Orientation="Horizontal">
                        <CheckBox
                            Name="chkInvoiceDate"
                            Width="195"
                            VerticalAlignment="Center"
                            Content="Assign Invoice Date" />
                        <DatePicker
                            Name="dtInvoices"
                            Height="25"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding ElementName=chkInvoiceDate, Path=IsChecked}"
                            SelectedDate="{x:Static sys:DateTime.Now}" />
                        <CheckBox
                            Name="chkScan"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"
                            Content="Scan Invoices?"
                            TextBlock.TextAlignment="Center" />
                    </StackPanel>
                    <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                        <CheckBox
                            Name="chkPayDate"
                            Width="195"
                            VerticalAlignment="Center"
                            Content="Assign Payment Due Date" />
                        <DatePicker
                            Name="dtPayDate"
                            Height="25"
                            IsEnabled="{Binding ElementName=chkPayDate, Path=IsChecked}"
                            SelectedDate="{x:Static sys:DateTime.Now}" />
                        <TextBlock
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"
                            Text="Memo" />
                        <TextBox
                            Name="txtMemo"
                            Width="370"
                            Height="45"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            MaxLength="120"
                            TextAlignment="Left"
                            TextWrapping="Wrap"
                            ToolTip="A Memo will only be applied to a single batch.  If you select multiple batches to process, Memo will be ignored." />
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </Grid>
    </Border>
</Window>
