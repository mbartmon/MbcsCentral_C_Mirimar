
<Window x:Class="MbcsCentral.WinGL.frmBalanceSheet"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Name="FormfrmBalanceSheet"
        Width="434.31"
        Height="263.598"
        Background="AliceBlue"
        Closed="frmBalanceSheet_Closed"
        Title="Balance Sheet"
        FontSize="14"
        FontWeight="Bold"
        Loaded="frmBalanceSheet_Loaded"
        TextBlock.TextAlignment="Center">
    <Border BorderBrush="Blue"
            BorderThickness="3"
            CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <TextBox Background="LightSteelBlue"
                     BorderBrush="Blue"
                     BorderThickness="2"
                     FontSize="14"
                     FontWeight="Bold"
                     Text="Balance Sheet"
                     TextAlignment="Center" />
            <Grid Grid.Row="1">
                <!--  Place your content here  -->
                <StackPanel  Margin="5" TextBlock.FontSize="12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Company" VerticalAlignment="Center" TextAlignment="Left"/>
                        <ComboBox Name="lstCompanies" 
                                  ItemsSource="{Binding}" 
                                  DisplayMemberPath="Name" 
                                  SelectedValuePath="CompanyNumber" 
                                  SelectedValue="{Binding Path=Company, Mode=TwoWay}" 
                                  SelectionChanged="lstCompanies_SelectionChanged"
                                  Width="250" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                    <CheckBox Name="chkConsolidated" Content="Consolidated Report" FlowDirection="RightToLeft" HorizontalAlignment="Left" VerticalAlignment="Center" IsChecked="{Binding Path=Consolidated, Mode=TwoWay}" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Deparment {if not consolidated)" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Left" TextAlignment="Left"/>
                        <ComboBox Name="lstDepartments" ItemsSource="{Binding}" DisplayMemberPath="Name" SelectedValuePath="DepartmentNumber" SelectedValue="{Binding Path=Department, Mode=TwoWay}" Width="250" VerticalAlignment="Center" Margin="5,0,0,0">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=chkConsolidated}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=chkConsolidated}" Value="False">
                                            <Setter Property="IsEnabled" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Account for Profit/Loss" VerticalAlignment="Center" HorizontalAlignment="Left" TextAlignment="Left" FontSize="10"/>
                        <ComboBox Name="lstAccounts" Width="200" ItemsSource="{Binding}" DisplayMemberPath="Description" SelectedValuePath="Key" SelectedValue="{Binding PLAccount}" Margin="5,0,0,0">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=chkNoAccount}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="SelectedIndex" Value="-1"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=chkNoAccount}" Value="False">
                                            <Setter Property="IsEnabled" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <CheckBox Name="chkNoAccount" Content="No Account" VerticalAlignment="Center" Margin="3,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Month/Year" VerticalAlignment="Top" TextAlignment="Left"/>
                        <ComboBox Name="lstMonths" 
                                  VerticalAlignment="Top" Width="90" 
                                  Background="White"
                                  Margin="5,0,0,0">
                            <ComboBoxItem>January</ComboBoxItem>
                            <ComboBoxItem>February</ComboBoxItem>
                            <ComboBoxItem>March</ComboBoxItem>
                            <ComboBoxItem>April</ComboBoxItem>
                            <ComboBoxItem>May</ComboBoxItem>
                            <ComboBoxItem>June</ComboBoxItem>
                            <ComboBoxItem>July</ComboBoxItem>
                            <ComboBoxItem>August</ComboBoxItem>
                            <ComboBoxItem>September</ComboBoxItem>
                            <ComboBoxItem>October</ComboBoxItem>
                            <ComboBoxItem>November</ComboBoxItem>
                            <ComboBoxItem>December</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Text="/" VerticalAlignment="Top"/>
                        <GroupBox Padding="3" FontSize="10" VerticalAlignment="Center">
                            <StackPanel>
                                <RadioButton Name="optCurrentYear" Content="Current Year" GroupName="grpYear" IsChecked="True"/>
                                <RadioButton Name="optPriorYear" Content="Prior Year" GroupName="grpYear"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="2"
                        Margin="0,5,0,5"
                        Background="AliceBlue"
                        Orientation="Horizontal">
                <Button Name="cmdSave"
                        Margin="10,0,0,0"
                        Click="cmdSave_Click"
                        Content="DISPLAY" />
                <Button Name="cmdClose"
                        Margin="10,0,0,0"
                        Click="cmdClose_Click"
                        Content="CLOSE" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
