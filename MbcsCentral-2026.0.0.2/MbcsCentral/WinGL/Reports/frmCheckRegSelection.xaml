
<Window x:Class="MbcsCentral.WinGL.frmCheckRegSelection"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:my="clr-namespace:MbcsCentral"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Name="FormfrmCheckRegSelection"
        Title="Check Register"
        Width="431.198"
        Height="300"
        Background="AliceBlue"
        Closed="frmCheckRegSelection_Closed"
        FontSize="14"
        FontWeight="Bold"
        Loaded="frmCheckRegSelection_Loaded"
        TextBlock.TextAlignment="Center">
    <Border BorderBrush="Blue"
            BorderThickness="3"
            CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="65" />
            </Grid.RowDefinitions>
            <TextBox Background="LightSteelBlue"
                     BorderBrush="Blue"
                     BorderThickness="2"
                     FontSize="14"
                     FontWeight="Bold"
                     Text="Check Register"
                     TextAlignment="Center" />
            <Grid Grid.Row="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0"
                                Margin="5"
                                Orientation="Horizontal">
                        <TextBlock Width="85"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Text="Company"
                                   TextAlignment="Left" />
                        <ComboBox Name="lstCompanies"
                                  Width="300"
                                  VerticalAlignment="Center"
                                  DisplayMemberPath="Name"
                                  ItemsSource="{Binding}"
                                  SelectionChanged="lstCompanies_SelectionChanged" />
                    </StackPanel>
                    <StackPanel Grid.Row="1"
                                Margin="5"
                                Orientation="Horizontal">
                        <TextBlock Width="85"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Text="Department"
                                   TextAlignment="Left" />
                        <ComboBox Name="lstDepartments"
                                  Width="300"
                                  VerticalAlignment="Center"
                                  DisplayMemberPath="Name"
                                  ItemsSource="{Binding}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2"
                                Margin="5"
                                Orientation="Horizontal">
                        <TextBlock Width="100"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Text="Starting Check"
                                   TextAlignment="Left" />
                        <my:NumberEntry x:Name="txtStartCheck"
                                        Width="55"
                                        VerticalAlignment="Center"
                                        Decimals="0"
                                        MaxLength="6" 
                                        Text="{Binding Path=StartCheck, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:#####0}}"/>
                        <TextBlock Width="95"
                                   Margin="20,0,0,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Text="Starting Date"
                                   TextAlignment="Left" />
                        <DatePicker Name="dtStartDate"
                                    Width="125"
                                    VerticalAlignment="Center"
                                    SelectedDateFormat="Short"
                                    SelectedDate="{Binding Path=StartDate, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                    <StackPanel Grid.Row="3"
                                Margin="5"
                                Orientation="Horizontal">
                        <TextBlock Width="100"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Text="Ending Check"
                                   TextAlignment="Left" />
                        <my:NumberEntry x:Name="txtEndCheck"
                                        Width="55"
                                        VerticalAlignment="Center"
                                        Decimals="0"
                                        MaxLength="6" 
                                        Text="{Binding Path=EndCheck, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:#####0}}"/>
                        <TextBlock Width="95"
                                   Margin="20,0,0,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Text="Ending Date"
                                   TextAlignment="Left" />
                        <DatePicker Name="dtEndDate"
                                    Width="125"
                                    VerticalAlignment="Center"
                                    SelectedDateFormat="Short"
                                    SelectedDate="{Binding Path=EndDate, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                    </StackPanel>
                </Grid>
            </Grid>
            <StackPanel Grid.Row="2"
                        Margin="0,5,0,5"
                        Background="AliceBlue"
                        Orientation="Horizontal">
                <Border Margin="3,0,0,0"
                        BorderBrush="Black"
                        BorderThickness="1">
                    <TextBlock Margin="3"
                               FontSize="12"
                               FontWeight="Normal"
                               TextAlignment="Left">
                        To print all departments for
                        <LineBreak />
                        a company, leave
                        <LineBreak />
                        Department un-selected
                    </TextBlock>
                </Border>
                <Button Name="cmdSave"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center"
                        Click="cmdSave_Click"
                        Content="DISPLAY" />
                <Button Name="cmdClose"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center"
                        Click="cmdClose_Click"
                        Content="CLOSE" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
