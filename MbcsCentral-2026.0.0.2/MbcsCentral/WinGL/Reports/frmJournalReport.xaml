<Window x:Class="MbcsCentral.WinGL.frmJournalReport"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Name="FormfrmJournalReport"
        Width="557.238"
        Height="358"
        Background="AliceBlue"
        Closed="frmJournalReport_Closed"
        FontSize="14"
        FontWeight="Bold"
        Loaded="frmJournalReport_Loaded"
        TextBlock.TextAlignment="Center"
        Title="Journal Reports">
    <Border BorderBrush="Blue"
            BorderThickness="3"
            CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <TextBox Background="LightSteelBlue"
                     BorderBrush="Blue"
                     BorderThickness="2"
                     FontSize="14"
                     FontWeight="Bold"
                     Text="Journal Reports"
                     TextAlignment="Center" />
            <Grid Grid.Row="1">
                <!--  Place your content here  -->
                <StackPanel Name="pnlMaster" Margin="5" TextBlock.FontSize="12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Company" Width="100" VerticalAlignment="Center" TextAlignment="Left"/>
                        <ComboBox Name="lstCompanies" 
                                  ItemsSource="{Binding}" 
                                  DisplayMemberPath="Name" 
                                  SelectedValue="{Binding Company, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="CompanyNumber"
                                  SelectionChanged="lstCompanies_SelectionChanged" 
                                  Width="300" 
                                  Margin="10,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="110,20,0,0">
                        <CheckBox Name="chkConsolidate" 
                                  Content="Consolidate Departments?"
                                  IsChecked="{Binding Consolidate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="110,0,0,0">
                        <CheckBox Name="chkSingleDepartment" 
                                  Content="Print Single Department?"
                                  IsChecked="{Binding Path=PrintSingleDepartment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <TextBlock Text="Department" Width="100" VerticalAlignment="Center" TextAlignment="Left"/>
                        <ComboBox Name="lstDepartments" 
                                  Width="300" 
                                  ItemsSource="{Binding}" 
                                  DisplayMemberPath="Name" 
                                  IsEnabled="{Binding ElementName=chkSingleDepartment, Path=IsChecked}"
                                  SelectedValue="{Binding Department, Mode=TwoWay}"
                                  SelectedValuePath="DepartmentNumber"
                                  Margin="10,0,0,0"/>
                        <CheckBox Name="chkSource" 
                                  Content="Source Search?" 
                                  IsChecked="{Binding SourceSearch, Mode=TwoWay}"
                                  FlowDirection="LeftToRight" 
                                  Margin="10,0,0,0" 
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Journal Name" Width="100" VerticalAlignment="Center" TextAlignment="Left"/>
                        <ComboBox Name="lstJournals" 
                                  Width="300" 
                                  Margin="10,0,0,0" 
                                  DisplayMemberPath="JournalName"
                                  SelectedValue="{Binding JournalName}"
                                  SelectedValuePath="JournalName"/>
                        <CheckBox Name="chkTotals" 
                                  Content="Print Totals?" 
                                  IsChecked="{Binding PrintTotals, Mode=TwoWay}"
                                  FlowDirection="LeftToRight" 
                                  Margin="10,0,0,0" 
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Layout" Width="100" VerticalAlignment="Center" TextAlignment="Left"/>
                        <ComboBox Name="lstLayouts" 
                                  Width="300" 
                                  Margin="10,0,0,0" 
                                  ItemsSource="{Binding}" 
                                  DisplayMemberPath="Layout"
                                  SelectedValue="{Binding Layout, Mode=TwoWay}"
                                  SelectedValuePath="Layout"
                                  VerticalAlignment="Center"
                                  SelectionChanged="lstLayouts_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Report Title" Width="110" VerticalAlignment="Center" TextAlignment="Left"/>
                        <TextBox Name="txtReportTitle"
                                 Text="{Binding ReportTitle, Mode=TwoWay}"
                                 Width="400" 
                                 VerticalAlignment="Center" 
                                 Height="25" 
                                 TextAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Start Date" Width="110" VerticalAlignment="Center" TextAlignment="Left"/>
                        <DatePicker Name="dStart" 
                                    SelectedDateFormat="Short" 
                                    SelectedDate="{Binding StartDate, Mode=TwoWay}"
                                    VerticalAlignment="Center"/>
                        <TextBlock Text="End Date" VerticalAlignment="Center" TextAlignment="Left" Margin="30,0,0,0"/>
                        <DatePicker Name="dtEnd" 
                                    SelectedDateFormat="Short" 
                                    SelectedDate="{Binding EndDate, Mode=TwoWay}"
                                    VerticalAlignment="Center" 
                                    Margin="20,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="2"
                        Margin="0,5,0,5"
                        Background="AliceBlue"
                        Orientation="Horizontal">
                <Button Name="cmdSave"
                        Margin="10,0,0,0"
                        Click="cmdSave_Click"
                        Content="DISPLAY" />
                <Button Name="cmdPrint"
                        Margin="10,0,0,0"
                        Click="cmdPrint_Click"
                        Content="PRINT"/>
                <Button Name="cmdClose"
                        Margin="10,0,0,0"
                        Click="cmdClose_Click"
                        Content="CLOSE" />
                <Button Name="cmdEdit"
                        Margin="10,0,0,0"
                        Click="cmdEdit_Click"
                        Content="EDIT LAYOUT"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
