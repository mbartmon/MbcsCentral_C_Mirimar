<Window x:Class="MbcsCentral.WinGL.frmAPTrans"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:MbcsCentral.WinGL"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Name="formAPTrans"
        Width="788.029"
        Height="300"
        Background="AliceBlue"
        Closed="frmAPTrans_Closed"
        FontSize="14"
        FontWeight="Bold"
        Loaded="frmAPTrans_Loaded"
        TextBlock.TextAlignment="Center"
        mc:Ignorable="d">
    <Border BorderBrush="Blue"
            BorderThickness="3"
            CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="35" />
            </Grid.RowDefinitions>
            <TextBox Background="LightSteelBlue"
                     BorderBrush="Blue"
                     BorderThickness="2"
                     FontSize="14"
                     FontWeight="Bold"
                     Text="Pending Accounts Payable Transactions"
                     TextAlignment="Center" />
            <Grid Grid.Row="1">
                <DataGrid Name="grdTransactions"
                          AutoGenerateColumns="False"
                          ItemsSource="{Binding}"
                          SelectionUnit="FullRow">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="DELETE" Click="MenuItem_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Date, StringFormat={}{0:MM/dd/yyyy}}" Header="Date">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            
                        </DataGridTextColumn>
                     <DataGridTextColumn Binding="{Binding Description}" Header="Description">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>

                        </DataGridTextColumn>
                       <DataGridTextColumn Binding="{Binding AccountName}" Header="Account">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            
                        </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding CompanyName}" Header="Company">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding DepartmentName}" Header="Department">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Amount, StringFormat={}{0:######0.00}}" Header="Amount">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Journal}" Header="Journal" TextBlock.TextAlignment="Left" />
                        <DataGridTextColumn Binding="{Binding CheckNumber, StringFormat={}{0:######}}" Header="Check#">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <StackPanel Grid.Row="2"
                        Margin="0,5,0,5"
                        Background="AliceBlue"
                        Orientation="Horizontal">
                <Button Name="cmdSave"
                        Margin="10,0,0,0"
                        Click="cmdSave_Click"
                        Content="SAVE" 
                        Visibility="Collapsed"/>
                <Button Name="cmdDelete"
                        Content="DELETE SELECTED ROWS"
                        Margin="10,0,0,0"
                        Click="MenuItem_Click"/>
                <Button Name="cmdClose"
                        Margin="10,0,0,0"
                        Click="cmdClose_Click"
                        Content="CLOSE" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
