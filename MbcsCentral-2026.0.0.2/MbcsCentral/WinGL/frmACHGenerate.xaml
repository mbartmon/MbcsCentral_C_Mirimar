<Window x:Class="MbcsCentral.WinGL.frmACHGenerate"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wait="clr-namespace:MbcsWpfControls;assembly=MbcsWpfControls"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Name="formACHGenerate"
        Title="Generate Vendor ACH File"
        Width="557"
        Height="323"
        Background="ForestGreen"
        Closed="formACHGenerate_Closed"
        Loaded="formACHGenerate_Loaded">
    <Window.Resources>
        <Style x:Key="{x:Type ListViewItem}" TargetType="{x:Type ListViewItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="true">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Name="mainGrid" DataContext="{Binding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="5" />
            <RowDefinition Height="40" />
            <RowDefinition Height="80" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="colMain" Width="10" />
            <ColumnDefinition x:Name="colMiddle" Width="186" />
            <ColumnDefinition x:Name="colTenant" Width="350" />
        </Grid.ColumnDefinitions>

        <Border x:Name="bdrBill3"
            Grid.Row="1"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            BorderBrush="Blue"
            BorderThickness="2,2,2,2">
            <TextBlock HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="20,0,0,0"
                FontWeight="Bold"
                Text="ACH FILE GENERATION" />
         </Border>
        <Border Grid.Row="2" Grid.Column="1" 
                Grid.ColumnSpan="2"
                BorderBrush="Blue"
                BorderThickness="2,0,2,0">
            <StackPanel Orientation="Horizontal" 
                    Grid.Row="2" 
                    Grid.Column="1"
                    Grid.ColumnSpan="2">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Processing Date: "
                        Margin="5,10,0,0"
                        VerticalAlignment="Top"/>
                        <DatePicker Name="dtProcessDate"
                            Margin="14,8,0,0"
                            Width="100"
                            VerticalAlignment="Top"
                            SelectedDate="{x:Static sys:DateTime.Now}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Payment Due Date:"
                               Margin="5,10,0,0"
                               VerticalAlignment="Top"/>
                        <DatePicker Name="dtPaymentDate"
                                Margin="4,8,0,0"
                                Width="100"
                                VerticalAlignment="Top"
                                SelectedDate="{x:Static sys:DateTime.Now}" />
                    </StackPanel>
                </StackPanel>
                <GroupBox Margin="20,0,0,0"
                      BorderBrush="Black"
                      BorderThickness="1"
                      Header="Voucher Description Options"
                      VerticalAlignment="Top">
                <StackPanel Margin="0,0,0,0">
                    <RadioButton
                        Name="optBuildingAddress"
                        Content="Building Address"
                        GroupName="VoucherOptions" />
                    <RadioButton
                        Name="optFirstLine"
                        Content="First Line of Allocations"
                        GroupName="VoucherOptions"
                        IsChecked="True" />
                    <RadioButton
                        Name="optPayroll"
                        Content="Payroll Format"
                        GroupName="VoucherOptions" />
                </StackPanel>
            </GroupBox>
        </StackPanel>
        </Border>
        <Border Name="bdrBill4"
                Grid.Row="3"
                Grid.RowSpan="4"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                BorderBrush="Blue"
                BorderThickness="2,0,2,2" >
            <StackPanel Margin="2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Width="100"
                               VerticalAlignment="Center"
                               Text="Filename prefix" />
                    <TextBox Name="txtNachaFilePrefix"
                             Width="200"
                             MaxLength="32" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Width="100"
                               VerticalAlignment="Center"
                               Text="Optional File Tag" />
                    <TextBox Name="txtNachaFileTag"
                             Width="100"
                             VerticalAlignment="Center"
                             MaxLength="16" />
                </StackPanel>
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="File Location" />
                    <TextBox Name="txtNachaFileLocation"
                             Width="300"
                             Margin="5,0,0,0"
                             VerticalAlignment="Center"
                             IsReadOnly="False"/>
                    <Button Name="cmdNachaBrowse"
                            Margin="5,0,0,0"
                            Click="cmdBillingBrowse_Click"
                            Content="BROWSE" />
                </StackPanel>
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <Grid>
                        <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Notification Msg:" />

                        <TextBox    x:Name="txtStatementMessage"
                                    VerticalAlignment="Top"
                                    Grid.Column="1"
                                    Width="300"
                                    Height="55"
                                    Margin="5,0,0,0"
                                    MaxLength="128"
                                    TextWrapping="Wrap" />
                        <Border Grid.Column="2"
                                Margin="5,0,0,0"
                                BorderBrush="Black"
                                BorderThickness="2">
                            <StackPanel>
                                <TextBox
                                BorderBrush="Black"
                                BorderThickness="1"
                                IsReadOnly="True"
                                Text="INSERTION FIELDS"/>
                                <ListBox Name="lstInsertionFields" ItemsSource="{Binding}"/>
                            </StackPanel>
                        </Border>

                    </Grid>

                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="cmdNachaFile"
                        Margin="5,5,0,0"
                        HorizontalAlignment="Left"
                        Click="cmdPrint_Click"
                        Content="GENERATE NACHA FILE" />
                    <Button x:Name="cmdNachaManageFiles"
                            Margin="10,5,0,0"
                            HorizontalContentAlignment="Left"
                            Click="cmdNachaManageFiles_Click"
                            Content="Manage ACH Files"/>
                 <Button Name="cmdCancel"
                        Width="50"
                        Margin="10,5,0,0"
                        VerticalAlignment="Center"
                        Click="cmdCancel_Click"
                        Content="CLOSE"
                        IsCancel="True" />
               </StackPanel>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="4"
                    Grid.RowSpan="2"
                    HorizontalAlignment="Center"
                    Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
            </StackPanel>
            <TextBlock Name="Status"
                       VerticalAlignment="Center"
                       TextAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
