<Window x:Class="MbcsCentral.WinGL.frmLaserChk"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:MbcsCentral.WinGL"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:my="clr-namespace:MbcsCentral"
        Name="formLaserChk"
        Width="354.326"
        Height="213.078"
        Background="AliceBlue"
        Closed="formLaserChk_Closed"
        FontSize="14"
        FontWeight="Bold"
        Loaded="formLaserChk_Loaded"
        TextBlock.TextAlignment="Center"
        mc:Ignorable="d">
    <Border BorderBrush="Blue"
            BorderThickness="3"
            CornerRadius="5">
        <Grid TextBlock.FontSize="12"
              TextBlock.FontWeight="DemiBold"
              TextBlock.TextAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <TextBox Background="LightSteelBlue"
                     BorderBrush="Blue"
                     BorderThickness="2"
                     FontSize="14"
                     FontWeight="Bold"
                     Text="A/P CHECKS - ENTER CHECK NUMBER"
                     TextAlignment="Center" />
            <StackPanel Grid.Row="1" Margin="5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Width="70"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Text="Company" />
                    <TextBox Name="txtCompany"
                             Width="250"
                             Margin="5,0,0,0"
                             IsReadOnly="True" />
                </StackPanel>
                <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                    <TextBlock Width="70"
                               VerticalAlignment="Center"
                               Text="Department" />
                    <TextBox Name="txtDepartment"
                             Width="250"
                             Margin="5,0,0,0"
                             IsReadOnly="True" />
                </StackPanel>
                <StackPanel Margin="0,15,0,0" Orientation="Horizontal">
                    <TextBlock Width="130"
                               VerticalAlignment="Center"
                               Text="Starting Check Number" />
                    <my:NumberEntry x:Name="txtCheckNumber"
                                    Width="100"
                                    Margin="5,0,0,0"
                                    Decimals="0"
                                    MaxLength="10" />
                </StackPanel>
                <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                    <TextBlock Width="130"
                               VerticalAlignment="Center"
                               Text="Check Date" />
                    <DatePicker Name="dtCheckDate"
                                Width="110"
                                Margin="5,0,0,0"
                                SelectedDateFormat="Short" />
                </StackPanel>
            </StackPanel>
            <Grid Grid.Row="2" />
            <StackPanel Grid.Row="2"
                        Margin="0,0,90,0"
                        HorizontalAlignment="Right"
                        Background="AliceBlue"
                        Orientation="Horizontal">
                <Button Name="cmdContinue"
                        Margin="10,0,0,0"
                        Click="cmdContinue_Click"
                        Content="CONTINUE" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
