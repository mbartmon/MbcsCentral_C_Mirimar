<Window x:Class="MbcsCentral.WinPM.frmChooseTenant"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Choose Tenant" Height="300" Width="300" 
    Name="formChooseTenant"
    Background="LightBlue"
    TextBlock.TextAlignment="Center" FontWeight="Bold" FontSize="14"
    Loaded="frmChooseTenant_Loaded">
    <Border BorderBrush="Blue" BorderThickness="3" CornerRadius="5">
        <Grid TextBlock.TextAlignment="Left" TextBlock.FontSize="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="85"/>
                <RowDefinition/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock FontSize="14" Text="There were 2 or more tenants with the same Tenant Number." Margin="5,5,5,0" TextWrapping="Wrap" />
                <TextBlock FontSize="14" Text="Select the correct tenant and DoubleClick or press ENTER." Margin="5,5,5,0" TextWrapping="Wrap"/>
            </StackPanel>
            <ListBox Grid.Row="1" Name="lstTenants" ItemsSource="{Binding}" DisplayMemberPath="DisplayItem" SelectedValuePath="ValueItem" MouseDoubleClick="lstTenants_MouseDoubleClick">
            </ListBox>
            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <Button Name="cmdSelect" Content="SELECT" Margin="10,0,0,0" Click="cmdSelect_Click" IsDefault="True"/>
                <Button Name="cmdCancel" Content="CANCEL" Margin="10,0,0,0" Click="cmdCancel_Click" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
