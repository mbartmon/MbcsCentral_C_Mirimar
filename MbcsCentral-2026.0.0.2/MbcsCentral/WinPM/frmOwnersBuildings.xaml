<Window x:Class="MbcsCentral.WinPM.frmOwnersBuildings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Name="formOwnersBuildings"
        Title="Owners and Buildings"
        Width="676"
        Height="330"
        Background="#FF00C0C0"
        Closing="frmOwnersBuildings_Closing"
        FontSize="14"
        Loaded="frmOwnersBuildings_Loaded"
        TextBlock.FontSize="14"
        TextBlock.FontWeight="Bold"
        TextBlock.TextAlignment="Center">
    <Border BorderBrush="Blue"
            BorderThickness="3"
            CornerRadius="5">
        <Grid TextBlock.FontSize="12"
              TextBlock.FontWeight="Normal"
              TextBlock.TextAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="120" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Grid.Row="0"
                   Grid.Column="0"
                   HorizontalAlignment="Left"
                   Content="Owners"
                   FontSize="14"
                   FontWeight="Bold" />
            <Label Grid.Row="0"
                   Grid.Column="2"
                   HorizontalAlignment="Left"
                   Content="Buildings"
                   FontSize="14"
                   FontWeight="Bold" />

            <ListView Name="lstOwners"
                      Grid.Row="1"
                      Grid.Column="0"
                      Margin="3,0,0,0"
                      MouseDoubleClick="lstOwners_MouseDoubleClick"
                      SelectionChanged="lstOwners_SelectionChanged" />
            <StackPanel Grid.Row="1" Grid.Column="1">
                <Button Name="cmdAddOwner"
                        Width="115"
                        HorizontalAlignment="Center"
                        Click="cmdAddOwner_Click"
                        Content="Add New Owner"
                        FontSize="14" />
                <Button Name="cmdRemoveOwner"
                        Width="115"
                        HorizontalAlignment="Center"
                        Click="cmdRemoveOwner_Click"
                        Content="Remove Owner"
                        FontSize="14" />
                <Button Name="cmdAddBuilding"
                        Width="115"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        Click="cmdAddBuilding_Click"
                        Content="Add Building"
                        FontSize="14" />
                <Button Name="cmdAddTenants"
                        Width="115"
                        HorizontalAlignment="Center"
                        Click="cmdAddTenants_Click"
                        FontSize="14"
                        Content="Add Tenants"/>
                <Button Name="cmdMoveBuilding"
                        Width="115"
                        HorizontalAlignment="Center"
                        Click="cmdMoveBuilding_Click"
                        Content="Move Building"
                        FontSize="14" />
                <Button Name="cmdRemoveBuilding"
                        Width="115"
                        HorizontalAlignment="Center"
                        Click="cmdRemoveBuilding_Click"
                        Content="Remove Building"
                        FontSize="14" />
            </StackPanel>
            <ListView Name="lstBuildings"
                      Grid.Row="1"
                      Grid.Column="2"
                      Margin="0,0,3,0"
                      MouseDoubleClick="lstBuildings_MouseDoubleClick" />

            <Button Name="cmdEditOwner"
                    Grid.Row="2"
                    Grid.Column="0"
                    Width="115"
                    Margin="0,3,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="top"
                    Click="cmdEditOwner_Click"
                    Content="Edit Owner"
                    FontSize="14" />
            <Button Name="cmdExit"
                    Grid.Row="2"
                    Grid.Column="1"
                    Width="115"
                    Margin="0,3,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Click="cmdExit_Click"
                    Content="EXIT"
                    FontSize="14" />
            <Button Name="cmdEditBuilding"
                    Grid.Row="2"
                    Grid.Column="2"
                    Width="115"
                    Margin="0,3,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Click="cmdEditBuilding_Click"
                    Content="Edit Building"
                    FontSize="14" />

        </Grid>
    </Border>
</Window>
