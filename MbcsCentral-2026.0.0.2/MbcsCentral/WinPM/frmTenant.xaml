<Window
    x:Class="MbcsCentral.WinPM.frmTenant"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:col="clr-namespace:System.Collections;assembly=mscorlib"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:diagnostics="clr-namespace:System.Diagnostics;assembly=WindowsBase"
    xmlns:ex="clr-namespace:MbcsWpfControls;assembly=MbcsWpfControls"
    xmlns:local="clr-namespace:MbcsCentral.WinPM"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:my="clr-namespace:MbcsCentral"
    xmlns:my2="clr-namespace:MbcsCentral.WinPM"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:viblend="clr-namespace:VIBlend.WPF.Controls;assembly=VIBlend.WPF.Editors"
    xmlns:xceed="clr-namespace:Xceed.Wpf.Toolkit;assembly=Xceed.Wpf.Toolkit"
    Name="formTenant"
    Width="1064.211"
    Height="557"
    MaxHeight="900"
    Background="AliceBlue"
    ContentRendered="formTenant_ContentRendered"
    FontWeight="Bold"
    mc:Ignorable="d">
    <Window.Title>
        <MultiBinding StringFormat="Tenant Record for: {0}-{1} {2} Apartment: {3}">
            <Binding Path="BuildingNumber" />
            <Binding Path="TenantNumber" />
            <Binding Path="TenantName" />
            <Binding Path="Apartment" />
        </MultiBinding>
    </Window.Title>
    <Window.Resources>
        <Style TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Rectangle Height="{TemplateBinding Height}" Fill="Black" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <my:NegativeColorRed x:Key="NegativeColorRed" />
        <my:CurrencyPaddingConverter x:Key="CurrencyPadder" />
        <my:DateConverter x:Key="DateConverter" />
        <my:StringPad x:Key="StringPad" />
        <my:UpperCase x:Key="ToUpper" />
        <my:DateNotNullBool x:Key="DateNotNull" />
        <my:NotNumericReturnSpaces x:Key="NotNumeric" />
        <CollectionViewSource x:Key="TenantCalcView" />
        <CollectionViewSource x:Key="FutureRentsView" Source="{Binding}" />
        <CollectionViewSource x:Key="LegalCodesSource" />
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="AntiqueWhite" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border
        Background="Bisque"
        BorderBrush="Blue"
        BorderThickness="2"
        CornerRadius="5">
        <Grid Name="MainGrid" Width="1000">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <TabControl
                Name="tabTenant"
                diagnostics:PresentationTraceSources.TraceLevel="High"
                Background="AliceBlue"
                SelectionChanged="tabTenant_SelectionChanged">

                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border
                                        Name="Border"
                                        Margin="2,0"
                                        BorderBrush="Gainsboro"
                                        BorderThickness="1,1,1,0"
                                        CornerRadius="4,4,0,0">
                                        <ContentPresenter
                                            x:Name="ContentSite"
                                            Margin="10,2"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            ContentSource="Header" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="LightSkyBlue" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="False">
                                            <Setter TargetName="Border" Property="Background" Value="Bisque" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <TabItem Name="tabAccount" Header="Tenant Account">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="60" />
                            <RowDefinition Height="5" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Label
                                    Margin="3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Content="Tenant Number:" />
                                <TextBox
                                    Name="txtBuildingNumber"
                                    Width="35"
                                    Height="23"
                                    Margin="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Text="{Binding Path=BuildingNumber, Mode=TwoWay}" />
                                <TextBox
                                    Name="txtTenantNumber"
                                    Width="40"
                                    Height="23"
                                    Margin="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    GotFocus="txtBuildingNumber_LostFocus"
                                    LostFocus="txtTenantNumber_LostFocus"
                                    Text="{Binding Path=TenantNumber, Mode=TwoWay}" />
                                <CheckBox
                                    Name="chkNew"
                                    Margin="5"
                                    VerticalAlignment="Center"
                                    Content="?New"
                                    FlowDirection="RightToLeft"
                                    IsChecked="{Binding Path=NewTenantFlag, Mode=TwoWay}" />
                                <Label
                                    Margin="3"
                                    VerticalAlignment="Center"
                                    Content="Name" />
                                <TextBox
                                    Name="txtTenantName"
                                    Width="300"
                                    Height="23"
                                    Margin="0"
                                    VerticalAlignment="Center"
                                    MaxLength="30"
                                    Text="{Binding Path=TenantName, Mode=TwoWay}" />
                                <Label
                                    Margin="3"
                                    VerticalAlignment="Center"
                                    Content="Apt" />
                                <TextBox
                                    Name="txtApartment"
                                    Width="40"
                                    Height="23"
                                    Margin="0"
                                    VerticalAlignment="Center"
                                    Text="{Binding Path=Apartment, Mode=TwoWay}" />
                                <Label
                                    Margin="3"
                                    VerticalAlignment="Center"
                                    Content="Key (Seq Num)" />
                                <TextBlock
                                    Width="40"
                                    VerticalAlignment="Center"
                                    Background="White"
                                    Text="{Binding SequenceNumber}" />
                            </StackPanel>
                            <StackPanel Margin="0,1,0,0" Orientation="Horizontal">
                                <TextBlock
                                    Margin="190,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="Additional Name" />
                                <TextBox
                                    Width="300"
                                    Height="23"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    IsEnabled="False"
                                    Text="{Binding Path=AddName}" />
                            </StackPanel>
                        </StackPanel>
                        <Separator
                            Grid.Row="1"
                            Height="5"
                            VerticalAlignment="Center"
                            BorderBrush="Black"
                            BorderThickness="0" />
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="330" />
                                <ColumnDefinition Width="450" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="260" />
                                <RowDefinition Height="125" />
                            </Grid.RowDefinitions>
                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="4"
                                Orientation="Horizontal">
                                <Label VerticalAlignment="Center" Content="Rooms" />
                                <viblend:NumberEditor
                                    Name="txtRooms"
                                    Width="40"
                                    Height="23"
                                    VerticalAlignment="Center"
                                    DecimalPlaces="1"
                                    MaxLength="4"
                                    Text="{Binding Path=Rooms, Mode=TwoWay, StringFormat={}{0:0.0}}" />
                                <Label
                                    Margin="3"
                                    VerticalAlignment="Center"
                                    Content="Security" />
                                <viblend:NumberEditor
                                    Name="txtSecurity"
                                    Width="70"
                                    Height="23"
                                    VerticalAlignment="Center"
                                    DecimalPlaces="2"
                                    MaxLength="10"
                                    Text="{Binding Path=Security, StringFormat={}{0:######0.00}, Mode=TwoWay}" />
                                <!-- Depracated 1.8.3.5
                                    <Label Margin="3"
                                       VerticalAlignment="Center"
                                       Content="Mult" />
                                <ComboBox Name="cmbMulti"
                                          Width="50"
                                          Height="25"
                                          IsEditable="True"
                                          Text="{Binding Path=SecMultiple, Mode=TwoWay}">
                                    <ComboBoxItem Content="1.0" />
                                    <ComboBoxItem Content="1.25" />
                                    <ComboBoxItem Content="1.5" />
                                    <ComboBoxItem Content="1.75" />
                                    <ComboBoxItem Content="2.0" />
                                </ComboBox>
                                -->
                                <Label
                                    Margin="2"
                                    VerticalAlignment="Center"
                                    Content="Sq Ft" />
                                <viblend:NumberEditor
                                    x:Name="txtSquareFeet"
                                    Width="60"
                                    Height="23"
                                    DecimalPlaces="1"
                                    MaxLength="7"
                                    Text="{Binding Path=SquareFeet, StringFormat={}{0:###0.00}, Mode=TwoWay}" />
                                <Label
                                    Margin="3"
                                    VerticalAlignment="Center"
                                    Content="Legal Rent" />
                                <my:NumberEntry
                                    x:Name="txtLegalRent"
                                    Width="70"
                                    Height="23"
                                    VerticalAlignment="Center"
                                    Decimals="2"
                                    MaxLength="10"
                                    Text="{Binding Path=RentLegal, Mode=TwoWay, StringFormat={}{0:###0.00}}"
                                    TextAlignment="Right" />
                                <TextBlock
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="DC Legal" />
                                <viblend:NumberEditor
                                    Name="txtDCLegal"
                                    Width="70"
                                    Height="23"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    DecimalPlaces="2"
                                    IsEnabled="{Binding Path=UseDC}"
                                    MaxLength="10"
                                    Text="{Binding Path=DecontrolledLegal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:###0.00}, Converter={StaticResource CurrencyPadder}, ConverterParameter=10}" />
                                <StackPanel
                                    Name="Replacing"
                                    Margin="10,0,0,0"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,3,0,4"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="Old Tenant" />
                                    <TextBox
                                        Width="60"
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        IsEnabled="False"
                                        Text="{Binding Path=ReplacingTenant, Mode=OneTime}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="35" />
                                            <RowDefinition Height="45" />
                                            <RowDefinition Height="25"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="55" />
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Text="Type" />
                                        <TextBox
                                            Name="txtType"
                                            Grid.Column="1"
                                            Width="30"
                                            Height="23"
                                            HorizontalAlignment="Left"
                                            LostFocus="txtType_LostFocus"
                                            MaxLength="2"
                                            Text="{Binding Path=Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ToUpper}}" />
                                        <TextBlock
                                            Grid.Row="1"
                                            VerticalAlignment="Center"
                                            Text="Due Date" />
                                        <TextBox
                                            Name="txtDueDate"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Width="30"
                                            Height="23"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            MaxLength="2"
                                            Text="{Binding Path=DueDate, Mode=TwoWay}" />
                                        <GroupBox
                                            Grid.Row="0"
                                            Grid.RowSpan="3"
                                            Grid.Column="2"
                                            Width="Auto"
                                            Height="Auto"
                                            BorderBrush="Blue"
                                            BorderThickness="3"
                                            Header="LEAD AREA">
                                            <Grid >
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="20"/>
                                                    <RowDefinition Height="30" />
                                                    <RowDefinition Height="30" />   
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.RowSpan="2"
                                                           Stroke="Blue"
                                                           Fill="Transparent"/>
                                                <CheckBox
                                                    Name="chkXrfTested"
                                                    HorizontalAlignment="Left"
                                                    Content="XRF"
                                                    FlowDirection="RightToLeft"
                                                    Margin="3,1,0,0"
                                                    IsChecked="{Binding Path=XrfTested, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                    Checked="chkXrfTested_Checked"/>
                                                <Rectangle Grid.Column="1"
                                                           Grid.RowSpan="2"
                                                           Stroke="Blue"
                                                           Fill="Transparent"/>
                                                <CheckBox
                                                    Name="chkXrfExempt"
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Left"
                                                    Margin="3,1,0,0"
                                                    Content="Exempt"
                                                    FlowDirection="RightToLeft"
                                                    IsChecked="{Binding Path=XrfExempt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                    Checked="chkXrfExempt_Checked"/>
                                                <ex:DatePickerEx 
                                                    Name="dtXrfTestedDate" 
                                                    Grid.Row="1" 
                                                    SelectedDate="{Binding XrfTestedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:MM/dd/yyyy}}" 
                                                    IsEnabled="{Binding ElementName=chkXrfTested, Path=IsChecked}"/>
                                                <ex:DatePickerEx
                                                    Name="dtXrfExemptDate"
                                                    Grid.Row="1"
                                                    Grid.Column="1" 
                                                    SelectedDate="{Binding XrfExemptDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:MM/dd/yyyy}}" 
                                                    IsEnabled="{Binding ElementName=chkXrfExempt, Path=IsChecked}"/>
                                                <Rectangle Grid.Row="2"
                                                           Grid.ColumnSpan="2"
                                                           Stroke="Blue"
                                                           Fill="Transparent"/>
                                                <CheckBox Name="chkXrfWorkComplete"
                                                          Grid.Row="2"
                                                          Margin="3,0,0,0"
                                                          Content="Turnover Work"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Center"
                                                          FlowDirection="LeftToRight"
                                                          IsChecked="{Binding Path=XrfWorkComplete, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Checked="chkXrfWorkComplete_Checked"/>
                                                <ex:DatePickerEx
                                                    Name="dtXrfWorkCompleteDate"
                                                    Grid.Row="2"
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left"
                                                    SelectedDate="{Binding XrfWorkCompleteDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:MM/dd/yyyy}}"
                                                    IsEnabled="{Binding ElementName=chkXrfWorkComplete, Path=IsChecked}"/>
                                            </Grid>

                                        </GroupBox>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Label
                                        Width="90"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Content="Legal Code" />
                                    <ComboBox
                                        Name="lstLegalCode"
                                        Width="175"
                                        DisplayMemberPath="ChargeDescription"
                                        ItemsSource="{Binding Source={StaticResource LegalCodesSource}}"
                                        SelectedValue="{Binding LegalCode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                        SelectedValuePath="ChargeCode" />

                                    <!--
                                    <TextBox
                                        Name="txtLegalCode"
                                        Width="30"
                                        Height="23"
                                        VerticalAlignment="Center"
                                        MaxLength="2"
                                        Text="{Binding Path=LegalCode, Mode=TwoWay}" />
                                    <TextBox
                                        Name="txtLegalCode2"
                                        Width="30"
                                        Height="23"
                                        Margin="2"
                                        VerticalAlignment="Center"
                                        MaxLength="2"
                                        Text="{Binding Path=LegalCode2, Mode=TwoWay}" />
                                    -->
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox
                                        Margin="5"
                                        Content="              ?Letter"
                                        FlowDirection="RightToLeft"
                                        IsChecked="{Binding Path=LeaseLetterFlag, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Width="90"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="MoveIn Date" />
                                    <!--
                                        <CheckBox Name="chkMoveIn" VerticalAlignment="Center"/>
                                        <DatePicker VerticalAlignment="Center" Name="dtMoveIn"  Text="{Binding Path=MoveinDate, Mode=TwoWay}" SelectedDateChanged="MoveInChanged" PreviewMouseDown="Date_PreviewMouseDown"/>
                                    -->
                                    <ex:DatePickerEx
                                        Name="dtMoveIn"
                                        Width="150"
                                        SelectedDate="{Binding MoveinDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:MM/dd/yyyy}}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Width="90"
                                        VerticalAlignment="Center"
                                        Text="Lease Start" />
                                    <!--  <CheckBox Name="chkLeaseStart" VerticalAlignment="Center" />  -->
                                    <ex:DatePickerEx
                                        Name="dtLeaseStart"
                                        Width="150"
                                        VerticalAlignment="Center"
                                        SelectedDate="{Binding Path=LeaseStartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Label
                                        Width="90"
                                        HorizontalAlignment="Left"
                                        Margin="-4, 0,0,0"
                                        VerticalAlignment="Center"
                                        Content="Lease Expires" />
                                    <!--  <CheckBox Name="chkLeaseExpires" VerticalAlignment="Center" />  -->
                                    <Border
                                        Name="LeaseFrame"
                                        BorderBrush="Black"
                                        BorderThickness="2">
                                        <ex:DatePickerEx
                                            Name="dtLeaseExpires"
                                            Width="150"
                                            Margin="3,0,0,0"
                                            VerticalAlignment="Center"
                                            SelectedDate="{Binding Path=LeaseExpirationDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedDateChanged="dtLeaseExpires_SelectedDateChanged" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                Width="Auto"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Bottom"
                                HorizontalContentAlignment="Center"
                                Background="LightGray"
                                Content="Future Rents" />
                            <Grid
                                Grid.Row="1"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                Margin="10,0,0,0"
                                Background="#FF21B721">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125" />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition Height="10" />
                                    <RowDefinition />
                                    <RowDefinition Height="10" />
                                    <RowDefinition />
                                    <RowDefinition Height="10" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Content="Current" />
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Content="Arrears" />
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Content="Total" />
                                <Label
                                    Name="MonthlyRent"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Content="Monthly Rent" />
                                <viblend:NumberEditor
                                    Name="txtRentCurrent"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="5"
                                    VerticalAlignment="Center"
                                    DecimalPlaces="2"
                                    FontFamily="Courier New"
                                    FontWeight="Bold"
                                    Foreground="{Binding Path=Rent, Converter={StaticResource NegativeColorRed}, Mode=Default}"
                                    LostFocus="amountLostFocus"
                                    LostMouseCapture="amountLostFocus"
                                    MaxLength="10"
                                    Text="{Binding Path=Rent, Mode=TwoWay, Converter={StaticResource CurrencyPadder}, ConverterParameter=10, UpdateSourceTrigger=PropertyChanged}"
                                    TextAlignment="Right" />
                                <my:NumberEntry
                                    x:Name="txtRentArrears"
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Margin="5"
                                    Decimals="2"
                                    FontFamily="Courier New"
                                    FontWeight="Bold"
                                    Foreground="{Binding Path=Arrears, Converter={StaticResource NegativeColorRed}, Mode=Default}"
                                    LostFocus="amountLostFocus"
                                    LostKeyboardFocus="txtRentArrears_LostKeyboardFocus"
                                    MaxLength="10"
                                    Text="{Binding Path=Arrears, Mode=TwoWay, StringFormat={}{0:#######.00}, UpdateSourceTrigger=PropertyChanged}"
                                    TextAlignment="Right" />
                                <TextBox
                                    Name="txtRentTotal"
                                    Grid.Row="1"
                                    Grid.Column="3"
                                    Margin="5"
                                    VerticalContentAlignment="Center"
                                    FontFamily="Courier New"
                                    FontWeight="Bold"
                                    Foreground="{Binding ElementName=txtRentTotal, Path=Text, Converter={StaticResource NegativeColorRed}, Mode=Default}"
                                    IsReadOnly="True"
                                    IsTabStop="False"
                                    Text="{Binding Source={StaticResource TenantCalcView}, Path=TotalRent, Converter={StaticResource CurrencyPadder}, ConverterParameter=10, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextAlignment="Right" />
                                <Label
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Content="One Time Charges" />
                                <TextBox
                                    Name="txtOneChargesCurrent"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="5"
                                    Background="White"
                                    FontFamily="Courier New"
                                    FontWeight="Bold"
                                    Foreground="{Binding Source={StaticResource TenantCalcView}, Path=CurrentOneCharges, Converter={StaticResource NegativeColorRed}, Mode=Default}"
                                    IsReadOnly="True"
                                    IsTabStop="False"
                                    Text="{Binding Source={StaticResource TenantCalcView}, Path=CurrentOneCharges, StringFormat={}{0:######0.00}, Mode=OneWay, Converter={StaticResource CurrencyPadder}, ConverterParameter=10}"
                                    TextAlignment="Right" />
                                <TextBox
                                    Name="txtOneChargesArrears"
                                    Grid.Row="2"
                                    Grid.Column="2"
                                    Margin="5"
                                    FontFamily="Courier New"
                                    FontWeight="Bold"
                                    Foreground="{Binding Source={StaticResource TenantCalcView}, Path=ArrearsOneCharges, Converter={StaticResource NegativeColorRed}, Mode=Default}"
                                    IsReadOnly="True"
                                    IsTabStop="False"
                                    Text="{Binding Source={StaticResource TenantCalcView}, Path=ArrearsOneCharges, StringFormat={}{0:######0.00}, Mode=OneWay, Converter={StaticResource CurrencyPadder}, ConverterParameter=10}"
                                    TextAlignment="Right" />
                                <TextBox
                                    Name="txtOneChargesTotal"
                                    Grid.Row="2"
                                    Grid.Column="3"
                                    Margin="5"
                                    FontFamily="Courier New"
                                    FontWeight="Bold"
                                    Foreground="{Binding Source={StaticResource TenantCalcView}, Path=TotalOneCharges, Converter={StaticResource NegativeColorRed}, Mode=Default}"
                                    IsReadOnly="True"
                                    IsTabStop="False"
                                    Text="{Binding Source={StaticResource TenantCalcView}, Path=TotalOneCharges, StringFormat={}{0:######0.00}, Mode=OneWay, Converter={StaticResource CurrencyPadder}, ConverterParameter=10}"
                                    TextAlignment="Right" />
                                <Button
                                    Name="cmdChargesDetail"
                                    Grid.Row="2"
                                    Grid.RowSpan="2"
                                    Grid.Column="4"
                                    Height="25"
                                    VerticalAlignment="Center"
                                    Click="cmdChargesDetail_Click"
                                    Content="Details" />
                                <Label
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Content="Recurring Charges" />
                                <TextBox
                                    Name="txtRecurChargesCurrent"
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Margin="5"
                                    FontFamily="Courier New"
                                    FontWeight="Bold"
                                    Foreground="{Binding Source={StaticResource TenantCalcView}, Path=CurrentRecCharges, Converter={StaticResource NegativeColorRed}, Mode=Default}"
                                    IsReadOnly="True"
                                    IsTabStop="False"
                                    Text="{Binding Source={StaticResource TenantCalcView}, Path=CurrentRecCharges, StringFormat={}{0:######0.00}, Mode=OneWay, Converter={StaticResource CurrencyPadder}, ConverterParameter=10}"
                                    TextAlignment="Right"
                                    TextChanged="amountLostFocus" />
                                <TextBox
                                    Name="txtRecurChargesArrears"
