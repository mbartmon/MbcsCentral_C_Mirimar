<Window x:Class="MbcsCentral.WinPM.frmTenantLabels"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ex="clr-namespace:MbcsWpfControls;assembly=MbcsWpfControls"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viblend="clr-namespace:VIBlend.WPF.Controls;assembly=VIBlend.WPF.Editors"
        x:Name="FormTenantLabels"
        Title="Tenant Mailing Labels"
        Width="838.682"
        Height="333"
        Background="Aqua"
        Loaded="FormTenantLabels_Loaded"
        TextBlock.FontSize="14"
        TextBlock.FontWeight="Bold"
        TextBlock.TextAlignment="Center"
        mc:Ignorable="d">
    <Border BorderBrush="Blue"
            BorderThickness="2"
            CornerRadius="5">
        <Grid Name="mainGrid"
              TextBlock.FontSize="12"
              TextBlock.FontWeight="Normal"
              TextBlock.TextAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <GroupBox Width="Auto"
                          Height="Auto"
                          BorderBrush="Blue"
                          BorderThickness="1"
                          Header="Selection Options">
                    <StackPanel>
                        <RadioButton x:Name="RadioAll"
                                     Margin="5,15,0,0"
                                     Click="RadioAll_Click"
                                     Content="All Tenants"
                                     GroupName="GroupOptions"
                                     IsChecked="True" />
                        <RadioButton x:Name="RadioArrears"
                                     Margin="5,15,0,0"
                                     Click="RadioAll_Click"
                                     Content="Tenants in Arrears"
                                     GroupName="GroupOptions" />
                        <RadioButton x:Name="RadioIndividual"
                                     Margin="5,15,0,0"
                                     Click="RadioAll_Click"
                                     Content="Individual Tenants"
                                     GroupName="GroupOptions" />
                        <RadioButton x:Name="RadioType"
                                     Margin="5,15,0,0"
                                     Click="RadioAll_Click"
                                     Content="Tenants by Type Code"
                                     GroupName="GroupOptions" />
                    </StackPanel>
                </GroupBox>
                <StackPanel Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal">
                    <StackPanel>
                        <StackPanel Margin="5,5,0,0" Orientation="Horizontal">
                            <TextBlock Width="95"
                                       VerticalAlignment="Center"
                                       Text="Starting Tenant #" />
                            <TextBox x:Name="txtStartBuilding"
                                     Width="30"
                                     VerticalAlignment="Center"
                                     BorderBrush="Black"
                                     Text="000" />
                            <TextBox x:Name="txtStartTenant"
                                     Width="30"
                                     VerticalAlignment="Center"
                                     BorderBrush="Black"
                                     Text="000" />
                        </StackPanel>
                        <StackPanel Margin="5,5,0,0" Orientation="Horizontal">
                            <TextBlock Width="95"
                                       VerticalAlignment="Center"
                                       Text="Ending Tenant #" />
                            <TextBox x:Name="txtEndBuilding"
                                     Width="30"
                                     VerticalAlignment="Center"
                                     BorderBrush="Black"
                                     Text="999" />
                            <TextBox x:Name="txtEndTenant"
                                     Width="30"
                                     VerticalAlignment="Center"
                                     BorderBrush="Black"
                                     Text="ZZZ" />
                        </StackPanel>
                        <CheckBox x:Name="chkPrintTenantNumber"
                                  Margin="5,5,0,0"
                                  VerticalAlignment="Center"
                                  Content="Print Tenant Number"
                                  IsChecked="{Binding PrintTenantNumber,
                                                      Mode=TwoWay,
                                                      UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox x:Name="chkAlternateAddress"
                                  Margin="5,5,0,0"
                                  VerticalAlignment="Center"
                                  Content="Use Alternate Billing Address"
                                  IsChecked="{Binding UseAlternateAddress,
                                                      Mode=TwoWay,
                                                      UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Margin="5,5,0,0" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="Lease Expiration " />
                            <ex:DatePickerEx Name="dtLease" Width="120" />
                        </StackPanel>
                        <StackPanel Margin="5,5,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="To"/>
                            <DatePicker Name="dtLeaseTo" IsEnabled="{Binding ElementName=dtLease, Path=dtLease.Ischecked}" Margin="5,0,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="5,10,0,0" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="Type Code" />
                            <ListBox x:Name="lstType"
                                     Width="130"
                                     Height="140"
                                     Margin="5,0,0,0"
                                     Background="White"
                                     DisplayMemberPath="DisplayDescription"
                                     ItemsSource="{Binding}"
                                     SelectedValuePath="ChargeCode"
                                     SelectionMode="Multiple" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="10,0,0,0">
                        <Border Width="182"
                                HorizontalAlignment="Left"
                                BorderBrush="Black"
                                BorderThickness="3,0,2,0">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="ACTIONS" />
                        </Border>
                        <Border Grid.Column="1"
                                Width="183"
                                HorizontalAlignment="Left"
                                BorderBrush="Black"
                                BorderThickness="3,3,2,3"
                                Padding="0,0,0,10">
                            <StackPanel>
                                <Button x:Name="cmdPrint"
                                        Width="93"
                                        Height="30"
                                        Margin="5,10,5,0"
                                        HorizontalAlignment="Center"
                                        Click="cmdPrint_Click"
                                        Content="PRINT" />
                                <Button x:Name="cmdDisplay"
                                        Width="93"
                                        Height="30"
                                        Margin="5,10,5,0"
                                        Click="cmdDisplay_Click"
                                        Content="DISPLAY" />
                                <Button x:Name="cmdExit"
                                        Width="93"
                                        Height="30"
                                        Margin="5,10,5,0"
                                        HorizontalAlignment="Center"
                                        Click="cmdExit_Click"
                                        Content="EXIT" />
                            </StackPanel>
                        </Border>
                        <StackPanel>
                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                <TextBlock Margin="5,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="Minimum Arrears" />
                                <viblend:NumberEditor x:Name="MinimumArrears"
                                                      Width="80"
                                                      Margin="5,0,0,0"
                                                      VerticalAlignment="Center"
                                                      DecimalPlaces="2"
                                                      MaxLength="6"
                                                      Value="{Binding MinimumBalance,
                                                                      Mode=TwoWay,
                                                                      UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <Border Width="160"
                                    Margin="10"
                                    BorderBrush="Blue"
                                    BorderThickness="3"
                                    CornerRadius="5">
                                <StackPanel Margin="2,0,-2,0">
                                    <TextBlock HorizontalAlignment="Center"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Text="Label Type" />
                                    <ComboBox x:Name="lstLabels"
                                              Width="145"
                                              Margin="5"
                                              Background="White"
                                              ItemsSource="{Binding}" />
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="10,5,0,0" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="Max Labels (0 = no limit)" />
                                <viblend:NumberEditor x:Name="MaxLabels"
                                                      Width="40"
                                                      Margin="5,0,0,0"
                                                      VerticalAlignment="Center"
                                                      DecimalPlaces="0"
                                                      MaxLength="3" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="ShowTenants" Grid.Column="3">
                    <Border Width="173"
                            HorizontalAlignment="Right"
                            BorderBrush="Black"
                            BorderThickness="2,0,3,0">
                        <TextBlock Margin="5,0,5,0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="INDIVIDUAL TENANTS" />
                    </Border>
                    <Border x:Name="bdrTenants"
                            Grid.Column="2"
                            Height="Auto"
                            Margin="15,0,0,0"
                            BorderBrush="Black"
                            BorderThickness="2,3,3,3"
                            Padding="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="5,5,0,0"
                                           VerticalAlignment="Center"
                                           Text="Tenant Number" />
                                <TextBox x:Name="txtTenantNumber"
                                         Width="80"
                                         Margin="5,5,5,0"
                                         VerticalAlignment="Center"
                                         MaxLength="7" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel>
                                    <Button x:Name="cmdAdd"
                                            Width="80"
                                            Margin="5,5,0,0"
                                            Click="cmdAdd_Click"
                                            Content="ADD"
                                            IsDefault="True"
                                            IsEnabled="False" />
                                    <Button x:Name="cmdRemove"
                                            Width="80"
                                            Margin="5,10,0,0"
                                            Click="cmdRemove_Click"
                                            Content="REMOVE" />
                                    <Button x:Name="cmdClear"
                                            Width="80"
                                            Margin="5,10,0,0"
                                            Click="cmdClear_Click"
                                            Content="CLEAR" />
                                </StackPanel>
                                <ListBox x:Name="lstTenants"
                                         Width="80"
                                         Height="224"
                                         Margin="8,5,0,0"
                                         VerticalAlignment="Stretch" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
