<Window x:Class="frmIssuesDashboard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Issues Dashboard" Height="697" Width="883" mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:my="clr-namespace:WinTRM" Background="#FFE1FFF5" Name="frmIssuesDashboard">
    <Window.Resources>
        <CollectionViewSource x:Key="AccountsViewSource" d:DesignSource="{d:DesignInstance my:Accounts, CreateList=True}" />
    </Window.Resources>
    <Grid ShowGridLines="True" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" HorizontalAlignment="Left" LastChildFill="True">
            <StackPanel Background="PowderBlue">
                <StackPanel Orientation="Horizontal" Height="25" Width="250" DockPanel.Dock="Left">
                    <Label Content="Tenants:" FontWeight="Bold"/>
                    <ComboBox Name="lstTenants"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton GroupName="SortBy" Content="Sort by Building" Height="16" Name="optBuilding" Margin="5,0,10,0" IsChecked="True" />
                    <RadioButton GroupName="SortBy" Content="Sort by Name" Height="16" Name="optName"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Label Content="From:" Grid.Column="0"/>
                        <CheckBox Name="chkTenantFrom" Grid.Column="1" VerticalAlignment="Center"/>
                        <DatePicker Name="dtTenantFrom" Grid.Column="2" />
                        <Label Content="  To:" Grid.Column="3"/>
                        <CheckBox Name="chkTenantTo" Grid.Column="4" VerticalAlignment="Center"/>
                        <DatePicker Name="dtTenantTo" Grid.Column="5"/>
                        <Button Name="cmdTenantDateApply" Content="Apply" Grid.Column="6"/>
                    </Grid>
                </StackPanel>
                <Grid Height="25" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Created By" Grid.Column="0" FontWeight="Black" />
                    <ComboBox Name="lstTenantCreated" Grid.Column="1"  />
                </Grid>
                <Grid Height="25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Responsible" FontWeight="Black" />
                    <ComboBox Name="lstTenantResponsible" Grid.Column="2" />
                </Grid>
                <Grid Height="25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Status" Grid.Column="0" FontWeight="Black" />
                    <ComboBox Name="lstTenantStatus" Grid.Column="1" />
                </Grid>
                <Grid Height="25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Priority" Grid.Column="0" FontWeight="Black" />
                    <ComboBox Name="lstTenantPriority" Grid.Column="1" />
                </Grid>
                <Grid Height="25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Category" Grid.Column="0" FontWeight="Black" />
                    <ComboBox Name="lstTenantCategory" Grid.Column="1" />
                </Grid>
            </StackPanel>
            <DataGrid Name="grdTenantIssues" ItemsSource="{Binding Path=.}" AutoGenerateColumns="True" IsReadOnly="True" Background="PowderBlue" RowBackground="PowderBlue" />
        </DockPanel>
        <DockPanel Grid.Row="1" HorizontalAlignment="Left" Background="LightSteelBlue">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Height="25" Width="250" DockPanel.Dock="Left">
                    <Label Content="Building:" FontWeight="Bold"/>
                    <ComboBox Name="lstBuildings"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Content="Reported" FontWeight="Black" VerticalAlignment="Top"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Label Content="From:" Grid.Column="0"/>
                        <CheckBox Name="chkReportedFrom" Grid.Column="1" VerticalAlignment="Center"/>
                        <DatePicker Name="dtReportedFrom" Grid.Column="2" />
                        <Label Content="  To:" Grid.Column="3"/>
                        <CheckBox Name="chkReportedTo" Grid.Column="4" VerticalAlignment="Center"/>
                        <DatePicker Name="dtReportedTo" Grid.Column="5"/>
                        <Button Name="cmdReportedApply" Content="Apply" Grid.Column="6"/>
                    </Grid>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Content="Assigned" FontWeight="Black"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Label Content="From:" Grid.Column="0"/>
                        <CheckBox Name="chkAssignedFrom" Grid.Column="1" VerticalAlignment="Center"/>
                        <DatePicker Name="dtAssignedFrom" Grid.Column="2" />
                        <Label Content="  To:" Grid.Column="3"/>
                        <CheckBox Name="chkAssignedTo" Grid.Column="4" VerticalAlignment="Center"/>
                        <DatePicker Name="dtAssignedTo" Grid.Column="5"/>
                        <Button Name="cmdAssignedApply" Content="Apply" Grid.Column="6"/>
                    </Grid>
                </StackPanel>
                <Grid Height="25" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Created By" Grid.Column="0" FontWeight="Black" />
                    <ComboBox Name="lstBuildingCreated" Grid.Column="1"  />
                </Grid>
                <Grid Height="25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Responsible" Grid.Column="0" FontWeight="Black" />
                    <ComboBox Name="lstBuildingResponsible" Grid.Column="1" />
                </Grid>
                <Grid Height="25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Status" Grid.Column="0" FontWeight="Black" />
                    <ComboBox Name="lstBuildingStatus" Grid.Column="1" />
                </Grid>
                <Grid Height="25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Priority" Grid.Column="0" FontWeight="Black" />
                    <ComboBox Name="lstBuildingPriority" Grid.Column="1" />
                </Grid>
                <Grid Height="25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Category" Grid.Column="0" FontWeight="Black" />
                    <ComboBox Name="lstBuildingCategory" Grid.Column="1" />
                </Grid>
                <Grid Height="25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Location" Grid.Column="0" FontWeight="Black" />
                    <ComboBox Name="lstBuildingLocation" Grid.Column="1" />
                </Grid>
                <Grid Height="25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Vendor" Grid.Column="0" FontWeight="Black" />
                    <ComboBox Name="lstBuildingVendor" Grid.Column="1" />
                </Grid>
            </StackPanel>
            <DataGrid Name="grdBuildingIssues" ItemsSource="{Binding Path=.}" AutoGenerateColumns="True" IsReadOnly="True" Background="LightSteelBlue" RowBackground="LightSteelBlue" />
        </DockPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="2">
            <Button Name="cmdCancel" Content="CANCEL" Margin="10,5,10,5"/>
            <Button Name="cmdAssignEmail" Content="ASSIGN EMAIL" Margin="0,5,0,5"/>
        </StackPanel>
    </Grid>
</Window>
