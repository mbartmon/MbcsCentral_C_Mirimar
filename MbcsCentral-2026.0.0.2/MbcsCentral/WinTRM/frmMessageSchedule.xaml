<Window x:Class="frmMessageSchedule"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Message Delivery Schedule" Height="661" Width="454" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:my="clr-namespace:WinTRM">
    <Window.Resources>
        <CollectionViewSource x:Key="RecipientMasterViewSource" d:DesignSource="{d:DesignInstance my:RecipientMaster, CreateList=True}" />
        <CollectionViewSource x:Key="SmtpConfigViewSource" d:DesignSource="{d:DesignInstance my:SmtpConfig, CreateList=True}" />
    </Window.Resources>
    <Grid Background="#FFE2D6D6" ShowGridLines="True" Name="mainGrid" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="135*"/>
            <ColumnDefinition Width="297*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="31" />
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>
        <Label Content="Message Delivery ID" Height="28" HorizontalAlignment="Left" Margin="10,0,0,0" Name="Label1" VerticalAlignment="Center" FontWeight="Bold" />
        <Label Content="Account" FontWeight="Bold" Height="28" HorizontalAlignment="Left" Margin="10" Name="Label2" VerticalAlignment="Center" Grid.Row="1" />
        <Label Content="Schedule " FontWeight="Bold" Height="28" HorizontalAlignment="Left" Margin="10" Name="Label3" VerticalAlignment="Center" Grid.Row="2" />
        <Label Content="Content" FontWeight="Bold" Height="28" HorizontalAlignment="Left" Margin="10" Name="Label4" VerticalAlignment="Center" Grid.Row="3" />
        <Label Content="Description" FontWeight="Bold" Height="28" HorizontalAlignment="Left" Margin="10" Name="Label5" VerticalAlignment="Center" Grid.Row="4" />
        <Label Content="Status" FontWeight="Bold" Height="28" HorizontalAlignment="Left" Margin="10" Name="Label6" VerticalAlignment="Center" Grid.Row="5" />
        <Label Content="Recipients" FontWeight="Bold" Height="28" HorizontalAlignment="Left" Margin="10" Name="Label7" VerticalAlignment="Center" Grid.Row="6" />
        <Label Content="From" FontWeight="Bold" Height="28" HorizontalAlignment="Left" Margin="10" Name="Label8" VerticalAlignment="Center" Grid.Row="7" />
        <Label Content="Subject" FontWeight="Bold" Height="28" HorizontalAlignment="Left" Margin="10" Name="Label9" VerticalAlignment="Center" Grid.Row="8" />
        <Label Content="Created On" FontWeight="Bold" Height="28" HorizontalAlignment="Left" Margin="10" Name="Label10" VerticalAlignment="Center" Grid.Row="9" />
        <Label Content="Last Sent On" FontWeight="Bold" Height="28" HorizontalAlignment="Left" Margin="10" Name="Label11" VerticalAlignment="Center" Grid.Row="10" />
        <Label Content="View Message" FontWeight="Bold" Height="28" HorizontalAlignment="Left" Margin="10" Name="Label12" VerticalAlignment="Center" Grid.Row="11" />
        <Label Grid.Row="12" Height="28" VerticalAlignment="Center" Grid.Column="0" Content="Use SMTP Account" Margin="10" FontWeight="Bold"/>
        <Label Grid.Row="15" Height="28" VerticalAlignment="Center" Content="On Error, Process" Margin="10,0,10,4" FontWeight="Bold"/>
        <TextBox Height="23" HorizontalAlignment="Left" Margin="10" Name="txtMsgSched" VerticalAlignment="Center" Width="120" Grid.Column="1" Grid.Row="0" IsReadOnly="True" BorderThickness="2" Focusable="False" Text="{Binding Path=msg_sched_id}" />
        <ComboBox Grid.Column="1" Grid.Row="1" Height="30" HorizontalAlignment="Stretch" Margin="10" Name="lstAccount" VerticalAlignment="Center" Width="243" 
                  DisplayMemberPath="name"
                  SelectedValuePath="id"
                  SelectedValue="{Binding account_id}"/>
        <ComboBox Height="30" HorizontalAlignment="Stretch" Margin="10" Name="lstSchedule" VerticalAlignment="Center" Width="243" Grid.Column="1" Grid.Row="2" 
                  DisplayMemberPath="name"
                  SelectedValuePath="id"
                  SelectedValue="{Binding schedule_id}"/>
        <ComboBox Height="30" HorizontalAlignment="Stretch" Margin="10" Name="lstContent" VerticalAlignment="Center" Width="243" Grid.Column="1" Grid.Row="3" 
                  DisplayMemberPath="name"
                  SelectedValuePath="id"
                  SelectedValue="{Binding content_id}"/>
        <ComboBox Height="30" HorizontalAlignment="Stretch" Margin="10,5,10,0" Name="lstStatus" VerticalAlignment="Center" Width="243" Grid.Column="1" Grid.Row="5" 
                  DisplayMemberPath="name"
                  SelectedValuePath="id"
                  SelectedValue="{Binding status}"/>
        <ComboBox Height="30" HorizontalAlignment="Stretch" Margin="10" Name="lstSmtpAccount" VerticalAlignment="Center" Grid.Column="1" Grid.Row="12" DisplayMemberPath="description" SelectedValuePath="ID" />
        <CheckBox Grid.Row="13" Grid.ColumnSpan="2" IsChecked="{Binding Path=ReturnReceipt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalAlignment="Left"  Content=" ?Request Return Receipt" FlowDirection="RightToLeft" FontWeight="Bold" Margin="10,0,0,0"/>
        <ComboBox Height="30" HorizontalAlignment="Stretch" Margin="10,2" Name="lstError" VerticalAlignment="Center" Grid.Column="1" Grid.Row="14" DisplayMemberPath="DisplayItem" SelectedValuePath="ValueItem" Grid.RowSpan="2" />
        <Grid Grid.Row="6" Grid.Column="1" DataContext="{StaticResource RecipientMasterViewSource}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="17"/>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <ListBox Grid.Column="0" Height="Auto" HorizontalAlignment="Stretch" Margin="0,0,0,0" Name="lstLists" VerticalAlignment="Stretch" Width="Auto" DisplayMemberPath="listName" SelectedValuePath="listId" ItemsSource="{Binding}" SelectionMode="Extended" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Button VerticalAlignment="center" Name="cmdListAdd" Height="15" Width="17" >
                    <Button.Background>
                        <ImageBrush  ImageSource="ARW08RT.ICO" />
                    </Button.Background>
                </Button>
                <Button VerticalAlignment="Center" Name="cmdListDelete" Height="15" Width="17">
                    <Button.Background>
                        <ImageBrush  ImageSource="ARW08LT.ICO" />
                    </Button.Background>
                </Button>
            </StackPanel>
            <ListBox Grid.Column="2" Height="Auto" HorizontalAlignment="Stretch" Margin="0,0,0,0" Name="lstListsActive" VerticalAlignment="Stretch" Width="Auto" DisplayMemberPath="listName" SelectedValuePath="listId" SelectionMode="Extended" />
        </Grid>
        <TextBox Grid.Column="1" Grid.Row="4" Height="31" HorizontalAlignment="Stretch" Margin="5" Name="txtDescription" VerticalAlignment="Stretch" Width="257" TextWrapping="Wrap" Text="{Binding Path=description}"/>
        <TextBox Grid.Column="1" Grid.Row="7" Height="24" HorizontalAlignment="Stretch" Margin="10" Name="txtFrom" VerticalAlignment="Center" Width="243" Text="{Binding Path=from}"/>
        <TextBox Height="24" HorizontalAlignment="Stretch" Margin="10" Name="txtSubject" VerticalAlignment="Center" Width="243" Grid.Column="1" Grid.Row="8" Text="{Binding Path=subject}" />
        <DatePicker Grid.Column="1" Grid.Row="9" Height="30" HorizontalAlignment="Left" Margin="10" Name="dtCreated" VerticalAlignment="Center" Width="199" SelectedDate="{Binding Path=created}"/>
        <DatePicker Height="30" HorizontalAlignment="Left" Margin="10" Name="dtLastSent" VerticalAlignment="Center" Width="199" Grid.Column="1" Grid.Row="10" SelectedDate="{Binding Path=last_sent}" />
        <Button Content="Click Here to View" Grid.Column="1" Grid.Row="11" Height="23" HorizontalAlignment="Stretch" Margin="10" Name="cmdMessage" VerticalAlignment="Center" Width="Auto" />
        <Button Content="SAVE" Grid.Column="1" Grid.Row="16" Height="24" HorizontalAlignment="Left" Margin="8,0,0,0" Name="cmdSave" VerticalAlignment="Top" Width="81" />
        <Button Content="CANCEL" Height="24" HorizontalAlignment="Left" Margin="108,0,0,0" Name="cmdCancel" VerticalAlignment="Top" Width="81" Grid.Column="1" Grid.Row="16" />
    </Grid>
</Window>
