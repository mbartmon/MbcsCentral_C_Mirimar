<Window x:Class="MbcsCentral.WinTrm.frmRecipient"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:MbcsCentral.WinTrm"
    Title="frmRecipient" Height="386" Width="654" mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:my="clr-namespace:WinTRM" Background="{StaticResource {x:Static SystemColors.InactiveBorderBrushKey}}">
    <Window.Resources>
        <CollectionViewSource x:Key="RecipientsViewSource"/>
    </Window.Resources>
    <Grid DataContext="{StaticResource RecipientsViewSource}">
        <Grid.RowDefinitions>
            <RowDefinition Height="28*" />
            <RowDefinition Height="14*" />
            <RowDefinition Height="272*" />
            <RowDefinition Height="33*" />
        </Grid.RowDefinitions>
        <Border BorderBrush="Silver" BorderThickness="2" Height="28" HorizontalAlignment="Center" Margin="0" Name="Border1" VerticalAlignment="Top" Width="171" CornerRadius="25" Background="{StaticResource {x:Static SystemColors.GradientInactiveCaptionBrushKey}}">
            <TextBlock Name="TextBlock1" Text="Add/Edit Recipient" FontWeight="Bold" FontSize="16" FontStretch="Normal" HorizontalAlignment="Center" />
        </Border>
        <StackPanel Grid.Row="2" Name="StackPanel1">
            <StackPanel Orientation="Horizontal" Width="Auto" HorizontalAlignment="Stretch">
            <Grid HorizontalAlignment="Left" Name="Grid1" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Content="recipient Id:" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Margin="3" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Grid.Row="0" Height="23" HorizontalAlignment="Left" Margin="3" Name="Recipient_IdTextBox" Text="{Binding Path=recipient_Id, Mode=OneWay}" VerticalAlignment="Center" Width="120" IsReadOnly="True" IsTabStop="False" />
            </Grid>
            <Grid  HorizontalAlignment="Left" Name="Grid2" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Content="list Id:" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Margin="3" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Grid.Row="0" Height="23" HorizontalAlignment="Left" Margin="3" Name="List_IdTextBox" Text="{Binding Path=list_Id, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" VerticalAlignment="Center" Width="120" IsReadOnly="True" IsTabStop="False" />
            </Grid>
        </StackPanel>
        <Grid  HorizontalAlignment="Left" Name="Grid3" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Content="email address:" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Margin="3" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Height="23" HorizontalAlignment="Left" Margin="3,3,0,3" Name="Email_addressTextBox" Text="{Binding Path=email_address, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" VerticalAlignment="Center" Width="255" TabIndex="0" />
            </Grid>
            <StackPanel Height="36" Name="StackPanel2" Width="Auto" Orientation="Horizontal">
                <Grid HorizontalAlignment="Left" Name="Grid4" VerticalAlignment="Top" Width="270">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Content="first name:" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Margin="3" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Height="23" HorizontalAlignment="Left" Margin="3,3,0,3" Name="First_nameTextBox" Text="{Binding Path=first_name, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" VerticalAlignment="Center" Width="190" TabIndex="1" />
                </Grid>
                <Grid HorizontalAlignment="Left" Name="Grid5" VerticalAlignment="Top" Width="307">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="237*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Content="last name:" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Margin="3" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Height="23" HorizontalAlignment="Left" Margin="3,3,0,3" Name="Last_nameTextBox" Text="{Binding Path=last_name, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" VerticalAlignment="Center" Width="228" TabIndex="2" />
                </Grid>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Width="Auto" HorizontalAlignment="Stretch">
            <Grid  HorizontalAlignment="Left" Name="Grid6" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Content="date of birth:" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Margin="3" VerticalAlignment="Center" />
                <DatePicker Grid.Column="1" Grid.Row="0" Height="25" HorizontalAlignment="Left" Margin="3" Name="Date_of_birthDatePicker" SelectedDate="{Binding Path=date_of_birth, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" VerticalAlignment="Center" Width="115" TabIndex="3" />
            </Grid>
            <Grid HorizontalAlignment="Left" Name="Grid7" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Content="phone:" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Margin="3" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Grid.Row="0" Height="23" HorizontalAlignment="Left" Margin="3" Name="PhoneTextBox" Text="{Binding Path=phone, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" VerticalAlignment="Center" Width="120" TabIndex="4" />
            </Grid>
            </StackPanel>
            <Grid  HorizontalAlignment="Left" Name="Grid8" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Content="address 1:" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Margin="3" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Height="23" HorizontalAlignment="Left" Margin="3,3,0,3" Name="Address_oneTextBox" Text="{Binding Path=address_one, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" VerticalAlignment="Center" Width="205" TabIndex="5" />
            </Grid>
            <Grid  HorizontalAlignment="Left" Name="Grid9" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Content="address 2:" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Margin="3" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Height="23" HorizontalAlignment="Left" Margin="3,3,0,3" Name="Address_twoTextBox" Text="{Binding Path=address_two, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" VerticalAlignment="Center" Width="205" TabIndex="6" />
            </Grid>
            <Grid HorizontalAlignment="Left" Name="Grid10" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Content="address 3:" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Margin="3" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Height="23" Margin="3,3,0,3" Name="Address_threeTextBox" Text="{Binding Path=address_three, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" VerticalAlignment="Center" Width="206" TabIndex="7" />
            </Grid>
        <StackPanel Orientation="Horizontal" Width="Auto" HorizontalAlignment="Stretch">
            <Grid HorizontalAlignment="Left" Name="Grid11" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Content="city:" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Margin="3" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Height="23" HorizontalAlignment="Left" Margin="3,3,0,3" Name="CityTextBox" Text="{Binding Path=city, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" VerticalAlignment="Center" Width="197" TabIndex="8" />
            </Grid>
                <Grid HorizontalAlignment="Left" Name="Grid12" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Content="state:" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Margin="3" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Grid.Row="0" Height="23" HorizontalAlignment="Left" Margin="3" Name="StateTextBox" Text="{Binding Path=state, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" VerticalAlignment="Center" Width="120" TabIndex="9" />
                </Grid>
                <Grid HorizontalAlignment="Left" Name="Grid13" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Content="zip:" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Margin="3" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Grid.Row="0" Height="23" HorizontalAlignment="Left" Margin="3" Name="ZipTextBox" Text="{Binding Path=zip, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" VerticalAlignment="Center" Width="120" TabIndex="10" />
                </Grid>
            </StackPanel>
        </StackPanel>
        <Button Content="SAVE" Grid.Row="3" Height="Auto" HorizontalAlignment="Left" Margin="0" Name="cmdSave" VerticalAlignment="Stretch" Width="80" FontWeight="Bold" />
        <Button Content="CANCEL" Grid.Row="3" FontWeight="Bold" Height="Auto" HorizontalAlignment="Left" Margin="100,0,0,0" Name="cmdCancel" VerticalAlignment="Stretch" Width="80"  />
    </Grid>
</Window>
