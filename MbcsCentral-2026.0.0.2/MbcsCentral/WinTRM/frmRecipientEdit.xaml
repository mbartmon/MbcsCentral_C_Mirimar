<Window
    x:Class="MbcsCentral.WinTrm.frmRecipientEdit"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:my="clr-namespace:WinTRM"
    Title="fmrRecipients"
    Width="846.091"
    Height="410"
    Background="{StaticResource {x:Static SystemColors.InactiveBorderBrushKey}}"
    mc:Ignorable="d">
    <Window.Resources>
        <CollectionViewSource x:Key="RecipientsViewSource" />
    </Window.Resources>
    <Grid DataContext="{StaticResource RecipientsViewSource}">
        <Grid.RowDefinitions>
            <RowDefinition Height="41" />
            <RowDefinition Height="35" />
            <RowDefinition Height="295*" />
        </Grid.RowDefinitions>
        <Border
            Name="Border1"
            Width="112"
            Height="41"
            Margin="0"
            Padding="7"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{StaticResource {x:Static SystemColors.GradientActiveCaptionBrushKey}}"
            BorderBrush="{StaticResource {x:Static SystemColors.ControlTextBrushKey}}"
            BorderThickness="2"
            CornerRadius="30">
            <TextBlock
                Name="TextBlock1"
                HorizontalAlignment="Center"
                FontSize="18"
                FontWeight="Bold"
                Text="Recipients" />
        </Border>
        <StackPanel
            Name="StackPanel1"
            Grid.Row="1"
            Orientation="Horizontal">
            <Button
                Name="cmdAdd"
                Width="100"
                Height="Auto"
                Margin="10,0,0,0"
                VerticalAlignment="Bottom"
                Content="ADD Recipient" />
            <Button
                Name="cmdImport"
                Width="100"
                Height="Auto"
                Margin="10,0,0,0"
                VerticalAlignment="Bottom"
                Click="cmdImport_Click"
                Content="IMPORT" />
            <Button
                Name="cmdDelete"
                Width="100"
                Height="Auto"
                Margin="10,0,0,0"
                VerticalAlignment="Bottom"
                Content="DELETE All" />
            <Button
                Name="cmdExit"
                Width="100"
                Height="Auto"
                Margin="10,0,0,0"
                VerticalAlignment="Bottom"
                Click="cmdExit_Click"
                Content="EXIT" />
        </StackPanel>
        <DataGrid
            Name="datRecipients"
            Grid.Row="2"
            AutoGenerateColumns="True"
            ItemsSource="{Binding}">
            <DataGrid.ContextMenu>
                <ContextMenu Name="RecipientEdit">
                    <MenuItem Click="EditRecip" Header="Edit" />
                    <MenuItem Click="DeleteRecip" Header="Delete" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </Grid>
</Window>
