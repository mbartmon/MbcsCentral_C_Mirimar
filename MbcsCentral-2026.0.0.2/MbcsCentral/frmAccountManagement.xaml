<Window x:Class="MbcsCentral.frmAccountManagement"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:l="clr-namespace:MbcsCentral"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Name="formAccountManagement"
        Title="User Account Management"
        Width="772.704"
        Height="509"
        Background="Bisque"
        Closed="formAccountManagement_Closed"
        Loaded="formAccountManagement_Loaded"
        mc:Ignorable="d">

    <Window.Resources>
        <CollectionViewSource x:Key="MailTags" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="25" />
        </Grid.RowDefinitions>
        <Border Width="Auto"
                Margin="10,10,10,10"
                HorizontalAlignment="Stretch"
                Background="#99FFFFFF"
                BorderBrush="#CCCCFF"
                BorderThickness="2"
                CornerRadius="5">
            <TabControl x:Name="tabCtrl"
                        Background="LightGray"
                        BorderBrush="Blue"
                        SelectedIndex="{Binding Mode=OneWay}">
                <TabItem Name="tabUser"
                         Background="LightGray"
                         FontSize="14"
                         FontWeight="Bold"
                         Header="User Info"
                         IsSelected="True">
                    <Grid Name="UserGrid"
                          Margin="5,11,0,0"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="35" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.RowSpan="8"
                                    Grid.Column="2"
                                    Width="Auto"
                                    HorizontalAlignment="Stretch">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="Blue"
                                       Text="EMAIL ADDRESSES" />
                            <DataGrid Name="lstEmails" 
                                      ItemsSource="{Binding}" 
                                      CanUserAddRows="False"
                                      AutoGenerateColumns="False">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Name="ctxEmailsAdd"
                                                  Click="ctxEmailsAdd_Click"
                                                  Header="ADD" />
                                        <MenuItem Name="ctxEmailsDelete"
                                                  Click="ctxEmailsDelete_Click"
                                                  Header="DELETE" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="140" Header="Purpose">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Name="txtMailTag"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding MailTag}"
                                                           TextAlignment="Left"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox Name="lstMailTags"
                                                        DisplayMemberPath="MailTag"
                                                        ItemsSource="{Binding Source={StaticResource MailTags}}"
                                                        SelectedValue="{Binding MailTag}"
                                                        SelectedValuePath="MailTag" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="230" Header="Email Address">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox LostFocus="TextBox_LostFocus" Text="{Binding EmailAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Margin="3"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Content="Id:" />
                        <TextBox x:Name="clientIdTextBox"
                                 Grid.Row="0"
                                 Grid.Column="1"
                                 Width="60"
                                 Height="23"
                                 Margin="3"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 IsReadOnly="True"
                                 Text="{Binding clientId,
                                                Mode=OneWay}" />
                        <Label Grid.Row="1"
                               Grid.Column="0"
                               Margin="3"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Content="Name:" />
                        <TextBox x:Name="clientNameTextBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Width="250"
                                 Height="23"
                                 Margin="3"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Text="{Binding clientName,
                                                Mode=TwoWay,
                                                NotifyOnValidationError=true,
                                                ValidatesOnExceptions=true}" />
                        <Label Grid.Row="2"
                               Grid.Column="0"
                               Margin="3"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Content="Address 1:" />
                        <TextBox x:Name="clientAddress1TextBox"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 Width="250"
                                 Height="23"
                                 Margin="3"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Text="{Binding clientAddress1,
                                                Mode=TwoWay,
                                                NotifyOnValidationError=true,
                                                ValidatesOnExceptions=true}" />
                        <Label Grid.Row="3"
                               Grid.Column="0"
                               Margin="3"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Content="Address 2:" />
                        <TextBox x:Name="clientAddress2TextBox"
                                 Grid.Row="3"
                                 Grid.Column="1"
                                 Width="250"
                                 Height="23"
                                 Margin="3"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Text="{Binding clientAddress2,
                                                Mode=TwoWay,
                                                NotifyOnValidationError=true,
                                                ValidatesOnExceptions=true}" />
                        <Label Grid.Row="4"
                               Grid.Column="0"
                               Margin="3"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Content="City:" />
                        <TextBox x:Name="clientCityTextBox"
                                 Grid.Row="4"
                                 Grid.Column="1"
                                 Width="250"
                                 Height="23"
                                 Margin="3"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Text="{Binding clientCity,
                                                Mode=TwoWay,
                                                NotifyOnValidationError=true,
                                                ValidatesOnExceptions=true}" />
                        <Label Grid.Row="5"
                               Grid.Column="0"
                               Margin="3"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Content="State:" />
                        <TextBox x:Name="clientStateTextBox"
                                 Grid.Row="5"
                                 Grid.Column="1"
                                 Width="250"
                                 Height="23"
                                 Margin="3"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Text="{Binding clientState,
                                                Mode=TwoWay,
                                                NotifyOnValidationError=true,
                                                ValidatesOnExceptions=true}" />
                        <Label Grid.Row="6"
                               Grid.Column="0"
                               Margin="3"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Content="Zip:" />
                        <TextBox x:Name="clientZipTextBox"
                                 Grid.Row="6"
                                 Grid.Column="1"
                                 Width="250"
                                 Height="23"
                                 Margin="3"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Text="{Binding clientZip,
                                                Mode=TwoWay,
                                                NotifyOnValidationError=true,
                                                ValidatesOnExceptions=true}" />
                        <Label Grid.Row="7"
                               Grid.Column="0"
                               Margin="3"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Content="Phone:" />
                        <TextBox x:Name="clientPhoneTextBox"
                                 Grid.Row="7"
                                 Grid.Column="1"
                                 Width="250"
                                 Height="23"
                                 Margin="3"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Text="{Binding clientPhone,
                                                Mode=TwoWay,
                                                NotifyOnValidationError=true,
                                                ValidatesOnExceptions=true}" />
                        <StackPanel Grid.Row="9"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Orientation="Horizontal">
                            <Button Name="cmdSave"
                                    Click="cmdSave_Click"
                                    Content="Save Changes" />
                            <Button Name="cmdAbandon"
                                    Margin="10,0,0,0"
                                    Click="cmdAbandon_Click"
                                    Content="Abandon Changes" />
                        </StackPanel>
                        <StackPanel Grid.Row="9"
                                    Grid.Column="2"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal">
                            <Button Name="cmdAddEmail"
                                    Click="cmdAddEmail_Click"
                                    Content="Add Email" />
                            <Button Name="cmdDeleteEmail"
                                    Margin="5,0,0,0"
                                    Click="cmdDeleteEmail_Click"
                                    Content="Delete Email" />
                        </StackPanel>
                    </Grid>

                </TabItem>
                <TabItem Background="LightBlue"
                         FontSize="14"
                         FontWeight="bold"
                         Header="Accounts"
                         IsSelected="False">
                    <StackPanel>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="35" />
                            </Grid.RowDefinitions>
                            <ListBox x:Name="lstAccounts"
                                     DisplayMemberPath="Name"
                                     ItemsSource="{Binding}"
                                     SelectedValuePath="accountId">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="AcctEdit"
                                                  Click="AcctEdit_Click"
                                                  Header="Edit" />
                                        <MenuItem x:Name="AcctRemove"
                                                  Click="AcctRemove_Click"
                                                  Header="Remove" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>
                            <StackPanel Grid.Row="1"
                                        Margin="5,5,0,0"
                                        HorizontalAlignment="Left"
                                        Orientation="Horizontal">
                                <Button x:Name="cmdAdd"
                                        Click="cmdAdd_Click"
                                        Content="New Account" />
                                <Button x:Name="cmdEdit"
                                        Margin="5,0,0,0"
                                        Click="AcctEdit_Click"
                                        Content="Edit Account" />
                                <Button x:Name="cmdRemove"
                                        Margin="5,0,0,0"
                                        Click="AcctRemove_Click"
                                        Content="Remove Account" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </TabItem>
                <TabItem Background="Bisque"
                         FontSize="14"
                         FontWeight="Bold"
                         Header="Groups"
                         IsSelected="False">
                    <StackPanel Background="Bisque">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="35" />
                            </Grid.RowDefinitions>
                            <ListBox x:Name="lstGroups"
                                     DisplayMemberPath="group_name"
                                     ItemsSource="{Binding}"
                                     SelectedValuePath="group_id">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Name="grpEdit"
                                                  Click="cmdEditGroup_Click"
                                                  Header="Edit" />
                                        <MenuItem Name="grpRemove"
                                                  Click="cmdRemoveGroup_Click"
                                                  Header="Remove" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>
                            <StackPanel Grid.Row="1" Orientation="Horizontal">
                                <Button Name="cmdAddGroup"
                                        Margin="5,0,5,0"
                                        Click="cmdAddGruoup_Click"
                                        Content="New Group" />
                                <Button Name="cmdEditGroup"
                                        Margin="5,0,5,0"
                                        Click="cmdEditGroup_Click"
                                        Content="Edit Group" />
                                <Button Name="cmdRemoveGroup"
                                        Margin="5,0,5,0"
                                        Click="cmdRemoveGroup_Click"
                                        Content="Remove Group" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </TabItem>
                <TabItem Name="tabPermissions"
                         Background="AntiqueWhite"
                         FontSize="14"
                         FontWeight="Bold"
                         Header="Permissions">
                    <TabControl Name="tabPerms" SelectionChanged="tabPerms_SelectionChanged">
                        <TabItem Name="tabAccountPerms"
                                 Background="AliceBlue"
                                 FontSize="12"
                                 FontWeight="Normal"
                                 Header="Accounts">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="15" />
                                    <RowDefinition Height="30" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Height="23"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Bottom"
                                               FontSize="11"
                                               Text="Name" />
                                    <ListBox Name="lstAccountPerms"
                                             HorizontalAlignment="Stretch"
                                             DisplayMemberPath="Name"
                                             ItemsSource="{Binding}"
                                             SelectedValuePath="accountId"
                                             SelectionChanged="lstAccountPerms_SelectionChanged"
                                             SelectionMode="Single" />
                                </StackPanel>
                                <DataGrid Name="grdAccountPerms"
                                          Grid.Column="1"
                                          AutoGenerateColumns="False"
                                          FontSize="11"
                                          ItemsSource="{Binding}">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PermissionType}" Value="0">
                                                    <Setter Property="Background" Value="Azure" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding Name,
                                                                              Mode=OneWay}"
                                                            Header="Name"
                                                            IsReadOnly="True" />
                                        <DataGridTextColumn Binding="{Binding Description,
                                                                              Mode=OneWay}"
                                                            Header="Description"
                                                            IsReadOnly="True" />
                                        <DataGridCheckBoxColumn Binding="{Binding Access, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Access" />
                                        <DataGridCheckBoxColumn Binding="{Binding Modify, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Modify" />
                                        <DataGridCheckBoxColumn Binding="{Binding Remove, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Remove" />
                                        <DataGridCheckBoxColumn Binding="{Binding Print, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Print" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Grid.Row="2"
                                            Grid.ColumnSpan="2"
                                            Orientation="Horizontal">
                                    <Button Name="cmdPermsSave"
                                            Margin="10,0,0,0"
                                            Click="cmdPermsSave_Click"
                                            Content="SAVE Changes" />
                                    <Button Name="cmdPermsAbandon"
                                            Margin="10,0,0,0"
                                            Click="cmdPermsAbandon_Click"
                                            Content="ABANDON Changes" />
                                </StackPanel>
                            </Grid>
                        </TabItem>
                        <TabItem Name="tabGroupPerms"
                                 Background="Aqua"
                                 FontSize="12"
                                 FontWeight="Normal"
                                 Header="Groups">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="15" />
                                    <RowDefinition Height="30" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Height="23"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Bottom"
                                               FontSize="11"
                                               Text="Name" />
                                    <ListBox Name="lstGroupPerms"
                                             HorizontalAlignment="Stretch"
                                             DisplayMemberPath="group_name"
                                             ItemsSource="{Binding}"
                                             SelectedValuePath="group_id"
                                             SelectionChanged="lstGroupPerms_SelectionChanged"
                                             SelectionMode="Single" />
                                </StackPanel>
                                <DataGrid Name="grdGroupPerms"
                                          Grid.Column="1"
                                          AutoGenerateColumns="False"
                                          FontSize="11"
                                          ItemsSource="{Binding}">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PermissionType}" Value="0">
                                                    <Setter Property="Background" Value="Azure" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding Name,
                                                                              Mode=OneWay}"
                                                            Header="Name"
                                                            IsReadOnly="True" />
                                        <DataGridTextColumn Binding="{Binding Description,
                                                                              Mode=OneWay}"
                                                            Header="Description"
                                                            IsReadOnly="True" />
                                        <DataGridCheckBoxColumn Binding="{Binding Access, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Access" />
                                        <DataGridCheckBoxColumn Binding="{Binding Modify, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Modify" />
                                        <DataGridCheckBoxColumn Binding="{Binding Remove, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Remove" />
                                        <DataGridCheckBoxColumn Binding="{Binding Print, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Print" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Grid.Row="2"
                                            Grid.ColumnSpan="2"
                                            Orientation="Horizontal">
                                    <Button Name="cmdGroupPermsSave"
                                            Margin="10,0,0,0"
                                            Click="cmdGroupPermsSave_Click"
                                            Content="SAVE Changes" />
                                    <Button Name="cmdGroupPermsAbandon"
                                            Margin="10,0,0,0"
                                            Click="cmdGroupPermsAbandon_Click"
                                            Content="ABANDON Changes" />
                                </StackPanel>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </TabItem>
            </TabControl>
        </Border>
        <Button Name="cmdClose"
                Grid.Row="1"
                Click="cmdClose_Click"
                Content="CLOSE" />
    </Grid>
</Window>
