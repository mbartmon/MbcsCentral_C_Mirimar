<Window x:Class="MbcsCentral.frmDatabasesEdit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:MbcsCentral"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Name="formDatabaseEdit"
        Title="Database Edit"
        Width="350"
        Height="300"
        Background="AliceBlue"
        Closed="formDatabaseEdit_Closed"
        Loaded="formDatabaseEdit_Loaded"
        SizeToContent="WidthAndHeight"
        TextBlock.FontSize="14"
        TextBlock.FontWeight="Bold"
        TextBlock.TextAlignment="Center"
        mc:Ignorable="d">
    <Border BorderBrush="Blue"
            BorderThickness="3"
            CornerRadius="5">
        <Grid Width="Auto"
              HorizontalAlignment="Left"
              TextBlock.FontSize="12"
              TextBlock.TextAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Grid.Column="0"
                    Margin="10"
                    BorderBrush="Blue"
                    BorderThickness="1"
                    CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Source Database" TextAlignment="Center" />
                    <ListBox Name="lstSources"
                             Background="White"
                             DisplayMemberPath="DisplayName"
                             ItemsSource="{Binding}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=Current}" Value="True">
                                        <Setter Property="ListBoxItem.Foreground" Value="Red" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Path=Current}" Value="False">
                                        <Setter Property="ListBoxItem.Foreground" Value="Black" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </StackPanel>
            </Border>
            <Border Grid.Row="0"
                    Grid.Column="1"
                    Margin="10"
                    BorderBrush="Blue"
                    BorderThickness="1"
                    CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Target Database" TextAlignment="Center" />
                    <ListBox Name="lstTargets"
                             Background="White"
                             DisplayMemberPath="DisplayName"
                             ItemsSource="{Binding}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=Current}" Value="True">
                                        <Setter Property="ListBoxItem.Foreground" Value="Red" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Path=Current}" Value="False">
                                        <Setter Property="ListBoxItem.Foreground" Value="Black" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="1" Grid.Column="0">
                <Button Name="cmdCopy"
                        HorizontalAlignment="Center"
                        Click="cmdCopy_Click"
                        Content="COPY" />
                <Button Name="cmdDelete"
                        Margin="0,5,0,0"
                        HorizontalAlignment="Center"
                        Click="cmdDelete_Click"
                        Content="DELETE" />
                <Button Name="cmdExit"
                        Margin="0,5,0,0"
                        HorizontalAlignment="Center"
                        Click="cmdExit_Click"
                        Content="EXIT" />
            </StackPanel>
            <Border Grid.Row="1"
                    Grid.Column="1"
                    BorderBrush="Black"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="3">
                <TextBlock FontSize="12"
                           FontStyle="Italic"
                           FontWeight="Normal"
                           Foreground="DarkBlue"
                           TextWrapping="Wrap">
                    <Bold>Copy:</Bold>
                    Select a Source and Target Database then click the
                    <Bold>COPY</Bold>
                    button.
                    <LineBreak />
                    <LineBreak />
                    <Bold>Delete:</Bold>
                    Select a Source Database then click the
                    <Bold>DELETE</Bold>
                    button.
                    <LineBreak />
                    <LineBreak />
                    <Bold>NOTE:</Bold>
                    The main database (in
                    <Span Foreground="Red">RED</Span>
                    ) cannot be deleted.
                </TextBlock>
            </Border>
        </Grid>
    </Border>
</Window>
