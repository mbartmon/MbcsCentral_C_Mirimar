<Window x:Class="MbcsCentral.frmLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="formLogin"
        Title="MbcsCentral Login"
        Width="415"
        Height="226"
        Background="LightGray"
        Loaded="formLogin_Loaded">
    <Window.Resources>
        <BitmapImage x:Key="Logo" UriSource="../CITYSCPE_raw.bmp" />
        <!--
            <ResourceDictionary>
            <BitmapImage x:Key="LogoPicture" >CITYSCPE_raw.bmp</BitmapImage>
            </ResourceDictionary>
        -->
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Image Source="{StaticResource Logo}" Stretch="UniformToFill" Margin="0,0,239,0" Grid.ColumnSpan="2" />
        <StackPanel Grid.Column="1">
            <TextBlock Margin="34,40,0,0" Text="User Name" />
            <TextBox Name="txtUsername"
                     Width="Auto"
                     Margin="33,0,5,0" />
            <TextBlock Margin="34,20,0,0" Text="Password" />
            <PasswordBox Name="txtPassword" Margin="33,0,5,0" />
            <StackPanel Margin="0,30,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                <Button Name="cmdOK"
                        Width="90"
                        Click="cmdOK_Click"
                        Content="OK"
                        IsDefault="True" />
                <Button Name="cmdCancel"
                        Width="90"
                        Margin="10,0,0,0"
                        Click="cmdCancel_Click"
                        Content="Cancel"
                        IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
