<Window
    x:Class="MbcsCentral.frmVendorNoticesEmail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MbcsCentral.WinPM"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:my="clr-namespace:MbcsCentral"
    Name="formNoticesEmail"
    Title="ACH Vendor Notices Email List ** NON-PAYROLL **"
    Width="796.476"
    Height="732"
    Closed="formNoticesEmail_Closed"
    Loaded="formNoticesEmail_Loaded"
    TextBlock.FontSize="14"
    TextBlock.FontWeight="Bold"
    TextBlock.TextAlignment="Center"
    mc:Ignorable="d">

    <Border
        Padding="2"
        BorderBrush="Blue"
        BorderThickness="3"
        CornerRadius="5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="79*" />
                <ColumnDefinition Width="183*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="50*" />
                <RowDefinition Height="30*" />
                <RowDefinition Height="35" />
            </Grid.RowDefinitions>
            <Border
                Name="bdrTenants"
                Grid.Row="0"
                Grid.ColumnSpan="2"
                BorderBrush="Blue"
                BorderThickness="1">
                <ListView
                    Name="lstTenants"
                    ItemsSource="{Binding}"
                    TextBlock.FontSize="12">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Send">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            Name="chkSend"
                                            IsChecked="{Binding SendEmail}"
                                            IsEnabled="{Binding CanSendEmail}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn DisplayMemberBinding="{Binding BuildingTenant}" Header="Tenant#" />
                            <GridViewColumn
                                Width="Auto"
                                DisplayMemberBinding="{Binding TenantName}"
                                Header="Name" />
                            <GridViewColumn Width="35" Header="Legal">
                                <GridViewColumn.DisplayMemberBinding>
                                    <MultiBinding StringFormat="{}{0}-{1}">
                                        <Binding Path="LegalCode" />
                                        <Binding Path="LegalCode2" />
                                    </MultiBinding>
                                </GridViewColumn.DisplayMemberBinding>
                            </GridViewColumn>

                            <GridViewColumn Width="Auto" Header="Email 1">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            Content="{Binding Email1}"
                                            IsChecked="{Binding UseEmail1}"
                                            IsEnabled="{Binding IsEmail1}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="Auto" Header="Email 2">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            Content="{Binding Email2}"
                                            IsChecked="{Binding UseEmail2}"
                                            IsEnabled="{Binding IsEmail2}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
            <Border
                Name="bdrVendors"
                Grid.Row="0"
                Grid.ColumnSpan="2"
                BorderBrush="Blue"
                BorderThickness="1">
                <ListView
                    x:Name="lstVendors"
                    ItemsSource="{Binding}"
                    TextBlock.FontSize="12">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Send">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            Name="chkVendorSend"
                                            IsChecked="{Binding Use}"
                                            IsEnabled="{Binding Use}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn
                                Width="Auto"
                                DisplayMemberBinding="{Binding VendorName}"
                                Header="Name" />
                            <GridViewColumn
                                Width="Auto"
                                DisplayMemberBinding="{Binding Email}"
                                Header="Email" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
            <Border
                Grid.RowSpan="2"
                Grid.ColumnSpan="2"
                Height="Auto"
                Margin="0,419,0,0"
                BorderBrush="Blue"
                BorderThickness="1"
                CornerRadius="3">
                <StackPanel Orientation="Horizontal">
                    <Border
                        Padding="2,0,2,0"
                        BorderBrush="Blue"
                        BorderThickness="2">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock>
                                Batch Limit<LineBreak />
                                (0=no limit):</TextBlock>
                            <my:NumberEntry
                                x:Name="txtLimit"
                                Width="35"
                                Margin="0,5,0,0"
                                Decimals="0"
                                MaxLength="2" />
                            <TextBlock>
                                Time Between<LineBreak />
                                Batches (Seconds)</TextBlock>
                            <my:NumberEntry
                                x:Name="txtDelay"
                                Width="50"
                                Margin="0,5,0,10"
                                Decimals="0"
                                MaxLength="3" />
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <Button
                                    Name="cmdSend"
                                    VerticalAlignment="Center"
                                    Click="cmdSend_Click"
                                    Content="SEND" />
                                <Button
                                    Name="cmdCancel"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    Click="cmdCancel_Click"
                                    Content="CANCEL" />
                            </StackPanel>
                            <CheckBox
                                Name="chkAlsoPrint"
                                Margin="5,10,0,0"
                                HorizontalAlignment="Center"
                                Content="Also Print"
                                IsChecked="{Binding AlsoPrint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Name="cmdTest"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Center"
                                Click="cmdTest_Click"
                                Content="TEST EMAIL" />
                        </StackPanel>
                    </Border>
                    <Grid
                        Name="EmailParms"
                        Height="Auto"
                        Margin="10,0,0,0"
                        DataContext="{Binding}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35" />
                            <RowDefinition Height="35" />
                            <RowDefinition Height="25*" />
                            <RowDefinition Height="100*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="From Name" />
                        <TextBox
                            Name="txtFromName"
                            Grid.Column="1"
                            Width="400"
                            Margin="3"
                            Text="{Binding DisplayName}"
                            TextAlignment="Left" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="ReplyTo?" />
                            <CheckBox
                                x:Name="chkReplyTo"
                                Margin="2,0,0,0"
                                VerticalAlignment="Center"
                                FlowDirection="RightToLeft" />
                        </StackPanel>
                        <ComboBox
                            Name="lstReplyTo"
                            Grid.Row="1"
                            Grid.Column="1"
                            Width="400"
                            Height="30"
                            Margin="3,0,0,0"
                            VerticalAlignment="Center"
                            IsEditable="True"
                            IsEnabled="{Binding ElementName=chkReplyTo, Path=IsChecked}"
                            ItemsSource="{Binding Path=ReturnAddresses, UpdateSourceTrigger=PropertyChanged}"
                            TextBlock.TextAlignment="Left" />


                        <TextBlock
                            Grid.Row="2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="Email Subject" />
                        <TextBox
                            Name="txtSubject"
                            Grid.Row="2"
                            Grid.Column="1"
                            Width="400"
                            Margin="3"
                            Text="{Binding EmailSubject, Mode=TwoWay}"
                            TextAlignment="Left" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Width="Auto"
                            Margin="3,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="Message" />
                        <Border
                            Grid.Row="3"
                            Grid.Column="1"
                            Height="Auto"
                            Margin="3,3,3,3"
                            VerticalAlignment="Stretch"
                            BorderBrush="Azure"
                            BorderThickness="2"
                            CornerRadius="3">

                            <TextBox
                                Name="txtMessage"
                                Width="400"
                                Height="Auto"
                                VerticalAlignment="Stretch"
                                AcceptsReturn="True"
                                Text="{Binding Message, Mode=TwoWay}"
                                TextAlignment="Left"
                                TextWrapping="Wrap" />
                        </Border>
                        <Border
                            Grid.RowSpan="4"
                            Grid.Column="2"
                            Padding="3"
                            BorderBrush="Blue"
                            BorderThickness="2">
                            <StackPanel>
                                <TextBlock Text="Return Receipt" />
                                <CheckBox
                                    Name="chkReceipt"
                                    HorizontalAlignment="Center"
                                    IsChecked="{Binding ReturnReceipt}" />
                                <Border
                                    Margin="0,5,0,0"
                                    BorderBrush="Blue"
                                    BorderThickness="2" />
                                <TextBox
                                    BorderBrush="Black"
                                    BorderThickness="1"
                                    IsReadOnly="True"
                                    Text="INSERTION FIELDS" />
                                <ListBox Name="lstInsertionFields" ItemsSource="{Binding}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
            <Border
                Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Height="31"
                VerticalAlignment="Center"
                BorderBrush="Azure"
                BorderThickness="3"
                IsEnabled="True">
                <StackPanel
                    Name="pnlSavedMessages"
                    Margin="3,0,0,0"
                    VerticalAlignment="Center"
                    IsEnabled="True"
                    Orientation="Horizontal"
                    TextBlock.FontSize="16">
                    <CheckBox
                        Name="chkSendToMe"
                        Height="30"
                        Margin="0,6,0,0"
                        Click="ChkSendToMe_Click"
                        FlowDirection="RightToLeft"
                        IsChecked="{Binding SendCopy}">
                        <TextBlock Margin="0,-3,0,0" Text="Send Copy To Me" />

                    </CheckBox>
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Text="Saved Messages" />
                    <ComboBox
                        Name="lstMessages"
                        Width="310"
                        Margin="5,0,0,0"
                        DisplayMemberPath="name"
                        ItemsSource="{Binding}"
                        SelectionChanged="LstMessages_SelectionChanged" />
                    <Button
                        Name="cmdSave"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Click="CmdSave_Click"
                        Content="SAVE MSG" />
                    <Button
                        Name="cmdDelete"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Click="CmdDelete_Click"
                        Content="DEL MSG"
                        Visibility="Collapsed" />
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>
