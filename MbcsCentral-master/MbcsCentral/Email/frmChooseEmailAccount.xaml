<Window x:Class="MbcsCentral.Email.frmChooseEmailAccount"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:MbcsCentral.Email"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Name="formChooseEmailAccount"
        Title="Choose Email Account"
        Width="300"
        Height="300"
        Background="LightBlue"
        FontSize="14"
        FontWeight="Bold"
        Loaded="Window_Loaded"
        TextBlock.TextAlignment="Center"
        mc:Ignorable="d">
    <Border BorderBrush="Blue"
            BorderThickness="3"
            CornerRadius="5">
        <Grid TextBlock.FontSize="12" TextBlock.TextAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="55" />
                <RowDefinition />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <TextBlock Margin="5"
                       Text="Please choose the email account you wish to use for this message and DoubleClick or press ENTER."
                       TextWrapping="Wrap" />
            <ListBox Name="lstEmails"
                     Grid.Row="1"
                     DisplayMemberPath="DisplayItem"
                     ItemsSource="{Binding}"
                     MouseDoubleClick="lstEmails_MouseDoubleClick"
                     SelectedValuePath="ValueItem" />
            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <Button Name="cmdSelect"
                        Margin="10,0,0,0"
                        Click="cmdSelect_Click"
                        Content="SELECT"
                        IsDefault="True" />
                <Button Name="cmdCancel"
                        Margin="10,0,0,0"
                        Click="cmdCancel_Click"
                        Content="CANCEL"
                        IsCancel="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
