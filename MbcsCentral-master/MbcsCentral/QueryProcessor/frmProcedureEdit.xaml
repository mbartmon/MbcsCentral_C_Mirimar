
<Window
    x:Class="MbcsCentral.frmProcedureEdit"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Name="FormfrmProcedureEdit"
    Title="Procedure Edit"
    Width="748.771"
    Height="411"
    Background="AliceBlue"
    Closed="frmProcedureEdit_Closed"
    FontSize="14"
    FontWeight="Bold"
    Loaded="frmProcedureEdit_Loaded"
    TextBlock.TextAlignment="Center">
    <Border
        BorderBrush="Blue"
        BorderThickness="3"
        CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="35" />
            </Grid.RowDefinitions>
            <TextBox
                Background="LightSteelBlue"
                BorderBrush="Blue"
                BorderThickness="2"
                FontSize="14"
                FontWeight="Bold"
                Text="Procedure Edit"
                TextAlignment="Center" />
            <Grid
                Name="grdMain"
                Grid.Row="1"
                DataContext="{Binding}">
                <!--  Place your content here  -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel
                    Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal">
                    <TextBox
                        Margin="5,0,5,0"
                        VerticalAlignment="Center"
                        Text="Query" />
                    <ComboBox
                        Name="lstQueries"
                        Width="500"
                        VerticalAlignment="Center"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding}"
                        SelectionChanged="lstQueries_SelectionChanged" />
                </StackPanel>
                <StackPanel
                    Grid.Row="1"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock Margin="5,0,0,0" Text="Parm 1" />
                    <TextBox
                        Name="txtParm1"
                        Width="300"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        MaxLength="50"
                        Text="{Binding Path=Parm1, UpdateSourceTrigger=PropertyChanged}"
                        TextAlignment="Left" />
                </StackPanel>
                <StackPanel
                    Grid.Row="1"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock Margin="5,0,0,0" Text="Parm 2" />
                    <TextBox
                        Name="txtParm2"
                        Width="300"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        MaxLength="50"
                        Text="{Binding Path=Parm2, UpdateSourceTrigger=PropertyChanged}"
                        TextAlignment="Left" />
                </StackPanel>
                <StackPanel
                    Grid.Row="2"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock Margin="5,0,0,0" Text="Parm 3" />
                    <TextBox
                        Name="txtParm3"
                        Width="300"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        MaxLength="50"
                        Text="{Binding Path=Parm3, UpdateSourceTrigger=PropertyChanged}"
                        TextAlignment="Left" />
                </StackPanel>
                <StackPanel
                    Grid.Row="2"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock Margin="5,0,0,0" Text="Parm 4" />
                    <TextBox
                        Name="txtParm4"
                        Width="300"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        MaxLength="50"
                        Text="{Binding Path=Parm4, UpdateSourceTrigger=PropertyChanged}"
                        TextAlignment="Left" />
                </StackPanel>
                <StackPanel
                    Grid.Row="3"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock Margin="5,0,0,0" Text="Parm 5" />
                    <TextBox
                        Name="txtParm5"
                        Width="300"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        MaxLength="50"
                        Text="{Binding Path=Parm5, UpdateSourceTrigger=PropertyChanged}"
                        TextAlignment="Left" />
                </StackPanel>
                <Button
                    Name="cmdBuilder"
                    Grid.Row="3"
                    Grid.Column="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Click="cmdBuilder_Click"
                    Content="Query Builder" 
                    IsEnabled="True"/>
                <TextBlock
                    Grid.Row="4"
                    Grid.ColumnSpan="2"
                    Height="20"
                    Background="Aqua"
                    Text="SQL Query" />

                <DockPanel
                    Name="pnlQuery"
                    Grid.Row="5"
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Stretch">
                    <TextBox
                        Name="txtQuery"
                        Height="{Binding ActualHeight, ElementName=pnlQuery}"
                        AcceptsReturn="True"
                        Text="{Binding Path=Query, UpdateSourceTrigger=PropertyChanged}"
                        TextAlignment="Left"
                        TextWrapping="Wrap" />
                </DockPanel>
            </Grid>
            <StackPanel
                Grid.Row="2"
                Margin="0,5,0,5"
                Background="AliceBlue"
                Orientation="Horizontal">
                <Button
                    Name="cmdSave"
                    Margin="10,0,0,0"
                    Click="cmdSave_Click"
                    Content="SAVE" />
                <Button
                    Name="cmdValidate"
                    Margin="10,0,0,0"
                    Click="cmdValidate_Click"
                    Content="VALIDATE QUERY" />
                <Button
                    Name="cmdAdd"
                    Margin="10,0,0,0"
                    Click="cmdAdd_Click"
                    Content="ADD" />
                <Button
                    Name="cmdDelete"
                    Margin="10,0,0,0"
                    Click="cmdDelete_Click"
                    Content="DELETE" />
                <Button
                    Name="cmdClose"
                    Margin="10,0,0,0"
                    Click="cmdClose_Click"
                    Content="CLOSE" />
                <Button
                    Name="cmdTest"
                    Margin="30,0,0,0"
                    Click="cmdTest_Click"
                    Content="Test Query" />
                <Button Name="cmdHelp" Margin="30,0,0,0" Click="cmdHelp_Click" Content="HELP"/>

            </StackPanel>
        </Grid>
    </Border>
</Window>
