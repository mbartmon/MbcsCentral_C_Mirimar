

<Window
    x:Class="MbcsCentral.frmQueryBuilder"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:my="clr-namespace:MbcsCentral"
    Name="FormfrmQueryBuilder"
    Title="Query Builder"
    Width="1033.06"
    Height="326.712"
    Background="AliceBlue"
    Closed="frmQueryBuilder_Closed"
    FontSize="14"
    FontWeight="Bold"
    Loaded="frmQueryBuilder_Loaded"
    TextBlock.TextAlignment="Center">
    <Border
        BorderBrush="Blue"
        BorderThickness="3"
        CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <TextBox
                Background="LightSteelBlue"
                BorderBrush="Blue"
                BorderThickness="2"
                FontSize="14"
                FontWeight="Bold"
                Text="Query Builder"
                TextAlignment="Center" />
            <Grid Name="Content" Grid.Row="1">
                <!--  Place your content here  -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="175" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel LastChildFill="True">
                    <TextBlock
                        Background="LightBlue"
                        DockPanel.Dock="Top"
                        Text=" Tables"
                        TextAlignment="Left" />
                    <ListBox
                        Name="lstTables"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding}"
                        MouseDoubleClick="lstTables_MouseDoubleClick"
                        PreviewMouseLeftButtonDown="lstTables_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="lstTables_MouseMove"
                        ScrollViewer.VerticalScrollBarVisibility="Visible" />
                </DockPanel>
                <Grid
                    Grid.Column="1"
                    Margin="5"
                    TextBlock.FontSize="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        BorderBrush="Blue"
                        BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Name="txtFields1"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="Bold">
                                <TextBlock.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem
                                            Name="ctxFields1"
                                            Click="CtxFields1_Click"
                                            Header="Remove Table" />
                                    </ContextMenu>
                                </TextBlock.ContextMenu>
                            </TextBlock>
                            <CheckBox
                                Name="chkFields1All"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Click="ChkFields1All_Checked"
                                Content="ALL"
                                IsChecked="True" />
                        </StackPanel>
                    </Border>

                    <ListView
                        Name="Fields1"
                        Grid.Row="1"
                        Grid.Column="0"
                        Width="Auto"
                        ItemsSource="{Binding}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn DisplayMemberBinding="{Binding Name}" Header="Field" />
                                <GridViewColumn Header="Show">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Show, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Prompt">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Prompt}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Sort">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Sort, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Range">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox   IsChecked="{Binding Path=Range}"
                                                        IsEnabled="{Binding Path=Prompt}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Alias">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox
                                                Height="20"
                                                MinWidth="125"
                                                Text="{Binding Alias}"
                                                TextAlignment="Left" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>


                    <Border
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        BorderBrush="Blue"
                        BorderThickness="2">
                        <StackPanel>
                            <TextBlock Text="Index Field" />
                            <CheckBox
                                Name="chkComplexIndex"
                                Checked="chkComplexIndex_Checked"
                                Content="Use complex index" />
                            <Border
                                Name="bdrComplexIndex"
                                BorderBrush="Black"
                                BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox
                                            Name="lstIndex1a"
                                            Width="150"
                                            DisplayMemberPath="Name"
                                            ItemsSource="{Binding}" />
                                        <ComboBox
                                            Name="lstIndex1b"
                                            Width="150"
                                            DisplayMemberPath="Name"
                                            ItemsSource="{Binding}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox
                                            Name="lstIndex2a"
                                            Width="150"
                                            DisplayMemberPath="Name"
                                            ItemsSource="{Binding}" />
                                        <ComboBox
                                            Name="lstIndex2b"
                                            Width="150"
                                            DisplayMemberPath="Name"
                                            ItemsSource="{Binding}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox
                                            Name="lstIndex3a"
                                            Width="150"
                                            DisplayMemberPath="Name"
                                            ItemsSource="{Binding}" />
                                        <ComboBox
                                            Name="lstIndex3b"
                                            Width="150"
                                            DisplayMemberPath="Name"
                                            ItemsSource="{Binding}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border
                                Name="bdrSimpleIndex"
                                BorderBrush="Black"
                                BorderThickness="1">
                                <TextBlock Name="IndexField" Margin="3" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border
                        Grid.Row="0"
                        Grid.Column="2"
                        BorderBrush="Blue"
                        BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Name="txtFields2"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                FontWeight="Bold">
                                <TextBlock.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem
                                            Name="ctxFields2"
                                            Click="CtxFields2_Click"
                                            Header="Remove Table" />
                                    </ContextMenu>
                                </TextBlock.ContextMenu>
                            </TextBlock>
                            <CheckBox
                                Name="chkFields2All"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Click="ChkFields2All_Checked"
                                Content="ALL"
                                IsChecked="True" />
                        </StackPanel>
                    </Border>
                    <ListView
                        Name="Fields2"
                        Grid.Row="1"
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn DisplayMemberBinding="{Binding Name}" Header="Field" />
                                <GridViewColumn Header="Show">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Show}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Alias">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox
                                                Height="20"
                                                MinWidth="125"
                                                Text="{Binding Alias}"
                                                TextAlignment="Left" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>

            </Grid>
            <StackPanel
                Grid.Row="2"
                Margin="0,5,0,5"
                Background="AliceBlue"
                Orientation="Horizontal">
                <Button
                    Name="cmdSave"
                    Margin="10,0,0,0"
                    Click="cmdSave_Click"
                    Content="SAVE"
                    IsEnabled="True" />
                <Button
                    Name="cmdClose"
                    Margin="10,0,0,0"
                    Click="cmdClose_Click"
                    Content="CLOSE" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
