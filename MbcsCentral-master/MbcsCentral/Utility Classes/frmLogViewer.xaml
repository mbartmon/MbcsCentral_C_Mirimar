<Window
    x:Class="MbcsCentral.frmLogViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Name="FormfrmLogViewer"
    Title="Log Viewer"
    Width="496.78"
    Height="300"
    Background="AliceBlue"
    Closed="frmLogViewer_Closed"
    FontSize="14"
    FontWeight="Bold"
    Loaded="frmLogViewer_Loaded"
    TextBlock.TextAlignment="Center">
    <Border
        Margin="0,0,8,0"
        BorderBrush="Blue"
        BorderThickness="3"
        CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <TextBox
                Background="LightSteelBlue"
                BorderBrush="Blue"
                BorderThickness="2"
                FontSize="14"
                FontWeight="Bold"
                Text="Log Viewer"
                TextAlignment="Center" />
            <Grid Grid.Row="1">
                <!--  Place your content here  -->
                <TabControl TextBlock.FontSize="12">
                    <TabItem Header="MbcsCentral Log">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="5,0,0,0">
                                <StackPanel Orientation="Horizontal" >
                                    <CheckBox
                                    Name="chkMbcsCentral"
                                    VerticalAlignment="Center"
                                    Content="TAIL"
                                    IsChecked="True" />
                                    <ComboBox Name="lstMainLogs"
                                              ItemsSource="{Binding}"
                                              Margin="10,0,0,0"
                                              SelectionChanged="LstMainLogs_SelectionChanged"
                                              VerticalAlignment="Center"
                                              Width="300"
                                              Height="22"/>
                                </StackPanel>
                                <Border
                                    Height="2"
                                    BorderBrush="Black"
                                    BorderThickness="1" />
                            </StackPanel>
                            <ListBox
                                Name="lstMbcsCentral"
                                Grid.Row="1"
                                Height="Auto"
                                Margin="3"
                                VerticalAlignment="Stretch"
                                FontFamily="Courier New"
                                FontSize="11"
                                FontWeight="Normal" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="MbcsCentral Service Log">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="138*"/>
                                <ColumnDefinition Width="207*"/>
                                <ColumnDefinition Width="124*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="5,0,0,0" Grid.ColumnSpan="3">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox
                                        Name="chkMbcsCentralService"
                                        VerticalAlignment="Bottom"
                                        Content="TAIL"/>
                                    <ComboBox Name="lstServiceLogs"
                                              ItemsSource="{Binding}"
                                              Margin="10,0,0,0"
                                              SelectionChanged="LstMainLogs_SelectionChanged"
                                              VerticalAlignment="Center"
                                              Width="300"
                                              Height="22"/>
                                </StackPanel>
                                <Border
                                    Height="2"
                                    BorderBrush="Black"
                                    BorderThickness="1" />
                            </StackPanel>
                            <ListBox
                                Name="lstMbcsCentralService"
                                Grid.Row="1"
                                Height="Auto"
                                Margin="3"
                                VerticalAlignment="Stretch"
                                FontFamily="Courier New"
                                FontSize="11"
                                FontWeight="Normal" Grid.ColumnSpan="3" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="MbcsCentralBackup Log">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="15" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="5,0,0,0">
                                <CheckBox
                                    Name="chkMbcsCentralBackup"
                                    VerticalAlignment="Bottom"
                                    Content="TAIL"/>
                                <Border
                                    Height="2"
                                    BorderBrush="Black"
                                    BorderThickness="1" />
                            </StackPanel>
                            <ListBox
                                Name="lstMbcsCentralBackup"
                                Grid.Row="1"
                                Height="Auto"
                                Margin="3"
                                VerticalAlignment="Stretch"
                                FontFamily="Courier New"
                                FontSize="11"
                                FontWeight="Normal" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="MbcsCentralCleanUp Log">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="15" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="5,0,0,0">
                                <CheckBox
                                    Name="chkMbcsCentralCleanUp"
                                    VerticalAlignment="Bottom"
                                    Content="TAIL"/>
                                <Border
                                    Height="2"
                                    BorderBrush="Black"
                                    BorderThickness="1" />
                            </StackPanel>
                            <ListBox
                                Name="lstMbcsCentralCleanUp"
                                Grid.Row="1"
                                Height="Auto"
                                Margin="3"
                                VerticalAlignment="Stretch"
                                FontFamily="Courier New"
                                FontSize="11"
                                FontWeight="Normal" />
                        </Grid>

                    </TabItem>
                </TabControl>
            </Grid>
            <StackPanel
                Grid.Row="2"
                Margin="0,5,0,5"
                Background="AliceBlue"
                Orientation="Horizontal">
                <Button
                    Name="cmdClose"
                    Margin="10,0,0,0"
                    Click="cmdClose_Click"
                    Content="CLOSE" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
