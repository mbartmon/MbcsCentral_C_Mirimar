<Window x:Class="MbcsCentral.WinGL.frmGeneralLedger"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:MbcsCentral.WinGL"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Name="formGeneralLedgerReport"
        Title="General Ledger Report"
        Width="356.74"
        Height="338.028"
        Background="Azure"
        Closed="formGeneralLedgerReport_Closed"
        Loaded="formGeneralLedgerReport_Loaded"
        TextBlock.FontSize="14"
        TextBlock.FontWeight="Bold"
        TextBlock.TextAlignment="Center"
        mc:Ignorable="d">
    <Grid>
        <Border BorderBrush="Blue"
                BorderThickness="3"
                CornerRadius="5"
                Padding="5">
            <Grid Name="InnerGrid"
                  DataContext="{Binding}"
                  TextBlock.FontSize="12"
                  TextBlock.TextAlignment="Left">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Width="110"
                                   VerticalAlignment="Center"
                                   Text="Report Date" />
                        <DatePicker Name="dtReport"
                                    VerticalAlignment="Center"
                                    Text="{Binding ReportDate}" />
                    </StackPanel>
                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <TextBlock Width="110"
                                   VerticalAlignment="Center"
                                   Text="Company" />
                        <ComboBox Name="lstCompany"
                                  Width="200"
                                  Background="White"
                                  DisplayMemberPath="Name"
                                  ItemsSource="{Binding}"
                                  SelectedValuePath="CompanyNumber"
                                  SelectedValue="{Binding Company}"
                                  SelectionChanged="lstCompany_SelectionChanged"/>
                    </StackPanel>
                    <CheckBox Name="chkConDept"
                              Margin="0,10,0,0"
                              VerticalAlignment="Center"
                              Content="Consolidate Departments"
                              IsChecked="{Binding Path=Consolidated}" />
                    <CheckBox Name="chkSingleDept"
                              Margin="0,10,0,0"
                              Content="Print Single Department"
                              IsChecked="{Binding SingleDepartment}" />
                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <TextBlock Width="110"
                                   VerticalAlignment="Center"
                                   Text="Department" />
                        <ComboBox Name="lstDepartments"
                                  Width="200"
                                  DisplayMemberPath="Name"
                                  IsEnabled="{Binding ElementName=chkSingleDept,
                                                      Path=IsChecked}"
                                  ItemsSource="{Binding}"
                                  SelectedValuePath="Id"
                                  Text="{Binding DepartmentName}" />
                    </StackPanel>
                    <CheckBox Name="chkSingleAccount"
                              Margin="0,10,0,0"
                              Content="Print Single Account"
                              IsChecked="{Binding SingleAccount}" />
                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <TextBlock Width="110"
                                   VerticalAlignment="Center"
                                   Text="Account" />
                        <ComboBox Name="lstAccounts"
                                  Width="200"
                                  Background="White"
                                  DisplayMemberPath="Description"
                                  IsEnabled="{Binding ElementName=chkSingleAccount,
                                                      Path=IsChecked}"
                                  ItemsSource="{Binding}"
                                  SelectedValuePath="Key" />
                    </StackPanel>
                    <CheckBox Name="chkPrintZero"
                              Margin="0,10,0,0"
                              VerticalAlignment="Center"
                              Content="Print Accounts with 0 Balance"
                              IsChecked="{Binding PrintZeroBalances}" />
                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="Start Date " />
                        <DatePicker Name="dtStart"
                                    VerticalAlignment="Center"
                                    DisplayDate="{Binding StartDate}"
                                    Text="{Binding StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock VerticalAlignment="Center" Text=" End Date " />
                        <DatePicker Name="dtEnd"
                                    VerticalAlignment="Center"
                                    DisplayDate="{Binding EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                    Text="{Binding EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <Button Name="cmdDisplay"
                                Margin="20,0,0,0"
                                Click="cmdPrint_Click"
                                Content="DISPLAY" />
                        <Button Name="cmdPrint"
                                Margin="10,0,0,0"
                                Click="cmdPrint_Click"
                                Content="PRINT" />
                        <Button Name="cmdExit"
                                Margin="10,0,0,0"
                                Click="cmdExit_Click"
                                Content="EXIT" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
