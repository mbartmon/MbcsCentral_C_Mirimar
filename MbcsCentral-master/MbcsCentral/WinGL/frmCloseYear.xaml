
<Window
    x:Class="MbcsCentral.WinGL.frmCloseYear"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Name="FormfrmCloseYear"
    Title="Close Year / Bring Balances Forward"
    Width="621.628"
    Height="300"
    Background="AliceBlue"
    Closed="frmCloseYear_Closed"
    FontSize="14"
    FontWeight="Bold"
    Loaded="frmCloseYear_Loaded"
    TextBlock.TextAlignment="Center">
    <Border
        BorderBrush="Blue"
        BorderThickness="3"
        CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <TextBox
                Background="LightSteelBlue"
                BorderBrush="Blue"
                BorderThickness="2"
                FontSize="14"
                FontWeight="Bold"
                Text="Bring Balances Forward / Close Vendor Year"
                TextAlignment="Center" />
            <Grid Grid.Row="1">
                <!--  Place your content here  -->
                <Grid TextBlock.FontSize="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="65" />
                    </Grid.RowDefinitions>
                    <DataGrid
                        Name="lstCompanies"
                        AutoGenerateColumns="False"
                        ItemsSource="{Binding}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="300  "
                                Binding="{Binding Path=CompanyName}"
                                Header="Company"
                                IsReadOnly="True"
                                TextBlock.TextAlignment="Left" />
                            <DataGridTextColumn
                                Binding="{Binding Path=CurrentYear}"
                                Header="Current Year"
                                IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Close">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            HorizontalAlignment="Center"
                                            IsChecked="{Binding Path=Close, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding Path=Active}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            HorizontalAlignment="Center"
                                            IsChecked="{Binding Path=Close, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding Path=Active}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1">
                        <Border BorderBrush="Red" BorderThickness="1">
                            <StackPanel>
                                <TextBlock FontSize="10" Foreground="Red">
                                    IMPORTANT
                                </TextBlock>
                                <TextBlock FontSize="10">
                                    This ONLY brings balances forward for the new fiscal year.
                                </TextBlock>
                                <TextBlock FontSize="10">
                                    It is not necessary to CLOSE the old FISCAL YEAR
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <StackPanel
                            Margin="3"
                            Orientation="Horizontal"
                            TextBlock.FontSize="10">
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="New Fiscal Year" />
                            <ComboBox
                                Name="lstYears"
                                Width="50"
                                Margin="1,0,0,0"
                                VerticalAlignment="Center"
                                SelectionChanged="lstYears_SelectionChanged" />
                            <TextBlock
                                Margin="3,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="Profit/Loss Account" />
                            <ComboBox
                                Name="lstAccounts"
                                Width="215"
                                Margin="1,0,0,0"
                                DisplayMemberPath="Description"
                                ItemsSource="{Binding}" />
                            <TextBlock Margin="3,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="Journal" />
                            <ComboBox
                                Name="lstJournals"
                                Margin="1,0,0,0"
                                Width="125"
                                DisplayMemberPath="JournalName"
                                ItemsSource="{Binding}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
            <StackPanel
                Grid.Row="2"
                Margin="0,5,0,5"
                Background="AliceBlue"
                Orientation="Horizontal">
                <Button
                    Name="cmdSave"
                    Margin="5,0,0,0"
                    Click="cmdSave_Click"
                    Content="FORWARD BALANCES"
                    FontSize="11" />
                <Button
                    Name="cmdClose"
                    Margin="10,0,0,0"
                    Click="cmdClose_Click"
                    Content="EXIT"
                    FontSize="11" />
                <TextBox
                    Name="txtStatus"
                    Width="422"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
