
<Window x:Class="MbcsCentral.WinGL.frmVendorAchReport"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Name="FormfrmVendorAchReport"
        Width="548"
        Height="300"
        Background="AliceBlue"
        Closed="frmVendorAchReport_Closed"
        FontSize="14"
        FontWeight="Bold"
        Loaded="frmVendorAchReport_Loaded"
        TextBlock.TextAlignment="Center"
        mc:Ignorable="d">
    <Border BorderBrush="Blue"
            BorderThickness="3"
            CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <TextBox Background="LightSteelBlue"
                     BorderBrush="Blue"
                     BorderThickness="2"
                     FontSize="14"
                     FontWeight="Bold"
                     Text="Cumulative  Vendor ACH Report"
                     TextAlignment="Center" />
            <Grid Grid.Row="1">
                <!--  Place your content here  -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="75"/>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="Black" BorderThickness="3" CornerRadius="3" Background="Cornsilk">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <TextBlock Margin="10,0,0,0" Text="Date From:" VerticalAlignment="Center"/>
                                <DatePicker Name="dtFrom" Margin="5"/>
                                <TextBlock Margin="10,0,0,0" Text="Date To:" VerticalAlignment="Center"/>
                                <DatePicker Name="dtTo" Margin="5"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal">
                                <TextBlock Margin="10,0,0,0" Text="File Path:" VerticalAlignment="Center"/>
                                <TextBox Name="txtFilePath" Margin="5,0,0,0"  Width="250" Height="25" TextAlignment="Left"/>
                                <Button Name="cmdBrowse" Click="cmdBrowse_Click" Height="25" Width="15">
                                    <Image Source="\Resources\ARW03DN.png"/>
                                </Button>
                                <Button Name="cmdLoad" Click="cmdLoad_Click" Content="LOAD" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ListView Grid.Row="1" Name="lstVendorAchReport" BorderBrush="Black" BorderThickness="3" FontWeight="Bold">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="USE">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox Name="chkUse" IsChecked="{Binding IsSelected}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="File" TextBlock.TextAlignment="Center" DisplayMemberBinding="{Binding FileName}" />

                            </GridView>
                        </ListView.View>                   
                    </ListView>
                </Grid>
            </Grid>
            <StackPanel Grid.Row="2"
                        Margin="0,5,0,5"
                        Background="AliceBlue"
                        Orientation="Horizontal">
                <Button Name="cmdDisplay"
                        Margin="10,0,0,0"
                        Click="cmdDisplay_Click"
                        Content="DISPLAY" />
                <Button Name="cmdClose"
                        Margin="20,0,0,0"
                        Click="cmdClose_Click"
                        Content="CLOSE" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
