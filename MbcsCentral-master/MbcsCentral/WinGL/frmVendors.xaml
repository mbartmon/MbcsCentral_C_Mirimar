<Window
    x:Class="MbcsCentral.WinGL.frmVendors"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:viblend="clr-namespace:VIBlend.WPF.Controls;assembly=VIBlend.WPF.Editors"
    Name="formVendors"
    Title="Vendor Maintenance"
    Width="973"
    Height="546"
    Background="Aqua"
    Closed="formVendors_Closed"
    FontWeight="Bold"
    Loaded="formVendors_Loaded"
    SizeToContent="WidthAndHeight">
    <Window.Resources>
        <Style x:Key="ShadowBox" TargetType="{x:Type TextBox}">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="AllowDrop" Value="true" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBoxBase}">
                        <Border
                            Name="Border"
                            Padding="0"
                            BorderBrush="#888888"
                            BorderThickness="1,1,0,0"
                            CornerRadius="2">
                            <Border
                                Padding="0"
                                BorderBrush="#AAAAAA"
                                BorderThickness="0,0,1,1"
                                CornerRadius="2">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="0">
                                    <ScrollViewer.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0" Color="WhiteSmoke" />
                                            <GradientStop Offset="1" Color="LightGray" />
                                        </LinearGradientBrush>
                                    </ScrollViewer.Background>
                                </ScrollViewer>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#EEEEEE" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#EEEEEE" />
                                <Setter Property="Foreground" Value="#888888" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="alternatingListViewItemStyle" TargetType="{x:Type ListViewItem}">
            <Style.Triggers>
                <!--  setting up triggers for alternate background colors  -->
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="LightGray" />
                </Trigger>
                <Trigger Property="ItemsControl.AlternationIndex" Value="2">
                    <Setter Property="Background" Value="White" />
                </Trigger>
            </Style.Triggers>
            <!--  setting row height here  -->
            <Setter Property="Height" Value="30" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition MinHeight="450" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="480" MaxWidth="480" />
            <ColumnDefinition Width="475" MaxWidth="475" />
        </Grid.ColumnDefinitions>
        <Border
            MaxWidth="480"
            Margin="10,10,0,0"
            VerticalAlignment="Top"
            BorderBrush="Black"
            BorderThickness="3"
            CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="60" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="55" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="Vendors:" />
                <ListView
                    Name="lstVendors"
                    Grid.Column="1"
                    Width="390"
                    Margin="5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Background="Cornsilk"
                    BorderBrush="Blue"
                    BorderThickness="1"
                    IsTextSearchEnabled="True"
                    ItemsSource="{Binding}"
                    SelectionChanged="lstVendors_SelectionChanged"
                    TextSearch.TextPath="VendorName">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=Inactive}" Value="False">
                                    <Setter Property="ListBoxItem.Foreground" Value="Black" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Inactive}" Value="True">
                                    <Setter Property="ListBoxItem.Foreground" Value="Gray" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListView.View>
                        <GridView>
                            <GridViewColumn
                                Width="50"
                                DisplayMemberBinding="{Binding VendorNumber}"
                                Header="ID" />
                            <GridViewColumn DisplayMemberBinding="{Binding FullName}" Header="Name" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                    <Border
                        Margin="0,5,0,5"
                        HorizontalAlignment="Center"
                        BorderBrush="Blue"
                        BorderThickness="1"
                        CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="Grayed Vendors are INACTIVE" />
                            <CheckBox
                                Name="chkActiveOnly"
                                Margin="10,0,0,0"
                                Checked="chkActiveOnly_Checked"
                                Content="Show Only Active"
                                IsChecked="True"
                                Unchecked="chkActiveOnly_Checked" />
                        </StackPanel>
                    </Border>
                    <StackPanel
                        Height="30"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Name="cmdAdd"
                            Click="cmdAdd_Click"
                            Content="ADD" />
                        <Button
                            Name="cmdDelete"
                            Margin="5,0,0,0"
                            Click="cmdDelete_Click"
                            Content="DELETE" />
                        <Button
                            Name="cmdCategories"
                            Margin="5,0,0,0"
                            Click="cmdCategories_Click"
                            Content="Allocations" />
                        <Button
                            Name="cmdMemos"
                            Margin="5,0,0,0"
                            Click="cmdMemos_Click"
                            Content="Memo Lines" />
                        <Button
                            Name="cmdExit"
                            Margin="5,0,0,0"
                            Click="cmdExit_Click"
                            Content="EXIT" />
                        <CheckBox
                            x:Name="chkNextYear"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Click="chkNextYear_Click"
                            Content="Use [year] as Current Purchases"
                            FontSize="11" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border
            Grid.Column="1"
            Margin="10,10,10,3"
            Padding="10"
            BorderBrush="Blue"
            BorderThickness="3"
            CornerRadius="5">
            <Grid Name="Detail">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="25" />
                    <RowDefinition Height="25" />
                    <RowDefinition Height="25" />
                    <RowDefinition Height="25" />
                    <RowDefinition Height="25" />
                    <RowDefinition Height="25" />
                    <RowDefinition Height="55" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="25" />
                    <RowDefinition Height="95" />
                    <RowDefinition Height="60" />
                    <RowDefinition Height="35" />
                </Grid.RowDefinitions>
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="Number" />
                    <TextBox
                        Width="50"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        IsEnabled="False"
                        Text="{Binding VendorNumber, Mode=OneTime}" />
                    <CheckBox
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Content="Corporation"
                        IsChecked="{Binding Corporation}" />
                    <CheckBox
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Content="Payroll"
                        IsChecked="{Binding Payroll}" />
                    <CheckBox
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Content="Inactive"
                        FontWeight="Bold"
                        IsChecked="{Binding Inactive}" />
                </StackPanel>
                <StackPanel
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock Width="100" Text="Name" />
                    <TextBox
                        Name="txtVendorName"
                        Width="300"
                        Margin="5,0,0,0"
                        MaxLength="50"
                        Text="{Binding VendorName}" />
                </StackPanel>
                <StackPanel
                    Grid.Row="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock Width="100" Text="Addtional Name" />
                    <TextBox
                        Width="300"
                        Margin="5,0,0,0"
                        MaxLength="50"
                        Text="{Binding Name2}" />
                </StackPanel>
                <StackPanel
                    Grid.Row="3"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock Width="100" Text="Street" />
                    <TextBox
                        Width="300"
                        Margin="5,0,0,0"
                        MaxLength="50"
                        Text="{Binding Street}" />
                </StackPanel>
                <StackPanel
                    Grid.Row="4"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock Width="100" Text="City" />
                    <TextBox
                        Width="300"
                        Margin="5,0,0,0"
                        MaxLength="50"
                        Text="{Binding City}" />
                </StackPanel>
                <StackPanel
                    Grid.Row="5"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock Width="100" Text="State" />
                    <TextBox
                        Width="30"
                        Margin="5,0,0,0"
                        MaxLength="2"
                        Text="{Binding State}" />
                    <TextBlock Margin="30,0,0,0" Text="Zip" />
                    <TextBox
                        Width="100"
                        Margin="5,0,0,0"
                        MaxLength="10"
                        Text="{Binding Zip}" />
                </StackPanel>
                <StackPanel
                    Grid.Row="6"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock Width="100" Text="Telephone" />
                    <TextBox
                        Width="150"
                        Margin="5,0,0,0"
                        MaxLength="20"
                        Text="{Binding Telephone}" />
                </StackPanel>
                <StackPanel
                    Grid.Row="7"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock Width="100" Text="Comment" />
                    <TextBox
                        Width="300"
                        Height="50"
                        Margin="5,0,0,0"
                        AcceptsReturn="True"
                        MaxLength="128"
                        Text="{Binding Comment}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel
                    Grid.Row="8"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock Width="100" Text="Default Journal" />
                    <ComboBox
                        Name="lstJournals"
                        Width="300"
                        Height="30"
                        Margin="5,0,0,0"
                        Background="White"
                        DisplayMemberPath="JournalName"
                        ItemsSource="{Binding}"
                        Text="{Binding Journal}" />
                </StackPanel>
                <StackPanel
                    Grid.Row="9"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock Width="100" Text="Federal ID" />
                    <TextBox
                        Width="130"
                        Margin="5,0,0,0"
                        MaxLength="11"
                        Text="{Binding FederalID}" />
                    <TextBlock Margin="10,0,0,0" Text="Add'l Info" />
                    <TextBox
                        Width="130"
                        Margin="5,0,0,0"
                        MaxLength="11"
                        Text="{Binding StateID}" />
                </StackPanel>
                <GroupBox
                    Grid.Row="10"
                    Margin="5,0,0,0"
                    Padding="3"
                    VerticalAlignment="top"
                    BorderThickness="1"
                    >
                    <GroupBox.Header>
                        ACH Payments
                    </GroupBox.Header>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Margin="0,2,0,0"
                                      Content="Use" 
                                      TextBlock.FontSize="12" 
                                      IsChecked="{Binding ACH, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock
                                Margin="10,1,0,0"
                                VerticalAlignment="Top"
                                FontSize="12"
                                Text="Email:" />
                            <TextBox Width="320" 
                                     Margin="5,1,0,0" 
                                     TextAlignment="Left"
                                     Text="{Binding ACHEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Routing Number"
                                       FontSize="12"
                                       VerticalAlignment="Top"
                                       HorizontalAlignment="Left"/>
                            <TextBox Width="150"
                                     Margin="5,0,0,0"
                                     VerticalAlignment="Top"
                                     TextAlignment="Left"
                                     MaxLength="9"
                                     Text="{Binding RoutingNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Bank Account"
                                       FontSize="12"/>
                            <TextBox Width="200"
                                     Margin="22,0,0,0"
                                     VerticalAlignment="Top"
                                     TextAlignment="Left"
                                     MaxLength="17"
                                     Text="{Binding BankAccount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
                <GroupBox
                    Grid.Row="11"
                    Margin="92,0,10,0"
                    Padding="3,3,3,3"
                    VerticalAlignment="Top"
                    BorderThickness="3">
                    <GroupBox.Header>
                        <system:String xml:space="preserve">Current Purchases                     Prior Year Purchases</system:String>
                    </GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <viblend:NumberEditor
                            Name="CurrentYear"
                            Width="100"
                            Height="20"
                            Margin="6,0,0,0"
                            DecimalPlaces="2"
                            IsReadOnly="True"
                            MaxLength="10" />
                        <viblend:NumberEditor
                            Name="PriorYear"
                            Width="100"
                            Height="20"
                            Margin="70,0,0,0"
                            DecimalPlaces="2"
                            IsReadOnly="True"
                            MaxLength="10" />
                    </StackPanel>
                </GroupBox>
                <StackPanel
                    Grid.Row="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Name="cmdVendorSave"
                        Click="cmdVendorSave_Click"
                        Content="SAVE" />
                    <Button
                        Name="cmdVendorCategories"
                        Margin="10,0,0,0"
                        Click="cmdCategories_Click"
                        Content="Allocations" />
                    <Button
                        Name="cmdVendorMemos"
                        Margin="5,0,0,0"
                        Click="cmdMemos_Click"
                        Content="Memo Lines" />
                    <Button
                        Name="cmdVendorExit"
                        Margin="10,0,0,0"
                        Click="cmdVendorExit_Click"
                        Content="CLOSE" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
