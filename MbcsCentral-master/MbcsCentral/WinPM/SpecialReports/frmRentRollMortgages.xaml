
<Window x:Class="MbcsCentral.WinPM.SpecialReports.frmRentRollMortgages"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Name="FormfrmRentRollMortgages"
        Width="300"
        Height="300"
        Background="AliceBlue"
        Closed="frmRentRollMortgages_Closed"
        FontSize="14"
        FontWeight="Bold"
        Loaded="frmRentRollMortgages_Loaded"
        TextBlock.TextAlignment="Center">
    <Border BorderBrush="Blue"
            BorderThickness="3"
            CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <TextBox Background="LightSteelBlue"
                     BorderBrush="Blue"
                     BorderThickness="2"
                     FontSize="14"
                     FontWeight="Bold"
                     Text="Title"
                     TextAlignment="Center" />
            <Grid Grid.Row="1">
                <!--  Place your content here  -->
            </Grid>
            <StackPanel Grid.Row="2"
                        Margin="0,5,0,5"
                        Background="AliceBlue"
                        Orientation="Horizontal">
                <Button Name="cmdSave"
                        Margin="10,0,0,0"
                        Click="cmdSave_Click"
                        Content="SAVE" />
                <Button Name="cmdClose"
                        Margin="10,0,0,0"
                        Click="cmdClose_Click"
                        Content="CLOSE" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
