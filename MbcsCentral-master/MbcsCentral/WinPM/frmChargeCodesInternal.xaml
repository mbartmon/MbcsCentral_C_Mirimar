                            </StackPanel>
                        </Border>
                    </StackPanel>
                    -->
                </Grid>
            </Grid>
            <StackPanel
                Grid.Row="2"
                HorizontalAlignment="Stretch"
                Background="AliceBlue"
                Orientation="Horizontal">
                <Button Name="cmdSave"
                    Margin="10,0,0,0"
                    Click="cmdSave_Click"
                    Content="SAVE" />
                <Button Name="cmdDelete"
                    Margin="20,0,0,0"
                    Click="ctxDelete_Click"
                    Content="DELETE" />
                <Button Name="cmdAdd"
                    Margin="20,0,0,0"
                    Click="cmdAdd_Click"
                    Content="ADD a New Charge" />
                <Button Name="cmdExit"
                    Margin="20,0,20,0"
                    Click="cmdExit_Click"
                    Content="EXIT" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
