
<Window Name="FormfrmChargeCodesInternal"
    x:Class="MbcsCentral.WinPM.frmChargeCodesInternal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:my="clr-namespace:MbcsCentral"
    xmlns:viblend="clr-namespace:VIBlend.WPF.Controls;assembly=VIBlend.WPF.Editors"
    Title="Charge Codes"
    Width="791.865"
    Height="300"
    Background="AliceBlue"
    Closed="frmChargeCodesInternal_Closed"
    FontSize="14"
    FontWeight="Bold"
    Loaded="frmChargeCodesInternal_Loaded"
    TextBlock.TextAlignment="Center">
    <Window.Resources>
        <CollectionViewSource x:Key="accounts" Source="{Binding}" />
        <Style x:Key="DescriptionCell" TargetType="DataGridCell">
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Window.Resources>

    <Border
        BorderBrush="Blue"
        BorderThickness="3"
        CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <TextBox Text="Charge Codes"
                Background="LightSteelBlue"
                BorderBrush="Blue"
                BorderThickness="2"
                FontSize="14"
                FontWeight="Bold"
                TextAlignment="Center" />
            <Grid Grid.Row="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="35" />
                    </Grid.RowDefinitions>

                    <DataGrid Name="lstCharges"
                        Grid.Row="0"
                        AutoGenerateColumns="False"
                        Background="Bisque"
                        BorderBrush="Black"
                        BorderThickness="2"
                        CanUserAddRows="False"
                        ItemsSource="{Binding}"
                        RowEditEnding="lstCharges_RowEditEnding">
                        <DataGrid.RowStyle>
                            <Style TargetType="{x:Type DataGridRow}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=Delete}" Value="False">
                                        <Setter Property="Foreground" Value="Black" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Path=Delete}" Value="True">
                                        <Setter Property="Foreground" Value="Red" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Name="ctxDelete"
                                    Click="ctxDelete_Click"
                                    Header="Delete/Restore This Code" />
                                <MenuItem Name="ctxAdd"
                                    Click="ctxAdd_Click"
                                    Header="Add New Code" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Code">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ChargeCode}"
                                            HorizontalAlignment="Left"
                                            TextAlignment="Left" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding ChargeCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            CharacterCasing="Upper"
                                            MaxLength="2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="200" Header="Description">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ChargeDescription}"
                                            HorizontalAlignment="Left"
                                            TextAlignment="Left" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding ChargeDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Width="300"
                                            HorizontalAlignment="Left"
                                            TextAlignment="Left" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridCheckBoxColumn Binding="{Binding LegalCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Legal" />
                            <DataGridTemplateColumn Width="250" Header="GL Credit Account">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding GLCreditAccountName}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            TextAlignment="Left" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox
                                            DisplayMemberPath="Description"
                                            ItemsSource="{Binding Source={StaticResource accounts}}"
                                            SelectedValue="{Binding Path=GLCreditAccountInt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Key" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="250" Header="GL Debit Account">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding GLDebitAccountName}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            TextAlignment="Left" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox
                                            DisplayMemberPath="Description"
                                            ItemsSource="{Binding Source={StaticResource accounts}}"
                                            SelectedValue="{Binding Path=GLDebitAccountInt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Key" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border
                        Grid.Row="1"
                        Margin="5"
                        BorderBrush="Black"
                        BorderThickness="2">
                        <StackPanel Margin="10,0,0,0" Orientation="Horizontal">
                            <TextBlock Text="Charge Codes in " />
                            <TextBlock Foreground="Red" Text="RED" />
                            <TextBlock Text=" will be deleted upon Saving" />
                        </StackPanel>
                    </Border>

