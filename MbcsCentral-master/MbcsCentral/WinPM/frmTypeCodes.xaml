<Window x:Class="MbcsCentral.WinPM.frmTypeCodes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:my="clr-namespace:MbcsCentral"
        Name="formTypeCodes"
        Title="Tenant Type Codes"
        Width="810"
        Height="300"
        Closing="Window_Closing"
        Loaded="Window_Loaded">
    <Window.Resources>
        <my:StringTruncate x:Key="StringTruncate" />

        <!--  SINGLE CLICK EDITING  -->
        <Style TargetType="{x:Type DataGridCell}">
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DataGridCell_PreviewMouseLeftButtonDown" />
        </Style>
        <CollectionViewSource x:Key="leases" />
    </Window.Resources>
    <Border BorderBrush="Blue"
            BorderThickness="3"
            CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="35" />
            </Grid.RowDefinitions>
            <DataGrid Name="grdTypes"
                      AlternatingRowBackground="LightBlue"
                      AutoGenerateColumns="False"
                      CanUserAddRows="True"
                      CanUserDeleteRows="True"
                      CellEditEnding="grdTypes_CellEditEnding"
                      EnableRowVirtualization="True"
                      ItemsSource="{Binding}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Type,
                                                          Mode=TwoWay,
                                                          UpdateSourceTrigger=PropertyChanged,
                                                          Converter={StaticResource StringTruncate},
                                                          ConverterParameter=2}"
                                        Header="Type"
                                        IsReadOnly="False" />
                    <DataGridTextColumn Width="150"
                                        Binding="{Binding Description,
                                                          Mode=TwoWay,
                                                          UpdateSourceTrigger=PropertyChanged,
                                                          Converter={StaticResource StringTruncate},
                                                          ConverterParameter=18}"
                                        Header="Description"
                                        IsReadOnly="False" />
                    <DataGridTextColumn Width="150"
                                        Binding="{Binding BillingName,
                                                          Mode=TwoWay,
                                                          UpdateSourceTrigger=PropertyChanged,
                                                          Converter={StaticResource StringTruncate},
                                                          ConverterParameter=18}"
                                        Header="Billing Name"
                                        IsReadOnly="False" />
                     <DataGridCheckBoxColumn Binding="{Binding PrintBill, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Print Bill" />
                     <DataGridCheckBoxColumn Binding="{Binding printApt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Print Apt" />
                    <DataGridCheckBoxColumn Binding="{Binding UseDC, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="UseDC"/>
                    <DataGridCheckBoxColumn x:Name="chkLease"
                                            Binding="{Binding Lease,
                                                              Mode=TwoWay,
                                                              UpdateSourceTrigger=PropertyChanged}"
                                            Header="UseLease" />
                     <DataGridCheckBoxColumn Binding="{Binding DeleteMe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Delete" />
                     <DataGridCheckBoxColumn Binding="{Binding IsChanged, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Changed" />
                     <DataGridTemplateColumn Width="100" Header="LeaseName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center" Text="{Binding LeaseName}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox x:Name="lstLeases"
                                          Background="White"
                                          DisplayMemberPath="DocumentName"
                                          IsEnabled="{Binding ElementName=chkLease,
                                                              Path=IsChecked}"
                                          IsSynchronizedWithCurrentItem="False"
                                          IsTextSearchEnabled="True"
                                          ItemsSource="{Binding Source={StaticResource leases}}"
                                          SelectedValue="{Binding LeaseName}"
                                          SelectedValuePath="DocumentName"
                                          SelectionChanged="lstLeases_SelectionChanged" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="100" Header="LeaseReverse">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center" Text="{Binding LeaseReverse}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox x:Name="lstReverse"
                                          Background="White"
                                          DisplayMemberPath="DocumentName"
                                          IsEnabled="{Binding ElementName=chkLease,
                                                              Path=IsChecked}"
                                          IsSynchronizedWithCurrentItem="False"
                                          IsTextSearchEnabled="True"
                                          ItemsSource="{Binding Source={StaticResource leases}}"
                                          SelectedValue="{Binding LeaseReverse}"
                                          SelectedValuePath="DocumentName"
                                          SelectionChanged="lstLeases_SelectionChanged" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="1" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="" />
                <Button Name="cmdAdd"
                        Width="85"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center"
                        Click="cmdAdd_Click"
                        Content="Add New Type" />
                <Button Name="cmdSave"
                        Width="85"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center"
                        Click="cmdSave_Click"
                        Content="Save Changes" />
                <Button Name="cmdExit"
                        Width="85"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center"
                        Click="cmdExit_Click"
                        Content="Exit" />
            </StackPanel>

        </Grid>
    </Border>
</Window>
