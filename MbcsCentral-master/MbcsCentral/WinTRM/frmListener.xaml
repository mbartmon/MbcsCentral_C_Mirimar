<Window x:Class="frmListener"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Message Listener Service" Height="501" Width="568" Background="{StaticResource {x:Static SystemColors.GradientInactiveCaptionBrushKey}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35" />
            <RowDefinition Height="40"/>
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border BorderBrush="Black" BorderThickness="2" CornerRadius="25" Height="31" HorizontalAlignment="Center" Name="Border1" VerticalAlignment="Bottom" Width="200" Background="{StaticResource {x:Static SystemColors.GradientActiveCaptionBrushKey}}">
            <TextBlock Name="TextBlock1" Text="Message Listener Service" HorizontalAlignment="Center" FontWeight="Bold" FontSize="16" />
        </Border>
        <StackPanel Orientation="Horizontal" Grid.Row="1" >
            <Label Content="STATUS: " VerticalAlignment="Bottom"  FontWeight="Bold"/>
            <TextBlock Name="ServiceStatus" VerticalAlignment="Bottom" Width="150" Margin="0,5" FontWeight="ExtraBold" FontSize="14" Foreground="Red" />
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Name="cmdStart" Content="START" Margin="10,10,0,0" Grid.Column="0"/>
                <Button Name="cmdStop" Content="STOP" Margin="10,10,0,0" Grid.Column="1" />
                <Button Name="cmdRESTART" Content="RESTART" Margin="10,10,0,0" Grid.Column="2" />
                <Button Name="cmdInstall" Content="INSTALL" Margin="10,10,0,0" Grid.Column="3"/>
                <Button Name="cmdUnInstall" Content="UNINSTALL" Margin="10,10,0,0" Grid.Column="4" />
            </Grid>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="2">
            <Label Content="Mail Retrieval Interval in minutes: " VerticalAlignment="Bottom" FontWeight="Bold" />
            <TextBox Name="MailRetrieval" Margin="0,3" Width="50" MaxLength="3" VerticalAlignment="Bottom" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="3" >
            <Label Content="Use SMTP Config to retrieve messages? " VerticalAlignment="Bottom" FontWeight="Bold" />
            <CheckBox Name="chkSMTP" Margin="0,5" VerticalAlignment="Bottom" />
            <Label Content="Read Outlook Inbox? " Margin="10,0,0,0" VerticalAlignment="Bottom" FontWeight="Bold" />
            <CheckBox Name="chkOutlook" Margin="0,5" VerticalAlignment="Bottom" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="4">
            <Button Name="cmdSave" Content="SAVE" Margin="10,0,0,0" VerticalAlignment="Bottom"/>
            <Button Name="cmdCancel" Content="CANCEL" Margin="10,0,0,0" VerticalAlignment="Bottom" />
            <Button Name="cmdViewLog" Content="VIEW LOG" Margin="10,0,0,0" VerticalAlignment="Bottom" />
            <Button Name="cmdRefreshLog" Content="REFRESH LOG" Margin="10,0,0,0" VerticalAlignment="Bottom" />
            <Button Name="cmdClearLog" Content="CLEAR LOG" Margin="10,0,0,0" VerticalAlignment="Bottom" />
        </StackPanel>
        <TextBox Grid.Row="5" Name="LogViewer" Margin="0,5" IsReadOnly="True"  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" IsTabStop="False" IsReadOnlyCaretVisible="True" />
    </Grid>
</Window>
