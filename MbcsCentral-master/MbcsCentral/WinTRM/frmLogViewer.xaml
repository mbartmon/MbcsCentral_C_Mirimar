<Window x:Class="frmLogViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WintRM Log" Height="433" Width="445" HorizontalContentAlignment="Center" Background="{StaticResource {x:Static SystemColors.InfoBrushKey}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>
        <Border CornerRadius="30" HorizontalAlignment="Center" Width="Auto" Background="{StaticResource {x:Static SystemColors.GradientActiveCaptionBrushKey}}" BorderThickness="2" BorderBrush="{StaticResource {x:Static SystemColors.MenuTextBrushKey}}">
            <TextBlock Text="LOG VIEWER" VerticalAlignment="Center" HorizontalAlignment="Center" Height="Auto" Width="Auto" FontWeight="Bold"/>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal">
        <Button  Name="cmdExit" Content="EXIT" Margin="10,0,0,0"/>
        <Button Name="cmdClear" Content="CLEAR LOG" Margin="10,0,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" BorderThickness="2" BorderBrush="{StaticResource {x:Static SystemColors.ActiveCaptionTextBrushKey}}">
                <TextBox Name="txtLog" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
        </Border>
    </Grid>
</Window>
