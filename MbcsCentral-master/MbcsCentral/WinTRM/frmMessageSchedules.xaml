<Window x:Class="frmMessageSchedules"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="All Message Delivery Schedules" Height="465" Width="686">
    <Grid HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height=".5*"/>
            <RowDefinition Height="5.5*" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <DataGrid AutoGenerateColumns="True" HorizontalAlignment="Stretch" Margin="1,2,0,0" Name="grdSchedules" VerticalAlignment="Stretch" Width="661" Grid.Row="1" />
        <Button Content="ADD" Grid.Row="2" Height="30" HorizontalAlignment="Left" Margin="28,22,0,0" Name="cmdAdd" VerticalAlignment="Center" Width="97" />
        <Button Content="EDIT" Height="30" HorizontalAlignment="Left" Margin="131,22,0,0" Name="cmdEdit" VerticalAlignment="Stretch" Width="97" Grid.Row="2" />
        <Button Content="DELETE" Height="30" HorizontalAlignment="Left" Margin="234,22,0,0" Name="cmdDelete" VerticalAlignment="Stretch" Width="97" Grid.Row="2" />
        <Button Content="EXIT" Height="30" HorizontalAlignment="Right" Margin="0,22,230,0" Name="cmdExit" VerticalAlignment="Stretch" Width="97" Grid.Row="2" />
        <CheckBox Content="Show content for all accounts?" Height="16" HorizontalAlignment="Left" Margin="10,10,0,0" Name="chkAll" VerticalAlignment="Top" Width="188" />
    </Grid>
</Window>
