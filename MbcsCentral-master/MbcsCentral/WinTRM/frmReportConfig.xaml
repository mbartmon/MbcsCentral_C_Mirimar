<Window x:Class="frmReportConfig"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Report Configuration" Name="frmReportConfig" Height="167" Width="416" Background="LightBlue">
    <Grid>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="Report Name: "/>
                <Label Name="lblReportName" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Height="50">
                <Label Content="Choose Printer: " Margin="0,10,0,10"/>
                <ComboBox Name="lstPrinters" Margin="0,10,0,10"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Height="50">
                <Button Name="cmdPrint" Content="PRINT" Margin="5,10,0,10"/>
                <Button Name="cmdDisplay" Content="DISPLAY" Margin="10,10,0,10"/>
                <Button Name="cmdExit" Content="EXIT" Margin="10,10,0,10"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
