<Window x:Class="frmServices"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WinTRM Service Management" Name="frmServices" FontWeight="Bold" Height="453" Width="864" mc:Ignorable="d" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:my="clr-namespace:WinTRM"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit">
    
    <Window.Resources>
        <CollectionViewSource x:Key="JobDataViewSource" d:DesignSource="{d:DesignInstance my:JobData, CreateList=True}" />
        <CollectionViewSource x:Key="TriggerDataViewSource" d:DesignSource="{d:DesignInstance my:TriggerData, CreateList=True}"/>
        <my:DateTimeConverter x:Key="DateTimeConverter"/>
        <CollectionViewSource x:Key="JobMasterViewSource" d:DesignSource="{d:DesignInstance my:JobMaster, CreateList=True}" />
        <CollectionViewSource x:Key="MessageScheduleViewSource" d:DesignSource="{d:DesignInstance my:MessageSchedule, CreateList=True}" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>
        <TabControl Background="{StaticResource {x:Static SystemColors.GradientInactiveCaptionBrushKey}}">
            <TabItem Name="tabJobCreation" Header="Message Job Creation">
                <Grid DataContext="{StaticResource JobMasterViewSource}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" >
                        <Label Content="STATUS: " VerticalAlignment="Bottom"  FontWeight="Bold"/>
                        <TextBlock Name="CreationStatus" VerticalAlignment="Bottom" Width="150" Margin="0,5" FontWeight="ExtraBold" FontSize="14" Foreground="Red" Background="WhiteSmoke" />
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Name="cmdStartCreation" Content="START" Margin="10,10,0,0" Grid.Column="0" Click="cmdStart_Click"/>
                            <Button Name="cmdStopCreation" Content="STOP" Margin="10,10,0,0" Grid.Column="1" Click="cmdStop_Click"/>
                            <Button Name="cmdRESTARTCreation" Content="RESTART" Margin="10,10,0,0" Grid.Column="2" Click="cmdRESTART_Click"/>
                            <Button Name="cmdInstallCreation" Content="INSTALL" Margin="10,10,0,0" Grid.Column="3"/>
                            <Button Name="cmdUnInstallCreation" Content="UNINSTALL" Margin="10,10,0,0" Grid.Column="4" />
                        </Grid>
                    </StackPanel>
                    <TabControl Grid.Row="1">
                        
                        <!-- JOB SCHEDULE -->
                        <TabItem Header="Job Schedule">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition/>
                                    <RowDefinition Height="75"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Background="LightGray">
                                    <RadioButton Content="All" Name="optJobsAll" GroupName="JobGroup" IsChecked="True" Margin="10,0,0,0" Checked="optJobs_Checked"/>
                                    <RadioButton Content="Sent Today" Name="optJobsToday" GroupName="JobGroup" Margin="10,0,0,0" Checked="optJobs_Checked"/>
                                    <RadioButton Content="Will Send Today" Name="optJobsReady" GroupName="JobGroup" Margin="10,0,0,0" Checked="optJobs_Checked"/>
                                    <RadioButton Content="Send Tomorrow" Name="optJobsTomorrow" GroupName="JobGroup" Margin="10,0,0,0" Checked="optJobs_Checked"/>
                                </StackPanel>
                                <DataGrid Grid.Row="1" AutoGenerateColumns="False" AlternatingRowBackground="AntiqueWhite" EnableRowVirtualization="True" DataContext="{StaticResource JobDataViewSource}" ItemsSource="{Binding}" Name="JobDataDataGrid" RowDetailsVisibilityMode="VisibleWhenSelected" SelectionChanged="JobDataDataGrid_SelectionChanged">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Name="ctxJobScheduleTrigger" Header="Trigger Now" Click="ctxJobScheduleTrigger_Click"/>
                                            <MenuItem Name="ctxJobSchedulePause" Header="Pause" Click="ctxJobSchedulePause_Click"/>
                                            <MenuItem Name="ctxJobScheduleDelete" Header="Delete" Click="ctxJobScheduleDelete_Click"/>
                                            <Separator/> 
                                            <MenuItem Name="ctxJobScheduleGotoJobMaster" Header="Go to Job Master record" Click="ctxJobScheduleGotoJobMaster_Click"/>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn x:Name="SchedNameColumn" Binding="{Binding Path=SchedName}" Header="Job Sched Name" Width="Auto" />
                                        <DataGridTextColumn x:Name="JobIdColumn" Binding="{Binding Path=JobId}" Header="JobId" Width="Auto" />
                                        <DataGridTextColumn x:Name="JobNameColumn" Binding="{Binding Path=JobName}" Header="JobMaster" Width="Auto" />
                                        <!-- <DataGridTextColumn x:Name="DescriptionColumn" Binding="{Binding Path=Description}" Header="Description" Width="Auto" /> -->
                                        <DataGridTextColumn x:Name="JobGroupColumn" Binding="{Binding Path=JobGroup}" Header="Group" Width="Auto" />
                                        <DataGridTextColumn x:Name="AccountNameColumn" Binding="{Binding Path=AccountName}" Header="Account Name" IsReadOnly="True" Width="Auto" />
                                        <DataGridHyperlinkColumn x:Name="MessageDeliveryColumn" ContentBinding="{Binding Path=MessageDeliverySchedule}" Header="Delivery Sched">
                                            <DataGridHyperlinkColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <EventSetter Event="Hyperlink.Click" Handler="MessageDeliveryColumnClick"/>
                                                </Style>
                                            </DataGridHyperlinkColumn.ElementStyle>
                                        </DataGridHyperlinkColumn>
                                        <DataGridTextColumn x:Name="FromColumn" Binding="{Binding Path=From}" Header="From" Width="Auto" />
                                        <DataGridTextColumn x:Name="SubjectColumn" Binding="{Binding Path=Subject}" Header="Subject" Width="Auto"/>
                                        <DataGridHyperlinkColumn x:Name="BodyContentColumn" ContentBinding="{Binding Path=BodyName}" Header="Message">
                                            <DataGridHyperlinkColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <EventSetter Event="Hyperlink.Click" Handler="BodyNameColumnClick"/>
                                                </Style>
                                            </DataGridHyperlinkColumn.ElementStyle>
                                        </DataGridHyperlinkColumn>
                                        <DataGridCheckBoxColumn x:Name="ReturnReceiptColumn" Binding="{Binding ReturnReceipt}" Header="RR" IsReadOnly="True"/>
                                        <DataGridCheckBoxColumn x:Name="IsDurableColumn" Binding="{Binding Path=IsDurable}" Header="Is Durable" Width="Auto" />
                                        <DataGridCheckBoxColumn x:Name="IsNonCurrentColumn" Binding="{Binding Path=IsNonCurrent}" Header="Is Non Current" Width="Auto" />
                                        <DataGridCheckBoxColumn x:Name="IsUpdateDataColumn" Binding="{Binding Path=IsUpdateData}" Header="Is Update Data" Width="Auto" />
                                        <!-- <DataGridTextColumn x:Name="JobClassNameColumn" Binding="{Binding Path=JobClassName}" Header="Job Class Name" Width="Auto" /> -->
                                        <DataGridHyperlinkColumn x:Name="RecipListsColumn" ContentBinding="{Binding Path=RecipLists}" Header="Recip Lists" Width="Auto">
                                            <DataGridHyperlinkColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <EventSetter Event="Hyperlink.Click" Handler="RecipListsColumnClick"/>
                                                </Style>
                                            </DataGridHyperlinkColumn.ElementStyle>    
                                        </DataGridHyperlinkColumn>                                       
                                        <DataGridCheckBoxColumn x:Name="RequestRecoveryColumn" Binding="{Binding Path=RequestRecovery}" Header="Request Recovery" Width="Auto" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <DataGrid Grid.Row="2" Name="grdTrigger" AutoGenerateColumns="False" DataContext="{StaticResource TriggerDataViewSource}" ItemsSource="{Binding}">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Name="ctxTriggerSave" Header="SAVE" Click="ctxTriggerSave_Click"/>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Trigger Name" Binding="{Binding Path=TriggerName, Mode=TwoWay}" Width="Auto"/>
                                        <DataGridTextColumn Header="Priority" Binding="{Binding Path=Priority, Mode=TwoWay}" Width="SizeToHeader"/>
                                        <DataGridTextColumn Header="Prev Fire Time" Binding="{Binding Path=PrevFireTime, Mode=TwoWay,
                                                                                            Converter={StaticResource DateTimeConverter}}" Width="Auto"/>
                                        <!-- <DataGridTextColumn Header="Next Fire Time" Binding="{Binding Path=NextFireTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,
                                                                                            Converter={StaticResource DateTimeConverter}}" Width="Auto"/> -->
                                        <DataGridTemplateColumn x:Name="dtNextFireTime" Header="Next Fire Time" Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <xctk:DateTimePicker Format="Custom" FormatString="MM/dd/yyyy hh:mm" Name="dtNextFireTime" 
                                                                         Value="{Binding Path=NextFireTime, Mode=TwoWay, 
                                                                         UpdateSourceTrigger=PropertyChanged,
                                                                         ValidatesOnExceptions=True,
                                                                         NotifyOnValidationError=True}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        
                                        <DataGridTextColumn Header="Start Date/Time" Binding="{Binding Path=StartTime, 
                                                                                            Converter={StaticResource DateTimeConverter}}" Width="Auto"/>
                                       <!-- <DataGridTextColumn Header="End Date/Time" Binding="{Binding Path=EndTime, Mode=TwoWay,
                                                                                            Converter={StaticResource DateTimeConverter}}" Width="Auto"/> -->
                                        <DataGridTemplateColumn x:Name="dtEndTime" Header="End Date/Time" Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <xctk:DateTimePicker Format="Custom" FormatString="MM/dd/yyyy hh:mm"
                                                                         Value="{Binding Path=EndTime, Mode=TwoWay,
                                                                         UpdateSourceTrigger=PropertyChanged,
                                                                         ValidatesOnExceptions=True,
                                                                         NotifyOnValidationError=True}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                        
                        <!-- JOB MASTER-->
                        <TabItem Name="tabItemJobMaster" Header="Job Master">
                            <DataGrid AutoGenerateColumns="False" AlternatingRowBackground="AntiqueWhite"  EnableRowVirtualization="True" ItemsSource="{Binding}" Name="JobMasterDataGrid" SelectionMode="Extended" RowDetailsVisibilityMode="VisibleWhenSelected">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Name="mnuJobmasterStatusReady" Header="Change Status to READY" Click="mnuJobmasterStatusReady_Click"/>
                                        <MenuItem Name="mnuJobMasterProcessed" Header="Change Status to PROCESSED" Click="mnuJobMasterProcessed_Click"/>
                                        <MenuItem Name="mnuJobMasterPaused" Header="Pause" Click="mnuJobMasterPaused_Click"/>
                                        <MenuItem Name="mnuJobmasterDelete" Header="Delete" Click="mnuJobmasterDelete_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="DodgerBlue"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn x:Name="JobIdColumn1" Binding="{Binding Path=jobId}" Header="JobId" IsReadOnly="True" Width="SizeToHeader" />
                                    <DataGridTextColumn x:Name="JobNameColumn1" Binding="{Binding Path=jobName}" Header="Job Name" Width="Auto" />
                                    <DataGridTextColumn x:Name="StatusColumn" Binding="{Binding Path=StatusMessage}" Header="Status" Width="Auto" />
                                    <DataGridTextColumn x:Name="AccountIdColumn" Binding="{Binding Path=AccountName}" Header="Account" Width="Auto" />
                                    <DataGridHyperlinkColumn x:Name="ContentIdColumn" ContentBinding="{Binding Path=ContentDescription}" Header="Message" Width="Auto" >
                                        <DataGridHyperlinkColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <EventSetter Event="Hyperlink.Click" Handler="ContentIdColumnClick"/>
                                            </Style>
                                        </DataGridHyperlinkColumn.ElementStyle>
                                    </DataGridHyperlinkColumn>
                                    <DataGridTemplateColumn x:Name="CreatedColumn" Header="Created" Width="Auto" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <DatePicker SelectedDate="{Binding Path=created, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn x:Name="DeliveryTimeColumn" Header="Delivery Time" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <xctk:DateTimePicker Format="Custom" FormatString="MM/dd/yyyy hh:mm" Value="{Binding Path=deliveryTime, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn x:Name="FinishedColumn" Header="Finished" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <xctk:DateTimePicker Format="Custom" FormatString="MM/dd/yyyy hh:mm" Value="{Binding Path=finished, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridHyperlinkColumn x:Name="ListIdsColumn" ContentBinding="{Binding Path=listIds}" Header="Recip Ids" Width="SizeToHeader" >
                                        <DataGridHyperlinkColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <EventSetter Event="Hyperlink.Click" Handler="ListIdsColumnClick"/>
                                            </Style>
                                        </DataGridHyperlinkColumn.ElementStyle>
                                    </DataGridHyperlinkColumn>
                                    <DataGridTextColumn x:Name="MessageCountColumn" Binding="{Binding Path=messageCount}" Header="Msg Count" Width="SizeToHeader" />
                                    <DataGridTextColumn x:Name="SmtpAccountIDColumn" Binding="{Binding Path=smtpAccountID}" Header="Email AcctId" Width="SizeToHeader" />
                                    <DataGridTextColumn x:Name="LastErrorColumn" Binding="{Binding Path=LastError}" Header="Last Error Message" Width="Auto"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        
                        <!-- DELIVERY SCHEDULE -->
                        <TabItem Name="tabItemDeliverySchedules" Header="Delivery Schedules">
                            <DataGrid AutoGenerateColumns="False" AlternatingRowBackground="AntiqueWhite" EnableRowVirtualization="True" ItemsSource="{Binding Source={StaticResource MessageScheduleViewSource}}" Name="MessageScheduleDataGrid" RowDetailsVisibilityMode="VisibleWhenSelected">
                                <DataGrid.Columns>
                                    <DataGridTextColumn x:Name="Msg_sched_idColumn" Binding="{Binding Path=msg_sched_id}" Header="Id" IsReadOnly="True" Width="Auto" />
                                    <DataGridHyperlinkColumn x:Name="Schedule_idColumn" ContentBinding="{Binding Path=ScheduleDescription}" Header="Schedule" Width="Auto" >
                                        <DataGridHyperlinkColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <EventSetter Event="Hyperlink.Click" Handler="Schedule_idColumnClick"/>
                                            </Style>
                                        </DataGridHyperlinkColumn.ElementStyle>
                                    </DataGridHyperlinkColumn>
                                    <DataGridTextColumn x:Name="DescriptionColumn" Binding="{Binding Path=description}" Header="Description" Width="Auto" />
                                    <DataGridTextColumn x:Name="SubjectColumn1" Binding="{Binding Path=subject}" Header="Subject" Width="Auto" />
                                    <DataGridTextColumn x:Name="FromColumn1" Binding="{Binding Path=from}" Header="From" Width="Auto" />
                                    <DataGridTextColumn x:Name="StatusColumn1" Binding="{Binding Path=status}" Header="status" Width="SizeToHeader" />
                                    <DataGridHyperlinkColumn x:Name="Content_idColumn" ContentBinding="{Binding Path=ContentDescription}" Header="Content" Width="Auto">
                                        <DataGridHyperlinkColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <EventSetter Event="Hyperlink.Click" Handler="Content_idColumnClick"/>
                                            </Style>
                                        </DataGridHyperlinkColumn.ElementStyle>
                                    </DataGridHyperlinkColumn>
                                    <DataGridCheckBoxColumn Header="RR" Binding="{Binding ReturnReceipt}" IsReadOnly="True"/>
                                    <DataGridTemplateColumn x:Name="CreatedColumn1" Header="Created On" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <xctk:DateTimePicker Value="{Binding Path=created, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" IsReadOnly="True" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn x:Name="Start_dateColumn" Header="Start On" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <xctk:DateTimePicker Value="{Binding Path=start_date, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn x:Name="Day_to_processColumn" Binding="{Binding Path=day_to_process}" Header="Day 1" Width="SizeToHeader" />
                                    <DataGridTextColumn x:Name="Day_to_process_2Column" Binding="{Binding Path=day_to_process_2}" Header="Day 2" Width="SizeToHeader" />
                                    <DataGridTemplateColumn x:Name="DoWhenColumn" Header="do When" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <xctk:DateTimePicker Value="{Binding Path=doWhen, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn x:Name="End_dateColumn" Header="end date" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <xctk:DateTimePicker Value="{Binding Path=end_date, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn x:Name="FrequencyColumn" Binding="{Binding Path=frequency}" Header="frequency" Width="SizeToHeader" />
                                    <DataGridTextColumn x:Name="HowOftenColumn" Binding="{Binding Path=HowOften}" Header="How Often" Width="SizeToHeader" />
                                    <DataGridCheckBoxColumn x:Name="IsChangedColumn" Binding="{Binding Path=isChanged}" Header="is Changed" Width="SizeToHeader" />
                                    <DataGridTemplateColumn x:Name="Last_sentColumn" Header="last sent" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <xctk:DateTimePicker Value="{Binding Path=last_sent, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" IsReadOnly="True" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridCheckBoxColumn x:Name="No_end_dateColumn" Binding="{Binding Path=no_end_date}" Header="no end date" Width="SizeToHeader" />
                                    <DataGridTextColumn x:Name="Number_to_processColumn" Binding="{Binding Path=number_to_process}" Header="number to process" Width="SizeToHeader" />
                                    <DataGridTextColumn x:Name="OnErrorColumn" Binding="{Binding Path=onError}" Header="on Error" Width="SizeToHeader" />
                                    <DataGridTextColumn x:Name="Process_countColumn" Binding="{Binding Path=process_count}" Header="process count" Width="SizeToHeader" />
                                    <DataGridTextColumn x:Name="RecipientsColumn" Binding="{Binding Path=recipients}" Header="recipients" Width="SizeToHeader" />
                                    <DataGridTextColumn x:Name="Smtp_acctColumn" Binding="{Binding Path=smtp_acct}" Header="smtp acct" Width="SizeToHeader" />
                                    <DataGridTextColumn x:Name="Account_idColumn" Binding="{Binding Path=account_id}" Header="account id" Width="SizeToHeader" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Name="tabItemJobCreation" Header="Log" GotFocus="Button_Click">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition Height="25"/>
                                </Grid.RowDefinitions>
                                <ScrollViewer Name="scrlJobLog"  HorizontalScrollBarVisibility="Auto">
                                    <TextBox Name="txtJobLogViewer" TextWrapping="NoWrap"/>
                                </ScrollViewer>
                                <Button Grid.Row="1" Content="REFRESH LOG" Click="Button_Click"/>
                            </Grid>
                        </TabItem>
                        <TabItem Name="tabItemSetServer" Header="Set Server">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="400"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="50"/>
                                    <RowDefinition Height="50"/>
                                    <RowDefinition Height="35"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Server" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Name="txtServerName" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Width="400"/>
                                
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Available Servers" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox Name="lstServers" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Width="400" SelectionChanged="lstServers_SelectionChanged"/>
                                
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                    <Button Name="cmdServerRevert" Content="Revert" Margin="0,5,0,5" Click="cmdServerRevert_Click" />
                                    <Button Name="cmdServerApply" Content="Apply" Margin="5" Click="cmdServerApply_Click"/>
                                </StackPanel>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>

            </TabItem>
            <TabItem Name="tabMessageDelivery" Header="Message Delivery">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" >
                        <Label Content="STATUS: " VerticalAlignment="Bottom"  FontWeight="Bold"/>
                        <TextBlock Name="DeliveryStatus" VerticalAlignment="Bottom" Width="150" Margin="0,5" FontWeight="ExtraBold" FontSize="14" Foreground="Red" Background="WhiteSmoke" />
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Name="cmdStartDelivery" Content="START" Margin="10,10,0,0" Grid.Column="0" Click="cmdStart_Click"/>
                            <Button Name="cmdStopDelivery" Content="STOP" Margin="10,10,0,0" Grid.Column="1" Click="cmdStop_Click"/>
                            <Button Name="cmdRESTARTDelivery" Content="RESTART" Margin="10,10,0,0" Grid.Column="2" Click="cmdRESTART_Click"/>
                            <Button Name="cmdInstallDelivery" Content="INSTALL" Margin="10,10,0,0" Grid.Column="3"/>
                            <Button Name="cmdUnInstallDelivery" Content="UNINSTALL" Margin="10,10,0,0" Grid.Column="4" />
                        </Grid>
                    </StackPanel>
                    <TabControl Grid.Row="1">
                        <TabItem Header="Log"  GotFocus="Button_Click_DeliveryLog">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition Height="25"/>
                                </Grid.RowDefinitions>
                                <ScrollViewer Name="scrlDeliveryLog"  HorizontalScrollBarVisibility="Auto">
                                    <TextBox Name="txtDeliveryLogViewer" TextWrapping="NoWrap"/>
                                </ScrollViewer>
                                <Button Grid.Row="1" Content="REFRESH LOG" Click="Button_Click_DeliveryLog"/>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>

            </TabItem>
            <TabItem Name="tabMessageListener" Header="Message Listener">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" >
                        <Label Content="STATUS: " VerticalAlignment="Bottom"  FontWeight="Bold"/>
                        <TextBlock Name="ListenerStatus" VerticalAlignment="Bottom" Width="150" Margin="0,5" FontWeight="ExtraBold" FontSize="14" Foreground="Red" Background="WhiteSmoke" />
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Name="cmdStartListener" Content="START" Margin="10,10,0,0" Grid.Column="0" Click="cmdStart_Click"/>
                            <Button Name="cmdStopListener" Content="STOP" Margin="10,10,0,0" Grid.Column="1" Click="cmdStop_Click"/>
                            <Button Name="cmdRESTARTListener" Content="RESTART" Margin="10,10,0,0" Grid.Column="2" Click="cmdRESTART_Click"/>
                            <Button Name="cmdInstallListener" Content="INSTALL" Margin="10,10,0,0" Grid.Column="3"/>
                            <Button Name="cmdUnInstallListener" Content="UNINSTALL" Margin="10,10,0,0" Grid.Column="4" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Name="cmdRefresh" Content="REFRESH" Margin="0,0,10,0" Click="cmdRefresh_Click"/>
            <Button Name="cmdExit" Content="EXIT" Click="cmdExit_Click"/>
        </StackPanel>
    </Grid>
</Window>
