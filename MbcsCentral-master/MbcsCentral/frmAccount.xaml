<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"  mc:Ignorable="d" x:Class="MbcsCentral.frmAccount"
        Title="Account Maintenance" Height="653" Width="401" Background="Bisque"
        Name="formAccount"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>
        <Grid >
            <Border Background="#99FFFFFF" BorderBrush="#CCCCFF" BorderThickness="3" Margin="10,10,10,10" Width="Auto" HorizontalAlignment="Stretch" Height="Auto" VerticalAlignment="Stretch">
                <TabControl x:Name="tabCtrl"  Background="LightGray" BorderBrush="Blue" SelectedIndex="{Binding Mode=OneWay}">
                    <TabItem x:Name="tabAccount" Header="Account Data" Background="Gray" FontSize="14" FontWeight="Bold" IsSelected="True" >
                        <Grid x:Name="grid1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,0" Width="aUTO">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="33"/>
                                <RowDefinition Height="33"/>
                                <RowDefinition Height="33"/>
                                <RowDefinition Height="33"/>
                                <RowDefinition Height="33"/>
                                <RowDefinition Height="33"/>
                                <RowDefinition Height="33"/>
                                <RowDefinition Height="33"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="33"/>
                                <RowDefinition Height="33"/>
                                <RowDefinition Height="33"/>
                                <RowDefinition Height="33"/>
                                <RowDefinition Height="33"/>
                                <RowDefinition Height="33"/>
                            </Grid.RowDefinitions>
                            <Label Content="account Id:" Grid.Column="0" HorizontalAlignment="Left" Margin="3" Grid.Row="0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="accountIdTextBox" Grid.Column="1" HorizontalAlignment="Left" Height="23" Margin="3" Grid.Row="0" Text="{Binding accountId, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" VerticalAlignment="Center" Width="50"/>
                            <Label Content="account Type:" Grid.Column="0" HorizontalAlignment="Left" Margin="3" Grid.Row="1" VerticalAlignment="Center"/>
                            <TextBox x:Name="accountTypeTextBox" Grid.Column="1" HorizontalAlignment="Left" Height="23" Margin="3" Grid.Row="1" Text="{Binding accountType, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" VerticalAlignment="Center" Width="120"/>
                            <Label Content="first Name:" Grid.Column="0" HorizontalAlignment="Left" Margin="3" Grid.Row="2" VerticalAlignment="Center"/>
                            <TextBox x:Name="firstNameTextBox" Grid.Column="1" HorizontalAlignment="Left" Height="23" Margin="2" Grid.Row="2" Text="{Binding firstName, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" VerticalAlignment="Center" Width="160" MaxLength="32"/>
                            <Label Content="last Name:" Grid.Column="0" HorizontalAlignment="Left" Margin="3" Grid.Row="3" VerticalAlignment="Center"/>
                            <TextBox x:Name="lastNameTextBox" Grid.Column="1" HorizontalAlignment="Left" Height="23" Margin="3" Grid.Row="3" Text="{Binding lastName, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" VerticalAlignment="Center" Width="160" MaxLength="32"/>
                            <Label Content="login:" Grid.Column="0" HorizontalAlignment="Left" Margin="3" Grid.Row="4" VerticalAlignment="Center"/>
                            <TextBox x:Name="loginTextBox" Grid.Column="1" HorizontalAlignment="Left" Height="23" Margin="3" Grid.Row="4" Text="{Binding login, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" VerticalAlignment="Center" Width="160" MaxLength="32"/>
                            <Label Content="email:" Grid.Column="0" HorizontalAlignment="Left" Margin="3" Grid.Row="5" VerticalAlignment="Center"/>
                            <TextBox x:Name="emailTextBox" Grid.Column="1" HorizontalAlignment="Left" Height="23" Margin="3" Grid.Row="5" Text="{Binding email, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" VerticalAlignment="Center" Width="200" MaxLength="50"/>
                            <Label Content="ip:" Grid.Column="0" HorizontalAlignment="Left" Margin="3" Grid.Row="6" VerticalAlignment="Center"/>
                            <TextBox x:Name="ipTextBox" Grid.Column="1" HorizontalAlignment="Left" Height="23" Margin="3" Grid.Row="6" Text="{Binding ip, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" VerticalAlignment="Center" Width="160" MaxLength="32"/>
                            <Label Content="mobile Phone:" Grid.Column="0" HorizontalAlignment="Left" Margin="3" Grid.Row="7" VerticalAlignment="Center"/>
                            <TextBox x:Name="mobilePhoneTextBox" Grid.Column="1" HorizontalAlignment="Left" Height="23" Margin="3" Grid.Row="7" Text="{Binding mobilePhone, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" VerticalAlignment="Center" Width="160" MaxLength="32"/>
                            <Label Content="outlook Folder:" Grid.Column="0" HorizontalAlignment="Left" Margin="3" Grid.Row="8" VerticalAlignment="Center"/>
                            <TextBox x:Name="outlookFolderTextBox" Grid.Column="1" HorizontalAlignment="Left" Height="50" Margin="3" Grid.Row="8" Text="{Binding outlookFolder, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" VerticalAlignment="Center" Width="200" TextWrapping="Wrap" />
                            <Label Content="parent Account:" Grid.Column="0" HorizontalAlignment="Left" Margin="3" Grid.Row="9" VerticalAlignment="Center"/>
                            <TextBox x:Name="parentAccountTextBox" Grid.Column="1" HorizontalAlignment="Left" Height="23" Margin="3" Grid.Row="9" Text="{Binding parentAccount, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" VerticalAlignment="Center" Width="120"/>
                            <Label Content="password:" Grid.Column="0" HorizontalAlignment="Left" Margin="3" Grid.Row="10" VerticalAlignment="Center"/>
                            <TextBox x:Name="passwordTextBox" Grid.Column="1" HorizontalAlignment="Left" Height="23" Margin="3" Grid.Row="10" Text="{Binding password, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" VerticalAlignment="Center" Width="160" MaxLength="32"/>
                            <Label Content="phone:" Grid.Column="0" HorizontalAlignment="Left" Margin="3" Grid.Row="11" VerticalAlignment="Center"/>
                            <TextBox x:Name="phoneTextBox" Grid.Column="1" HorizontalAlignment="Left" Height="23" Margin="3" Grid.Row="11" Text="{Binding phone, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" VerticalAlignment="Center" Width="160" MaxLength="32"/>
                            <Label Content="port:" Grid.Column="0" HorizontalAlignment="Left" Margin="3" Grid.Row="12" VerticalAlignment="Center"/>
                            <TextBox x:Name="portTextBox" Grid.Column="1" HorizontalAlignment="Left" Height="23" Margin="3" Grid.Row="12" Text="{Binding port, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" VerticalAlignment="Center" Width="120"/>
                            <Label Content="sms:" Grid.Column="0" HorizontalAlignment="Left" Margin="3" Grid.Row="13" VerticalAlignment="Center"/>
                            <TextBox x:Name="smsTextBox" Grid.Column="1" HorizontalAlignment="Left" Height="23" Margin="3" Grid.Row="13" Text="{Binding sms, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" VerticalAlignment="Center" Width="160" MaxLength="32"/>
                            <Label Content="use Outlook:" Grid.Column="0" HorizontalAlignment="Left" Margin="3" Grid.Row="14" VerticalAlignment="Center"/>
                            <CheckBox x:Name="useOutlookCheckBox" Content="" Grid.Column="1" HorizontalAlignment="Left" IsChecked="{Binding useOutlook, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" Margin="3" Grid.Row="14" VerticalAlignment="Center"/>
                        </Grid>

                    </TabItem>
                    <TabItem x:Name="tabGroups" Header="Group Membership"  Background="Gray" FontSize="14" FontWeight="Bold" IsSelected="False">
                        <Border Background="#99FFFFFF" BorderBrush="#CCCCFF" BorderThickness="5" Margin="10,10,10,10" Width="Auto" HorizontalAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="Auto"/>                                                  
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="35"/>
                                </Grid.RowDefinitions>
                                <ListBox Name="lstGroups" Grid.Column="0" Grid.Row="0" ItemsSource="{Binding}" DisplayMemberPath="group_name" SelectedValuePath="group_id" 
                                         SelectionMode="Extended" Padding="5,0,5,0" Margin="10" Height="Auto" Width="Auto" HorizontalAlignment="Stretch" 
                                         VerticalAlignment="Stretch" AllowDrop="True" MouseMove="lstGroups_MouseMove" Drop="lstGroups_Drop" DragEnter="lstGroups_DragEnter"/>
                                <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                    <Button Name="cmdAddOne" Content=">" Click="cmdAddOne_Click"/>
                                    <Button Name="cmdAddAll" Content=">>" Click="cmdAddAll_Click"/>
                                    <Button Name="cmdDelOne" Content="&lt;" Click="cmdDelOne_Click" Margin="0,10,0,0"/>
                                    <Button Name="cmdDelAll" Content="&lt;&lt;" Click="cmdDelAll_Click" />
                                </StackPanel>
                                <ListBox Name="lstMembership" Grid.Column="2" Grid.Row="0" ItemsSource="{Binding}" DisplayMemberPath="GroupName" SelectedValuePath="groupId" 
                                         SelectionMode="Extended" Padding="5,0,5,0" MinWidth="50" Margin="10" Height="Auto" Width="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                                         AllowDrop="True" Drop="lstMembership_Drop" DragEnter="lstMembership_DragEnter"  MouseMove="lstMembership_MouseMove"/>

                            </Grid>
                        </Border>

                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Button Name="cmdSave" Content="SAVE" Width="70" Margin="10,0,0,0" Click="cmdSave_Click"/>
            <Button Name="cmdExit" Content="EXIT" Width="70" Margin="10,0,0,0" Click="cmdExit_Click"/>
        </StackPanel>
    </Grid>
</Window>
