<Window
    x:Class="MbcsCentral.frmDocumentLayout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:my="clr-namespace:MbcsCentral"
    Name="FormDocumentLayout"
    Title="Document Page Layout Editor"
    Width="911"
    Height="660"
    Closed="Window_Closed"
    Closing="Window_Closing"
    Loaded="Window_Loaded">
    <Border
        Padding="5"
        BorderBrush="Blue"
        BorderThickness="3"
        CornerRadius="5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="300*" />
                <ColumnDefinition Width="100*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="115" />
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Orientation="Horizontal"
                TextBlock.FontSize="14">
                <StackPanel>
                    <Label Content="Documents" />
                    <ComboBox
                        Name="lstDocuments"
                        Margin="3,0,0,0"
                        Background="Beige"
                        DisplayMemberPath="DocumentName"
                        FontSize="16"
                        ItemsSource="{Binding}" />
                    <StackPanel>
                        <Label Content="Page Files" />
                        <ComboBox
                            Name="lstPages"
                            Width="200"
                            Margin="3,0,0,0"
                            VerticalAlignment="Center"
                            Background="Beige"
                            DisplayMemberPath="Pages"
                            FontSize="16"
                            ItemsSource="{Binding}" />
                    </StackPanel>
                </StackPanel>
                <Button
                    Name="cmdRetrieve"
                    Height="40"
                    Margin="5,8,0,0"
                    VerticalAlignment="Center"
                    Click="cmdRetrieve_Click"
                    Content="Retrieve" />
                <StackPanel>
                    <Label Content="Document Type" />
                    <ComboBox
                        Name="lstType"
                        Width="150"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Background="Wheat"
                        DisplayMemberPath="CategoryName"
                        ItemsSource="{Binding}"
                        SelectedIndex="0" />
                    <Label Content="Document Form" />
                    <ComboBox
                        Name="lstClass"
                        Width="150"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Background="Wheat"
                        DisplayMemberPath="Description"
                        ItemsSource="{Binding}"
                        SelectedIndex="0" />
                </StackPanel>
                <StackPanel
                    Height="75"
                    Margin="10,2,2,2"
                    Background="LightSkyBlue">
                    <TextBlock Text="FONT FAMILY" />
                    <Label
                        Name="lblFontFamily"
                        Margin="0,10,0,0"
                        BorderBrush="Black"
                        BorderThickness="2"
                        Content="{Binding Family}"
                        Foreground="Red" />
                </StackPanel>

                <StackPanel
                    Height="75"
                    Margin="10,2,2,2"
                    Background="LightSkyBlue">
                    <TextBlock Text="FONT STYLE" />
                    <Label
                        Name="lblFontStyle"
                        Margin="0,10,0,0"
                        BorderBrush="Black"
                        BorderThickness="2"
                        Content="{Binding Style}"
                        Foreground="Red" />
                </StackPanel>

                <StackPanel
                    Height="75"
                    Margin="10,2,2,2"
                    Background="LightSkyBlue">

                    <TextBlock Text="FONT WEIGHT" />
                    <Label
                        Name="lblFontWeight"
                        Margin="0,10,0,0"
                        BorderBrush="Black"
                        BorderThickness="2"
                        Content="{Binding Weight}"
                        Foreground="Red" />

                </StackPanel>
                <StackPanel
                    Height="75"
                    Margin="10,2,2,2"
                    Background="LightSkyBlue">
                    <TextBlock Text="SIZE" />
                    <Label
                        Name="lblFontSize"
                        Margin="0,10,0,0"
                        BorderBrush="Black"
                        BorderThickness="2"
                        Content="{Binding Size}"
                        Foreground="Red" />
                </StackPanel>
                <Button
                    Name="cmdChangeDefaultFont"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Background="LightSkyBlue"
                    BorderBrush="Blue"
                    Click="cmdChangeDefaultFont_Click"
                    Content="Change Default Font" />
            </StackPanel>

            <StackPanel
                Grid.Row="1"
                Grid.Column="0"
                Background="LightSkyBlue"
                TextBlock.FontSize="14"
                TextBlock.FontWeight="Bold">
                <Button
                    Name="cmdAddDocument"
                    Margin="5,30,5,5"
                    BorderBrush="Blue"
                    BorderThickness="3"
                    Click="cmdAddDocument_Click"
                    Content="New Page"
                    FontSize="13" />
                <Button
                    Name="cmdDocDelete"
                    Margin="5,25,5,5"
                    BorderBrush="Blue"
                    BorderThickness="3"
                    Click="cmdDocDelete_Click"
                    Content="Delete Page" />
                <Button
                    Name="cmdDocAlignVertically"
                    Margin="5,45,5,5"
                    FontSize="11"
                    BorderBrush="Blue"
                    BorderThickness="3"
                    Click="cmdDocAlignVertically_Click"
                    Content="Align Vertically" />
                <Button
                    x:Name="cmdDocAlignHorizontally"
                    Margin="5,15,5,5"
                    FontSize="11"
                    BorderBrush="Blue"
                    BorderThickness="3"
                    Click="cmdDocAlignHorizontally_Click"
                    Content="Align Horizontally" />
                <Button
                    x:Name="cmdDocClearSelections"
                    Margin="5,15,5,5"
                    FontSize="11"
                    BorderBrush="Blue"
                    BorderThickness="3"
                    Click="cmdDocClearSelections_Click"
                    Content="Clear Selections"/>
            </StackPanel>
            <Border
                Grid.Row="1"
                Grid.Column="1"
                BorderBrush="Blue"
                BorderThickness="2">
                <ScrollViewer
                    Background="AliceBlue"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <my:DragCanvas
                        x:Name="pnlDocument"
                        Width="850"
                        Height="1100"
                        Background="Transparent"
                        Focusable="True"
                        AllowDragging="True"
                        AllowDrop="True"
                        Drop="lstFields_Drop"
                        PreviewMouseLeftButtonDown="pnlDocument_PreviewMouseLeftButtonDown"
                        PreviewKeyDown="pnlDocument_KeyDown"
                        PreviewMouseRightButtonDown="pnlDocument_PreviewMouseRightButtonDown" />
                </ScrollViewer>
            </Border>
            <Grid Grid.Row="1" Grid.Column="2">
                <DockPanel Background="AliceBlue" LastChildFill="True">
                    <TextBlock
                        Height="30"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Top"
                        FontSize="16"
                        FontWeight="Bold"
                        Text="Available Fields"
                        TextAlignment="Center" />
                    <ListBox
                        Name="lstFields"
                        Margin="0,3,0,3"
                        Background="AliceBlue"
                        DisplayMemberPath="FullDescription"
                        FontWeight="Bold"
                        ItemsSource="{Binding}"
                        PreviewMouseMove="lstFields_PreviewMouseMove"
                        ScrollViewer.VerticalScrollBarVisibility="Visible" />
                </DockPanel>
            </Grid>

            <StackPanel
                Grid.Row="2"
                Grid.Column="1"
                Background="AliceBlue"
                Orientation="Horizontal">
                <Button
                    Name="cmdClose"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Click="cmdClose_Click"
                    Content="Close" />
                <Button
                    Name="cmdSave"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Click="cmdSave_Click"
                    Content="Save Layout" />
                <Button
                    Name="cmdDelete"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Click="cmdDelete_Click"
                    Content="Delete Layout" />
                <Button
                    Name="cmdHelp"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Click="cmdHelp_Click"
                    Content="Help" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
