<Window x:Class="MbcsCentral.frmReportViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report Viewer" Height="708" Width="508"
        Name="fromReportViewer"
        Loaded="fromReportViewer_Loaded"
        Background="AliceBlue">
    <Grid x:Name="rootGrid" >
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid Name="DisplayGrid" Grid.Row="0">
            <!-- Place holder for DocumentViewer -->
        </Grid>
        <Button Grid.Row="1" Name="cmdClose" Content="CLOSE" Click="cmdClose_Click_1"/>
    </Grid>
</Window>
