<Window x:Class="MbcsCentral.Email.frmAccountAddEdit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:my="clr-namespace:MbcsCentral"
        Name="FormfrmAccountAddEdit"
        Title="Email Account Maintenance"
        Width="438.207"
        Height="303.891"
        Background="AliceBlue"
        Closed="frmAccountAddEdit_Closed"
        FontSize="14"
        FontWeight="Bold"
        Loaded="frmAccountAddEdit_Loaded"
        TextBlock.TextAlignment="Center">
    <Window.Resources>
        <CollectionViewSource x:Key="MailTags" />

    </Window.Resources>
    <Border BorderBrush="Blue"
            BorderThickness="3"
            CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <TextBox Background="LightSteelBlue"
                     BorderBrush="Blue"
                     BorderThickness="2"
                     FontSize="14"
                     FontWeight="Bold"
                     Text="Email Account"
                     TextAlignment="Center" />
            <Grid Grid.Row="1"
                  Margin="5"
                  DataContext="{Binding}"
                  TextBlock.FontSize="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="25" />
                    <RowDefinition Height="25" />
                    <RowDefinition Height="25" />
                    <RowDefinition Height="25" />
                    <RowDefinition Height="25" />
                    <RowDefinition Height="80" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="Description:" />
                    <TextBox Name="txtDescription"
                             Width="150"
                             Margin="5,0,0,0"
                             VerticalAlignment="Center"
                             MaxLength="32"
                             Text="{Binding Path=description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextAlignment="Left" />
                    <TextBlock Margin="5,0,5,0"
                               VerticalAlignment="Center"
                               Text="MailTag:" />
                    <ComboBox Name="lstMailTag"
                              Width="150"
                              VerticalAlignment="Center"
                              Background="White"
                              DisplayMemberPath="MailTag"
                              ItemsSource="{Binding Source={StaticResource MailTags}}"
                              SelectedValue="{Binding Path=MailTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="MailTag" />
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="Email Address:" />
                    <TextBox Name="txtEmailAddress"
                             Width="250"
                             Margin="5,0,0,0"
                             VerticalAlignment="Center"
                             Text="{Binding Path=emailAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextAlignment="Left"
                             LostFocus="txtEmailAddress_LostFocus"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="User Name:" />
                    <TextBox Name="txtUserName"
                             Width="250"
                             Margin="5,0,0,0"
                             VerticalAlignment="Center"
                             MaxLength="64"
                             Text="{Binding Path=userName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextAlignment="Left" />
                </StackPanel>
                <StackPanel Grid.Row="3" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="Password:" />
                    <TextBox Name="txtPassword"
                             Width="150"
                             Margin="5,0,0,0"
                             VerticalAlignment="Center"
                             Text="{Binding Path=password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextAlignment="Left" />
                </StackPanel>
                <StackPanel Grid.Row="4" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="Display Name:" />
                    <TextBox Name="txtDisplayName"
                             Width="250"
                             Margin="5,0,0,0"
                             VerticalAlignment="Center"
                             MaxLength="64"
                             Text="{Binding Path=displayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextAlignment="Left" />
                </StackPanel>
                <Border Grid.Row="5"
                        BorderBrush="Black"
                        BorderThickness="2"
                        CornerRadius="3">

                    <TabControl Margin="5">
                        <TabItem FontSize="8" Header="OUTBOUND SERVER">
                            <StackPanel TextBlock.FontSize="10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" Text="Server Name:" />
                                    <TextBox Name="txtSmtpServer"
                                             Width="250"
                                             Margin="5,0,0,0"
                                             VerticalAlignment="Center"
                                             Text="{Binding Path=server, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             TextAlignment="Left" />
                                </StackPanel>
                                <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" Text="Port:" />
                                    <my:NumberEntry x:Name="txtOutPort"
                                                    Width="35"
                                                    Margin="5,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Decimals="0"
                                                    MaxLength="3"
                                                    Text="{Binding Path=port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    TextAlignment="Right" />
                                    <TextBlock Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="Connection Security:" />
                                    <ComboBox Name="lstSecurityType"
                                              Width="85"
                                              Margin="5,0,0,0"
                                              SelectedIndex="0">
                                        <ComboBoxItem>NONE</ComboBoxItem>
                                        <ComboBoxItem>STARTTLS</ComboBoxItem>
                                        <ComboBoxItem>SSL</ComboBoxItem>
                                        <ComboBoxItem>TLS</ComboBoxItem>
                                        <ComboBoxItem>SSL/TLS</ComboBoxItem>
                                    </ComboBox>
                                    <Button Name="cmdTest"
                                            Margin="20,0,0,0"
                                            VerticalAlignment="Center"
                                            Content="TEST" 
                                            Click="cmdTest_Click"/>
                                </StackPanel>
                                <StackPanel Margin="0,3,0,0" Orientation="Horizontal" />
                            </StackPanel>
                        </TabItem>
                        <TabItem FontSize="8" Header="INBOUND SERVER">
                            <StackPanel TextBlock.FontSize="10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" Text="Server Name:" />
                                    <TextBox Name="txtInServer"
                                             Width="250"
                                             Margin="5,0,0,0"
                                             VerticalAlignment="Center"
                                             Text="{Binding Path=in_server, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             TextAlignment="Left" />
                                </StackPanel>
                                <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" Text="Port:" />
                                    <my:NumberEntry x:Name="txtInPort"
                                                    Width="35"
                                                    Margin="5,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Decimals="0"
                                                    MaxLength="3"
                                                    Text="{Binding Path=in_port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    TextAlignment="Right" />
                                    <TextBlock Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="Connection Security:" />
                                    <ComboBox Name="lstInSecurityType"
                                              Width="85"
                                              Margin="5,0,0,0"
                                              SelectedIndex="0">
                                        <ComboBoxItem>NONE</ComboBoxItem>
                                        <ComboBoxItem>STARTTLS</ComboBoxItem>
                                        <ComboBoxItem>SSL</ComboBoxItem>
                                        <ComboBoxItem>TLS</ComboBoxItem>
                                        <ComboBoxItem>SSL/TLS</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,3,0,0" Orientation="Horizontal" />
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
            <StackPanel Grid.Row="2"
                        Margin="0,5,0,5"
                        Background="AliceBlue"
                        Orientation="Horizontal">
                <Button Name="cmdSave"
                        Margin="10,0,0,0"
                        Click="cmdSave_Click"
                        Content="SAVE" />
                <Button Name="cmdClose"
                        Margin="10,0,0,0"
                        Click="cmdClose_Click"
                        Content="CLOSE" />
            </StackPanel>
        </Grid>
    </Border>
</Window>