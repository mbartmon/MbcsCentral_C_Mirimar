<Window x:Class="MbcsCentral.Email.frmSmtpConfigurator"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:my="clr-namespace:MbcsCentral.Email"
        Name="formSmtpConfigurator"
        Title="Email Accounts Configuration"
        Width="988"
        Height="519"
        Background="{StaticResource {x:Static SystemColors.InactiveBorderBrushKey}}"
        Loaded="formSmtpDelivery_Loaded"
        mc:Ignorable="d">
    <Window.Resources>
        <CollectionViewSource x:Key="SmtpConfigViewSource" d:DesignSource="{d:DesignInstance my:SmtpConfig, CreateList=True}" />
        <DataTemplate x:Key="SmtpAccountDataTemplate">
            <Grid>
                <StackPanel HorizontalAlignment="Stretch" Orientation="Horizontal">
                    <TextBox Width="300"
                             Margin="10,0,0,0"
                             BorderThickness="0"
                             IsReadOnly="True"
                             Text="{Binding Path=description, FallbackValue=description}"
                             TextWrapping="Wrap" />
                    <TextBox Width="25"
                             Margin="5,0,0,0"
                             HorizontalAlignment="Left"
                             Text="{Binding Path=AccountId, FallbackValue=AccountId}"
                             TextAlignment="Right" />
                    <CheckBox Name="chkDefault"
                              Margin="5,0,0,0"
                              Content="Default?"
                              IsChecked="{Binding Path=defaultAccount, FallbackValue=defaultAccount}"
                              IsEnabled="False"
                              IsTabStop="False" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <CollectionViewSource x:Key="MailTags" />
    </Window.Resources>
    <Grid Name="gridMain"
          Height="auto"
          DataContext="{StaticResource SmtpConfigViewSource}">
        <Grid.RowDefinitions>
            <RowDefinition Height="39" />
            <RowDefinition Height="*" />
            <RowDefinition Height="35" />
            <RowDefinition Height="160" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Border Name="Border1"
                Width="248"
                Height="33"
                HorizontalAlignment="center"
                VerticalAlignment="Center"
                Background="{StaticResource {x:Static SystemColors.GradientActiveCaptionBrushKey}}"
                BorderBrush="{StaticResource {x:Static SystemColors.ControlTextBrushKey}}"
                BorderThickness="2"
                CornerRadius="20">
            <TextBlock Name="TextBlock1"
                       Width="Auto"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="16"
                       FontWeight="Bold"
                       Text="Email Account Configurations" />
        </Border>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Label Content="Email Accounts" FontWeight="Bold" />
            <ListBox Name="lstSmtpAccts"
                     Width="450"
                     HorizontalAlignment="Stretch"
                     ItemTemplate="{DynamicResource SmtpAccountDataTemplate}"
                     ItemsSource="{Binding}"
                     MouseDoubleClick="lstSmtpAccts_MouseDoubleClick"
                     SelectedValuePath="ID"
                     />
            <StackPanel Name="pnlAccount" Margin="20,10,0,0">
                <TextBlock FontWeight="Bold" Text="For Account" />
                <TextBox Name="txtAccountName"
                         Width="200"
                         BorderBrush="Blue"
                         BorderThickness="2"
                         IsReadOnly="True" />
            </StackPanel>
        </StackPanel>
        <StackPanel Name="StackAddSmtp"
                    Grid.Row="2"
                    Height="25"
                    Orientation="Horizontal"
                    Visibility="Collapsed">
            <Label Width="Auto"
                   Content="New Email Account Description"
                   FontWeight="Bold" />
            <TextBox Name="NewSmtpAccount" Width="120" />
            <Button Name="cmdSaveNewSmtp"
                    Click="cmdSaveNewSmtp_Click"
                    Content="SAVE" />
            <Button Name="cmdCancelNewSmtp"
                    Click="cmdCancelNewSmtp_Click"
                    Content="CANCEL" />
        </StackPanel>
        <StackPanel Grid.Row="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
            <Grid Name="Grid1"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox Name="DescriptionTextBox"
                         Grid.Column="1"
                         Width="200"
                         Height="22"
                         Margin="3,2,0,8"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Text="{Binding Path=description, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" />
                <Label Grid.Row="0"
                       Grid.Column="0"
                       Margin="3"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Content="Description:"
                       FontWeight="Bold" />
            </Grid>
            <StackPanel Name="pnlMailTag" Orientation="Horizontal">
                <TextBlock Margin="10,0,5,0"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Text="Mail Tag" />
                <ComboBox Name="lstMailTags"
                          Width="150"
                          VerticalAlignment="Center"
                          Background="White"
                          DisplayMemberPath="MailTag"
                          ItemsSource="{Binding Source={StaticResource MailTags}}"
                          SelectedValue="{Binding Path=MailTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          SelectedValuePath="MailTag" />
            </StackPanel>
            <Grid Name="Grid2"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox Name="EmailAddressTextBox"
                         Grid.Column="1"
                         Width="240"
                         Height="23"
                         Margin="3,3,0,3"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         LostFocus="EmailAddressTextBox_LostFocus"
                         Text="{Binding Path=emailAddress, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" />
                <Label Grid.Row="0"
                       Grid.Column="0"
                       Margin="3"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Content="Email Address:"
                       FontWeight="Bold" />
            </Grid>
            <Grid Name="Grid10"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Grid.Row="0"
                       Grid.Column="0"
                       Margin="3"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Content="Default Account:" />
                <CheckBox Name="chkDefault"
                          Grid.Row="0"
                          Grid.Column="1"
                          Height="16"
                          Margin="3"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Content=""
                          IsChecked="{Binding Path=defaultAccount, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" />
            </Grid>
        </StackPanel>
        <TextBox Grid.Row="3" Text="DOUBLE CLICK an account to edit it." HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" Background="Yellow"/>

