<Window x:Class="MbcsCentral.MessageBoxCustomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:MbcsCentral.WinGL"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Name="FormMessageBoxCustom"
        Width="550"
        SizeToContent="Height"
        VerticalAlignment="Stretch"
        Background="AliceBlue"
        Closed="MessageBoxCustomWindow_Closed"
        FontSize="14"
        FontWeight="Bold"
        Loaded="MessageBoxCustomWindow_Loaded"
        TextBlock.TextAlignment="Center"
        WindowStyle="None"
        MinHeight="240"
        MaxHeight="955"
        SizeChanged="FormMessageBoxCustom_SizeChanged"
        mc:Ignorable="d" Height="127.928">
    <Border BorderBrush="Blue"
            BorderThickness="3"
            CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <TextBox Name="txtTitle"
                     Background="LightSteelBlue"
                     BorderBrush="Blue"
                     BorderThickness="2"
                     FontSize="14"
                     FontWeight="Bold"
                     TextAlignment="Center" 
                     Width="Auto"
                     Height="Auto"/>
            <Grid Grid.Row="1">
                <TextBox Name="txtMessage" IsReadOnly="True" Margin="19,21,21,19" FontFamily="Courier New" TextAlignment="Left" MinHeight="65"  MaxHeight="845" TextWrapping="WrapWithOverflow"  VerticalAlignment="Stretch" Padding="3" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </Grid>
            <StackPanel Name="pnlButtons"
                        Grid.Row="2"
                        Margin="0,5,0,5"
                        Background="AliceBlue"
                        Orientation="Horizontal" />
        </Grid>
    </Border>
</Window>

