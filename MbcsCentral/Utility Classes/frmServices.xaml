<Window Name="formServices"
    x:Class="MbcsCentral.frmServices"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:my="clr-namespace:WinTRM"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    Title="WinTRM Service Management"
    Width="864"
    Height="453"
    FontWeight="Bold"
    mc:Ignorable="d">

    <Window.Resources />
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="25" />
        </Grid.RowDefinitions>
        <TabControl Background="{StaticResource {x:Static SystemColors.GradientInactiveCaptionBrushKey}}">
            <TabItem Name="tabMessageListener" Header="Message Listener">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Label
                            VerticalAlignment="Bottom"
                            Content="STATUS: "
                            FontWeight="Bold" />
                        <TextBlock Name="ListenerStatus"
                            Width="150"
                            Margin="0,5"
                            VerticalAlignment="Bottom"
                            Background="WhiteSmoke"
                            FontSize="14"
                            FontWeight="ExtraBold"
                            Foreground="Red" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Name="cmdStartListener"
                                Grid.Column="0"
                                Margin="10,10,0,0"
                                Click="cmdStart_Click"
                                Content="START" />
                            <Button Name="cmdStopListener"
                                Grid.Column="1"
                                Margin="10,10,0,0"
                                Click="cmdStop_Click"
                                Content="STOP" />
                            <Button Name="cmdRESTARTListener"
                                Grid.Column="2"
                                Margin="10,10,0,0"
                                Click="cmdRESTART_Click"
                                Content="RESTART" />
                            <Button Name="cmdInstallListener"
                                Grid.Column="3"
                                Margin="10,10,0,0"
                                Content="INSTALL" />
                            <Button Name="cmdUnInstallListener"
                                Grid.Column="4"
                                Margin="10,10,0,0"
                                Content="UNINSTALL" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Button Name="cmdRefresh"
                Margin="0,0,10,0"
                Click="cmdRefresh_Click"
                Content="REFRESH" />
            <Button Name="cmdExit"
                Click="cmdExit_Click"
                Content="EXIT" />
        </StackPanel>
    </Grid>
</Window>
