
<Window Name="Formfrm1099Report"
    x:Class="MbcsCentral.WinGL.frm1099Report"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="1099 Report"
    Height="277.481"
    Background="AliceBlue"
    Closed="frm1099Report_Closed"
    FontSize="14"
    FontWeight="Bold"
    Loaded="frm1099Report_Loaded"
    TextBlock.TextAlignment="Center" Width="628.5">
    <Border
        Margin="0,0,0,-4"
        BorderBrush="Blue"
        BorderThickness="3"
        CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBox Text="1099 Report"
                Background="LightSteelBlue"
                BorderBrush="Blue"
                BorderThickness="2"
                FontSize="14"
                FontWeight="Bold"
                TextAlignment="Center" />
            <Grid Grid.Row="1">
                <!--  Place your content here  -->
                <Grid Name="grdMain" DataContext="{Binding}" TextBlock.FontSize="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Name="colMain" Width="250" />
                        <ColumnDefinition Name="colAction" Width="100" />
                        <ColumnDefinition Name="colVendor" Width="260" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Starting Date"
                                Width="80"
                                VerticalAlignment="Center"
                                TextAlignment="Left" />
                            <DatePicker Name="dtStart"
                                SelectedDate="{Binding Path=StartDate}"
                                Width="100"
                                VerticalAlignment="Center"
                                SelectedDateFormat="Short" />
                        </StackPanel>
                        <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                            <TextBlock Text="Ending Date"
                                Width="80"
                                VerticalAlignment="Center"
                                TextAlignment="Left" />
                            <DatePicker Name="dtEnd"
                                SelectedDate="{Binding Path=EndDate}"
                                Width="100"
                                VerticalAlignment="Center"
                                SelectedDateFormat="Short" />
                        </StackPanel>
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <CheckBox Name="chkDetail"
                                IsChecked="{Binding Path=PrintDetail}"
                                VerticalAlignment="Center"
                                Content="Print Detail" />
                        </StackPanel>
                        <GroupBox
                            Margin="0,10,0,0"
                            BorderThickness="2"
                            Header="Report Order">
                            <StackPanel>
                                <RadioButton Name="optVendor"
                                    Margin="5,10,0,0"
                                    Content="By Vendor"
                                    GroupName="grpOrder"
                                    IsChecked="{Binding Path=OrderByVendor}" />
                                <RadioButton Name="optCompany"
                                    Margin="5,5,0,5"
                                    Content="By Company"
                                    GroupName="grpOrder">
                                    <RadioButton.Style>
                                        <Style TargetType="RadioButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=OrderByVendor}" Value="False">
                                                    <Setter Property="IsChecked" Value="True"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Path=OrderByVendor}" Value="True">
                                                    <Setter Property="IsChecked" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </RadioButton.Style>
                                </RadioButton>
                            </StackPanel>
                        </GroupBox>
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <CheckBox Name="chkAddress"
                                IsChecked="{Binding Path=PrintVendorAddress}"
                                VerticalAlignment="Center"
                                Content="Print Vendor Address" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <Border BorderBrush="Black" BorderThickness="2,0,3,0">
                            <TextBlock Text="ACTIONS"
                                Margin="5,0,5,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold" />
                        </Border>
                        <Border
                            VerticalAlignment="Stretch"
                            BorderBrush="Black"
                            BorderThickness="3,3,2,3">
                            <StackPanel>
                                <Button x:Name="cmdDisplay"
                                    Width="85"
                                    Height="30"
                                    Margin="5,10,5,0"
                                    HorizontalAlignment="Center"
                                    Click="cmdDisplayClick"
                                    Content="DISPLAY" />
                                <Button x:Name="cmdVendors"
                                    Width="85"
                                    Height="30"
                                    Margin="5,10,5,0"
                                    HorizontalAlignment="Center"
                                    Click="cmdVendors_Click"
                                    Content="VENDORS&gt;&gt;" />
                                <Button x:Name="cmdExit"
                                    Width="85"
                                    Height="30"
                                    Margin="5,10,5,5"
                                    HorizontalAlignment="Center"
                                    Click="cmdClose_Click"
                                    Content="EXIT" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Grid x:Name="Expander" Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Name="VendorEntry"
                            Grid.Row="0"
                            BorderBrush="Black"
                            BorderThickness="2,0,3,0">
                            <TextBlock Text="INDIVIDUAL VENDORS"
                                Margin="5,0,5,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold" />
                        </Border>
                        <Border x:Name="bdrTenants"
                            Grid.Row="1"
                            BorderBrush="Black"
                            BorderThickness="2,3,3,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Vendor Name"
                                        Width="83"
                                        Margin="5,5,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        TextAlignment="Left" />
                                    <ComboBox x:Name="lstVendorNames"
                                              IsEditable="True"
                                              IsTextSearchEnabled="True"
                                              TextBlock.TextAlignment="Left"
                                        Width="160"
                                        Margin="5,5,5,0"
                                        VerticalAlignment="Center"
                                        DisplayMemberPath="FullName"
                                        ItemsSource="{Binding}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel>
                                        <Button x:Name="cmdAdd"
                                            Width="80"
                                            Margin="5,5,0,0"
                                            Click="cmdAdd_Click"
                                            Content="ADD"
                                            IsDefault="True"
                                            IsEnabled="False" />
                                        <Button x:Name="cmdRemove"
                                            Width="80"
                                            Margin="5,10,0,0"
                                            Click="cmdRemove_Click"
                                            Content="REMOVE" />
                                        <Button x:Name="cmdClear"
                                            Width="80"
                                            Margin="5,10,0,0"
                                            Click="cmdClear_Click"
                                            Content="CLEAR" />
                                    </StackPanel>
                                    <ListBox x:Name="lstVendors"
                                        Width="160"
                                        Height="150"
                                        Margin="8,5,0,0"
                                        VerticalAlignment="Stretch"
                                        DisplayMemberPath="VendorName" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
