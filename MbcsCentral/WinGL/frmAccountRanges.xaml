
<Window x:Class="MbcsCentral.WinGL.frmAccountRanges"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Name="FormfrmAccountRanges"
        Width="420.564"
        Height="414.484"
        Background="AliceBlue"
        Closed="frmAccountRanges_Closed"
        FontSize="14"
        FontWeight="Bold"
        Loaded="frmAccountRanges_Loaded"
        TextBlock.TextAlignment="Center"
        Title="Account Ranges">
    <Border BorderBrush="Blue"
            BorderThickness="3"
            CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <TextBox Background="LightSteelBlue"
                     BorderBrush="Blue"
                     BorderThickness="2"
                     FontSize="14"
                     FontWeight="Bold"
                     Text="Account Ranges"
                     TextAlignment="Center" />
            <Grid Grid.Row="1">
                <ListView Name="lstAccounts" ItemsSource="{Binding}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Account Description" Width="350">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Description}">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RangeCatFlag}" Value="True">
                                                            <Setter Property="Background" Value="Coral"/>
                                                        </DataTrigger>
                                                         <DataTrigger Binding="{Binding RangeCatFlag}" Value="True">
                                                            <Setter Property="TextAlignment" Value="Center"/>
                                                        </DataTrigger>
                                                           <DataTrigger Binding="{Binding RangeCatFlag}" Value="True">
                                                            <Setter Property="TextAlignment" Value="Center"/>
                                                        </DataTrigger>
                                                         <DataTrigger Binding="{Binding RangeCatFlag}" Value="False">
                                                            <Setter Property="TextAlignment" Value="Left"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RangeCatFlag}" Value="False">
                                                            <Setter Property="Background" Value="White"/>
                                                        </DataTrigger>
                                                   </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                              </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Use" Width="30">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding RangeUseFlag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Checked="CheckBox_Checked" Unchecked="CheckBox_Checked"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
            <StackPanel Grid.Row="2"
                        Margin="0,5,0,5"
                        Background="AliceBlue"
                        Orientation="Horizontal">
                <Button Name="cmdSave"
                        Margin="10,0,0,0"
                        Click="cmdSave_Click"
                        Content="SAVE" />
                <Button Name="cmdClose"
                        Margin="10,0,0,0"
                        Click="cmdClose_Click"
                        Content="CANCEL" />
                <Button Name="cmdSelectAll"
                        Margin="40,0,0,0"
                        Click="cmdSelectAll_Click"
                        Content="Select All"/>
                <Button Name="cmdSelectClear"
                        Margin="10,0,0,0"
                        Click="cmdSelectClear_Click"
                        Content="Clear All"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
