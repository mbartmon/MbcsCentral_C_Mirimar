<Window x:Class="MbcsCentral.WinGL.frmAchSelectReport"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Name="FormfrmAchSelectReport"
        ResizeMode="NoResize"
        Width="300"
        Height="200"
        Background="AliceBlue"
        Closed="frmAchSelectReport_Closed"
        FontSize="14"
        FontWeight="Bold"
        Loaded="frmAchSelectReport_Loaded"
        TextBlock.TextAlignment="Center"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">
    <Border BorderBrush="Blue"
            BorderThickness="3"
            CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <TextBox Background="LightSteelBlue"
                     BorderBrush="Blue"
                     BorderThickness="2"
                     FontSize="14"
                     FontWeight="Bold"
                     Text="ACH Selection Report"
                     TextAlignment="Center" />
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Grid.Row="0"
                           Margin="5"
                           VerticalAlignment="Center"
                           Text="Payment Due Date" />
                <DatePicker Grid.Column="1"
                            Grid.Row="0"
                            VerticalAlignment="Center"
                            Margin="5"
                            Name="dtpPaymentDueDate"
                            SelectedDate="{x:Static sys:DateTime.Now}" />

            </Grid>
            <StackPanel Grid.Row="2"
                        Margin="0,5,0,5"
                        Background="AliceBlue"
                        Orientation="Horizontal">
                <Button Name="cmdSave"
                        Margin="10,0,0,0"
                        Click="cmdSave_Click"
                        Content="DISPLAY" />
                <Button Name="cmdClose"
                        Margin="10,0,0,0"
                        Click="cmdClose_Click"
                        Content="CLOSE" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
