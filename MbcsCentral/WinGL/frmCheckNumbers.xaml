
<Window
    x:Class="MbcsCentral.WinGL.frmCheckNumbers"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:my="clr-namespace:MbcsCentral"
    Name="FormfrmCheckNumbers"
    Title="Check Numbers"
    Width="861"
    Height="300"
    Background="AliceBlue"
    Closed="frmCheckNumbers_Closed"
    FontSize="14"
    FontWeight="Bold"
    Loaded="frmCheckNumbers_Loaded"
    TextBlock.TextAlignment="Center">
    <Border
        BorderBrush="Blue"
        BorderThickness="3"
        CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <TextBox
                Background="LightSteelBlue"
                BorderBrush="Blue"
                BorderThickness="2"
                FontSize="14"
                FontWeight="Bold"
                Text="Check Numbers"
                TextAlignment="Center" />
            <Grid Grid.Row="1">
                <!--  Place your content here  -->
                <DataGrid
                    Name="grdCheckNumbers"
                    AutoGenerateColumns="False"
                    ItemsSource="{Binding}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn
                            Width="250"
                            Header="Company">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Width="300" Text="{Binding CompanyName}" TextAlignment="Left"/>
                                </DataTemplate>    
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn
                            Header="Department"
                            Width="250">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Width="300" Text="{Binding DepartmentName}" TextAlignment="Left"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="120" Header="NEXT REGULAR">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CheckNumber, StringFormat={}{0:#####0}}" TextAlignment="Right"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <my:NumberEntry
                                    x:Name="txtCheck"
                                    VerticalAlignment="Center"
                                    Decimals="0"
                                    MaxLength="6"
                                    Text="{Binding CheckNumber}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="120" Header="NEXT EFT">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding BatchCheck, StringFormat={}{0:#####0}}" TextAlignment="Right"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <my:NumberEntry
                                    x:Name="txtBatch"
                                    VerticalAlignment="Center"
                                    Decimals="0"
                                    MaxLength="6"
                                    Text="{Binding BatchCheck, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="120" Header="NEXT ACH">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ACHCheck, StringFormat={}{0:#####0}}" TextAlignment="Right"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <my:NumberEntry
                                        x:Name="txtACH"
                                        VerticalAlignment="Center"
                                        Decimals="0"
                                        MaxLength="6"
                                        Text="{Binding ACHCheck, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <StackPanel
                Grid.Row="2"
                Margin="0,5,0,5"
                Background="AliceBlue"
                Orientation="Horizontal">
                <Button
                    Name="cmdSave"
                    Margin="10,0,0,0"
                    Click="cmdSave_Click"
                    Content="SAVE" />
                <Button
                    Name="cmdClose"
                    Margin="10,0,0,0"
                    Click="cmdClose_Click"
                    Content="CLOSE" />
                <Button Name="cmdRefresh"
                        Margin="25,0,0,0"
                        Click="cmdRefresh_Click"
                        Content="REFRESH"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
