<Window x:Class="MbcsCentral.WinGL.frmCompany"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viblend="clr-namespace:VIBlend.WPF.Controls;assembly=VIBlend.WPF.Editors"
        xmlns:my="clr-namespace:MbcsCentral"
        Name="formCompany"
        Title="Company Record"
        Width="382"
        Height="363"
        Background="#FF00C0C0"
        FontSize="12"
        FontWeight="Bold">
    <Grid Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="112" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="25" />
            <RowDefinition Height="20" />
            <RowDefinition Height="20" />
            <RowDefinition Height="20" />
            <RowDefinition Height="20" />
            <RowDefinition Height="20" />
            <RowDefinition Height="20" />
            <RowDefinition Height="20" />
            <RowDefinition Height="20" />
            <RowDefinition Height="20" />
            <RowDefinition Height="20" />
            <RowDefinition Height="20" />
            <RowDefinition Height="20"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <TextBlock Margin="5,0,0,0"
                   VerticalAlignment="Center"
                   Text="Company Number" />
        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1">
            <viblend:NumberEditor Name="txtCompanyNumber"
                              Width="30"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              DecimalPlaces="0"
                              MaxLength="2"
                              Text="{Binding CompanyNumber,
                                             Mode=TwoWay}" />
            <CheckBox Name="chkInactive" IsChecked="{Binding InActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="InActive?" Margin="20,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Row="1"
                   Margin="5,0,0,0"
                   VerticalAlignment="Center"
                   Text="Company Name" />
        <TextBox Name="txtCompanyName"
                 Grid.Row="1"
                 Grid.Column="1"
                 Width="250"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Center"
                 MaxLength="50"
                 Text="{Binding Name,
                                Mode=TwoWay}" />
        <TextBlock Grid.Row="2"
                   Margin="5,0,0,0"
                   VerticalAlignment="Center"
                   Text="Street Address" />
        <TextBox Grid.Row="2"
                 Grid.Column="1"
                 Width="200"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Center"
                 MaxLength="50"
                 Text="{Binding StreetAddress,
                                Mode=TwoWay}" />
        <TextBlock Grid.Row="3"
                   Margin="5,0,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Text="City" />
        <TextBox Grid.Row="3"
                 Grid.Column="1"
                 Width="200"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Center"
                 MaxLength="50"
                 Text="{Binding City,
                                Mode=TwoWay}" />
        <TextBlock Grid.Row="4"
                   Margin="5,0,0,0"
                   VerticalAlignment="Center"
                   Text="State/Zip" />
        <StackPanel Grid.Row="4"
                    Grid.Column="1"
                    Orientation="Horizontal">
            <TextBox Width="30"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     MaxLength="2"
                     Text="{Binding State,
                                    Mode=TwoWay}" />
            <TextBox Width="100"
                     Margin="5,0,0,0"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     Text="{Binding Zip,
                                    Mode=TwoWay}" />
        </StackPanel>
        <TextBlock Grid.Row="5"
                   Margin="5,0,0,0"
                   VerticalAlignment="Center"
                   Text="Telephone" />
        <TextBox Grid.Row="5"
                 Grid.Column="1"
                 Width="150"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Center"
                 MaxLength="20"
                 Text="{Binding Telephone,
                                Mode=TwoWay}" />
        <TextBlock Grid.Row="6"
                   Grid.Column="0"
                   Margin="5,0,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Text="Fax" />
        <TextBox Grid.Row="6"
                 Grid.Column="1"
                 Width="150"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Center"
                 MaxLength="20"
                 Text="{Binding Fax,
                                Mode=TwoWay}" />
        <TextBlock Grid.Row="7"
                   Margin="5,0,0,0"
                   VerticalAlignment="Center"
                   Text="Federal ID#" />
        <TextBox Grid.Row="7"
                 Grid.Column="1"
                 Width="150"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Center"
                 MaxLength="11"
                 Text="{Binding FederalID,
                                Mode=TwoWay}" />
        <TextBlock Grid.Row="8"
                   Grid.Column="0"
                   Margin="5,0,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Text="State ID#" />
        <TextBox Grid.Row="8"
                 Grid.Column="1"
                 Width="150"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Center"
                 MaxLength="11"
                 Text="{Binding StateID,
                                Mode=TwoWay}" />
        <TextBlock Grid.Row="9"
                   Margin="5,0,0,0"
                   VerticalAlignment="Center"
                   Text="Email" />
        <TextBox Grid.Row="9"
                 Grid.Column="1"
                 Width="250"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Center"
                 Text="{Binding Email,
                                Mode=TwoWay}" />
        <TextBlock Grid.Row="10"
                   Margin="5,0,0,0"
                   VerticalAlignment="Center"
                   Text="Routing Number"/>
        <TextBox Grid.Row="10"
                 Grid.Column="1"
                 Width="100"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Center"
                 MaxLength="9"
                 Text="{Binding RoutingNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Grid.Row="11"
                   Margin="5,0,0,0"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   Text="Bank Account"/>
        <TextBox Grid.Row="11"
                 Grid.Column="1"
                 Width="150"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Center"
                 MaxLength="17"
                 Text="{Binding BankAccount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Grid.Row="12"
                   Margin="5,0,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Text="Current Fiscal Year" />
        <my:NumberEntry Grid.Row="12"
                               Grid.Column="1"
                               Width="50"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Decimals="0"
                               MaxLength="4"
                               Text="{Binding CurrentFiscalYear,
                                               Mode=TwoWay,
                                               StringFormat={}{0:0000}}" />
        <Button Name="cmdOk"
                Grid.Row="13"
                Width="50"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="cmdOk_Click"
                Content="SAVE" />
        <Button Name="cmdCancel"
                Grid.Row="13"
                Grid.Column="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Click="cmdCancel_Click"
                Content="CANCEL" />
    </Grid>
</Window>