<Window x:Class="MbcsCentral.WinGL.frmJournalNames"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:MbcsCentral.WinGL"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Name="formJournalNames"
        Title="Journal Name Maintenance"
        Width="484.902"
        Closed="formJournalNames_Closed"
        Loaded="formJournalNames_Loaded"
        TextBlock.FontSize="14"
        TextBlock.FontWeight="Bold"
        TextBlock.TextAlignment="Center"
        mc:Ignorable="d">

    <Grid>
        <Border Margin="0,0,0,0"
                BorderBrush="Blue"
                BorderThickness="3"
                CornerRadius="5">
            <Grid TextBlock.FontSize="12" TextBlock.TextAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="35" />
                </Grid.RowDefinitions>
                <DataGrid Name="grdJournals"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          ItemsSource="{Binding}">
                    <DataGrid.ItemContainerStyle>
                        <Style TargetType="{x:Type DataGridRow}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=Delete}" Value="true">
                                    <Setter Property="DataGridRow.Foreground" Value="Red" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Delete}" Value="false">
                                    <Setter Property="DataGridRow.Foreground" Value="Black" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.ItemContainerStyle>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Name="ctxAdd"
                                      Click="ctxAdd_Click"
                                      Header="ADD New Journal Name" />
                            <MenuItem Name="ctxDelete"
                                      Click="ctxDelete_Click"
                                      Header="DELETE this Journal Name" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="200"
                                            Binding="{Binding JournalName,
                                                              Mode=TwoWay,
                                                              UpdateSourceTrigger=PropertyChanged}"
                                            FontWeight="Normal"
                                            Header="Name" />

                        <DataGridTextColumn Width="250"
                                            Binding="{Binding Description,
                                                              Mode=TwoWay,
                                                              UpdateSourceTrigger=PropertyChanged}"
                                            FontWeight="Normal"
                                            Header="Description" />
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="1"
                            Margin="10,0,0,0"
                            Orientation="Horizontal">
                    <Button Name="cmdAdd"
                            VerticalAlignment="Center"
                            Click="ctxAdd_Click"
                            Content="ADD New Journal" />
                    <Button Name="cmdDelete"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"
                            Click="ctxDelete_Click"
                            Content="DELETE Selected Journal" />
                    <Button Name="cmdSave"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"
                            Click="cmdSave_Click"
                            Content="SAVE CHANGES" />
                    <Button Name="cmdExit"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"
                            Click="cmdExit_Click"
                            Content="EXIT" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
