<Window
    x:Class="MbcsCentral.WinGL.frmVendorAllocations"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:MbcsCentral"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:edit="clr-namespace:MbcsCentral"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:my="clr-namespace:MbcsCentral.WinGL"
    xmlns:viblend="clr-namespace:VIBlend.WPF.Controls;assembly=VIBlend.WPF.Editors"
    x:Name="formVendorAllocations"
    Title="Vendor Allocations"
    Width="835.809"
    Height="300"
    Closed="formVendorAllocations_Closed"
    FontWeight="Bold"
    Loaded="formVendorAllocations_Loaded"
    TextBlock.TextAlignment="Center"
    mc:Ignorable="d">
    <Window.Resources>
        <!--  SINGLE CLICK EDITING  -->
        <Style TargetType="{x:Type DataGridCell}">
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DataGridCell_PreviewMouseLeftButtonDown" />
        </Style>

        <CollectionViewSource x:Key="departments" />
        <CollectionViewSource x:Key="companies" />
        <CollectionViewSource x:Key="accounts" />
        <CollectionViewSource x:Key="journals" />
        <edit:IdToName x:Key="IdToName" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition />
            <RowDefinition Height="35" />
        </Grid.RowDefinitions>
        <Border
            Height="35"
            Margin="1"
            Padding="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="Linen"
            BorderBrush="Blue"
            BorderThickness="3"
            CornerRadius="5">
            <TextBlock
                x:Name="txtVendorName"
                Width="Auto"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Linen"
                FontSize="20" />
        </Border>
        <Border
            Grid.Row="1"
            Margin="1"
            Padding="2"
            BorderBrush="Blue"
            BorderThickness="3"
            CornerRadius="5">
            <DataGrid
                x:Name="grdAllocations"
                AutoGenerateColumns="False"
                Background="Linen"
                ItemsSource="{Binding}">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem
                            Name="ctxDelete"
                            Click="ctxDelete_Click"
                            Header="Delete" />
                        <MenuItem
                            Name="xtxAdd"
                            Click="ctxAdd_Click"
                            Header="Add Item" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="150" Header="Company">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center" Text="{Binding CompanyName}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox
                                    x:Name="lstCompanies"
                                    Background="White"
                                    DisplayMemberPath="Name"
                                    IsSynchronizedWithCurrentItem="False"
                                    IsTextSearchEnabled="True"
                                    ItemsSource="{Binding Source={StaticResource companies}}"
                                    SelectedValue="{Binding Path=CompanyName}"
                                    SelectedValuePath="Name"
                                    SelectionChanged="List_SelectionChanged" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="150" Header="Department">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center" Text="{Binding DepartmentName}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox
                                    x:Name="lstDepartments"
                                    Background="White"
                                    DisplayMemberPath="Name"
                                    IsSynchronizedWithCurrentItem="False"
                                    IsTextSearchEnabled="True"
                                    ItemsSource="{Binding Source={StaticResource departments}}"
                                    SelectedValue="{Binding Path=DepartmentName}"
                                    SelectedValuePath="Name"
                                    SelectionChanged="List_SelectionChanged" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        x:Name="colAccount"
                        Width="200"
                        Header="Account">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Name="txtAccountName"
                                    VerticalAlignment="Center"
                                    TextAlignment="Left"
                                    Text="{Binding Path=AccountName, Mode=OneWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox
                                    x:Name="lstAccounts"
                                    Width="150"
                                    Background="White"
                                    HorizontalAlignment="Left"
                                    DisplayMemberPath="Description"
                                    IsSynchronizedWithCurrentItem="False"
                                    IsTextSearchEnabled="True"
                                    ItemsSource="{Binding Source={StaticResource accounts}}"
                                    SelectedValue="{Binding Path=Account}"
                                    SelectedValuePath="Key"
                                    SelectionChanged="List_SelectionChanged">
                                    <ComboBox.Style>
                                        <Style>
                                            <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                                        </Style>
                                    </ComboBox.Style>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="100" Header="Amount">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <edit:NumberEntry
                                    VerticalAlignment="Center"
                                    Decimals="2"
                                    MaxLength="10"
                                    Text="{Binding Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:######0.00}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="150" Header="Journal">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center" Text="{Binding JournalName}" TextAlignment="Left"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox
                                    x:Name="lstJournals"
                                    Background="White"
                                    DisplayMemberPath="JournalName"
                                    IsSynchronizedWithCurrentItem="False"
                                    IsTextSearchEnabled="True"
                                    ItemsSource="{Binding Source={StaticResource journals}}"
                                    SelectedValue="{Binding Path=JournalName}"
                                    SelectedValuePath="JournalName">
                                    <ComboBox.Style>
                                        <Style>
                                            <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                                        </Style>
                                    </ComboBox.Style>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Order">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center" Text="{Binding Order}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <edit:NumberEntry
                                    VerticalAlignment="Center"
                                    Decimals="0"
                                    MaxLength="2"
                                    Text="{Binding Order}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <StackPanel
            Grid.Row="2"
            Margin="3"
            Background="WhiteSmoke"
            Orientation="Horizontal">
            <Button
                x:Name="cmdSave"
                Margin="10,0,0,0"
                Click="cmdSave_Click"
                Content="SAVE" />
            <Button
                Name="cmdClose"
                Margin="20,0,0,0"
                Click="cmdClose_Click"
                Content="CLOSE" />
            <Button
                Name="cmdRefresh"
                Margin="50,0,0,0"
                Click="cmdRefresh_Click"
                Content="SAVE AND REFRESH" />
        </StackPanel>
    </Grid>
</Window>
