<Window x:Class="MbcsCentral.frmBuilding"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:my="clr-namespace:MbcsCentral"
        xmlns:viblend="clr-namespace:VIBlend.WPF.Controls;assembly=VIBlend.WPF.Editors"
        Name="formBuilding"
        Title="Building Record"
        MinWidth="950"
        MinHeight="540"
        Background="#FF00C0C0"
        TextBlock.FontSize="16"
        TextBlock.FontWeight="Bold"
        TextBlock.TextAlignment="Center">

    <Window.Resources>
        <my:DateNotNullBool x:Key="DateNotNull" />
        <Style TargetType="TextBox">
            <Setter Property="TextAlignment" Value="Left" />
        </Style>
    </Window.Resources>

    <Border Margin="5"
            BorderBrush="Blue"
            BorderThickness="2"
            CornerRadius="5">
        <Grid Name="MainGrid" TextBlock.FontSize="12" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="125" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="25" />
                <RowDefinition Height="30" />
                <RowDefinition Height="45" />
                <RowDefinition Height="30" />
                <RowDefinition Height="50" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="60" />
                <RowDefinition Height="20" />
                <RowDefinition Height="35" />
            </Grid.RowDefinitions>
            <TextBlock Margin="5,0,0,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Text="Building Number" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBox Name="txtBuildingNumber"
                         Width="50"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         MaxLength="3"
                         Text="{Binding BuildingNumber,
                                        Mode=TwoWay}"
                         TextChanged="txtBuildingNumber_TextChanged" />
                <CheckBox Name="CheckCoop"
                          Margin="5,0,0,0"
                          VerticalAlignment="Center"
                          Content="This is a Coop or Condo"
                          IsChecked="{Binding CoopCondo}" />
            </StackPanel>

            <Grid Grid.Row="0"
                  Grid.RowSpan="5"
                  Grid.Column="1"
                  Margin="0,3,10,0"
                  HorizontalAlignment="Right">
                <TabControl Background="LightGray" TextBlock.TextAlignment="Left">
                    <TabItem Name="tabDhcr1" Header="DHCR ADDRESS 1">
                        <StackPanel Margin="0,5,0,0" Orientation="Vertical">
                            <StackPanel Margin="5,5,0,0" Orientation="Horizontal">
                                <TextBlock Width="110"
                                           VerticalAlignment="Center"
                                           Text="Low House #" />
                                <TextBox Width="60"
                                         Margin="5,0,0,0"
                                         VerticalAlignment="Center"
                                         MaxLength="8"
                                         Text="{Binding DHCRLow}" />
                                <TextBlock Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="High House #" />
                                <TextBox Width="60"
                                         Margin="5,0,0,0"
                                         VerticalAlignment="Center"
                                         MaxLength="8"
                                         Text="{Binding DHCRHigh}" />
                            </StackPanel>
                            <StackPanel Margin="5,5,0,0" Orientation="Horizontal">
                                <TextBlock Width="110"
                                           VerticalAlignment="Center"
                                           Text="Street Name" />
                                <TextBox Width="200"
                                         Margin="5,0,0,0"
                                         VerticalAlignment="Center"
                                         MaxLength="25"
                                         Text="{Binding DHCRStreetName}" />
                                <TextBlock Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="Suffix" />
                                <TextBox Width="60"
                                         Margin="5,0,5,0"
                                         VerticalAlignment="Center"
                                         MaxLength="8"
                                         Text="{Binding DHCRStreetSuffix}" />
                            </StackPanel>
                            <StackPanel Margin="5,5,0,0" Orientation="Horizontal">
                                <TextBlock Width="110"
                                           VerticalAlignment="Center"
                                           Text="City/Town/Village" />
                                <TextBox Width="200"
                                         Margin="5,0,0,0"
                                         VerticalAlignment="Center"
                                         MaxLength="25"
                                         Text="{Binding DHCRCity}" />
                                <TextBlock Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="Code" />
                                <viblend:NumberEditor Width="30"
                                                      Margin="5,0,0,0"
                                                      VerticalAlignment="Center"
                                                      DecimalPlaces="0"
                                                      MaxLength="2"
                                                      Value="{Binding DHCRMunicipality,
                                                                      Mode=TwoWay,
                                                                      UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="5,5,0,0" Orientation="Horizontal">
                                <TextBlock Width="110"
                                           VerticalAlignment="Center"
                                           Text="Zip Code" />
                                <TextBox Width="70"
                                         Margin="5,0,0,0"
                                         VerticalAlignment="Center"
                                         MaxLength="0"
                                         Text="{Binding DHCRZip}" />
                                <TextBlock Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="County Code" />
                                <viblend:NumberEditor Width="30"
                                                      Margin="5,0,0,0"
                                                      VerticalAlignment="Center"
                                                      DecimalPlaces="0"
                                                      MaxLength="2"
                                                      Value="{Binding DHCRCounty,
                                                                      Mode=TwoWay,
                                                                      UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                    <TabItem Name="tabDhcr2" Header="DHCR ADDRESS 2">
                        <StackPanel Margin="0,5,0,0" Orientation="Vertical">
                            <StackPanel Margin="5,5,0,0" Orientation="Horizontal">
                                <TextBlock Width="110"
                                           VerticalAlignment="Center"
                                           Text="Low House #" />
                                <TextBox Width="60"
                                         Margin="5,0,0,0"
                                         VerticalAlignment="Center"
                                         MaxLength="8"
                                         Text="{Binding DHCRLow2}" />
                                <TextBlock Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="High House #" />
                                <TextBox Width="60"
                                         Margin="5,0,0,0"
                                         VerticalAlignment="Center"
                                         MaxLength="8"
                                         Text="{Binding DHCRHigh2}" />
                            </StackPanel>
                            <StackPanel Margin="5,5,0,0" Orientation="Horizontal">
                                <TextBlock Width="110"
                                           VerticalAlignment="Center"
                                           Text="Street Name" />
                                <TextBox Width="200"
                                         Margin="5,0,0,0"
                                         VerticalAlignment="Center"
                                         MaxLength="25"
                                         Text="{Binding DHCRStreetName2}" />
                                <TextBlock Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="Suffix" />
                                <TextBox Width="60"
                                         Margin="5,0,5,0"
                                         VerticalAlignment="Center"
                                         MaxLength="8"
                                         Text="{Binding DHCRStreetSuffix2}" />
                            </StackPanel>
                            <StackPanel Margin="5,5,0,0" Orientation="Horizontal">
                                <TextBlock Width="110"
                                           VerticalAlignment="Center"
                                           Text="City/Town/Village" />
                                <TextBox Width="200"
                                         Margin="5,0,0,0"
                                         VerticalAlignment="Center"
                                         MaxLength="25"
                                         Text="{Binding DHCRCity2}" />
                                <TextBlock Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="Code" />
                                <viblend:NumberEditor Width="30"
                                                      Margin="5,0,0,0"
                                                      VerticalAlignment="Center"
                                                      DecimalPlaces="0"
                                                      MaxLength="2"
                                                      Value="{Binding DHCRMunicipality2,
                                                                      Mode=TwoWay,
                                                                      UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="5,5,0,0" Orientation="Horizontal">
                                <TextBlock Width="110"
                                           VerticalAlignment="Center"
                                           Text="Zip Code" />
                                <TextBox Width="70"
                                         Margin="5,0,0,0"
                                         VerticalAlignment="Center"
                                         MaxLength="0"
                                         Text="{Binding DHCRZip2}" />
                                <TextBlock Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="County Code" />
                                <viblend:NumberEditor Width="30"
                                                      Margin="5,0,0,0"
                                                      VerticalAlignment="Center"
                                                      DecimalPlaces="0"
                                                      MaxLength="2"
                                                      Value="{Binding DHCRCounty2,
                                                                      Mode=TwoWay,
                                                                      UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>

                    </TabItem>
                    <TabItem Name="tabDhcr3" Header="DHCR ADDRESS 3">
                        <StackPanel Margin="0,5,0,0" Orientation="Vertical">
                            <StackPanel Margin="5,5,0,0" Orientation="Horizontal">
                                <TextBlock Width="110"
                                           VerticalAlignment="Center"
                                           Text="Low House #" />
                                <TextBox Width="60"
                                         Margin="5,0,0,0"
                                         VerticalAlignment="Center"
                                         MaxLength="8"
                                         Text="{Binding DHCRLow3}" />
                                <TextBlock Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="High House #" />
                                <TextBox Width="60"
                                         Margin="5,0,0,0"
                                         VerticalAlignment="Center"
                                         MaxLength="8"
                                         Text="{Binding DHCRHigh3}" />
                            </StackPanel>
                            <StackPanel Margin="5,5,0,0" Orientation="Horizontal">
                                <TextBlock Width="110"
                                           VerticalAlignment="Center"
                                           Text="Street Name" />
                                <TextBox Width="200"
                                         Margin="5,0,0,0"
                                         VerticalAlignment="Center"
                                         MaxLength="25"
                                         Text="{Binding DHCRStreetName3}" />
                                <TextBlock Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="Suffix" />
                                <TextBox Width="60"
                                         Margin="5,0,5,0"
                                         VerticalAlignment="Center"
                                         MaxLength="8"
                                         Text="{Binding DHCRStreetSuffix3}" />
                            </StackPanel>
                            <StackPanel Margin="5,5,0,0" Orientation="Horizontal">
                                <TextBlock Width="110"
                                           VerticalAlignment="Center"
                                           Text="City/Town/Village" />
                                <TextBox Width="200"
                                         Margin="5,0,0,0"
                                         VerticalAlignment="Center"
                                         MaxLength="25"
                                         Text="{Binding DHCRCity3}" />
                                <TextBlock Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="Code" />
                                <viblend:NumberEditor Width="30"
                                                      Margin="5,0,0,0"
                                                      VerticalAlignment="Center"
                                                      DecimalPlaces="0"
                                                      MaxLength="2"
                                                      Value="{Binding DHCRMunicipality3,
                                                                      Mode=TwoWay,
                                                                      UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="5,5,0,0" Orientation="Horizontal">
                                <TextBlock Width="110"
                                           VerticalAlignment="Center"
                                           Text="Zip Code" />
                                <TextBox Width="70"
                                         Margin="5,0,0,0"
                                         VerticalAlignment="Center"
                                         MaxLength="0"
                                         Text="{Binding DHCRZip3}" />
                                <TextBlock Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="County Code" />
                                <viblend:NumberEditor Width="30"
                                                      Margin="5,0,0,0"
                                                      VerticalAlignment="Center"
                                                      DecimalPlaces="0"
                                                      MaxLength="2"
                                                      Value="{Binding DHCRCounty3,
                                                                      Mode=TwoWay,
                                                                      UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>

                    </TabItem>
                    <TabItem Name="TabDhcr4"
                             Header="Coop/Condo"
                             IsEnabled="{Binding ElementName=CheckCoop,
                                                 Path=IsChecked}">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="35" />
                                <RowDefinition Height="35" />
                                <RowDefinition Height="35" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="Non-Eviction Date" />
                            <StackPanel Grid.Row="0"
                                        Grid.Column="1"
                                        Orientation="Horizontal">
                                <CheckBox Name="CheckCoop1Date"
                                          VerticalAlignment="Center"
                                          Click="CheckCoopDate_Checked"
                                          IsChecked="{Binding NonEvictionDate,
                                                              Converter={StaticResource DateNotNull}}" />
                                <DatePicker Name="DatCoop1Date"
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            IsEnabled="{Binding ElementName=CheckCoop1Date,
                                                                Path=IsChecked}"
                                            SelectedDate="{Binding NonEvictionDate,
                                                                   Mode=TwoWay}" />
                            </StackPanel>
                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="Eviction Date" />
                            <StackPanel Grid.Row="1"
                                        Grid.Column="1"
                                        Orientation="Horizontal">
                                <CheckBox Name="CheckCoop2Date"
                                          VerticalAlignment="Center"
                                          Click="CheckCoopDate_Checked"
                                          IsChecked="{Binding EvictionDate,
                                                              Converter={StaticResource DateNotNull}}" />
                                <DatePicker Name="DatCoop2Date"
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            IsEnabled="{Binding ElementName=CheckCoop2Date,
                                                                Path=IsChecked}"
                                            SelectedDate="{Binding EvictionDate,
                                                                   Mode=TwoWay}" />
                            </StackPanel>
                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="Plan Accepted for Filing" />
                            <StackPanel Grid.Row="2"
                                        Grid.Column="1"
                                        Orientation="Horizontal">
                                <CheckBox Name="CheckCoop3Date"
                                          VerticalAlignment="Center"
                                          Click="CheckCoopDate_Checked"
                                          IsChecked="{Binding AcceptedForFilingDate,
                                                              Converter={StaticResource DateNotNull}}" />
                                <DatePicker Name="DatCoop3Date"
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            IsEnabled="{Binding ElementName=CheckCoop3Date,
                                                                Path=IsChecked}"
                                            SelectedDate="{Binding AcceptedForFilingDate,
                                                                   Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>

            </Grid>
            <TextBlock Grid.Row="1"
                       Margin="5,0,0,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Text="Owner" />
            <TextBox Name="txtOwnerName"
                     Grid.Row="1"
                     Grid.Column="1"
                     Width="300"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     IsReadOnly="True"
                     Text="{Binding OwnerName,
                                    Mode=OneTime}" />
            <TextBlock Grid.Row="2"
                       Margin="5,0,0,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Text="Address" />
            <TextBox Name="txtAddress1"
                     Grid.Row="2"
                     Grid.Column="1"
                     Width="250"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Bottom"
                     MaxLength="30"
                     Text="{Binding Address1,
                                    Mode=TwoWay}" />
            <TextBox Grid.Row="3"
                     Grid.Column="1"
                     Width="250"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     MaxLength="30"
                     Text="{Binding Address2,
                                    Mode=TwoWay}" />
            <TextBlock Grid.Row="4"
                       Margin="5,0,0,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Text="Superintendent" />
            <TextBox Grid.Row="4"
                     Grid.Column="1"
                     Width="200"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Bottom"
                     MaxLength="18"
                     Text="{Binding SuperintendantName,
                                    Mode=TwoWay}" />
            <TextBlock Grid.Row="5"
                       Margin="5,0,0,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Text="Phone" />
            <TextBox Grid.Row="5"
                     Grid.Column="1"
                     Width="150"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     MaxLength="12"
                     Text="{Binding SuperintendantPhone,
                                    Mode=TwoWay}" />
            <TextBlock Grid.Row="6"
                       Margin="5,0,0,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Text="Agent" />
            <TextBox Grid.Row="6"
                     Grid.Column="1"
                     Width="200"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Bottom"
                     MaxLength="12"
                     Text="{Binding AgentName,
                                    Mode=TwoWay}" />
            <TextBlock Grid.Row="7"
                       Margin="5,0,0,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Text="Email" />
            <StackPanel Grid.Row="7" Grid.Column="1" Margin="0,2,0,0">
                <TextBox Grid.Row="7"
                     Grid.Column="1"
                     Width="450"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     MaxLength="50"
                     Text="{Binding email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    Width="450"
                    Margin="0,2,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    MaxLength="50"
                    Text="{Binding Email2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <Grid Grid.Row="8"
                  Grid.Column="0"
                  Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,10,0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Text="Block" />
                <TextBox Grid.Column="1"
                         Width="50"
                         Margin="0,0,5,0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         MaxLength="4"
                         Text="{Binding BlockNumber,
                                        Mode=TwoWay}" />
                <TextBlock Grid.Column="2"
                           Margin="5,0,5,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Text="Lot" />
                <TextBox Grid.Column="3"
                         Width="45"
                         Margin="0,0,5,0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         MaxLength="3"
                         Text="{Binding LotNumber,
                                        Mode=TwoWay}" />
                <TextBlock Grid.Column="4"
                           Margin="5,0,5,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Text="Section" />
                <TextBox Grid.Column="5"
                         Width="50"
                         Margin="0,0,5,0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         MaxLength="3"
                         Text="{Binding SectionNumber,
                                        Mode=TwoWay}" />
                <TextBlock Grid.Column="6"
                           Margin="5,0,5,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Text="MDR Number" />
                <TextBox Grid.Column="7"
                         Width="80"
                         Margin="0,0,5,0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         MaxLength="6"
                         Text="{Binding MultipleDwellingRegistrationNumber,
                                        Mode=TwoWay}" />

            </Grid>
            <GroupBox Grid.Row="9"
                      Grid.RowSpan="2"
                      Grid.ColumnSpan="2"
                      BorderBrush="Blue"
                      BorderThickness="2"
                      Foreground="Blue"
                      Header="Security Account Info">
                <StackPanel Margin="0,5,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="125" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="5,0,0,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Text="Master Account" />
                        <TextBlock Grid.Column="2"
                                   Margin="10,0,5,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Text="Authorized Rep" />
                        <TextBox Grid.Column="3"
                                 Width="250"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 MaxLength="32"
                                 Text="{Binding AuthRep,
                                                Mode=TwoWay}" />

                        <TextBox Grid.Row="9"
                                 Grid.Column="1"
                                 Width="100"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 MaxLength="10"
                                 Text="{Binding MasterAccount,
                                                Mode=TwoWay}" />
                    </Grid>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="125" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="5,0,0,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Text="Authorization Code" />
                        <TextBox Grid.Column="1"
                                 Width="100"
                                 Margin="0,0,5,0"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 MaxLength="10"
                                 Text="{Binding AuthCode,
                                                Mode=TwoWay}" />

                    </Grid>
                </StackPanel>
            </GroupBox>
            <Grid Grid.Row="11" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="5,0,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Text="RE Taxes" />
                <viblend:NumberEditor Grid.Column="1"
                                      Width="80"
                                      Margin="0,0,5,5"
                                      VerticalAlignment="Center"
                                      DecimalPlaces="2"
                                      MaxLength="10"
                                      Text="{Binding RealEstateTaxes,
                                                     Mode=TwoWay}" />
                <TextBlock Grid.Column="2"
                           Margin="5,0,5,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Text="Mort. Interest" />
                <viblend:NumberEditor Grid.Column="3"
                                      Width="80"
                                      Margin="0,0,5,0"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      DecimalPlaces="2"
                                      MaxLength="10"
                                      Text="{Binding MortgageInterest}" />
                <TextBlock Grid.Column="4"
                           Margin="5,0,5,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Text="Total Shares" />
                <viblend:NumberEditor Grid.Column="5"
                                      Width="100"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      DecimalPlaces="0"
                                      MaxLength="8"
                                      Text="{Binding TotalShares,
                                                     Mode=TwoWay}" />

            </Grid>
            <Grid Grid.Row="12" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <GroupBox Grid.Column="0"
                          Margin="20,0,0,0"
                          Background="LightGray"
                          BorderBrush="Black"
                          BorderThickness="1"
                          Header="Rent Change Reasons">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Margin="5,10,0,0"
                                  Content="MCI"
                                  IsChecked="{Binding RentChangeMCI,
                                                      Mode=TwoWay,
                                                      UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Margin="20,10,5,0"
                                  Content="Hardship"
                                  IsChecked="{Binding RentChangeHardship,
                                                      Mode=TwoWay,
                                                      UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Grid.Column="1"
                          Margin="30,0,0,0"
                          Background="LightGray"
                          BorderBrush="Black"
                          BorderThickness="1"
                          Header="Apartment Contact Person Is">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Name="optOwner"
                                     Margin="5,10,0,0"
                                     Content="Owner"
                                     GroupName="ContactGroup" />
                        <RadioButton Name="optAgent"
                                     Margin="10,10,0,0"
                                     Content="Agent"
                                     GroupName="ContactGroup" />
                        <RadioButton Name="optCoop"
                                     Margin="10,10,5,0"
                                     Content="Coop/Condo Owner"
                                     GroupName="ContactGroup" />
                    </StackPanel>
                </GroupBox>

            </Grid>
            <Grid Grid.Row="14" Grid.ColumnSpan="2">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Name="cmdSave"
                            Margin="50,0,0,0"
                            Click="cmdSave_Click"
                            Content="SAVE" />
                    <Button Name="cmdPrint"
                            Margin="20,0,0,0"
                            Click="cmdPrint_Click"
                            Content="PRINT FORM" />
                    <Button Name="cmdCancel"
                            Margin="20,0,0,0"
                            Click="cmdCancel_Click"
                            Content="EXIT" />
                    <Button Name="cmdAddTenants"
                            Margin="50,0,0,0"
                            Click="cmdAddTenants_Click"
