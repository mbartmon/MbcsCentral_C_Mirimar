<Window x:Class="MbcsCentral.WinPM.frmCharge"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:my="clr-namespace:MbcsCentral"
        xmlns:viblend="clr-namespace:VIBlend.WPF.Controls;assembly=VIBlend.WPF.Editors"
        Name="formCharge"
        Title="Charge Record"
        Width="462"
        Height="503"
        Background="#FF00C0C0"
        FontSize="14"
        FontWeight="Bold"
        TextBlock.TextAlignment="Center">

    <Window.Resources>
        <my:CurrencyPaddingConverter x:Key="CurrencyPadder" />
        <my:NegativeColorRed x:Key="NegativeColorRed" />
    </Window.Resources>

    <Border BorderBrush="Blue"
            BorderThickness="3"
            CornerRadius="5">
        <Grid TextBlock.FontSize="12" TextBlock.TextAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    BorderBrush="Black"
                    BorderThickness="2">
                <StackPanel Name="pnlTenant" Orientation="Horizontal">
                    <TextBlock Margin="5,0,0,0"
                               VerticalAlignment="Center"
                               Text="Tenant #" />
                    <TextBox Width="35"
                             Margin="5,0,0,0"
                             VerticalAlignment="Center"
                             IsReadOnly="True"
                             Text="{Binding BuildingNumber}" />
                    <TextBox Width="40"
                             Margin="1,0,0,0"
                             VerticalAlignment="Center"
                             IsReadOnly="True"
                             Text="{Binding TenantNumber}" />
                    <TextBlock Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Text="Name" />
                    <TextBox Width="170"
                             Margin="5,0,0,0"
                             VerticalAlignment="Center"
                             IsReadOnly="True"
                             Text="{Binding TenantName}" />
                    <TextBlock Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Text="Apt" />
                    <TextBox Width="40"
                             Margin="5,0,0,0"
                             VerticalAlignment="Center"
                             IsReadOnly="True"
                             Text="{Binding Apartment}" />
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal">
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Text="Charge Code/Desc: " />
                <ComboBox Name="lstCodes"
                          Width="300"
                          Height="30"
                          DisplayMemberPath="DisplayDescription"
                          FontFamily="Courier New"
                          ItemsSource="{Binding}"
                          SelectedValuePath="ChargeCode" />
            </StackPanel>
            <StackPanel Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal">
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Text="Frequency:" />
                <RadioButton Name="optOneTime"
                             Margin="10,0,0,0"
                             VerticalAlignment="Center"
                             Content="One Time"
                             GroupName="FrequencyGroup"
                             IsChecked="False" />
                <RadioButton Name="optRecurring"
                             Margin="10,0,0,0"
                             VerticalAlignment="Center"
                             Content="Recurring"
                             GroupName="FrequencyGroup"
                             IsChecked="False" />
            </StackPanel>
            <GroupBox Grid.Row="3" Grid.ColumnSpan="2">
                <StackPanel Orientation="Horizontal">
                    <CheckBox Margin="10,0,0,0"
                              VerticalAlignment="Center"
                              Content="Legal Rent"
                              IsChecked="{Binding LegalRent}" />
                    <CheckBox Margin="40,0,0,0"
                              VerticalAlignment="Center"
                              Content="Charge to Tenant"
                              IsChecked="{Binding ChargeToTenant}" />
                    <CheckBox Margin="40,0,0,0"
                              VerticalAlignment="Center"
                              Content="Show on Bill"
                              IsChecked="{Binding ShowOnBill}" />
                </StackPanel>
            </GroupBox>
            <StackPanel Grid.Row="4"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal">
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Text="Comment" />
                <TextBox Width="300"
                         Margin="5,0,0,0"
                         VerticalAlignment="Center"
                         Text="{Binding Comment}" />
                <CheckBox Margin="5,0,0,0"
                          VerticalAlignment="Center"
                          Content="On Bill"
                          IsChecked="{Binding OnBill}" />
            </StackPanel>
            <Border Grid.Row="5"
                    Grid.RowSpan="6"
                    Margin="10,0,10,0"
                    BorderBrush="White"
                    BorderThickness="2"
                    CornerRadius="5">
                <StackPanel Background="Green">
                    <StackPanel Height="30"
                                Margin="0,10,0,0"
                                Orientation="Horizontal">
                        <TextBlock Width="60"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="Amount" />
                        <my:NumberEntry Width="100"
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        HorizontalContentAlignment="Right"
                                        Decimals="2"
                                        Foreground="{Binding Path=Amount,
                                                             Converter={StaticResource NegativeColorRed},
                                                             Mode=Default}"
                                        MaxLength="10"
                                        Text="{Binding Amount,
                                                       Mode=TwoWay,
                                                       StringFormat={}{0:######0.00}}" />
                    </StackPanel>
                    <StackPanel Height="30" Orientation="Horizontal">
                        <TextBlock Width="60"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="Arrears" />
                        <my:NumberEntry Width="100"
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        Decimals="2"
                                        HorizontalContentAlignment="Right"
                                        Foreground="{Binding Path=Arrears,
                                                             Converter={StaticResource NegativeColorRed},
                                                             Mode=Default}"
                                        MaxLength="10"
                                        Text="{Binding Arrears,
                                                       Mode=TwoWay,
                                                       StringFormat={}{0:######0.00},
                                                       Converter={StaticResource CurrencyPadder},
                                                       ConverterParameter=10}" />
                    </StackPanel>
                    <StackPanel Height="50" Orientation="Horizontal">
                        <TextBlock Width="60"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="Total" />
                        <TextBox Width="100"
                                 Margin="5,0,0,0"
                                 VerticalAlignment="Center"
                                 Foreground="{Binding Path=Total,
                                                      Converter={StaticResource NegativeColorRed},
                                                      Mode=Default}"
                                 IsReadOnly="True"
                                 Text="{Binding Total,
                                                Mode=OneWay,
                                                StringFormat={}{0:######0.00},
                                                Converter={StaticResource CurrencyPadder},
                                                ConverterParameter=10}"
                                 TextAlignment="Right" />
                    </StackPanel>
                    <StackPanel Height="50" Orientation="Horizontal">
                        <TextBlock Width="60"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="Paid" />
                        <my:NumberEntry Width="100"
                                         Margin="5,0,0,0"
                                         VerticalAlignment="Center"
                                         Decimals="2"
                                        HorizontalContentAlignment="Right"
                                         Foreground="{Binding Path=Paid,
                                                              Converter={StaticResource NegativeColorRed},
                                                              Mode=Default}"
                                         MaxLength="10"
                                         Text="{Binding Paid,
                                                        Mode=TwoWay,
                                                        StringFormat={}{0:######0.00},
                                                        Converter={StaticResource CurrencyPadder},
                                                        ConverterParameter=10}" />
                    </StackPanel>
                    <StackPanel Height="50" Orientation="Horizontal">
                        <TextBlock Width="60"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="Balance" />
                        <TextBox Width="100"
                                 Margin="5,0,0,0"
                                 VerticalAlignment="Center"
                                 Foreground="{Binding Path=Balance,
                                                      Converter={StaticResource NegativeColorRed},
                                                      Mode=Default}"
                                 IsReadOnly="True"
                                 Text="{Binding Balance,
                                                Mode=OneWay,
                                                StringFormat={}{0:######0.00},
                                                Converter={StaticResource CurrencyPadder},
                                                ConverterParameter=10}"
                                 TextAlignment="Right" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="5"
                        Grid.Column="1"
                        Orientation="Horizontal">
                <TextBlock Width="85"
                           VerticalAlignment="Center"
                           Text="Starting Date" />
                <CheckBox Name="chkStartDate"
                          Margin="5,0,0,0"
                          VerticalAlignment="Center" />
                <DatePicker VerticalAlignment="Center"
                            DisplayDate="{Binding StartingDate,
                                                  Mode=OneWay}"
                            DisplayDateStart="1900-01-01"
                            IsEnabled="{Binding ElementName=chkStartDate,
                                                Path=IsChecked}"
                            PreviewMouseDown="Date_PreviewMouseDown"
                            Text="{Binding StartingDate,
                                           Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Row="6"
                        Grid.Column="1"
                        Orientation="Horizontal">
                <TextBlock Width="85"
                           VerticalAlignment="Top"
                           Text="Ending Date" />
                <CheckBox Name="chkEndingDate"
                          Margin="5,4,0,0"
                          VerticalAlignment="Top" />
                <DatePicker VerticalAlignment="Top"
                            DisplayDate="{Binding EndingDate,
                                                  Mode=OneWay}"
                            DisplayDateStart="1900-01-01"
                            IsEnabled="{Binding ElementName=chkEndingDate,
                                                Path=IsChecked}"
                            PreviewMouseDown="Date_PreviewMouseDown"
                            Text="{Binding EndingDate,
                                           Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Row="7"
                        Grid.Column="1"
                        Orientation="Horizontal">
                <TextBlock Width="85"
                           VerticalAlignment="Center"
                           Text="Future Amount" />
                <my:NumberEntry Width="100"
                                      Margin="5,0,0,0"
                                      VerticalAlignment="Center"
                                      Decimals="2"
                                      MaxLength="10"
                                      Text="{Binding FutureAmount,
                                                     Mode=TwoWay,
                                                     StringFormat={}{0:######0.00},
                                                     Converter={StaticResource CurrencyPadder},
                                                     ConverterParameter=10}" />
            </StackPanel>
            <StackPanel Grid.Row="8"
                        Grid.Column="1"
                        Orientation="Horizontal">
                <TextBlock Width="85"
                           VerticalAlignment="Top"
                           Text="Future Date" />
                <CheckBox Name="chkFutureDate"
                          Margin="5,4,0,0"
                          VerticalAlignment="Top" />
                <DatePicker VerticalAlignment="Top"
                            DisplayDate="{Binding FutureDate,
                                                  Mode=OneWay}"
                            DisplayDateStart="1900-01-01"
                            IsEnabled="{Binding ElementName=chkFutureDate,
                                                Path=IsChecked}"
                            PreviewMouseDown="Date_PreviewMouseDown"
                            Text="{Binding FutureDate,
                                           Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Row="10"
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                <Button Name="cmdSave"
                        VerticalAlignment="Center"
                        Click="cmdSave_Click_1"
                        Content="SAVE" />
                <Button Name="cmdCancel"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center"
                        Click="cmdCancel_Click_1"
                        Content="CANCEL" />
                <Button Name="cmdPrint"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center"
                        Click="cmdPrint_Click"
                        Content="PRINT FORM" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
