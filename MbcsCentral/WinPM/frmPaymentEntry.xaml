            <StackPanel
                Grid.Row="3"
                Grid.Column="1"
                HorizontalAlignment="Left"
                Orientation="Horizontal">
                <Border
                    Width="90"
                    Height="55"
                    Margin="5,5,20,0"
                    VerticalAlignment="Top"
                    BorderBrush="Black"
                    BorderThickness="2">
                    <TextBlock
                        Height="Auto"
                        Margin="3,0,0,0"
                        FontWeight="Bold">
                        Rent Due is
                        <LineBreak />
                        exclusive of
                        <LineBreak />
                        credits.
                    </TextBlock>
                </Border>

                <StackPanel VerticalAlignment="Top">
                    <Button Name="cmdSave"
                        Width="100"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        Click="payent_save"
                        Content="SAVE"
                        IsDefault="False" />
                    <Button Name="cmdClear"
                        Width="100"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        Click="cmdClear_Click_1"
                        Content="CLEAR" />
                    <Button Name="cmdReset"
                        Width="100"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        Click="cmdReset_Click_1"
                        Content="RESET" />
                    <Button Name="cmdExit"
                        Width="100"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        Click="cmdExit_Click_1"
                        Content="EXIT"
                        IsCancel="true" />
                </StackPanel>
            </StackPanel>
            <StackPanel
                Grid.Row="4"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Grid Width="34" Margin="0,10,0,9">
                    <TextBlock VerticalAlignment="Center" Text="TOTAL" />
                </Grid>
                <viblend:NumberEditor x:Name="txtTotal"
                    Grid.Row="4"
                    Width="90"
                    Margin="5,0,12,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    DecimalPlaces="2"
                    IsReadOnly="True"
                    MaxLength="10" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
