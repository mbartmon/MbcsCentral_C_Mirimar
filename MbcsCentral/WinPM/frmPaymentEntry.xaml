<Window Name="formPaymentEntry"
    x:Class="MbcsCentral.WinPM.frmPaymentEntry"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:col="clr-namespace:System.Collections;assembly=mscorlib"
    xmlns:diag="clr-namespace:System.Diagnostics;assembly=WindowsBase"
    xmlns:my="clr-namespace:MbcsCentral"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:viblend="clr-namespace:VIBlend.WPF.Controls;assembly=VIBlend.WPF.Editors"
    Title="Tenant Payment Entries"
    Width="600"
    Height="400"
    Background="#FF21B721"
    Closed="formPaymentEntry_Closed_1"
    Loaded="formPaymentEntry_Loaded_1">

    <Window.Resources>
        <my:NegativeColorRed x:Key="NegativeColorRed" />
        <my:CurrencyPaddingConverter x:Key="CurrencyPadder" />
        <my:DateConverter x:Key="DateConverter" />
        <my:StringPad x:Key="StringPad" />
    </Window.Resources>
    <Border
        BorderBrush="Blue"
        BorderThickness="3"
        CornerRadius="5">
        <Grid Name="MainGrid"
            Margin="-3,-3,3,3"
            DataContext="{Binding}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="240" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="35" />
                <RowDefinition Height="35" />
                <RowDefinition Height="5" />
                <RowDefinition />
                <RowDefinition Height="35" />
            </Grid.RowDefinitions>
            <StackPanel Name="pnlTenantInfo"
                Grid.ColumnSpan="2"
                Orientation="Horizontal">
                <TextBlock Text="Tenant #"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center" />
                <TextBox Name="txtBuildingNumber"
                    Width="35"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    MaxLength="3"
                    TextChanged="txtBuildingNumber_TextChanged_1" />
                <TextBox Name="txtTenantNumber"
                    Width="40"
                    VerticalAlignment="Center"
                    LostFocus="txtTenantNumber_LostFocus_1"
                    MaxLength="4"
                    PreviewKeyDown="txtTenantNumber_PreviewKeyDown_1" />
                <TextBlock Text="Name"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center" />
                <TextBox Name="txtTenantName" Text="{Binding TenantName}"
                    Width="200"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    IsReadOnly="True"
                    IsTabStop="False" />
                <TextBlock Text="Apt"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center" />
                <TextBox Name="txtApartment" Text="{Binding Apartment}"
                    Width="45"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    IsReadOnly="True"
                    IsTabStop="False" />
                <TextBlock Text="Due"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center" />
                <TextBox Name="txtDue"
                    Width="90"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    IsReadOnly="True"
                    IsTabStop="False"
                    TextAlignment="Right" />
            </StackPanel>
            <StackPanel
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Orientation="Horizontal">
                <TextBlock Text="Amt Received"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center" />
                <my:NumberEntry x:Name="txtReceived"
                    Width="90"
                    Margin="3,0,0,0"
                    VerticalAlignment="Center"
                    Decimals="2"
                    GotFocus="NumberEditor_GotFocus"
                    LostFocus="txtReceived_LostFocus"
                    MaxLength="10"
                    PreviewKeyDown="txtReceived_PreviewKeyDown_1"
                    TextAlignment="Right" />
                <CheckBox Name="chkSecurity"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Checked="chkSecurity_LostFocus_1"
                    Content="Security Payment"
                    FlowDirection="RightToLeft"
                    LostFocus="chkSecurity_LostFocus_1" />
                <TextBlock Text="Date"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center" />
                <DatePicker Name="dtDatePaid"
                    Margin="3,0,0,0"
                    VerticalAlignment="Center"
                    SelectedDateChanged="dtDatePaid_SelectedDateChanged" />
                <CheckBox Name="chkNotSystemDate"
                    VerticalAlignment="Center"
                    Checked="chkNotSystemDate_Checked"
                    Content="Payment Date Instead of System Date" />
            </StackPanel>
            <Border
                Grid.Row="2"
                Grid.ColumnSpan="2"
                BorderBrush="Black"
                BorderThickness="3" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="3" Grid.Column="0">
                        <Grid Name="grdPayments">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="400" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ScrollViewer>
