<Window x:Class="MbcsCentral.WinPM.frmSecTrans"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:MbcsCentral.WinPM"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:my="clr-namespace:MbcsCentral"
        xmlns:viblend="clr-namespace:VIBlend.WPF.Controls;assembly=VIBlend.WPF.Editors"
        Name="formSecTrans"
        Title="Tenant Security Transactions"
        Width="627"
        Height="341"
        Background="LightBlue"
        Closing="Window_Closing"
        Loaded="Window_Loaded"
        TextBlock.FontSize="14"
        TextBlock.FontWeight="Bold"
        TextBlock.TextAlignment="Center"
        mc:Ignorable="d">
    <Window.Resources>
        <!--  SINGLE CLICK EDITING  -->
        <Style TargetType="{x:Type DataGridCell}">
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DataGridCell_PreviewMouseLeftButtonDown" />
        </Style>
        <CollectionViewSource x:Key="Codes" />
        <my:CurrencyPaddingConverter x:Key="CurrencyPadder" />
    </Window.Resources>
    <!--
                        <DataGridTemplateColumn Header="Type" Width="225" TextBlock.TextAlignment="Left">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center" TextAlignment="Left"  Text="{Binding Description}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox Name="List"
                                          Background="White"
                                          DisplayMemberPath="FullDescription"
                                          IsSynchronizedWithCurrentItem="False"
                                          IsTextSearchEnabled="True"
                                          ItemsSource="{Binding Source={StaticResource Codes}}"
                                          SelectedValue="{Binding Path=TransType}"
                                          SelectedValuePath="FullDescription"
                                          SelectionChanged="List_SelectionChanged" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

    -->
    <Border BorderBrush="Blue"
            BorderThickness="3"
            CornerRadius="5">
        <Grid Name="MainGrid"
              DataContext="{Binding}"
              TextBlock.FontSize="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="115" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="35" />
                <RowDefinition Height="35" />
                <RowDefinition />
                <RowDefinition Height="35" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal">
                <TextBlock Margin="5,0,0,0"
                           VerticalAlignment="Center"
                           Text="Tenant Number" />
                <TextBox Name="txtBuildingNumber"
                         Width="30"
                         Margin="5,0,0,0"
                         VerticalAlignment="Center"
                         GotFocus="TextBox_GotFocus"
                         MaxLength="3"
                         Text="{Binding BuildingNumber,
                                        Mode=OneTime}"
                         TextChanged="txtBuildingNumber_TextChanged" />
                <TextBox Name="txtTenantNumber"
                         Width="35"
                         Margin="2"
                         VerticalAlignment="Center"
                         GotFocus="TextBox_GotFocus"
                         MaxLength="4"
                         PreviewKeyDown="txtTenantNumber_PreviewKeyDown"
                         Text="{Binding TenantNumber,
                                        Mode=OneTime}" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Text="Name" />
                <TextBox Width="250"
                         Margin="5,0,0,0"
                         VerticalAlignment="Center"
                         Background="White"
                         IsEnabled="False"
                         Text="{Binding TenantName}"
                         TextAlignment="Left" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Text="Apt" />
                <TextBox Width="35"
                         Margin="5,0,0,0"
                         VerticalAlignment="Center"
                         Background="White"
                         IsEnabled="False"
                         Text="{Binding Apartment}" />
                <TextBlock Text="Seq" Margin="5,0,0,0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding SequenceNumber}" IsReadOnly="True" VerticalAlignment="Center" Margin="3,0,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="1"
                        Grid.Column="0"
                        Orientation="Horizontal">
                <TextBlock Margin="5,0,0,0"
                           VerticalAlignment="Center"
                           Text="Social Security Numbers" />
                <TextBox Width="100"
                         Margin="5,0,0,0"
                         VerticalAlignment="Center"
                         Background="White"
                         IsEnabled="False"
                         Text="{Binding SocialSecurityOne}"
                         TextAlignment="Left" />
                <TextBox Width="100"
                         Margin="3,0,0,0"
                         VerticalAlignment="Center"
                         Background="White"
                         IsEnabled="False"
                         Text="{Binding SocialSecurityTwo}"
                         TextAlignment="Left" />
            </StackPanel>
            <DataGrid Name="grdMain"
                      Grid.Row="2"
                      Grid.Column="0"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      ItemsSource="{Binding}">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Name="ctxDelete"
                                  Click="ctxDelete_Click"
                                  Header="Delete" />
                        <MenuItem Name="xtxAdd"
                                  Click="ctxAdd_Click"
                                  Header="Add Item" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="100"
                                            Header="Date"
                                            TextBlock.TextAlignment="Right">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Date, StringFormat={}{0:MM/dd/yyyy}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <DatePicker SelectedDate="{Binding Date}" SelectedDateFormat="Short" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="250"
                                            Header="Type"
                                            TextBlock.TextAlignment="Left">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Name="txtType"
                                           VerticalAlignment="Center"
                                           Text="{Binding Description}"
                                           TextAlignment="Left" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox Name="List"
                                          Background="White"
                                          DisplayMemberPath="FullDescription"
                                          IsSynchronizedWithCurrentItem="False"
                                          IsTextSearchEnabled="True"
                                          ItemsSource="{Binding Source={StaticResource Codes}}"
                                          SelectedValue="{Binding Description}"
                                          SelectedValuePath="FullDescription"
                                          SelectionChanged="List_SelectionChanged" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="110"
                                            Header="Amount"
                                            TextBlock.TextAlignment="Center">
                        <!--
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding Amount,
                                                          StringFormat={}{0:####0.00}}"
                                           TextAlignment="Right" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        -->
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <my:NumberEntry Decimals="2"
                                                MaxLength="10"
                                                Text="{Binding Path=Amount,
                                                               Mode=TwoWay,
                                                               UpdateSourceTrigger=PropertyChanged,
                                                               StringFormat={}{0:####0.00}}"
                                                TextAlignment="Right"
                                                TextChanged="NumberEntry_TextChanged" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="2"
                        Grid.Column="1"
                        Orientation="Vertical">
                    <Button Name="cmdGetTenant"
                            VerticalAlignment="Center"
                            Click="cmdGetTenant_Click"
                            Content="Get Current Tenant" />
                <Button Name="cmdGetList"
                            VerticalAlignment="Center"
                            Content="Get Tenant List"
                            Click="cmdGetList_Click"/>
                <Button Name="cmdClear"
                            Margin="1,0,0,0"
                            VerticalAlignment="Center"
                            Click="cmdClear_Click"
                            Content="CLEAR" />
                <Button Name="cmdAdd"
                        Margin="0,20,0,0"
                        Click="cmdAdd_Click"
                        Content="ADD" />
                <Button Name="cmdSave"
                        Margin="0,2,0,0"
                        Click="cmdSave_Click"
                        Content="SAVE" />
                <Button Name="cmdExit"
                        Margin="0,2,0,0"
                        Click="cmdExit_Click"
                        Content="EXIT" />
            </StackPanel>
            <Grid Grid.Row="3" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Text="Total = " />
                <Border Grid.Column="1"
                        Margin="6,6,23,6"
                        BorderBrush="Black"
                        BorderThickness="2"
                        CornerRadius="3">
                    <TextBlock Name="txtTotal"
                               VerticalAlignment="Center"
                               TextAlignment="Right" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
