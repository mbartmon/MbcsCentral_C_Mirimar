<Window x:Class="MbcsCentral.WinPM.frmSecurityCodes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:my="clr-namespace:MbcsCentral"
        Name="FormSecurityCodes"
        Title="Security Transaction Codes"
        Width="438"
        Height="300"
        Closing="FormSecurityCodes_Closing"
        Loaded="FormSecurityCodes_Loaded"
        TextBlock.FontSize="14"
        TextBlock.FontWeight="Bold"
        TextBlock.TextAlignment="Center">
    <Window.Resources>
        <my:StringTruncate x:Key="StringTruncate" />
        <!--  SINGLE CLICK EDITING  -->
        <Style TargetType="{x:Type DataGridCell}">
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DataGridCell_PreviewMouseLeftButtonDown" />
        </Style>
        <CollectionViewSource x:Key="leases" />
    </Window.Resources>
    <Border BorderBrush="Blue"
            BorderThickness="3"
            CornerRadius="5">
        <Grid TextBlock.FontSize="12" TextBlock.TextAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="35" />
            </Grid.RowDefinitions>
            <DataGrid Name="grdCodes"
                      AlternatingRowBackground="LightBlue"
                      AutoGenerateColumns="False"
                      CanUserAddRows="True"
                      CanUserDeleteRows="True"
                      EnableRowVirtualization="True"
                      ItemsSource="{Binding}">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Click="ctxAdd_Click" Header="Add" />
                        <MenuItem Click="ctxDelete_Click" Header="Delete" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Code">
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="CharacterCasing" Value="Upper"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=IsNew}" Value="True">
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Path=IsNew}" Value="False">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Width="350"
                                        Binding="{Binding Description,
                                                          Mode=TwoWay,
                                                          UpdateSourceTrigger=PropertyChanged,
                                                          Converter={StaticResource StringTruncate},
                                                          ConverterParameter=32}"
                                        Header="Description" />
                </DataGrid.Columns>

            </DataGrid>
            <StackPanel Grid.Row="1" Orientation="Horizontal">
                <Button Name="cmdAdd"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center"
                        Click="cmdAdd_Click"
                        Content="Add New Code" />
                <Button Name="cmdSave"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Click="cmdSave_Click"
                        Content="Save" />
                <Button Name="cmdExit"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Click="cmdExit_Click"
                        Content="Exit" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
