<Window
    x:Class="MbcsCentral.frmTenants"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:my="clr-namespace:MbcsCentral"
    Name="formTenants"
    Title="Work With Tenants"
    Width="689"
    Height="368"
    Background="LightSteelBlue"
    Closing="formTenants_Closing"
    FontWeight="Bold">
    <!--  xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"  -->

    <Window.Resources>
        <my:StringPad x:Key="StringPad" />

    </Window.Resources>

    <Border
        BorderBrush="Blue"
        BorderThickness="3"
        CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Label
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Content="Building/Tenant #" />
                <TextBox
                    Name="txtBuildingNumber"
                    Width="30"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    GotFocus="TextBox_GotFocus"
                    LostFocus="txtBuildingNumber_LostFocus"
                    MaxLength="3"
                    TextChanged="moveNextOnMaxlength" />
                <TextBox
                    Name="txtTenantNumber"
                    Width="40"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    GotFocus="TextBox_GotFocus"
                    LostFocus="txtBuildingNumber_LostFocus"
                    MaxLength="4"
                    PreviewKeyDown="txtTenantNumber_PreviewKeyDown" />
                <Label
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Content="Name" />
                <TextBox
                    Name="txtName"
                    Width="250"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    IsReadOnly="False"
                    PreviewTextInput="txtName_PreviewTextInput" />
                <Label
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Content="Apt" />
                <TextBox
                    Name="txtApt"
                    Width="50"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center" />
            </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="157,0,0,0">
                    <TextBlock Text="Search By Name" VerticalAlignment="Center" />
                    <TextBox Name="txtNameSearch" Width="250" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <Button Name="cmdSearch" Content="SEARCH" VerticalAlignment="Center" Margin="2,0,0,0" Click="cmdSearch_Click"/>
                </StackPanel>
            </StackPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <ListView
                    Name="lstTenants"
                    Grid.Column="0"
                    Margin="0,8,0,0"
                    FontFamily="Courier New"
                    ItemsSource="{Binding}"
                    SelectedValuePath="SequenceNumber"
                    SelectionChanged="lstTenants_SelectionChanged"
                    IsTextSearchEnabled="True"
                    TextSearch.TextPath="TenantName">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="{x:Type ListViewItem}">
                            <EventSetter Event="MouseDoubleClick" Handler="cmdEdit_Click" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn DisplayMemberBinding="{Binding Path=TenantName, Converter={StaticResource StringPad}, ConverterParameter=-35}" Header="Tenant Name" />
                            <GridViewColumn DisplayMemberBinding="{Binding Path=BuildingNumber, Converter={StaticResource StringPad}, ConverterParameter=-3}" Header="Bld" />
                            <GridViewColumn DisplayMemberBinding="{Binding Path=TenantNumber, Converter={StaticResource StringPad}, ConverterParameter=-5}" Header="Ten#" />
                            <GridViewColumn DisplayMemberBinding="{Binding Apartment, Converter={StaticResource StringPad}, ConverterParameter=4}" Header="Apt" />
                            <GridViewColumn DisplayMemberBinding="{Binding Type, Converter={StaticResource StringPad}, ConverterParameter=2}" Header="Type" />
                            <GridViewColumn  Header="ACH">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Path=UseACH}" IsEnabled="False"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel
                    Grid.Column="1"
                    Orientation="Vertical"
                    TextBlock.FontSize="11">
                    <Button
                        Name="cmdEdit"
                        Width="100"
                        Margin="10,3,0,0"
                        HorizontalAlignment="Left"
                        Click="cmdEdit_Click"
                        Content="EDIT" />
                    <Button
                        Name="cmdAdd"
                        Width="100"
                        Margin="10,2,0,0"
                        HorizontalAlignment="Left"
                        Click="cmdAdd_Click"
                        Content="ADD" />
                    <Button
                        Name="cmdHistory"
                        Width="100"
                        Margin="10,2,0,0"
                        HorizontalAlignment="Left"
                        Click="cmdHistory_Click"
                        Content="HISTORY" />
                    <Button
                        Name="cmdMaint"
                        Width="100"
                        Margin="10,2,0,0"
                        HorizontalAlignment="Left"
                        Click="cmdMaint_Click"
                        Content="MAINT RECS" />
                    <Button
                        Name="cmdRemove"
                        Width="100"
                        Margin="10,2,0,0"
                        HorizontalAlignment="Left"
                        Click="cmdRemove_Click">
                        <Button.Content>
                            <TextBlock FontSize="10.5" TextAlignment="Center">
                                REMOVE<LineBreak />
                                Keep history</TextBlock>
                        </Button.Content>
                    </Button>
                    <Button
                        Name="cmdErase"
                        Width="100"
                        Margin="10,2,0,0"
                        HorizontalAlignment="Left"
                        Click="cmdErase_Click">
                        <Button.Content>
                            <TextBlock FontSize="10.5" TextAlignment="Center">
                                ERASE<LineBreak />
                                Delete History</TextBlock>
                        </Button.Content>
                    </Button>
                    <Button
                        Name="cmdVacate"
                        Width="100"
                        Margin="10,2,0,0"
                        HorizontalAlignment="Left"
                        Click="cmdVacate_Click"
                        Content="VACATE" />
                    <Button
                        Name="cmdLabels"
                        Width="100"
                        Margin="10,2,0,0"
                        HorizontalAlignment="Left"
                        Click="cmdLabels_Click"
                        Content="LABELS" />
                    <Button Name="cmdCheckABA"
                            Width="100"
                            Margin="10,2,0,0"
                            HorizontalAlignment="Left"
                            Click="cmdCheckABA_Click"
                            Content="Check ABA"/>
                    <Button
                        Name="cmdClose"
                        Width="100"
                        Margin="10,15,0,0"
                        HorizontalAlignment="Left"
                        Click="cmdExit_Click"
                        Content="CLOSE" />
                    <CheckBox
                        Name="chkVacant"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        Click="chkVacant_Click"
                        Content="Include Vacant?"
                        IsChecked="True" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
