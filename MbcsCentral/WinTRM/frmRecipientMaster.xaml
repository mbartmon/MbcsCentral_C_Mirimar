<Window
    x:Class="MbcsCentral.WinTrm.frmRecipientMaster"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:my="clr-namespace:MbcsCentral.WinTrm"
    Name="formRecipientMaster"
    Title="Recipient List Master"
    Width="1070.943"
    Height="626.208"
    Background="{StaticResource {x:Static SystemColors.InactiveBorderBrushKey}}"
    Closing="frmRecipientMaster_Closing"
    Loaded="Window_Loaded"
    mc:Ignorable="d">
    <Window.Resources>
        <CollectionViewSource x:Key="RecipientMasterViewSource" />
        <CollectionViewSource x:Key="RecipientsViewSource" />
        <CollectionViewSource x:Key="BuildingViewSource" />
        <CollectionViewSource x:Key="OwnerTableViewSource" />
        <CollectionViewSource x:Key="typesViewSource" />
    </Window.Resources>
    <Grid DataContext="{StaticResource RecipientMasterViewSource}" Visibility="Visible">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="75" />
            <RowDefinition Height="55" />
            <RowDefinition Height="55" />
            <RowDefinition Height="20*" />
            <RowDefinition Height="25" />
            <RowDefinition Height="15*" />
        </Grid.RowDefinitions>
        <Border
            Name="Border1"
            Grid.Column="1"
            Width="176"
            Height="41"
            Margin="0,12,0,0"
            Padding="7"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{StaticResource {x:Static SystemColors.GradientActiveCaptionBrushKey}}"
            BorderBrush="{StaticResource {x:Static SystemColors.ControlTextBrushKey}}"
            BorderThickness="2"
            CornerRadius="30">
            <TextBlock
                Name="TextBlock1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="Bold"
                Text="Recipient Lists" />
        </Border>
        <StackPanel
            Name="stackAddList"
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Orientation="Horizontal"
            Visibility="Collapsed">
            <Label
                Grid.Column="0"
                VerticalAlignment="Center"
                Content="List Name to Add"
                FontWeight="Bold" />
            <TextBox
                Name="NewListName"
                Width="300"
                VerticalAlignment="Center"
                MaxLength="32" />
            <Button
                Name="cmdNewListAdd"
                Margin="5"
                Content="ADD"
                FontWeight="Bold"
                Visibility="Visible" 
                Click="cmdNewListAdd_Click"/>
            <Button
                Name="cmdNewListCancel"
                Margin="5"
                Content="CANCEL"
                FontWeight="Bold" 
                Click="cmdNewListCancel_Click"/>
        </StackPanel>
        <StackPanel
            Name="stackList"
            Grid.Row="1"
            Grid.ColumnSpan="3"
            Width="479"
            Height="58"
            Margin="0,3,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Visibility="Visible">
            <Label
                Name="Label1"
                Height="34"
                Background="{StaticResource {x:Static SystemColors.ControlLightBrushKey}}"
                Content="Select List"
                FontWeight="Bold" />
            <ComboBox
                Name="lstLists"
                Width="285"
                Height="36"
                Background="{StaticResource {x:Static SystemColors.GradientInactiveCaptionBrushKey}}"
                DisplayMemberPath="listName"
                ItemsSource="{Binding}"
                SelectedValuePath="listId"
                SelectionChanged="ComboBox1_SelectionChanged" />
            <Button
                Name="cmdAddList"
                Margin="5,3,0,0"
                Click="cmdAddList_Click"
                Content="Add List"
                FontWeight="Bold" 
                VerticalAlignment="Center"/>
            <Button
                Name="cmdExit"
                Width="54"
                Margin="5,3,0,0"
                HorizontalContentAlignment="Center"
                Click="cmdExit_Click"
                Content="EXIT"
                FontWeight="Bold"
                VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel
            Name="stackIdName"
            Grid.Row="2"
            Grid.ColumnSpan="3"
            Width="727"
            Height="58"
            Margin="0,3,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <Grid
                Name="Grid1"
                Margin="22,8,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{StaticResource {x:Static SystemColors.ControlLightBrushKey}}"
                    Content="list Id:"
                    FontWeight="Bold" />
                <TextBox
                    Name="ListIdTextBox"
                    Grid.Column="1"
                    Width="60"
                    Height="23"
                    Margin="3,3,0,3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    BorderBrush="{StaticResource {x:Static SystemColors.ActiveCaptionTextBrushKey}}"
                    IsReadOnly="True"
                    IsReadOnlyCaretVisible="True"
                    IsTabStop="False"
                    Text="{Binding Path=listId, Mode=OneWay}" />
            </Grid>
            <Grid
                Name="Grid2"
                Width="476"
                Margin="10,8,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32*" />
                </Grid.RowDefinitions>
                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{StaticResource {x:Static SystemColors.ControlLightBrushKey}}"
                    Content="list Name:"
                    FontWeight="Bold" />
                <TextBox
                    Name="ListNameTextBox"
                    Grid.Column="1"
                    Width="398"
                    Height="23"
                    Margin="3,3,0,3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    BorderBrush="{StaticResource {x:Static SystemColors.ActiveCaptionTextBrushKey}}"
                    IsManipulationEnabled="True"
                    MaxLength="32"
                    MaxLines="1"
                    Text="{Binding Path=listName, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true}" />
            </Grid>
            <Button
                Name="cmdEditList"
                Margin="10,0,0,0"
                Click="cmdEditList_Click"
                Content="SAVE"
                FontWeight="Bold"
                Visibility="{Binding isChanged}" 
                VerticalAlignment="Center"/>
            <Button
                Name="cmdDelete"
                Margin="10,0,0,0"
                Click="cmdDelete_Click"
                Content="DELETE"
                FontWeight="Bold" 
                VerticalAlignment="Center"/>
        </StackPanel>
        <Grid Grid.Row="3" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <Border
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="4"
                BorderBrush="Black"
                BorderThickness="1">
                <Button
                    Margin="50,0,50,0"
                    VerticalAlignment="Center"
                    Click="Button_Click"
                    FontSize="13"
                    FontWeight="Bold">
                    Filters Help
                </Button>
            </Border>
            <Border
                Grid.Column="0"
                BorderBrush="#FF121111"
                BorderThickness="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="25" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Label
                            Grid.Row="0"
                            VerticalAlignment="Center"
                            Content="Filter by Owners"
                            FontSize="13"
                            FontWeight="Bold" />
                        <CheckBox
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            Content="Active"
                            IsChecked="{Binding OwnerFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width=".5*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            Content="Available" />
                        <Label
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            Content="Action" />
                        <Label
                            Grid.Column="2"
                            HorizontalAlignment="Center"
                            Content="Active" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="17" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ListBox
                            Name="lstOwners"
                            Grid.Column="0"
                            Width="Auto"
                            Height="Auto"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            DisplayMemberPath="OwnerName"
                            ItemsSource="{Binding Source={StaticResource OwnerTableViewSource}}"
                            SelectedValuePath="OwnerNumber"
                            SelectionMode="Extended" />
                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="center">
                            <Button
                                Name="cmdAddOwner"
                                Width="17"
                                Height="15"
                                VerticalAlignment="Center"
                                FontWeight="Bold">
                                <Button.Background>
                                    <ImageBrush ImageSource="ARW08RT.ICO" />
                                </Button.Background>
                            </Button>
                            <Button
                                Name="cmdRemoveOwner"
                                Width="17"
                                Height="15"
                                VerticalAlignment="Center"
                                FontSize="8"
                                FontWeight="Bold">
                                <Button.Background>
                                    <ImageBrush ImageSource="ARW08LT.ICO" />
                                </Button.Background>
                            </Button>
                        </StackPanel>
                        <ListBox
                            Name="lstActiveOwners"
                            Grid.Column="2"
                            Width="Auto"
                            Height="auto"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            DisplayMemberPath="OwnerName"
                            FontWeight="Bold"
                            SelectedValuePath="OwnerNumber"
                            SelectionMode="Extended" />
                    </Grid>
                </Grid>
            </Border>
            <Border
                Grid.Column="1"
                BorderBrush="#FF121111"
                BorderThickness="2">
                <Grid ShowGridLines="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="25" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel
                        Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Label
                            Content="Filter by Buildings"
                            FontSize="13"
                            FontWeight="Bold" />
                        <CheckBox
                            VerticalAlignment="Center"
                            Content="Active"
                            IsChecked="{Binding BuildingFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width=".5*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            Content="Available" />
                        <Label
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            Content="Action" />
                        <Label
                            Grid.Column="2"
                            HorizontalAlignment="Center"
                            Content="Active" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="17" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ListBox
                            Name="lstBuildings"
                            Grid.Column="0"
                            Width="Auto"
                            Height="Auto"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            DisplayMemberPath="Address1"
                            ItemsSource="{Binding Source={StaticResource BuildingViewSource}}"
                            SelectedValuePath="BuildingNumber" />
                        <StackPanel Grid.Column="1" VerticalAlignment="center">
                            <Button
                                Name="cmdAddBuilding"
                                Width="17"
                                Height="15"
                                VerticalAlignment="Center"
                                FontSize="8"
                                FontWeight="Bold">
                                <Button.Background>
                                    <ImageBrush ImageSource="ARW08RT.ICO" />
                                </Button.Background>
                            </Button>
                            <Button
                                Name="cmdRemoveBuilding"
                                Width="17"
                                Height="15"
                                VerticalAlignment="Center"
                                FontSize="8"
                                FontWeight="Bold">
                                <Button.Background>
                                    <ImageBrush ImageSource="ARW08LT.ICO" />
                                </Button.Background>
                            </Button>
                        </StackPanel>
                        <ListBox
                            Name="lstActiveBuildings"
                            Grid.Column="2"
                            Width="Auto"
                            Height="auto"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            DisplayMemberPath="Address1"
                            FontWeight="Bold"
                            SelectedValuePath="BuildingNumber" />
                    </Grid>
                </Grid>
            </Border>
            <Border
                Grid.Column="2"
                BorderBrush="#FF121111"
                BorderThickness="2">
                <Grid ShowGridLines="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="25" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Label
                            Content="Filter by Tenant Type"
                            FontSize="13"
                            FontWeight="Bold" />
                        <CheckBox
                            VerticalAlignment="Center"
                            Content="Active"
                            IsChecked="{Binding TypeFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width=".5*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            Content="Available" />
                        <Label
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            Content="Action"
                            FontSize="10" />
                        <Label
                            Grid.Column="2"
                            HorizontalAlignment="Center"
                            Content="Active" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="17" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button
                                Name="cmdAddType"
                                Width="17"
                                Height="15"
                                VerticalAlignment="Center"
                                FontSize="8"
                                FontWeight="Bold">
                                <Button.Background>
                                    <ImageBrush ImageSource="ARW08RT.ICO" />
                                </Button.Background>
                            </Button>
                            <Button
                                Name="cmdRemoveType"
                                Width="17"
                                Height="15"
                                VerticalAlignment="Center"
                                FontSize="8"
                                FontWeight="Bold">
                                <Button.Background>
                                    <ImageBrush ImageSource="ARW08LT.ICO" />
                                </Button.Background>
                            </Button>
                        </StackPanel>
                        <ListBox
                            Name="lstTypes"
                            DisplayMemberPath="Description"
                            ItemsSource="{Binding Source={StaticResource typesViewSource}}"
                            SelectedValuePath="Type" />
                        <ListBox
                            Name="lstActiveTypes"
                            Grid.Column="2"
                            DisplayMemberPath="Description"
                            FontWeight="Bold"
                            SelectedValuePath="Type" />
                    </Grid>
                </Grid>
            </Border>
            <Border
                Grid.Column="3"
                BorderBrush="Black"
                BorderThickness="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Label
                        Grid.Row="0"
                        HorizontalAlignment="Center"
                        Content="Other Filters"
                        FontSize="13"
                        FontWeight="Bold" />
                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox
                                Margin="3,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="Arrears Amount"
                                IsChecked="{Binding ArrearsFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Width="100"
                                Margin="3,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding ArrearsAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Label
            Grid.Row="4"
            VerticalAlignment="Bottom"
            Content="RECIPIENTS"
            FontWeight="Bold" />
        <StackPanel
            Grid.Row="4"
            Grid.Column="1"
            Orientation="Horizontal">
            <Button
                Name="cmdEditRecipients"
                Width="80"
                Margin="0,5,0,0"
                Click="cmdEditRecipients_Click"
                Content="EDIT" />
            <Button
                Name="cmdDeleteRecipients"
                Width="80"
                Margin="0,5,0,0"
                Click="cmdDeleteRecipients_Click"
                Content="DELETE ALL" />
        </StackPanel>
        <DataGrid
            Name="datRecipients"
            Grid.Row="5"
            Grid.ColumnSpan="3"
            Width="Auto"
            Height="Auto"
            Margin="8,10,0,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            AutoGenerateColumns="true"
            ItemsSource="{Binding Source={StaticResource RecipientsViewSource}}" />
    </Grid>
</Window>
