<Window x:Class="MbcsCentral.frmReportList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:MbcsCentral.WinGL"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:diag="clr-namespace:System.Diagnostics;assembly=WindowsBase"
        Name="FormReportList"
        Width="300"
        Height="300"
        Background="AliceBlue"
        Closed="frmReportList_Closed"
        FontSize="14"
        FontWeight="Bold"
        Loaded="frmReportList_Loaded"
        Activated="FormReportList_Activated"
        TextBlock.TextAlignment="Center"
        mc:Ignorable="d">
    <Border BorderBrush="Blue"
            BorderThickness="3"
            CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <TextBox Name="txtTitle" 
                     Background="LightSteelBlue"
                     BorderBrush="Blue"
                     BorderThickness="2"
                     FontSize="16"
                     FontWeight="Bold"
                     Text="Report"
                     TextAlignment="Center" />
            <Grid Grid.Row="1">
                <ListView Name="lstReport" FontFamily="Courier New">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <EventSetter Event="MouseDoubleClick" Handler="listViewItem_MouseDoubleClick" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>
            <StackPanel Grid.Row="2"
                        Margin="0,5,0,5"
                        Background="AliceBlue"
                        Orientation="Horizontal">
                <Button Name="cmdPrint"
                        Margin="10,0,0,0"
                        Click="cmdPrint_Click"
                        Content="PRINT" />
                <Button Name="cmdEmail"
                        Margin="10,0,0,0"
                        Click="cmdEmail_Click"
                        Content="EMAIL"/>
                <Button Name="cmdClose"
                        Margin="10,0,0,0"
                        Click="cmdClose_Click"
                        Content="CLOSE" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

